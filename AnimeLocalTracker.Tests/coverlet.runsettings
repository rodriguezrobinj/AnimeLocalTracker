<?xml version="1.0" encoding="utf-8"?>
<!-- DEV-06b: configuración de coverlet para el umbral de cobertura en CI.
     Excluye el ensamblado de tests (si contara, inflaría el % casi al 100%). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[AnimeLocalTracker.Tests]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
