{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/AnimeLocalTracker/AnimeLocalTracker.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary",
        "/p:UseSharedCompilation=false"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/AnimeLocalTracker/AnimeLocalTracker.csproj",
        "--no-build"
      ],
      "dependsOn": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/AnimeLocalTracker/AnimeLocalTracker.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
