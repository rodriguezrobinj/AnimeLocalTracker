{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch AnimeLocalTracker (C# Dev Kit)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/AnimeLocalTracker/bin/Debug/net8.0-windows/AnimeLocalTracker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/AnimeLocalTracker/bin/Debug/net8.0-windows",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Attach to AnimeLocalTracker (C# Dev Kit)",
      "type": "coreclr",
      "request": "attach",
      "processName": "AnimeLocalTracker.exe"
    }
  ]
}
