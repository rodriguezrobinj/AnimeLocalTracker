<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Barra de "quedó a medio ver" (tiempo reproducido de un capítulo).
         Plana y recta (como la de Galería), con el azul de acento de la app.
         Se combina en App.xaml igual que MinimalScrollBar y CustomComboBox.

         Uso (solo hay que llamar al estilo; Value va de 0 a 1):
           - Junto a un texto:            Style="{StaticResource AppWatchProgressBar}"
           - Sobre una miniatura/portada: Style="{StaticResource AppWatchProgressBar.Overlay}" -->

    <LinearGradientBrush x:Key="Brush.WatchProgressFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#60A5FA" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="AppWatchProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.WatchProgressFill}"/>
        <Setter Property="Background" Value="#44FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" CornerRadius="0" ClipToBounds="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Border x:Name="PART_Indicator" CornerRadius="0" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante para superponer sobre una miniatura: abajo, centrada y sin tocar los bordes -->
    <Style x:Key="AppWatchProgressBar.Overlay" TargetType="ProgressBar" BasedOn="{StaticResource AppWatchProgressBar}">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="10,0,10,8"/>
    </Style>
</ResourceDictionary>
