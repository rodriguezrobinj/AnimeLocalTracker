<Application x:Class="AnimeLocalTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:AnimeLocalTracker.Converters"
             xmlns:vm="clr-namespace:AnimeLocalTracker.ViewModels"
             xmlns:views="clr-namespace:AnimeLocalTracker.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tema Oscuro y colores de acento -->
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Teal" />
                
                <!-- MaterialDesign3 Defaults -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                
                <!-- Barra de Desplazamiento Ultra-Fina Personalizada (Sobrescribe MaterialDesign) -->
                <ResourceDictionary Source="/Themes/MinimalScrollBar.xaml" />

                <!-- Estilo Global de ComboBox Moderno y Glassmorphic -->
                <ResourceDictionary Source="/Themes/CustomComboBox.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Estilo Shimmer Global para imágenes cargando -->
            <Style x:Key="ShimmerEffectStyle" TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform X="-1"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#151515" Offset="0" />
                            <GradientStop Color="#2A2A2A" Offset="0.5" />
                            <GradientStop Color="#151515" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                                                 From="-1" To="1" Duration="0:0:1.5" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>
            
            <!-- Conversores Globales -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <materialDesign:BooleanToVisibilityConverter x:Key="InverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible" />
            <conv:StringEqualsConverter x:Key="StringEquals" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--  SISTEMA DE DISEÑO (tokens canónicos = paleta de DetalleView)  -->
            <!--  Superficies slate-oscuro, acento azul, texto en 3 jerarquías.  -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <SolidColorBrush x:Key="Brush.Surface1" Color="#14181E" />       <!-- tarjetas -->
            <SolidColorBrush x:Key="Brush.Surface2" Color="#161B22" />       <!-- paneles elevados -->
            <SolidColorBrush x:Key="Brush.Surface3" Color="#1E293B" />       <!-- chips / hover con acento -->
            <SolidColorBrush x:Key="Brush.Border" Color="#262D38" />         <!-- bordes sutiles -->
            <SolidColorBrush x:Key="Brush.BorderStrong" Color="#2D3748" />   <!-- bordes de inputs -->
            <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E2E8F0" />
            <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9CA3AF" />
            <!-- UX-02: #6B7280 no alcanzaba 4.5:1 sobre las superficies oscuras en texto
                 pequeño (9-13 px); #94A3B8 cumple AA conservando la jerarquía. -->
            <SolidColorBrush x:Key="Brush.TextTertiary" Color="#94A3B8" />
            <SolidColorBrush x:Key="Brush.Accent" Color="#60A5FA" />
            <SolidColorBrush x:Key="Brush.AccentStrong" Color="#3B82F6" />
            <SolidColorBrush x:Key="Brush.AccentSoft" Color="#93C5FD" />
            <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
            <SolidColorBrush x:Key="Brush.Danger" Color="#F87171" />
            <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B" />
            <SolidColorBrush x:Key="Brush.Rose" Color="#F43F5E" />
            <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

            <!-- ── Escala tipográfica (única fuente de verdad para tamaños) ── -->
            <Style x:Key="AppText.PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            </Style>
            <Style x:Key="AppText.Section" TargetType="TextBlock" BasedOn="{StaticResource AppText.PageTitle}">
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <Style x:Key="AppText.Body" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            </Style>
            <Style x:Key="AppText.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource AppText.Body}">
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="AppText.Secondary" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            </Style>
            <Style x:Key="AppText.Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            </Style>
            <Style x:Key="AppText.Micro" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            </Style>

            <!-- ── Componentes compartidos ── -->
            <!-- Tarjeta estándar -->
            <Style x:Key="AppCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="14"/>
            </Style>
            <!-- Chip / badge de conteo -->
            <Style x:Key="AppBadge" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="MinWidth" Value="26"/>
                <Setter Property="Padding" Value="7,0"/>
            </Style>
            <!-- Contenedor de página: márgenes + animación de entrada (unificado en todas las vistas) -->
            <Style x:Key="AppPageRoot" TargetType="Grid">
                <Setter Property="Margin" Value="95,60,30,30"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="0"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,30,30,30"/>
                    </DataTrigger>
                    <Trigger Property="Visibility" Value="Visible">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuarticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="25" To="0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuarticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Estados vacíos -->
            <Style x:Key="AppEmptyTitle" TargetType="TextBlock" BasedOn="{StaticResource AppText.BodyStrong}">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="AppEmptyText" TargetType="TextBlock" BasedOn="{StaticResource AppText.Secondary}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Opacity" Value="0.85"/>
            </Style>
            <!-- Botones de acción de página -->
            <!-- UX-03: blanco sobre #3B82F6 daba 3.68:1 (< 4.5 AA); #2563EB sube a ~5.1:1. -->
            <Style x:Key="AppPrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#2563EB"/>
                <Setter Property="BorderBrush" Value="#2563EB"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style x:Key="AppOutlinedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--  NAVEGACIÓN VM→VISTA (ARC-04): DataTemplates implícitas.          -->
            <!--  Sustituyen a la fábrica manual con `new` de MainWindow y a los    -->
            <!--  registros DI de vistas que nunca se resolvían.                    -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <DataTemplate DataType="{x:Type vm:GaleriaViewModel}">
                <views:GaleriaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DetalleViewModel}">
                <views:DetalleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AgregarAnimeViewModel}">
                <views:AgregarAnimeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CalendarioViewModel}">
                <views:CalendarioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DescargasViewModel}">
                <views:DescargasView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfiguracionViewModel}">
                <views:ConfiguracionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AcercaDeViewModel}">
                <views:AcercaDeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EstadisticasViewModel}">
                <views:EstadisticasView />
            </DataTemplate>
            <!-- El reproductor NUNCA se reutiliza (swapchain Direct3D nativa): cada
                 navegación crea una vista nueva a partir del VM transitorio. -->
            <DataTemplate DataType="{x:Type vm:ReproductorViewModel}">
                <views:ReproductorView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>