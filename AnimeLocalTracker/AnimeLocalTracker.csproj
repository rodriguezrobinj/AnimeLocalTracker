<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- ARC-08: LibraryImport source-generated (FFI a animetracker_core.dll) exige unsafe. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- DEV-09: versión única del producto; el pipeline de release la lee del tag
             (vX.Y.Z) y los builds locales del script de empaquetado la toman de aquí. -->
        <Version>1.0.5</Version>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Core\" />
    </ItemGroup>

    <ItemGroup>
      <!-- Evita colisiones de nombres entre WinForms y WPF (UserControl, Application, Point, KeyEventArgs...). -->
      <Using Remove="System.Windows.Forms" />
      <Using Remove="System.Drawing" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Flyleaf.FFmpeg" Version="9.0.0" />
      <PackageReference Include="FlyleafLib" Version="3.11.3" />
      <PackageReference Include="FlyleafLib.Controls.WPF" Version="1.7.3" />
      <PackageReference Include="MaterialDesignThemes" Version="5.3.3-ci1462" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
      <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.1" />
      <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
      <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
      <PackageReference Include="Velopack" Version="1.2.0" />
      <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
    </ItemGroup>

    <ItemGroup>
      <None Include="FFmpeg\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="Tools\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <!-- Núcleo nativo Rust (parsing/fingerprint/spritesheets). build.ps1 lo refresca
           desde native\animetracker_core\target\release antes de empaquetar. -->
      <None Include="animetracker_core.dll" Condition="Exists('animetracker_core.dll')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
