<UserControl x:Class="AnimeLocalTracker.Controls.DonutChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Donut -->
        <Grid Width="170" Height="170" VerticalAlignment="Center">
            <Canvas x:Name="DonutCanvas"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="CentroTextoBlock" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CentroSubtextoBlock" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Leyenda -->
        <ItemsControl x:Name="Leyenda" Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PorcentajeTexto}" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
