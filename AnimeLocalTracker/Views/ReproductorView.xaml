<UserControl x:Class="AnimeLocalTracker.Views.ReproductorView"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
        xmlns:ctl="clr-namespace:AnimeLocalTracker.Controls"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="Transparent"
        Focusable="True"
        PreviewMouseDoubleClick="ReproductorView_PreviewMouseDoubleClick"
        PreviewMouseLeftButtonDown="ReproductorView_PreviewMouseLeftButtonDown"
        PreviewKeyDown="ReproductorView_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Foco visible por teclado (UX-001/004): mismo color #3B82F6 que GaleriaView/AgregarAnimeView,
             pero vía FocusVisualStyle en vez de un trigger IsKeyboardFocusWithin sobre el template, porque
             estos son botones de icono transparentes sobre video con plantilla de MaterialDesignToolButton
             (ripple), no cards con borde propio. El adorner se dibuja igual sin depender de esa plantilla. -->
        <Style x:Key="PlayerFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="{StaticResource Brush.AccentStrong}" StrokeThickness="2"
                                   RadiusX="6" RadiusY="6" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Parte reproducida: solo captura el clic. La línea blanca (con sus tramos de color) la dibuja MarcadoresLineaTiempo. -->
        <Style x:Key="TimelinePlayedRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para la parte no reproducida (Transparente para dejar visible el BackgroundTrack translúcido) -->
        <Style x:Key="TimelineUnplayedRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo del Thumb (la bolita blanca limpia, unida a la barra y sin sombras) -->
        <Style x:Key="TimelineScrubberThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="ThumbEllipse"
                                     Width="10" Height="10"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover general sobre el slider (hace crecer la bolita de 10px a 16px) -->
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbEllipse"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.6" Duration="{StaticResource Anim.Rapida}"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbEllipse"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.6" Duration="{StaticResource Anim.Rapida}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbEllipse"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="{StaticResource Anim.Rapida}"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbEllipse"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="{StaticResource Anim.Rapida}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            
                            <!-- Cuando se está arrastrando la bolita (feedback táctil a 18px) -->
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbEllipse" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.8" ScaleY="1.8" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo completo del Slider de la Línea de Tiempo -->
        <Style x:Key="TimelineSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PlayerFocusVisual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid x:Name="SliderGrid" VerticalAlignment="Center" Background="Transparent">
                            <!-- Pista de fondo translúcida (tiempo no reproducido) -->
                            <!-- Margen 10 = media bolita: la pista empieza donde está la bolita en el segundo 0 y acaba donde queda al final
                                 (antes sobraban 10 px a cada lado y la barra nunca se veía ni vacía al empezar ni llena al terminar). -->
                            <Border x:Name="BackgroundTrack" Height="3" CornerRadius="1.5" Margin="10,0"
                                    Background="#55FFFFFF" VerticalAlignment="Center" />

                            <!-- La línea de progreso: parte reproducida en blanco y tramos de opening / ending / resumen en color (la parte
                                 reproducida de un tramo y la bolita toman su color). Crece con el cursor igual que la pista de fondo. -->
                            <ctl:MarcadoresLineaTiempo x:Name="Marcadores"
                                                       Segmentos="{Binding SegmentosLineaTiempo}"
                                                       Duracion="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Valor="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Height="20" VerticalAlignment="Center" />

                            <!-- Track con el botón izquierdo que representa el progreso reproducido en blanco -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TimelinePlayedRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Style="{StaticResource TimelineScrubberThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TimelineUnplayedRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Expansión de la barra de fondo de 3px a 5px en Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BackgroundTrack" Storyboard.TargetProperty="Height" To="5" Duration="{StaticResource Anim.Rapida}"/>
                                            <DoubleAnimation Storyboard.TargetName="Marcadores" Storyboard.TargetProperty="Grosor" To="5" Duration="{StaticResource Anim.Rapida}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BackgroundTrack" Storyboard.TargetProperty="Height" To="3" Duration="{StaticResource Anim.Rapida}"/>
                                            <DoubleAnimation Storyboard.TargetName="Marcadores" Storyboard.TargetProperty="Grosor" To="3" Duration="{StaticResource Anim.Rapida}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem transparente para el cajón de episodios (ui-wpf-vistas.md #2): sin
             plantilla de selección MaterialDesign, el resaltado del episodio actual lo pinta
             el propio DataTemplate con EpisodioItem.EsReproduciendose. -->
        <Style x:Key="CajonEpisodioItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de la barra que abre un menú: con el menú abierto (Tag="activo", lo pone el code-behind) se pinta
             en azul, así se ve a qué botón pertenece el menú que está desplegado. -->
        <Style x:Key="PlayerMenuToolButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="activo">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                    <Setter Property="Background" Value="{StaticResource Brush.AccentTint}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Flecha bajo cada menú flotante que apunta al botón que lo abrió (su posición la calcula el code-behind). -->
        <Style x:Key="FlechaMenu" TargetType="Path">
            <Setter Property="Data" Value="M0,0 L16,0 L8,8 Z"/>
            <Setter Property="Fill" Value="#F2141414"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Chip de ajuste predefinido del ecualizador (resaltado el que está puesto). -->
        <Style x:Key="ChipPresetEcualizador" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface3}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding EsActual}" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo premium compartido por los menús flotantes del reproductor (Subtítulos y
             Más opciones): antes vivía duplicado dentro de los Resources de cada Popup. -->
        <!-- Panel de los menús flotantes del reproductor (subtítulos, audio, más opciones, ecualizador). -->
        <Style x:Key="PlayerMenuPanel" TargetType="Border">
            <Setter Property="Background" Value="#F2141414"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="MenuItemButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.RingBase}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Reproductor NATIVO Flyleaf -->
        <!-- El doble-click fullscreen del host se desactiva por CÓDIGO (ver Loaded en el code-behind):
             como atributo XAML el compilador BAML lo mapea a la propiedad equivocada. -->
        <fl:FlyleafHost Player="{Binding Player}" x:Name="HostFlyleaf">
            <Grid>
                <!-- Bindings vía ElementName: FlyleafHost sobrescribe el DataContext de su contenido -->

                <!-- Subtítulos. Dos elementos (SubtitleTextView) que dibujan el texto con el estilo elegido en
                     Configuración → Reproducción (tipografía, tamaño, color, contorno, caja).
                     Están en la raíz del contenido del FlyleafHost (no se desvanecen con los controles), así que
                     su texto y su estilo los empuja el code-behind (EnlazarSubtitulos), no un Binding: en esa raíz
                     los bindings se quedan congelados y los subtítulos nunca aparecían (ver memoria del proyecto).
                     MaxHeight amplio: con letra grande y dos líneas el bloque supera los 150 px y se encogía.
                     La de abajo es la de siempre; la de arriba solo se llena cuando dos líneas se solapan en el
                     tiempo (dos personajes hablando a la vez) — así ninguna tapa a la otra. -->
                <Viewbox VerticalAlignment="Top" Margin="40,25,40,40" StretchDirection="DownOnly" MaxHeight="320" IsHitTestVisible="False">
                    <ctl:SubtitleTextView x:Name="SubtitulosVistaArriba" MaxWidth="1200"/>
                </Viewbox>
                <Viewbox VerticalAlignment="Bottom" Margin="40,40,40,25" StretchDirection="DownOnly" MaxHeight="320" IsHitTestVisible="False">
                    <ctl:SubtitleTextView x:Name="SubtitulosVista" MaxWidth="1200"/>
                </Viewbox>

                <!-- Subtítulos ASS/SSA con su estilo original: una imagen del tamaño del video que dibuja libass (ver
                     docs/investigacion-subtitulos-ass.md). Se estira igual que el video para que los carteles coincidan con su
                     letrero. Como el texto de arriba, la llena y la muestra el code-behind (ActualizarCapaAss), no un Binding. -->
                <Image x:Name="SubtitulosAssImagen" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed"/>

                <!-- Tapa el video mientras abre y, al reanudar, hasta que el salto al punto guardado se asienta: sin ella se veía
                     un instante el 0:00. Va FUERA de OverlayControls porque esos controles se desvanecen tras 3 s sin mover el
                     ratón (al pasar solo al siguiente episodio la tapa quedaba invisible), y en esta raíz un Binding se queda pegado:
                     su visibilidad la pone el code-behind (ActualizarTapaVideo), igual que los subtítulos y los avisos. -->
                <Grid x:Name="TapaVideo" Background="Black" IsHitTestVisible="False" Visibility="Collapsed">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True" Width="44" Height="44"
                                 Value="0" Foreground="{StaticResource Brush.Accent}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Controles Overlays -->
                <Grid x:Name="OverlayControls" Background="Transparent" DataContext="{x:Null}" Focusable="True" FocusVisualStyle="{x:Null}">

                <!-- Gradiente Superior -->
                <Grid VerticalAlignment="Top" Height="120"
                      Visibility="{Binding EsModoMini, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B3000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid Margin="20,20,20,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Back Arrow -->
                        <Button Grid.Column="0" Command="{Binding CerrarCommand}" Focusable="True"
                                FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="50" Height="50" Margin="0,0,15,0"
                                AutomationProperties.Name="{loc:T Player_VolverFicha}">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="36" Height="36" />
                        </Button>
                        <!-- Titulos Netflix Style -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,-3,0,0">
                            <TextBlock Text="{Binding TituloAnime}" FontWeight="Bold" FontSize="22" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TituloEpisodio}" FontSize="16" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- Favorito del episodio que se está viendo, en la esquina superior derecha: el mismo marcador que en la ficha -->
                        <Button Grid.Column="2" Command="{Binding AlternarFavoritoEpisodioCommand}" Focusable="True"
                                FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                Style="{StaticResource MaterialDesignToolButton}" Width="44" Height="44" Margin="16,0,0,0" VerticalAlignment="Top"
                                ToolTip="{Binding TooltipFavoritoEpisodio}" AutomationProperties.Name="{Binding TooltipFavoritoEpisodio}">
                            <materialDesign:PackIcon Width="28" Height="28">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="BookmarkOutline"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EpisodioEsFavorito}" Value="True">
                                                <Setter Property="Kind" Value="Bookmark"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Barra Inferior Completa -->
                <Grid VerticalAlignment="Bottom"
                      Visibility="{Binding EsModoMini, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#40000000" Offset="0.5"/>
                            <GradientStop Color="#CC000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    
                    <Grid Margin="20,60,20,15" VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Skip Intro -->
                            <RowDefinition Height="Auto"/> <!-- Slider -->
                            <RowDefinition Height="Auto"/> <!-- Botones -->
                        </Grid.RowDefinitions>

                        <!-- Botón Skip Intro / Outro (AniSkip API Crunchyroll / Netflix Style) -->
                        <Button Grid.Row="0" Command="{Binding SkipIntroOutroCommand}" Focusable="True"
                                FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                Visibility="{Binding MostrarSkipButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Right" Margin="0,0,0,14"
                                Background="#E616181F" Foreground="White" BorderBrush="#55FFFFFF" BorderThickness="1"
                                Padding="16,8" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="8"
                                ToolTip="{loc:T Player_SaltarSegmento}">
                            <Button.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.7"/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="{Binding SkipButtonIcon}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A78BFA"/>
                                <TextBlock Text="{Binding SkipButtonTexto}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <!-- Barra de progreso interactiva con Bolita Scrubber -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid x:Name="ProgressBarArea" Cursor="Hand" Background="Transparent"
                                  PreviewMouseLeftButtonDown="ProgressBarArea_PreviewMouseLeftButtonDown"
                                  MouseMove="ProgressBarArea_MouseMove" MouseLeave="ProgressBarArea_MouseLeave">
                                <!-- Tiempo del punto bajo el ratón (y del tramo: opening/ending/resumen). Lo posiciona el code-behind. -->
                                <Canvas IsHitTestVisible="False" ClipToBounds="False" Panel.ZIndex="10">
                                    <Border x:Name="VistaPreviaTiempo" Visibility="Collapsed" Canvas.Top="-34"
                                            Background="#E6141414" CornerRadius="6" Padding="8,3">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="VistaPreviaTiempoTexto" Foreground="White" FontSize="12.5" FontWeight="Bold"/>
                                            <TextBlock x:Name="VistaPreviaTramoTexto" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                                <Slider x:Name="SliderTiempo" Minimum="0" Maximum="{Binding TotalSeconds}" Value="{Binding CurrentSeconds, Mode=TwoWay}"
                                        Style="{StaticResource TimelineSliderStyle}"
                                        AutomationProperties.Name="{loc:T Player_ProgresoEpisodio}"
                                        IsMoveToPointEnabled="True" Focusable="True"
                                        primitives:Thumb.DragStarted="Slider_DragStarted"
                                        primitives:Thumb.DragDelta="Slider_DragDelta"
                                        primitives:Thumb.DragCompleted="Slider_DragCompleted"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- Controles: agrupados por función (navegación de episodio → scrub/play → volumen/tiempo
                             → [espacio] → acciones secundarias) en vez de la fila plana anterior, donde
                             Retroceder/Adelantar 10s quedaban separados del Play/Prev/Next por el bloque de
                             Volumen+Tiempo — el usuario tenía que recorrer casi toda la barra para encontrarlos.
                             Captura y Modo Noche (las dos acciones menos usadas) se agrupan en "Más opciones"
                             para no sumar dos íconos más a una barra ya larga. -->
                        <Grid Grid.Row="2" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- 0: Episodio anterior -->
                                <ColumnDefinition Width="Auto"/> <!-- 1: Retroceder 10s -->
                                <ColumnDefinition Width="Auto"/> <!-- 2: Play/Pausa -->
                                <ColumnDefinition Width="Auto"/> <!-- 3: Adelantar 10s -->
                                <ColumnDefinition Width="Auto"/> <!-- 4: Episodio siguiente -->
                                <ColumnDefinition Width="Auto"/> <!-- 5: Volumen -->
                                <ColumnDefinition Width="Auto"/> <!-- 6: Tiempo -->
                                <ColumnDefinition Width="*"/>    <!-- 7: Espacio -->
                                <ColumnDefinition Width="Auto"/> <!-- 8: Audio + Subtítulos + Ecualizador -->
                                <ColumnDefinition Width="Auto"/> <!-- 9: Más opciones (Captura + Modo Noche) -->
                                <ColumnDefinition Width="Auto"/> <!-- 10: PiP -->
                                <ColumnDefinition Width="Auto"/> <!-- 11: Cajón de episodios -->
                                <ColumnDefinition Width="Auto"/> <!-- 12: Pantalla completa (siempre el último) -->
                            </Grid.ColumnDefinitions>

                            <!-- Episodio Anterior -->
                            <Button Grid.Column="0" Command="{Binding AnteriorEpisodioCommand}" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    IsEnabled="{Binding TieneEpisodioAnterior}"
                                    ToolTip="{Binding EpisodioAnteriorTooltip}"
                                    AutomationProperties.Name="{Binding EpisodioAnteriorTooltip}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="36" Height="36" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="SkipPrevious" Width="24" Height="24" />
                            </Button>

                            <!-- Retroceder (segundos configurables en Ajustes) -->
                            <Button Grid.Column="1" Command="{Binding Rewind10Command}" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{Binding RetrocederTooltip}"
                                    AutomationProperties.Name="{Binding RetrocederTooltip}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="36" Height="36" Margin="0,0,2,0">
                                <materialDesign:PackIcon Kind="Rewind" Width="24" Height="24" />
                            </Button>

                            <!-- Play/Pause -->
                            <Button Grid.Column="2" Command="{Binding TogglePlayPauseCommand}" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{loc:T Player_PlayPausaTooltip}"
                                    AutomationProperties.Name="{loc:T Atajo_PlayPausa}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,2,0">
                                <materialDesign:PackIcon Kind="{Binding PlayPauseIcon}" Width="28" Height="28" />
                            </Button>

                            <!-- Adelantar (segundos configurables en Ajustes) -->
                            <Button Grid.Column="3" Command="{Binding Forward10Command}" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{Binding AdelantarTooltip}"
                                    AutomationProperties.Name="{Binding AdelantarTooltip}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="36" Height="36" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="FastForward" Width="24" Height="24" />
                            </Button>

                            <!-- Episodio Siguiente -->
                            <Button Grid.Column="4" Command="{Binding SiguienteEpisodioCommand}" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    IsEnabled="{Binding TieneEpisodioSiguiente}"
                                    ToolTip="{Binding EpisodioSiguienteTooltip}"
                                    AutomationProperties.Name="{Binding EpisodioSiguienteTooltip}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="36" Height="36" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="SkipNext" Width="24" Height="24" />
                            </Button>

                            <!-- Contenedor Volumen Animado -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal" x:Name="VolumePanel" Background="Transparent" Margin="0,0,10,0"
                                        MouseLeave="VolumePanel_MouseLeave">
                                <Button Command="{Binding ToggleMuteCommand}" Focusable="True" FocusVisualStyle="{StaticResource PlayerFocusVisual}" Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" AutomationProperties.Name="{loc:T Player_SilenciarToggle}">
                                    <materialDesign:PackIcon Kind="{Binding VolumenIcon}" Width="24" Height="24" />
                                </Button>
                                <Slider x:Name="SliderVolumen" Minimum="0" Maximum="100" Value="{Binding Volumen, Mode=TwoWay}"
                                        AutomationProperties.Name="{loc:T Player_Volumen}"
                                        VerticalAlignment="Center" Focusable="True"
                                        FocusVisualStyle="{StaticResource PlayerFocusVisual}" Cursor="Hand"
                                        IsMoveToPointEnabled="True">
                                    <Slider.Resources>
                                        <!-- Thumb limpio sin halo ni ripple circular -->
                                        <Style x:Key="VolumeSliderThumb" TargetType="{x:Type Thumb}">
                                            <Setter Property="SnapsToDevicePixels" Value="True" />
                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                            <Setter Property="Height" Value="14" />
                                            <Setter Property="Width" Value="14" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Ellipse Fill="White" Width="14" Height="14" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- RepeatButton invisible para el Track -->
                                        <Style x:Key="VolumeRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                            <Setter Property="IsTabStop" Value="False" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Background="Transparent">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Slider.Resources>
                                    <Slider.Style>
                                        <Style TargetType="Slider">
                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                            <Setter Property="SnapsToDevicePixels" Value="True" />
                                            <Setter Property="Width" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Slider">
                                                        <Grid VerticalAlignment="Center" Height="20" Background="Transparent">
                                                            <!-- Pista inactiva de fondo -->
                                                            <Border Height="3" CornerRadius="1.5" Background="#55FFFFFF" VerticalAlignment="Center" Margin="7,0,7,0"/>
                                                            <!-- Track interactivo con thumb y pista activa -->
                                                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                                                <Track.DecreaseRepeatButton>
                                                                    <RepeatButton Style="{StaticResource VolumeRepeatButtonStyle}" Command="Slider.DecreaseLarge">
                                                                        <Border Height="3" CornerRadius="1.5" Background="White" Margin="7,0,0,0" />
                                                                    </RepeatButton>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.Thumb>
                                                                    <Thumb Style="{StaticResource VolumeSliderThumb}" />
                                                                </Track.Thumb>
                                                                <Track.IncreaseRepeatButton>
                                                                    <RepeatButton Style="{StaticResource VolumeRepeatButtonStyle}" Command="Slider.IncreaseLarge" />
                                                                </Track.IncreaseRepeatButton>
                                                            </Track>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=IsMouseOver}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="80" Duration="{StaticResource Anim.Normal}" />
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="5,0,10,0" Duration="{StaticResource Anim.Normal}" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Anim.Normal}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="{StaticResource Anim.Normal}" />
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="{StaticResource Anim.Normal}" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Anim.Normal}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                                <!-- Mismo reveal que el hover, pero por foco de teclado (UX-001):
                                                     sin esto, el slider de volumen quedaría focuseable con ancho 0 (invisible). -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=IsKeyboardFocusWithin}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="80" Duration="{StaticResource Anim.Normal}" />
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="5,0,10,0" Duration="{StaticResource Anim.Normal}" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Anim.Normal}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="{StaticResource Anim.Normal}" />
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="{StaticResource Anim.Normal}" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Anim.Normal}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Slider.Style>
                                </Slider>
                            </StackPanel>

                            <!-- Tiempo -->
                            <TextBlock Grid.Column="6" Text="{Binding TiempoCombinadoTexto}"
                                       Foreground="White" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="5,0,0,0" Opacity="0.9"/>

                            <!-- Audio (siempre visible, aunque el archivo traiga una sola pista) + Subtítulos (menús manuales) -->
                            <StackPanel Grid.Column="8" Orientation="Horizontal">
                            <Button x:Name="AudioButton" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{loc:T Player_MenuAudio}"
                                    AutomationProperties.Name="{loc:T Player_MenuAudio}"
                                    PreviewMouseLeftButtonDown="AudioButton_PreviewMouseLeftButtonDown"
                                    Click="AudioButton_Click"
                                    Style="{StaticResource PlayerMenuToolButton}" Width="40" Height="40" Margin="0,0,5,0">
                                <materialDesign:PackIcon Kind="Translate" Width="24" Height="24" />
                            </Button>

                            <Button x:Name="SubtitlesButton" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{loc:T Player_Subtitulos}"
                                    AutomationProperties.Name="{loc:T Player_MenuSubtitulos}"
                                    PreviewMouseLeftButtonDown="SubtitlesButton_PreviewMouseLeftButtonDown"
                                    Click="SubtitlesButton_Click"
                                    Style="{StaticResource PlayerMenuToolButton}" Width="40" Height="40" Margin="0,0,5,0">
                                <materialDesign:PackIcon Kind="{Binding SubtitulosIcon}" Width="26" Height="26" />
                            </Button>

                            <!-- Ecualizador: botón propio (antes escondido en Más opciones). El punto azul indica que está encendido. -->
                            <Button x:Name="EqualizerButton" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{loc:T Eq_Titulo}"
                                    AutomationProperties.Name="{loc:T Eq_Titulo}"
                                    PreviewMouseLeftButtonDown="EqualizerButton_PreviewMouseLeftButtonDown"
                                    Click="EqualizerButton_Click"
                                    Style="{StaticResource PlayerMenuToolButton}" Width="40" Height="40" Margin="0,0,5,0">
                                <Grid>
                                    <materialDesign:PackIcon Kind="Equalizer" Width="24" Height="24"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Accent}" Stroke="#141414" StrokeThickness="1"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                                             Visibility="{Binding EcualizadorActivo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                            </StackPanel>

                            <!-- Menú de pistas de audio: mismo patrón manual que el de subtítulos (StaysOpen=True, cierre a mano). -->
                            <Popup x:Name="AudioPopup" IsOpen="False" StaysOpen="True"
                                   PlacementTarget="{Binding Source={x:Reference AudioButton}}" Placement="Top"
                                   VerticalOffset="-4" Opened="Menu_Opened" Closed="Menu_Closed" PopupAnimation="Fade" AllowsTransparency="True">
                                <StackPanel>
                                <Border Style="{StaticResource PlayerMenuPanel}" Padding="10" MinWidth="200">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T Player_Audio}" Foreground="{StaticResource Brush.TextTertiary}" FontSize="12" FontWeight="Bold" Margin="15,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding PistasAudio}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SeleccionarPistaAudioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Click="AudioMenuItem_Click" Style="{StaticResource MenuItemButton}"
                                                            AutomationProperties.Name="{Binding Nombre}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                     Visibility="{Binding EsActual, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Con una sola pista (o ninguna) el menú lo explica en vez de parecer roto -->
                                        <TextBlock Text="{loc:T Player_AudioUnicaPista}"
                                                   Visibility="{Binding HayUnaSolaPistaAudio, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   Foreground="{StaticResource Brush.TextTertiary}" FontSize="12" TextWrapping="Wrap" MaxWidth="240" Margin="15,8,10,0"/>
                                        <TextBlock Text="{loc:T Player_AudioSinPistas}"
                                                   Visibility="{Binding SinPistasAudio, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   Foreground="{StaticResource Brush.TextTertiary}" FontSize="12" TextWrapping="Wrap" MaxWidth="240" Margin="15,0,10,0"/>
                                    </StackPanel>
                                </Border>
                                <Path x:Name="AudioPopupFlecha" Style="{StaticResource FlechaMenu}"/>
                            </StackPanel>
                            </Popup>

                            <!-- StaysOpen=True: con False, el popup se cierra por captura del mouse y el
                             mismo clic lo volvía a abrir (toggle imposible). El cierre es manual. -->
                            <Popup x:Name="SubtitlesPopup" IsOpen="False" StaysOpen="True"
                                   PlacementTarget="{Binding Source={x:Reference SubtitlesButton}}" Placement="Top"
                                   VerticalOffset="-4" Opened="Menu_Opened" Closed="Menu_Closed" PopupAnimation="Fade" AllowsTransparency="True">
                                <StackPanel>
                                <Border Style="{StaticResource PlayerMenuPanel}" Padding="10" MinWidth="200">
                                    
                                    <StackPanel>
                                        <TextBlock Text="{loc:T Player_Subtitulos}" Foreground="{StaticResource Brush.TextTertiary}" FontSize="12" FontWeight="Bold" Margin="15,0,0,10" />

                                        <!-- Apagar -->
                                        <Button Content="{loc:T Player_ApagarSubtitulos}" Command="{Binding TurnOffSubtitlesCommand}" Click="SubtitleMenuItem_Click" Style="{StaticResource MenuItemButton}"/>

                                        <!-- Lista de streams disponibles -->
                                        <ItemsControl ItemsSource="{Binding Player.Subtitles.Streams}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectSubtitleStreamCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Click="SubtitleMenuItem_Click" Style="{StaticResource MenuItemButton}">
                                                        <TextBlock>
                                                            <Run Text="{Binding Language, Mode=OneWay}" />
                                                            <Run Text="—" Foreground="#888888"/>
                                                            <Run Text="{Binding Title, Mode=OneWay}" Foreground="#AAAAAA"/>
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Usar mi estilo: solo con una pista ASS/SSA. Encendido = texto plano con el estilo de
                                             Configuración; apagado = estilo original del subtítulo. -->
                                        <Button Command="{Binding ToggleUsarMiEstiloEnAssCommand}" Click="SubtitleMenuItem_Click" Style="{StaticResource MenuItemButton}"
                                                Visibility="{Binding PistaActualEsAss, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FormatFont" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#E5E5E5"/>
                                                <TextBlock Text="{loc:T Player_UsarMiEstilo}" VerticalAlignment="Center"/>
                                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#818CF8"
                                                                          Visibility="{Binding UsarMiEstiloEnAss, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Path x:Name="SubtitlesPopupFlecha" Style="{StaticResource FlechaMenu}"/>
                            </StackPanel>
                            </Popup>

                            <!-- Más opciones: agrupa Captura y Modo Noche (las dos acciones que menos se
                                 tocan durante la reproducción normal) para no sumar dos íconos permanentes
                                 más a la barra. Mismo patrón de Popup manual que Subtítulos. -->
                            <Button x:Name="MoreOptionsButton" Grid.Column="9" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{loc:T Player_MasOpciones}"
                                    AutomationProperties.Name="{loc:T Player_MasOpciones}"
                                    PreviewMouseLeftButtonDown="MoreOptionsButton_PreviewMouseLeftButtonDown"
                                    Click="MoreOptionsButton_Click"
                                    Style="{StaticResource PlayerMenuToolButton}" Width="40" Height="40" Margin="0,0,4,0">
                                <materialDesign:PackIcon Kind="DotsVertical" Width="24" Height="24" />
                            </Button>

                            <Popup x:Name="MoreOptionsPopup" IsOpen="False" StaysOpen="True"
                                   PlacementTarget="{Binding Source={x:Reference MoreOptionsButton}}" Placement="Top"
                                   VerticalOffset="-4" Opened="Menu_Opened" Closed="Menu_Closed" PopupAnimation="Fade" AllowsTransparency="True">
                                <StackPanel>
                                <Border Style="{StaticResource PlayerMenuPanel}" Padding="10" MinWidth="200">

                                    <StackPanel>
                                        <!-- Captura de pantalla HD (Ctrl+S) -->
                                        <Button Command="{Binding CapturarFrameCommand}" Click="MoreOptionsMenuItem_Click" Style="{StaticResource MenuItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CameraOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{loc:T Player_Captura}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Modo Noche: compresor de rango dinámico del audio (toggle, con check cuando está activo) -->
                                        <Button Command="{Binding ToggleModoNocheCommand}" Click="MoreOptionsMenuItem_Click" Style="{StaticResource MenuItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="WeatherNight" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="#E5E5E5"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ModoNocheActivo}" Value="True">
                                                                    <Setter Property="Foreground" Value="#818CF8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <TextBlock Text="{loc:T Player_ModoNoche}" VerticalAlignment="Center"/>
                                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#818CF8"
                                                                          Visibility="{Binding ModoNocheActivo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </Border>
                                <Path x:Name="MoreOptionsPopupFlecha" Style="{StaticResource FlechaMenu}"/>
                            </StackPanel>
                            </Popup>

                            <!-- ECUALIZADOR de 10 bandas (su propio botón en la barra). Mover un deslizador cambia solo esa banda en vivo,
                                 sin cortes; elegir un ajuste o mover una banda lo enciende. Se guarda solo (Configuración no hace falta). -->
                            <Popup x:Name="EqualizerPopup" IsOpen="False" StaysOpen="True"
                                   PlacementTarget="{Binding Source={x:Reference EqualizerButton}}" Placement="Top"
                                   VerticalOffset="-4" Opened="Menu_Opened" Closed="Menu_Closed" PopupAnimation="Fade" AllowsTransparency="True">
                                <StackPanel>
                                    <Border Style="{StaticResource PlayerMenuPanel}" Padding="16,12,16,14" Width="580">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Equalizer" Width="18" Height="18" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{loc:T Eq_Titulo}"
                                                               Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding NombrePresetEcualizador}" Foreground="{StaticResource Brush.TextTertiary}" FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ToggleButton Grid.Column="1" IsChecked="{Binding EcualizadorActivo, Mode=TwoWay}" Cursor="Hand"
                                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                              ToolTip="{loc:T Eq_Activar}"
                                                              AutomationProperties.Name="{loc:T Eq_Activar}"/>
                                            </Grid>

                                            <TextBlock Text="{loc:T Eq_Ajustes}"
                                                       Foreground="{StaticResource Brush.TextTertiary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding PresetsEcualizador}" Margin="0,0,0,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Nombre}" Style="{StaticResource ChipPresetEcualizador}"
                                                                AutomationProperties.Name="{Binding Nombre}"
                                                                Command="{Binding DataContext.AplicarPresetEcualizadorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding Clave}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Escala en dB a la izquierda de los deslizadores -->
                                                <Grid Width="30" Height="130" Margin="0,18,4,0" VerticalAlignment="Top">
                                                    <TextBlock Text="+12" Foreground="{StaticResource Brush.TextTertiary}" FontSize="10" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="0" Foreground="{StaticResource Brush.TextTertiary}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="-12" Foreground="{StaticResource Brush.TextTertiary}" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding BandasEcualizador}">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EcualizadorActivo}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.55"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding TextoGanancia}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <Slider Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="1" LargeChange="3"
                                                                        TickFrequency="1" IsSnapToTickEnabled="True" Foreground="{StaticResource Brush.Accent}" Cursor="Hand"
                                                                        HorizontalAlignment="Center"
                                                                        Value="{Binding Ganancia, Mode=TwoWay}"
                                                                        ToolTip="{Binding TextoGanancia}"
                                                                        AutomationProperties.Name="{Binding Etiqueta, StringFormat={}{0} Hz}"/>
                                                                <TextBlock Text="{Binding Etiqueta}" Foreground="{StaticResource Brush.TextTertiary}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:T Eq_Pista}"
                                                           Foreground="{StaticResource Brush.TextTertiary}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Grid.Column="1" Command="{Binding RestablecerEcualizadorCommand}" Style="{StaticResource MenuItemButton}" Padding="10,6"
                                                        AutomationProperties.Name="{loc:T Eq_Restablecer}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Restore" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{loc:T Eq_Restablecer}" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Path x:Name="EqualizerPopupFlecha" Style="{StaticResource FlechaMenu}"/>
                                </StackPanel>
                            </Popup>

                            <!-- Modo Mini Reproductor -->
                            <Button Grid.Column="10" Command="{Binding MinimizarAMiniCommand}" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{loc:T Player_Mini}"
                                    AutomationProperties.Name="{loc:T Player_ModoFlotante}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,4,0">
                                <materialDesign:PackIcon Kind="PictureInPictureBottomRight" Width="26" Height="26" />
                            </Button>

                            <!-- Fullscreen con ícono dinámico -->
                            <Button Grid.Column="12" Command="{Binding ToggleFullscreenCommand}" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{loc:T Player_PantallaCompletaTooltip}"
                                    AutomationProperties.Name="{loc:T Atajo_PantallaCompleta}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,0,0">
                                <materialDesign:PackIcon Kind="{Binding FullscreenIcon}" Width="26" Height="26" />
                            </Button>

                            <!-- Cajón lateral de episodios (tecla L) -->
                            <Button x:Name="CajonButton" Grid.Column="11" Command="{Binding ToggleCajonEpisodiosCommand}" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{loc:T Player_CajonEpisodiosTip}"
                                    AutomationProperties.Name="{loc:T Player_CajonEpisodiosTip}"
                                    Style="{StaticResource PlayerMenuToolButton}" Width="40" Height="40" Margin="0,0,4,0">
                                <materialDesign:PackIcon Kind="PlaylistPlay" Width="26" Height="26" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- CONTROLES MODO MINI REPRODUCTOR (EMBEBIDO) -->
                <Grid Visibility="{Binding EsModoMini, Converter={StaticResource BoolToVis}}" Background="Transparent">
                    <!-- Barra Superior Mini -->
                    <Grid VerticalAlignment="Top" Height="38">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E6000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid Margin="10,4,6,0" Cursor="SizeAll"
                              MouseLeftButtonDown="BarraSuperior_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Título anime y episodio compacto -->
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0">
                                <Run Text="{Binding TituloAnime, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text=" · " Foreground="#A0A0A0"/>
                                <Run Text="{Binding TituloEpisodio, Mode=OneWay}" Foreground="#D0D0D0"/>
                            </TextBlock>

                            <!-- BOTÓN RESTAURAR FORMATO HABITUAL (REQUERIDO) -->
                            <Button Grid.Column="1" Command="{Binding RestaurarFormatoHabitualCommand}" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{loc:T Player_RestaurarFormato}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="30" Height="30" Margin="0,0,2,0"
                                    AutomationProperties.Name="{loc:T Player_RestaurarFormatoNombre}">
                                <materialDesign:PackIcon Kind="Fullscreen" Width="18" Height="18" />
                            </Button>

                            <!-- Botón Cerrar Mini Reproductor -->
                            <Button Grid.Column="2" Command="{Binding CerrarCommand}" Focusable="True"
                                    FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                    ToolTip="{loc:T Player_Cerrar}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="#EF4444" Width="30" Height="30"
                                    AutomationProperties.Name="{loc:T Player_Cerrar}">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Barra Inferior Mini -->
                    <Grid VerticalAlignment="Bottom" Height="50">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#B3000000" Offset="0.4"/>
                                <GradientStop Color="#E6000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>

                        <Grid Margin="10,0,10,4" VerticalAlignment="Bottom">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Scrubber mini -->
                                <RowDefinition Height="Auto"/> <!-- Botones reproducción -->
                            </Grid.RowDefinitions>

                            <!-- Scrubber interactivo -->
                            <Slider Grid.Row="0" Minimum="0" Maximum="{Binding TotalSeconds}" Value="{Binding CurrentSeconds, Mode=TwoWay}"
                                    Style="{StaticResource TimelineSliderStyle}" Height="18" Margin="0,0,0,2"
                                    AutomationProperties.Name="{loc:T Player_ProgresoEpisodio}"
                                    IsMoveToPointEnabled="True" Focusable="True"
                                    primitives:Thumb.DragStarted="Slider_DragStarted"
                                    primitives:Thumb.DragDelta="Slider_DragDelta"
                                    primitives:Thumb.DragCompleted="Slider_DragCompleted"
                                    VerticalAlignment="Center" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Play/Pausa -->
                                    <ColumnDefinition Width="Auto"/> <!-- -10s -->
                                    <ColumnDefinition Width="Auto"/> <!-- +10s -->
                                    <ColumnDefinition Width="Auto"/> <!-- Tiempo -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/> <!-- Mute -->
                                </Grid.ColumnDefinitions>

                                <!-- Play/Pausa -->
                                <Button Grid.Column="0" Command="{Binding TogglePlayPauseCommand}" Focusable="True"
                                        FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                        ToolTip="{loc:T Player_PlayPausaTooltip}"
                                        AutomationProperties.Name="{loc:T Atajo_PlayPausa}"
                                        Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="28" Height="28" Margin="0,0,2,0">
                                    <materialDesign:PackIcon Kind="{Binding PlayPauseIcon}" Width="20" Height="20" />
                                </Button>

                                <!-- Retroceder (segundos configurables en Ajustes) -->
                                <Button Grid.Column="1" Command="{Binding Rewind10Command}" Focusable="True"
                                        FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                        ToolTip="{Binding RetrocederTooltip}"
                                        AutomationProperties.Name="{Binding RetrocederTooltip}"
                                        Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="26" Height="26" Margin="0,0,2,0">
                                    <materialDesign:PackIcon Kind="Rewind" Width="18" Height="18" />
                                </Button>

                                <!-- Adelantar (segundos configurables en Ajustes) -->
                                <Button Grid.Column="2" Command="{Binding Forward10Command}" Focusable="True"
                                        FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                        ToolTip="{Binding AdelantarTooltip}"
                                        AutomationProperties.Name="{Binding AdelantarTooltip}"
                                        Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="26" Height="26" Margin="0,0,6,0">
                                    <materialDesign:PackIcon Kind="FastForward" Width="18" Height="18" />
                                </Button>

                                <!-- Tiempo compacto -->
                                <TextBlock Grid.Column="3" Text="{Binding TiempoCombinadoTexto}" Foreground="#D1D5DB"
                                           VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>

                                <!-- Botón Mute -->
                                <Button Grid.Column="5" Command="{Binding ToggleMuteCommand}" Focusable="True"
                                        FocusVisualStyle="{StaticResource PlayerFocusVisual}"
                                        ToolTip="{loc:T Player_SilenciarTooltip}"
                                        AutomationProperties.Name="{loc:T Player_SilenciarToggle}"
                                        Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="{Binding VolumenIcon}" Width="18" Height="18" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- CAJÓN LATERAL DE EPISODIOS (tecla L) -->
                <Border HorizontalAlignment="Right" Width="340"
                        Background="#EE0B0F14" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0"
                        Visibility="{Binding CajonEpisodiosAbierto, Converter={StaticResource BoolToVis}}">
                    <Border.RenderTransform>
                        <TranslateTransform X="340"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CajonEpisodiosAbierto}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource Anim.Suave}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="340" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,16,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T Player_CajonEpisodios}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ToggleCajonEpisodiosCommand}" Focusable="True"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="30" Height="30">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <ListBox x:Name="ListaCajonEpisodios" Grid.Row="1" ItemsSource="{Binding EpisodiosDelCajon}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource CajonEpisodioItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Fila" Padding="10,8" Margin="8,2" CornerRadius="8" Cursor="Hand"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SaltarAEpisodioCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="72" Height="42">
                                                <!-- Recorte redondeado: ClipToBounds recorta en rectángulo y las puntas de la miniatura asomaban
                                                     fuera del marco redondeado del episodio que se está viendo. -->
                                                <Grid.Clip>
                                                    <RectangleGeometry Rect="0,0,72,42" RadiusX="6" RadiusY="6"/>
                                                </Grid.Clip>
                                                <Border CornerRadius="6" Background="{StaticResource Brush.SurfaceControl}">
                                                    <Image Source="{Binding RutaMiniatura, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                                </Border>
                                                <!-- Encima de la miniatura del que se está viendo: velo + icono de reproducción -->
                                                <Border x:Name="MarcaMiniatura" CornerRadius="6" Background="{StaticResource Brush.Scrim}" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1.5" Visibility="Collapsed">
                                                    <materialDesign:PackIcon Kind="Play" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <!-- Favorito: el mismo marcador azul que en la ficha -->
                                                    <materialDesign:PackIcon DockPanel.Dock="Right" Kind="Bookmark" Foreground="{StaticResource Brush.Accent}" Width="15" Height="15"
                                                                             VerticalAlignment="Center" Margin="6,0,4,0"
                                                                             ToolTip="{loc:T Player_EpisodioFavorito}"
                                                                             Visibility="{Binding Favorito, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBlock x:Name="TituloFila" Text="{Binding TituloVisual}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding BadgeTecnico}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                                                <StackPanel x:Name="EtiquetaReproduciendo" Orientation="Horizontal" Margin="0,3,0,0" Visibility="Collapsed">
                                                    <materialDesign:PackIcon Kind="VolumeHigh" Width="12" Height="12" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{loc:T Player_Reproduciendo}"
                                                               Foreground="{StaticResource Brush.Accent}" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Fila" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Fila" Property="Background" Value="#14FFFFFF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding EsReproduciendose}" Value="True">
                                            <Setter TargetName="Fila" Property="Background" Value="{StaticResource Brush.AccentTint}"/>
                                            <Setter TargetName="Fila" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                            <Setter TargetName="MarcaMiniatura" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="EtiquetaReproduciendo" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="TituloFila" Property="FontWeight" Value="Bold"/>
                                            <Setter TargetName="TituloFila" Property="Foreground" Value="{StaticResource Brush.AccentSoft}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

                <!-- AVISO (toast) DEL REPRODUCTOR. Va en la raíz del contenido del host y NO dentro de
                     OverlayControls: esos controles se desvanecen tras unos segundos sin actividad, y avisos
                     como "Continuando desde 09:36" salen justo cuando ya están ocultos. Sus textos los
                     actualiza el code-behind (ReproductorView.xaml.cs), no un Binding: en la raíz del
                     contenido del FlyleafHost los bindings se quedan congelados (ver memoria del proyecto). -->
                <Border x:Name="ToastReproductor" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0"
                        Opacity="0" IsHitTestVisible="False" AutomationProperties.LiveSetting="Assertive">
                    <materialDesign:Card UniformCornerRadius="10" Background="{StaticResource Brush.Surface2}" Padding="20,15" materialDesign:ElevationAssist.Elevation="Dp8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="ToastRepIcono" Kind="InformationOutline" Foreground="White" Width="28" Height="28"
                                                     VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ToastRepTitulo" FontWeight="Bold" FontSize="15" Foreground="White"/>
                                <TextBlock x:Name="ToastRepMensaje" TextWrapping="Wrap" MaxWidth="450" Foreground="#CCCCCC" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Border>

                <!-- CUENTA ATRÁS DE AUTO-PLAY (Configuración → Reproducción → "Al terminar un episodio").
                     Igual que ToastReproductor: fuera de OverlayControls (no se desvanece por inactividad,
                     justo cuando el episodio termina y el mouse lleva rato quieto) y con texto empujado
                     desde el code-behind, no por Binding (bindings congelados en la raíz del FlyleafHost). -->
                <Border x:Name="CuentaAtrasSiguiente" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,90"
                        Background="#F2141414" BorderBrush="{StaticResource Brush.RingBase}" BorderThickness="1" CornerRadius="10" Padding="16"
                        Opacity="0" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.7"/>
                    </Border.Effect>
                    <StackPanel Width="260">
                        <TextBlock Text="{loc:T Player_SiguienteEpisodioEn}"
                                   Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CuentaAtrasTitulo" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,2,0,10" TextTrimming="CharacterEllipsis"/>
                        <!-- "Te saltas el episodio 4 (no está descargado)": el siguiente con archivo no es el que sigue -->
                        <Border x:Name="CuentaAtrasAviso" Background="{StaticResource Brush.WarningTint}" CornerRadius="6" Padding="8,6" Margin="0,-2,0,10" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AlertOutline" Foreground="{StaticResource Brush.Warning}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,6,0"/>
                                <TextBlock x:Name="CuentaAtrasAvisoTexto" Grid.Column="1" Foreground="{StaticResource Brush.Warning}" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="BtnCancelarAutoPlay_Click" HorizontalAlignment="Left"
                                    Style="{StaticResource MenuItemButton}" Padding="10,6"
                                    Content="{loc:T Player_Cancelar}"/>
                            <Button x:Name="BtnReproducirAhoraCuentaAtras" Grid.Column="1" Click="BtnReproducirAhoraCuentaAtras_Click"
                                    Style="{StaticResource AppPrimaryButton}" Padding="14,6" materialDesign:ButtonAssist.CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="CuentaAtrasSegundosTexto" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </fl:FlyleafHost>
    </Grid>
</UserControl>
