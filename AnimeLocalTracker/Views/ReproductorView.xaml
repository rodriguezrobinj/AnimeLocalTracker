<UserControl x:Class="AnimeLocalTracker.Views.ReproductorView"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="Black"
        Focusable="True"
        PreviewMouseDoubleClick="ReproductorView_PreviewMouseDoubleClick"
        PreviewMouseLeftButtonDown="ReproductorView_PreviewMouseLeftButtonDown"
        PreviewKeyDown="ReproductorView_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Estilo para la parte reproducida (Blanco sólido conectado sin fisuras con el centro del Thumb) -->
        <Style x:Key="TimelinePlayedRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border x:Name="PlayedTrackBorder" Height="3" CornerRadius="1.5,0,0,1.5"
                                Margin="0,0,-10,0"
                                Background="White" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                <Setter TargetName="PlayedTrackBorder" Property="Height" Value="5" />
                                <Setter TargetName="PlayedTrackBorder" Property="CornerRadius" Value="2.5,0,0,2.5" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para la parte no reproducida (Transparente para dejar visible el BackgroundTrack translúcido) -->
        <Style x:Key="TimelineUnplayedRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo del Thumb (la bolita blanca limpia, unida a la barra y sin sombras) -->
        <Style x:Key="TimelineScrubberThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="ThumbEllipse"
                                     Width="10" Height="10"
                                     Fill="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover general sobre el slider (hace crecer la bolita de 10px a 16px) -->
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbEllipse"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.6" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbEllipse"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.6" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbEllipse"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbEllipse"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            
                            <!-- Cuando se está arrastrando la bolita (feedback táctil a 18px) -->
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbEllipse" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.8" ScaleY="1.8" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo completo del Slider de la Línea de Tiempo -->
        <Style x:Key="TimelineSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid x:Name="SliderGrid" VerticalAlignment="Center" Background="Transparent">
                            <!-- Pista de fondo translúcida (tiempo no reproducido) -->
                            <Border x:Name="BackgroundTrack" Height="3" CornerRadius="1.5"
                                    Background="#55FFFFFF" VerticalAlignment="Center" />

                            <!-- Track con el botón izquierdo que representa el progreso reproducido en blanco -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TimelinePlayedRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Style="{StaticResource TimelineScrubberThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TimelineUnplayedRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Expansión de la barra de fondo de 3px a 5px en Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BackgroundTrack" Storyboard.TargetProperty="Height" To="5" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BackgroundTrack" Storyboard.TargetProperty="Height" To="3" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Reproductor NATIVO Flyleaf -->
        <!-- El doble-click fullscreen del host se desactiva por CÓDIGO (ver Loaded en el code-behind):
             como atributo XAML el compilador BAML lo mapea a la propiedad equivocada. -->
        <fl:FlyleafHost Player="{Binding Player}" x:Name="HostFlyleaf">
            <Grid>
                <!-- Subtítulos optimizados: 2 TextBlocks en vez de 9 -->
                <!-- Bindings vía ElementName: FlyleafHost sobrescribe el DataContext de su contenido -->
                <Viewbox VerticalAlignment="Bottom" Margin="40,40,40,25" StretchDirection="DownOnly" MaxHeight="150" IsHitTestVisible="False">
                    <Grid MaxWidth="1200">
                        <Grid.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                        </Grid.Effect>

                        <!-- Stroke negro (una sola capa con outline grueso simulado por shadow) -->
                        <TextBlock Text="{Binding DataContext.Player.Subtitles.SubsText, ElementName=RootWindow}"
                                   Foreground="Black" FontSize="44" FontFamily="Trebuchet MS, Arial"
                                   FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center">
                            <TextBlock.Effect>
                                <BlurEffect Radius="2.5" KernelType="Gaussian"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Texto interior blanco -->
                        <TextBlock Text="{Binding DataContext.Player.Subtitles.SubsText, ElementName=RootWindow}"
                                   Foreground="White" FontSize="44" FontFamily="Trebuchet MS, Arial"
                                   FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" />
                    </Grid>
                </Viewbox>

                <!-- Controles Overlays -->
                <Grid x:Name="OverlayControls" Background="Transparent" DataContext="{x:Null}">
                
                <!-- Gradiente Superior -->
                <Grid VerticalAlignment="Top" Height="120">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B3000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid Margin="20,20,20,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Back Arrow -->
                        <Button Grid.Column="0" Command="{Binding CerrarCommand}" Focusable="False"
                                Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="50" Height="50" Margin="0,0,15,0"
                                AutomationProperties.Name="Volver a la ficha del anime">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="36" Height="36" />
                        </Button>
                        <!-- Titulos Netflix Style -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,-3,0,0">
                            <TextBlock Text="{Binding TituloAnime}" FontWeight="Bold" FontSize="22" Foreground="White"/>
                            <TextBlock Text="{Binding TituloEpisodio}" FontSize="16" Foreground="#CCCCCC"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Barra Inferior Completa -->
                <Grid VerticalAlignment="Bottom">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#40000000" Offset="0.5"/>
                            <GradientStop Color="#CC000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    
                    <Grid Margin="20,60,20,15" VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Skip Intro -->
                            <RowDefinition Height="Auto"/> <!-- Slider -->
                            <RowDefinition Height="Auto"/> <!-- Botones -->
                        </Grid.RowDefinitions>

                        <!-- Botón Skip Intro / Outro (AniSkip API Crunchyroll / Netflix Style) -->
                        <Button Grid.Row="0" Command="{Binding SkipIntroOutroCommand}" Focusable="False"
                                Visibility="{Binding MostrarSkipButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Right" Margin="0,0,0,14"
                                Background="#E616181F" Foreground="White" BorderBrush="#55FFFFFF" BorderThickness="1"
                                Padding="16,8" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="8"
                                ToolTip="Saltar segmento (Atajo: S)">
                            <Button.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.7"/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="{Binding SkipButtonIcon}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A78BFA"/>
                                <TextBlock Text="{Binding SkipButtonTexto}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <!-- Barra de progreso interactiva con Bolita Scrubber -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid x:Name="ProgressBarArea" Cursor="Hand" Background="Transparent"
                                  PreviewMouseLeftButtonDown="ProgressBarArea_PreviewMouseLeftButtonDown">
                                <Slider x:Name="SliderTiempo" Minimum="0" Maximum="{Binding TotalSeconds}" Value="{Binding CurrentSeconds, Mode=TwoWay}"
                                        Style="{StaticResource TimelineSliderStyle}"
                                        IsMoveToPointEnabled="True" Focusable="False"
                                        primitives:Thumb.DragStarted="Slider_DragStarted"
                                        primitives:Thumb.DragDelta="Slider_DragDelta"
                                        primitives:Thumb.DragCompleted="Slider_DragCompleted"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- Controles -->
                        <Grid Grid.Row="2" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- 0: Anterior -->
                                <ColumnDefinition Width="Auto"/> <!-- 1: Play -->
                                <ColumnDefinition Width="Auto"/> <!-- 2: Siguiente -->
                                <ColumnDefinition Width="Auto"/> <!-- 3: Volumen -->
                                <ColumnDefinition Width="Auto"/> <!-- 4: Tiempo -->
                                <ColumnDefinition Width="*"/>    <!-- 5: Espacio -->
                                <ColumnDefinition Width="Auto"/> <!-- 6: Retroceder -->
                                <ColumnDefinition Width="Auto"/> <!-- 7: Adelantar -->
                                <ColumnDefinition Width="Auto"/> <!-- 8: Subtítulos -->
                                <ColumnDefinition Width="Auto"/> <!-- 9: Fullscreen -->
                            </Grid.ColumnDefinitions>

                            <!-- Episodio Anterior -->
                            <Button Grid.Column="0" Command="{Binding AnteriorEpisodioCommand}" Focusable="False"
                                    IsEnabled="{Binding TieneEpisodioAnterior}"
                                    ToolTip="{Binding EpisodioAnteriorTooltip}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="36" Height="36" Margin="0,0,2,0">
                                <materialDesign:PackIcon Kind="SkipPrevious" Width="24" Height="24" />
                            </Button>

                            <!-- Play/Pause -->
                            <Button Grid.Column="1" Command="{Binding TogglePlayPauseCommand}" Focusable="False" 
                                    ToolTip="Reproducir / Pausar (Espacio)"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,2,0">
                                <materialDesign:PackIcon Kind="{Binding PlayPauseIcon}" Width="28" Height="28" />
                            </Button>

                            <!-- Episodio Siguiente -->
                            <Button Grid.Column="2" Command="{Binding SiguienteEpisodioCommand}" Focusable="False"
                                    IsEnabled="{Binding TieneEpisodioSiguiente}"
                                    ToolTip="{Binding EpisodioSiguienteTooltip}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="36" Height="36" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="SkipNext" Width="24" Height="24" />
                            </Button>

                            <!-- Contenedor Volumen Animado -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" x:Name="VolumePanel" Background="Transparent" Margin="0,0,10,0">
                                <Button Command="{Binding ToggleMuteCommand}" Focusable="False" Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40">
                                    <materialDesign:PackIcon Kind="{Binding VolumenIcon}" Width="24" Height="24" />
                                </Button>
                                <Slider Minimum="0" Maximum="100" Value="{Binding Volumen, Mode=TwoWay}"
                                        VerticalAlignment="Center" Focusable="False" Cursor="Hand"
                                        IsMoveToPointEnabled="True">
                                    <Slider.Resources>
                                        <!-- Thumb limpio sin halo ni ripple circular -->
                                        <Style x:Key="VolumeSliderThumb" TargetType="{x:Type Thumb}">
                                            <Setter Property="SnapsToDevicePixels" Value="True" />
                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                            <Setter Property="Height" Value="14" />
                                            <Setter Property="Width" Value="14" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Ellipse Fill="White" Width="14" Height="14" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- RepeatButton invisible para el Track -->
                                        <Style x:Key="VolumeRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                            <Setter Property="IsTabStop" Value="False" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Background="Transparent">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Slider.Resources>
                                    <Slider.Style>
                                        <Style TargetType="Slider">
                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                            <Setter Property="SnapsToDevicePixels" Value="True" />
                                            <Setter Property="Width" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Slider">
                                                        <Grid VerticalAlignment="Center" Height="20" Background="Transparent">
                                                            <!-- Pista inactiva de fondo -->
                                                            <Border Height="3" CornerRadius="1.5" Background="#55FFFFFF" VerticalAlignment="Center" Margin="7,0,7,0"/>
                                                            <!-- Track interactivo con thumb y pista activa -->
                                                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                                                <Track.DecreaseRepeatButton>
                                                                    <RepeatButton Style="{StaticResource VolumeRepeatButtonStyle}" Command="Slider.DecreaseLarge">
                                                                        <Border Height="3" CornerRadius="1.5" Background="White" Margin="7,0,0,0" />
                                                                    </RepeatButton>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.Thumb>
                                                                    <Thumb Style="{StaticResource VolumeSliderThumb}" />
                                                                </Track.Thumb>
                                                                <Track.IncreaseRepeatButton>
                                                                    <RepeatButton Style="{StaticResource VolumeRepeatButtonStyle}" Command="Slider.IncreaseLarge" />
                                                                </Track.IncreaseRepeatButton>
                                                            </Track>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=IsMouseOver}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="80" Duration="0:0:0.2" />
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="5,0,10,0" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2" />
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Slider.Style>
                                </Slider>
                            </StackPanel>

                            <!-- Tiempo -->
                            <TextBlock Grid.Column="4" Text="{Binding TiempoCombinadoTexto}" 
                                       Foreground="White" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="5,0,0,0" Opacity="0.9"/>
                                       
                            <!-- Retroceder 10s -->
                            <Button Grid.Column="6" Command="{Binding Rewind10Command}" Focusable="False" 
                                    ToolTip="Retroceder 10s (←)"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,5,0">
                                <materialDesign:PackIcon Kind="Rewind" Width="26" Height="26" />
                            </Button>

                            <!-- Adelantar 10s -->
                            <Button Grid.Column="7" Command="{Binding Forward10Command}" Focusable="False" 
                                    ToolTip="Adelantar 10s (→)"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="FastForward" Width="26" Height="26" />
                            </Button>

                            <!-- Subtítulos (Menú Manual) -->
                            <Button x:Name="SubtitlesButton" Grid.Column="8" Focusable="False"
                                    ToolTip="Subtítulos"
                                    PreviewMouseLeftButtonDown="SubtitlesButton_PreviewMouseLeftButtonDown"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,5,0">
                                <materialDesign:PackIcon Kind="{Binding SubtitulosIcon}" Width="26" Height="26" />
                            </Button>

                            <!-- StaysOpen=True: con False, el popup se cierra por captura del mouse y el
                             mismo clic lo volvía a abrir (toggle imposible). El cierre es manual. -->
                            <Popup x:Name="SubtitlesPopup" IsOpen="False" StaysOpen="True"
                                   PlacementTarget="{Binding Source={x:Reference SubtitlesButton}}" Placement="Top"
                                   VerticalOffset="-35" HorizontalOffset="10" PopupAnimation="Fade" AllowsTransparency="True">
                                <Border Background="#F2141414" BorderThickness="0" CornerRadius="8" Padding="10" MinWidth="200">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
                                    </Border.Effect>
                                    
                                    <Border.Resources>
                                        <!-- Estilo premium para los botones del menú -->
                                        <Style TargetType="Button" x:Key="MenuItemButton">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#E5E5E5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="15,10"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#33FFFFFF"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Border.Resources>

                                    <StackPanel>
                                        <TextBlock Text="Subtítulos" Foreground="Gray" FontSize="12" FontWeight="Bold" Margin="15,0,0,10" />

                                        <!-- Apagar -->
                                        <Button Content="Apagar" Command="{Binding TurnOffSubtitlesCommand}" Click="SubtitleMenuItem_Click" Style="{StaticResource MenuItemButton}"/>

                                        <!-- Lista de streams disponibles -->
                                        <ItemsControl ItemsSource="{Binding Player.Subtitles.Streams}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectSubtitleStreamCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Click="SubtitleMenuItem_Click" Style="{StaticResource MenuItemButton}">
                                                        <TextBlock>
                                                            <Run Text="{Binding Language, Mode=OneWay}" />
                                                            <Run Text="—" Foreground="#888888"/>
                                                            <Run Text="{Binding Title, Mode=OneWay}" Foreground="#AAAAAA"/>
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            
                            <!-- Fullscreen con ícono dinámico -->
                            <Button Grid.Column="9" Command="{Binding ToggleFullscreenCommand}" Focusable="False" 
                                    ToolTip="Pantalla completa (F11)"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,0,0">
                                <materialDesign:PackIcon Kind="{Binding FullscreenIcon}" Width="26" Height="26" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>
        </fl:FlyleafHost>
    </Grid>
</UserControl>
