<UserControl x:Class="AnimeLocalTracker.Views.ReproductorView"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="Black"
        Focusable="True"
        PreviewKeyDown="ReproductorView_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- Reproductor NATIVO Flyleaf -->
        <fl:FlyleafHost Player="{Binding Player}">
            <Grid>
                        <!-- Subtítulos optimizados: 2 TextBlocks en vez de 9 -->
                        <!-- Bindings vía ElementName: FlyleafHost sobrescribe el DataContext de su contenido -->
                        <Viewbox VerticalAlignment="Bottom" Margin="40,40,40,25" StretchDirection="DownOnly" MaxHeight="150" IsHitTestVisible="False">
                            <Grid MaxWidth="1200">
                                <Grid.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                </Grid.Effect>

                                <!-- Stroke negro (una sola capa con outline grueso simulado por shadow) -->
                                <TextBlock Text="{Binding DataContext.Player.Subtitles.SubsText, ElementName=RootWindow}"
                                           Foreground="Black" FontSize="44" FontFamily="Trebuchet MS, Arial"
                                           FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center">
                                    <TextBlock.Effect>
                                        <BlurEffect Radius="2.5" KernelType="Gaussian"/>
                                    </TextBlock.Effect>
                                </TextBlock>

                                <!-- Texto interior blanco -->
                                <TextBlock Text="{Binding DataContext.Player.Subtitles.SubsText, ElementName=RootWindow}"
                                           Foreground="White" FontSize="44" FontFamily="Trebuchet MS, Arial"
                                           FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" />
                            </Grid>
                        </Viewbox>

                <!-- Controles Overlays -->
                <Grid x:Name="OverlayControls" Background="Transparent" DataContext="{x:Null}">
                
                <!-- Gradiente Superior -->
                <Grid VerticalAlignment="Top" Height="120">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B3000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid Margin="20,20,20,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Back Arrow -->
                        <Button Grid.Column="0" Command="{Binding CerrarCommand}"
                                Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="50" Height="50" Margin="0,0,15,0">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="36" Height="36" />
                        </Button>
                        <!-- Titulos Netflix Style -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,-3,0,0">
                            <TextBlock Text="{Binding TituloAnime}" FontWeight="Bold" FontSize="22" Foreground="White"/>
                            <TextBlock Text="{Binding TituloEpisodio}" FontSize="16" Foreground="#CCCCCC"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Barra Inferior Completa -->
                <Grid VerticalAlignment="Bottom">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#40000000" Offset="0.5"/>
                            <GradientStop Color="#CC000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    
                    <Grid Margin="20,60,20,15" VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Skip Intro -->
                            <RowDefinition Height="Auto"/> <!-- Slider -->
                            <RowDefinition Height="Auto"/> <!-- Botones -->
                        </Grid.RowDefinitions>

                        <!-- Botón Skip Intro / Outro (AniSkip API Crunchyroll / Netflix Style) -->
                        <Button Grid.Row="0" Command="{Binding SkipIntroOutroCommand}"
                                Visibility="{Binding MostrarSkipButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Right" Margin="0,0,0,14"
                                Background="#E616181F" Foreground="White" BorderBrush="#55FFFFFF" BorderThickness="1"
                                Padding="16,8" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="8"
                                ToolTip="Saltar segmento (Atajo: S)">
                            <Button.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.7"/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="{Binding SkipButtonIcon}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A78BFA"/>
                                <TextBlock Text="{Binding SkipButtonTexto}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <!-- Barra de progreso con hover interactivo -->
                        <Grid Grid.Row="1" Margin="0,0,0,15" x:Name="ProgressBarArea" Cursor="Hand">
                            <!-- Línea de progreso visual -->
                            <ProgressBar Minimum="0" Maximum="{Binding TotalSeconds}" Value="{Binding CurrentSeconds, Mode=OneWay}"
                                         Height="3" Foreground="White" Background="#44FFFFFF" BorderThickness="0" VerticalAlignment="Center">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Height" To="5" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Height" To="3" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            
                            <!-- Slider transparente encima -->
                            <Slider Minimum="0" Maximum="{Binding TotalSeconds}" Value="{Binding CurrentSeconds, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True" Foreground="White" Focusable="False"
                                    primitives:Thumb.DragStarted="Slider_DragStarted"
                                    primitives:Thumb.DragDelta="Slider_DragDelta"
                                    primitives:Thumb.DragCompleted="Slider_DragCompleted"
                                    PreviewMouseLeftButtonUp="Slider_PreviewMouseLeftButtonUp"
                                    Opacity="0.01" Height="20" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Controles -->
                        <Grid Grid.Row="2" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Anterior -->
                                <ColumnDefinition Width="Auto"/> <!-- Play -->
                                <ColumnDefinition Width="Auto"/> <!-- Siguiente -->
                                <ColumnDefinition Width="Auto"/> <!-- Volumen -->
                                <ColumnDefinition Width="Auto"/> <!-- Tiempo -->
                                <ColumnDefinition Width="*"/>    <!-- Espacio -->
                                <ColumnDefinition Width="Auto"/> <!-- Retroceder -->
                                <ColumnDefinition Width="Auto"/> <!-- Adelantar -->
                                <ColumnDefinition Width="Auto"/> <!-- AutoPlay Siguiente -->
                                <ColumnDefinition Width="Auto"/> <!-- Subtítulos -->
                                <ColumnDefinition Width="Auto"/> <!-- Fullscreen -->
                            </Grid.ColumnDefinitions>

                            <!-- Episodio Anterior -->
                            <Button Grid.Column="0" Command="{Binding AnteriorEpisodioCommand}"
                                    IsEnabled="{Binding TieneEpisodioAnterior}"
                                    ToolTip="{Binding EpisodioAnteriorTooltip}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="36" Height="36" Margin="0,0,2,0">
                                <materialDesign:PackIcon Kind="SkipPrevious" Width="24" Height="24" />
                            </Button>

                            <!-- Play/Pause -->
                            <Button Grid.Column="1" Command="{Binding TogglePlayPauseCommand}" 
                                    ToolTip="Reproducir / Pausar (Espacio)"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,2,0">
                                <materialDesign:PackIcon Kind="{Binding PlayPauseIcon}" Width="28" Height="28" />
                            </Button>

                            <!-- Episodio Siguiente -->
                            <Button Grid.Column="2" Command="{Binding SiguienteEpisodioCommand}"
                                    IsEnabled="{Binding TieneEpisodioSiguiente}"
                                    ToolTip="{Binding EpisodioSiguienteTooltip}"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="36" Height="36" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="SkipNext" Width="24" Height="24" />
                            </Button>

                            <!-- Contenedor Volumen Animado -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" x:Name="VolumePanel" Background="Transparent" Margin="0,0,10,0">
                                <Button Command="{Binding ToggleMuteCommand}" Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40">
                                    <materialDesign:PackIcon Kind="{Binding VolumenIcon}" Width="24" Height="24" />
                                </Button>
                                <Slider Minimum="0" Maximum="100" Value="{Binding Volumen, Mode=TwoWay}" VerticalAlignment="Center" Foreground="White" Focusable="False">
                                    <Slider.Style>
                                        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                            <Setter Property="Width" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=IsMouseOver}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="80" Duration="0:0:0.2" />
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="5,0,10,0" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2" />
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Slider.Style>
                                </Slider>
                            </StackPanel>

                            <!-- Tiempo -->
                            <TextBlock Grid.Column="4" Text="{Binding TiempoCombinadoTexto}" 
                                       Foreground="White" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="5,0,0,0" Opacity="0.9"/>
                                       
                            <!-- Retroceder 10s -->
                            <Button Grid.Column="6" Command="{Binding Rewind10Command}" 
                                    ToolTip="Retroceder 10s (←)"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,5,0">
                                <materialDesign:PackIcon Kind="Rewind10" Width="26" Height="26" />
                            </Button>

                            <!-- Adelantar 10s -->
                            <Button Grid.Column="7" Command="{Binding Forward10Command}" 
                                    ToolTip="Adelantar 10s (→)"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="FastForward10" Width="26" Height="26" />
                            </Button>

                            <!-- AutoPlay Siguiente -->
                            <Button Grid.Column="8" Command="{Binding ToggleAutoPlayCommand}"
                                    ToolTip="Reproducción automática del siguiente capítulo"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,5,0">
                                <materialDesign:PackIcon Kind="{Binding AutoPlayIcon}" Width="24" Height="24" />
                            </Button>

                            <!-- Subtítulos (Menú Manual) -->
                            <ToggleButton x:Name="SubtitlesToggle" Grid.Column="9"
                                    ToolTip="Subtítulos"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,5,0">
                                <materialDesign:PackIcon Kind="{Binding SubtitulosIcon}" Width="26" Height="26" />
                            </ToggleButton>
                            
                            <Popup x:Name="SubtitlesPopup" IsOpen="{Binding IsChecked, Source={x:Reference SubtitlesToggle}, Mode=TwoWay}" StaysOpen="False" 
                                   PlacementTarget="{Binding Source={x:Reference SubtitlesToggle}}" Placement="Top" 
                                   VerticalOffset="-35" HorizontalOffset="10" PopupAnimation="Fade" AllowsTransparency="True">
                                <Border Background="#F2141414" BorderThickness="0" CornerRadius="8" Padding="10" MinWidth="200">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
                                    </Border.Effect>
                                    
                                    <Border.Resources>
                                        <!-- Estilo premium para los botones del menú -->
                                        <Style TargetType="Button" x:Key="MenuItemButton">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#E5E5E5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="15,10"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#33FFFFFF"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Border.Resources>

                                    <StackPanel>
                                        <TextBlock Text="Subtítulos" Foreground="Gray" FontSize="12" FontWeight="Bold" Margin="15,0,0,10" />
                                        
                                        <!-- Apagar -->
                                        <Button Content="Apagar" Command="{Binding TurnOffSubtitlesCommand}" Style="{StaticResource MenuItemButton}"/>
                                        
                                        <!-- Lista de streams disponibles -->
                                        <ItemsControl ItemsSource="{Binding Player.Subtitles.Streams}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectSubtitleStreamCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                            CommandParameter="{Binding}" Style="{StaticResource MenuItemButton}">
                                                        <TextBlock>
                                                            <Run Text="{Binding Language, Mode=OneWay}" /> 
                                                            <Run Text="—" Foreground="#888888"/> 
                                                            <Run Text="{Binding Title, Mode=OneWay}" Foreground="#AAAAAA"/>
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            
                            <!-- Fullscreen con ícono dinámico -->
                            <Button Grid.Column="10" Command="{Binding ToggleFullscreenCommand}" 
                                    ToolTip="Pantalla completa (F11)"
                                    Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="40" Height="40" Margin="0,0,0,0">
                                <materialDesign:PackIcon Kind="{Binding FullscreenIcon}" Width="26" Height="26" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>
        </fl:FlyleafHost>

        <!-- Overlay Flotante de Auto-Play (Cuenta Regresiva de 5 segundos estilo Netflix / Crunchyroll) -->
        <!-- NOTA: debe vivir FUERA de FlyleafHost porque este sobrescribe el DataContext de su contenido,
             lo que rompe los bindings (panel vacío, siempre visible y botones sin comando). -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,30,110" MaxWidth="440" MinWidth="360"
                Background="#F2141720" BorderBrush="#3B4858" BorderThickness="1"
                CornerRadius="16" Padding="22,18"
                Visibility="{Binding MostrarAutoPlayCountdown, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="6" Opacity="0.85"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header / Countdown -->
                    <RowDefinition Height="Auto"/> <!-- Titulo siguiente ep -->
                    <RowDefinition Height="Auto"/> <!-- Barra de progreso 5s -->
                    <RowDefinition Height="Auto"/> <!-- Botones de acción -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2A1B4E" CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="MotionPlay" Foreground="#A78BFA" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Siguiente episodio en" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AutoPlayCountdownSegundos, StringFormat='{}{0} segundos...'}" FontSize="15" FontWeight="Bold" Foreground="#A78BFA"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Botón X sutil para cerrar / cancelar -->
                    <Button Command="{Binding CancelarAutoPlayCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource MaterialDesignToolButton}" Foreground="#9CA3AF" Width="28" Height="28" Padding="0"
                            ToolTip="Cancelar reproducción automática">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <!-- Titulo del siguiente episodio -->
                <StackPanel Grid.Row="1" Margin="0,2,0,12">
                    <TextBlock Text="{Binding TituloAnime}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SiguienteEpisodioTitulo}" FontSize="13" Foreground="#D1D5DB" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Barra de progreso animada de 5 segundos -->
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding AutoPlayProgress, Mode=OneWay}"
                                 Height="4" Foreground="#A78BFA" Background="#334155" BorderThickness="0"/>
                </Grid>

                <!-- Botones de Acción -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botón Reproducir Ahora -->
                    <Button Grid.Column="0" Command="{Binding ReproducirSiguienteAhoraCommand}"
                            Background="#7C3AED" BorderBrush="#8B5CF6" BorderThickness="1" Foreground="White"
                            Height="38" Padding="14,0" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="8"
                            FontWeight="Bold" FontSize="13">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Reproducir ahora" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Botón Cancelar -->
                    <Button Grid.Column="2" Command="{Binding CancelarAutoPlayCommand}"
                            Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Foreground="#E2E8F0"
                            Height="38" Padding="14,0" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="8"
                            FontWeight="SemiBold" FontSize="13">
                        <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
