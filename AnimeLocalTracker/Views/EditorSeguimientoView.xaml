<UserControl x:Class="AnimeLocalTracker.Views.EditorSeguimientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <!-- Editor de seguimiento de AniList de la ficha y su selector de fecha, cada uno como tarjeta sobre un fondo oscurecido.
         DataContext: SeguimientoEditorViewModel. -->
    <UserControl.Resources>

    <!-- ══ Calendario del selector de fecha, con la plantilla estándar de WPF (su cabecera navega
         mes → año → década con un clic) y los colores de la app ══ -->
    <Style x:Key="SegCalNavBtn" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Raiz" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Raiz" Property="Background" Value="{StaticResource Brush.Surface3}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegCalHeaderBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Raiz" Background="Transparent" CornerRadius="8" Padding="10,5" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter x:Name="Texto" VerticalAlignment="Center" TextElement.FontSize="13.5" TextElement.FontWeight="Bold"
                                              TextElement.Foreground="{StaticResource Brush.TextPrimary}"/>
                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Brush.TextTertiary}" StrokeThickness="1.6" Margin="7,2,0,0" VerticalAlignment="Center"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Raiz" Property="Background" Value="{StaticResource Brush.Surface3}"/>
                            <Setter TargetName="Texto" Property="TextElement.Foreground" Value="{StaticResource Brush.AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Día del mes -->
    <Style x:Key="SegCalDayBtn" TargetType="CalendarDayButton">
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <Border x:Name="Fondo" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="17" Margin="1"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Brush.Surface3}"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="#4B5563"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mes / año (vistas de año y década) -->
    <Style x:Key="SegCalMonthBtn" TargetType="CalendarButton">
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid>
                        <Border x:Name="Fondo" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Margin="3" Height="38" VerticalAlignment="Center"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Brush.Surface3}"/>
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="#4B5563"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegCalItem" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,4"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root" MinWidth="268">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_PreviousButton" Grid.Column="0" Style="{StaticResource SegCalNavBtn}">
                                <Path Data="M 5,0 L 0,5 L 5,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                            <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource SegCalHeaderBtn}" HorizontalAlignment="Center"/>
                            <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource SegCalNavBtn}">
                                <Path Data="M 0,0 L 5,5 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                        </Grid>

                        <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        </Grid>

                        <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- La vista visible depende del modo del calendario: mes (por defecto), año (12 meses) o década (años) -->
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegCalendar" TargetType="Calendar">
        <!-- En la vista de décadas el botón del título está deshabilitado (no hay nivel superior): se atiende el clic aquí para volver a los días -->
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="CalendarioTitulo_PreviewMouseLeftButtonDown"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource SegCalItem}"/>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource SegCalDayBtn}"/>
        <Setter Property="CalendarButtonStyle" Value="{StaticResource SegCalMonthBtn}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Border Background="{StaticResource Brush.SurfaceDialog}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="12" Padding="10,8,10,10">
                        <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de fecha: abre la tarjeta de calendario -->
    <Style x:Key="SegDateField" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Raiz" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="10">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Raiz" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calendario dentro de la tarjeta (sin marco propio: ya lo da la tarjeta) -->
    <Style x:Key="SegCalendarInline" TargetType="Calendar" BasedOn="{StaticResource SegCalendar}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    </UserControl.Resources>

    <Grid>
    <!-- PARTE 3: OVERLAY DEL EDITOR DE SEGUIMIENTO ANILIST (DISEÑO UNIFICADO Y PULIDO) -->
    <Grid Visibility="{Binding MostrandoEditorSeguimiento, Converter={StaticResource BoolToVis}}" 
          Background="#CC000000" Panel.ZIndex="100">

        <materialDesign:Card x:Name="EditorSeguimientoCard" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" 
                             UniformCornerRadius="16" Background="{StaticResource Brush.SurfaceDialog}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1"
                             materialDesign:ElevationAssist.Elevation="Dp16" Padding="22,20" Focusable="True" FocusVisualStyle="{x:Null}">
            <!-- Escape cierra el editor (como "Cancelar"). Un clic fuera NO lo cierra: aquí sí hay cambios que perder. -->
            <materialDesign:Card.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CerrarEditorSeguimientoCommand}"/>
            </materialDesign:Card.InputBindings>
            <materialDesign:Card.Resources>
                <Style x:Key="CleanScoreSlider" TargetType="Slider">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Slider">
                                <Grid VerticalAlignment="Center" Height="20">
                                    <Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                          OverridesDefaultStyle="True"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          Height="4"
                                                          VerticalAlignment="Center">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="{StaticResource Brush.AccentStrong}" Height="4" CornerRadius="2,0,0,2"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                          OverridesDefaultStyle="True"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          Height="4"
                                                          VerticalAlignment="Center">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="{StaticResource Brush.BorderStrong}" Height="4" CornerRadius="0,2,2,0"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb OverridesDefaultStyle="True"
                                                   Focusable="False" 
                                                   Width="16" 
                                                   Height="16" 
                                                   VerticalAlignment="Center">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Ellipse Width="16" Height="16" Fill="{StaticResource Brush.AccentStrong}" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" Cursor="Hand"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="SegLabel" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}"/>
                </Style>

                <!-- Chip de estado: activo = borde y texto azules -->
                <Style x:Key="SegChip" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Raiz" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" Padding="13,6" Margin="4,0,4,8">
                                    <ContentPresenter x:Name="Texto" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Brush.TextSecondary}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Raiz" Property="Background" Value="#1B222C"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding EsActivo}" Value="True">
                                        <Setter TargetName="Raiz" Property="Background" Value="{StaticResource Brush.Surface3}"/>
                                        <Setter TargetName="Raiz" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                        <Setter TargetName="Texto" Property="TextElement.Foreground" Value="{StaticResource Brush.AccentSoft}"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Botón cuadrado pequeño (−, +, hoy) -->
                <Style x:Key="SegStepBtn" TargetType="Button">
                    <Setter Property="MinWidth" Value="40"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Raiz" Background="Transparent" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Raiz" Property="Background" Value="{StaticResource Brush.Surface3}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.AccentSoft}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </materialDesign:Card.Resources>

            <StackPanel>
                <!-- CABECERA: icono + título + anime + cerrar -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Sync" Width="19" Height="19" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Det_ActualizarAniListTitulo}" FontSize="15.5" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Anime.Titulo}" FontSize="11.5" Foreground="{StaticResource Brush.TextTertiary}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="2" Command="{Binding CerrarEditorSeguimientoCommand}"
                            Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Padding="0" Cursor="Hand"
                            ToolTip="{loc:T Det_CerrarVentanaTip}" AutomationProperties.Name="{loc:T Det_CerrarVentanaTip}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </Button>
                </Grid>

                <!-- ESTADO: chips de un clic -->
                <TextBlock Text="{loc:T Det_Estado}" Style="{StaticResource SegLabel}"/>
                <ItemsControl ItemsSource="{Binding EstadosChips}" HorizontalAlignment="Center" Margin="0,6,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Etiqueta}" Style="{StaticResource SegChip}"
                                    Command="{Binding DataContext.SeleccionarEstadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Clave}"
                                    AutomationProperties.Name="{Binding Etiqueta}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- PROGRESO (stepper) + PUNTUACIÓN, en dos columnas -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Episodios vistos -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:T Det_EpisodiosVistos}" Style="{StaticResource SegLabel}"/>
                        <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="10" Height="40" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding DecrementarProgresoCommand}" Style="{StaticResource SegStepBtn}"
                                        ToolTip="{loc:T Det_SegMenosTip}" AutomationProperties.Name="{loc:T Det_SegMenosTip}">
                                    <materialDesign:PackIcon Kind="Minus" Width="16" Height="16"/>
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBox Text="{Binding EditProgresoTexto, UpdateSourceTrigger=PropertyChanged}"
                                             MaxWidth="60" Padding="0" BorderThickness="0" Background="Transparent"
                                             Foreground="White" FontSize="15" FontWeight="Bold" TextAlignment="Center"
                                             CaretBrush="{StaticResource Brush.Accent}" VerticalContentAlignment="Center"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                             AutomationProperties.Name="{loc:T Det_EpisodiosVistos}"/>
                                    <TextBlock Text="{Binding EditTotalEpisodiosTexto}" FontSize="13" Foreground="{StaticResource Brush.TextTertiary}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding IncrementarProgresoCommand}" Style="{StaticResource SegStepBtn}"
                                        ToolTip="{loc:T Det_SegMasTip}" AutomationProperties.Name="{loc:T Det_SegMasTip}">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Puntuación -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:T Det_Puntuacion}" Style="{StaticResource SegLabel}"/>
                        <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="10" Height="40" Margin="0,6,0,0" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding EditPuntaje, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource CleanScoreSlider}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                        AutomationProperties.Name="{loc:T Det_Puntuacion}"/>
                                <TextBlock Grid.Column="1" Text="{Binding EditPuntajeTexto}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Brush.AccentSoft}"
                                           MinWidth="26" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- FECHAS: inicio y fin en una fila, con atajo "hoy" -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:T Det_FechaInicio}" Style="{StaticResource SegLabel}"/>
                        <Button Margin="0,6,0,0" Command="{Binding AbrirCalendarioInicioCommand}" Style="{StaticResource SegDateField}"
                                AutomationProperties.Name="{loc:T Det_FechaInicio}">
                            <Grid>
                                <TextBlock Text="{Binding EditFechaInicioTexto}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" Foreground="White"/>
                                <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Brush.TextTertiary}"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:T Det_FechaFin}" Style="{StaticResource SegLabel}"/>
                        <Button Margin="0,6,0,0" Command="{Binding AbrirCalendarioFinCommand}" Style="{StaticResource SegDateField}"
                                AutomationProperties.Name="{loc:T Det_FechaFin}">
                            <Grid>
                                <TextBlock Text="{Binding EditFechaFinTexto}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" Foreground="White"/>
                                <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Brush.TextTertiary}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ACCIONES -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{loc:T Gal_Cancelar}" Command="{Binding CerrarEditorSeguimientoCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#374151" Foreground="{StaticResource Brush.TextSecondary}" Height="42" Padding="18,0" FontSize="13"
                            materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand"/>

                    <Button Grid.Column="1" Command="{Binding GuardarEditorSeguimientoCommand}"
                            Style="{StaticResource AppPrimaryButton}"
                            Height="42" Padding="18,0" Margin="10,0,0,0"
                            materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloudUpload" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:T Det_GuardarAniList}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </materialDesign:Card>
    </Grid>

    <!-- PARTE 4: TARJETA DEL CALENDARIO (fecha de inicio / fin), sobre el editor de seguimiento -->
    <Grid Visibility="{Binding MostrandoCalendarioFecha, Converter={StaticResource BoolToVis}}"
          Background="{StaticResource Brush.Scrim}" Panel.ZIndex="110" x:Name="FondoCalendario" MouseLeftButtonDown="FondoCalendario_MouseLeftButtonDown">
        <materialDesign:Card x:Name="CalendarioFechaCard" Width="340" VerticalAlignment="Center" HorizontalAlignment="Center"
                             UniformCornerRadius="16" Background="{StaticResource Brush.SurfaceDialog}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1"
                             materialDesign:ElevationAssist.Elevation="Dp16" Padding="20,18" Focusable="True" FocusVisualStyle="{x:Null}">
            <!-- Escape o un clic fuera cierran el calendario sin tocar la fecha (el editor sigue abierto debajo) -->
            <materialDesign:Card.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CerrarCalendarioFechaCommand}"/>
            </materialDesign:Card.InputBindings>
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="10" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="18" Height="18" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding CalendarioTitulo}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Command="{Binding CerrarCalendarioFechaCommand}"
                            Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Padding="0" Cursor="Hand"
                            ToolTip="{loc:T Det_CerrarVentanaTip}" AutomationProperties.Name="{loc:T Det_CerrarVentanaTip}">
                        <materialDesign:PackIcon Kind="Close" Width="17" Height="17" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </Button>
                </Grid>

                <Calendar x:Name="CalendarioFecha" Style="{StaticResource SegCalendarInline}"
                          PreviewMouseLeftButtonUp="CalendarioFecha_PreviewMouseLeftButtonUp"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding QuitarFechaCalendarioCommand}" HorizontalAlignment="Left"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource Brush.Danger}" Height="38" Padding="12,0" Cursor="Hand"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Visibility="{Binding CalendarioTieneFecha, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T Det_SegQuitarFecha}" FontSize="12.5" FontWeight="SemiBold"/>
                    </Button>
                    <Button Grid.Column="1" Content="{loc:T Gal_Cancelar}" Command="{Binding CerrarCalendarioFechaCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#374151" Foreground="{StaticResource Brush.TextSecondary}" Height="38" Padding="16,0" FontSize="12.5"
                            materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
    </Grid>
</UserControl>
