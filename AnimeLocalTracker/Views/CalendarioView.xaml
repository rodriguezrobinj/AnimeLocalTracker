<UserControl x:Class="AnimeLocalTracker.Views.CalendarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Estilo para las listas de cada día -->
        <DataTemplate x:Key="AiringEpisodeTemplate">
            <materialDesign:Card Margin="0,0,0,10" Background="#1B222C" UniformCornerRadius="8" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Portada (recorte fijo, sin distorsión) -->
                    <Border Grid.Column="0" CornerRadius="8,0,0,8" ClipToBounds="True" Height="72">
                        <Grid>
                            <Border Style="{StaticResource ShimmerEffectStyle}" />
                            <Image Source="{Binding UrlPortada, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}"
                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>

                    <!-- Información (compacta: filas fijas, sin desbordes) -->
                    <Grid Grid.Column="1" Margin="8,5,6,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Fila 1: hora + indicadores circulares de estado (solo color) -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HoraEmisionFormateada}" FontSize="11.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                            <!-- Ya emitido: punto ámbar -->
                            <Ellipse Fill="#F59E0B" Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding EstaEmitido, Converter={StaticResource BoolToVis}}" ToolTip="Ya emitido"/>
                            <!-- Próximo: círculo con contorno azul -->
                            <Ellipse Stroke="#3B82F6" StrokeThickness="1.5" Fill="Transparent" Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding EstaEmitido, Converter={StaticResource InverseBoolToVis}}" ToolTip="Próximo"/>
                        </StackPanel>

                        <!-- Fila 2: título (hasta 2 líneas con recorte) -->
                        <TextBlock Grid.Row="1" Text="{Binding Titulo}" FontSize="11.5" FontWeight="SemiBold" Foreground="White"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28" Margin="0,1,0,0"/>

                        <!-- Fila 3: episodio -->
                        <TextBlock Grid.Row="2" Text="{Binding NumeroEpisodio, StringFormat='Episodio {0}'}" FontSize="10.5"
                                   Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </Grid>

                    <!-- BOTÓN A TODA LA TARJETA: cubre 100% del cuadro (portada + info) -->
                    <Button Grid.Column="0" Grid.ColumnSpan="2"
                            Command="{Binding DataContext.AbrirAnimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                            Cursor="Hand" Panel.ZIndex="20"
                            AutomationProperties.Name="{Binding Titulo, StringFormat=Ver {0} en la ficha}"
                            ToolTip="Abrir la ficha del anime"/>
                </Grid>
            </materialDesign:Card>
        </DataTemplate>
        
        <Style TargetType="TextBlock" x:Key="DayHeaderStyle" BasedOn="{StaticResource AppText.Section}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Mantener la barra de scroll estándar en Calendario -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" />
    </UserControl.Resources>

    <Grid Style="{StaticResource AppPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Calendario de Emisión" Style="{StaticResource AppText.PageTitle}" VerticalAlignment="Center"/>
                
                <!-- BADGE CONTEO EN EMISIÓN -->
                <Border Style="{StaticResource AppBadge}" Margin="14,0,0,0" 
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalAnimesEnEmision}" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" 
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </StackPanel>
            <Button Command="{Binding CargarCalendarioCommand}" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ACTUALIZAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Loader -->
        <ProgressBar Grid.Row="1" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     Value="0" IsIndeterminate="True" 
                     Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" Width="50" Height="50"/>

        <!-- Calendario Kanban -->
        <Grid Grid.Row="1" Visibility="{Binding EstaCargando, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LUNES -->
            <Border Grid.Column="0" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="LUNES" Style="{StaticResource DayHeaderStyle}" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=LUNES}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Lunes.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Lunes.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Lunes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- MARTES -->
            <Border Grid.Column="1" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="MARTES" Style="{StaticResource DayHeaderStyle}" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=MARTES}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Martes.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Martes.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Martes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- MIÉRCOLES -->
            <Border Grid.Column="2" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="MIÉRCOLES" Style="{StaticResource DayHeaderStyle}" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=MIÉRCOLES}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Miercoles.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Miercoles.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Miercoles}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- JUEVES -->
            <Border Grid.Column="3" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="JUEVES" Style="{StaticResource DayHeaderStyle}" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=JUEVES}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Jueves.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Jueves.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Jueves}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- VIERNES -->
            <Border Grid.Column="4" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="VIERNES" Style="{StaticResource DayHeaderStyle}" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=VIERNES}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Viernes.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Viernes.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Viernes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- SÁBADO -->
            <Border Grid.Column="5" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="SÁBADO" Style="{StaticResource DayHeaderStyle}" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=SÁBADO}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Sabado.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Sabado.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Sabado}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- DOMINGO -->
            <Border Grid.Column="6" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="DOMINGO" Style="{StaticResource DayHeaderStyle}" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=DOMINGO}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Domingo.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Domingo.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Domingo}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
