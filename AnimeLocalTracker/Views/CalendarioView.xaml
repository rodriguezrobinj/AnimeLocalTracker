<UserControl x:Class="AnimeLocalTracker.Views.CalendarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Botón que cubre toda la tarjeta: transparente, con un velo azul suave al pasar el ratón y al pulsar. El de Material
             Design (sombra, ripple, estados) costaba ~160 ms con las ~40 tarjetas que se construyen a la vez al abrir la pestaña. -->
        <Style x:Key="CalTarjetaBoton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Velo" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Velo" Property="Background" Value="{StaticResource Brush.AccentStrongTint}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Velo" Property="Background" Value="{StaticResource Brush.AccentTint}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Velo" Property="BorderBrush" Value="{StaticResource Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para las listas de cada día -->
        <DataTemplate x:Key="AiringEpisodeTemplate">
            <!-- Piezas ligeras a propósito: al abrir la pestaña se construyen ~40 tarjetas de golpe y la interfaz se congelaba
                 ~0,45 s (medido). Un Border en vez de materialDesign:Card y la portada como ImageBrush, que respeta la esquina
                 redondeada sin el recorte de la Card. La portada ya llega decodificada de la caché compartida con la Galería:
                 no hace falta shimmer mientras carga (sin portada se ve el fondo). -->
            <Border Margin="0,0,0,10" Background="#1B222C" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="8,0,0,8" Height="72" Background="{StaticResource Brush.SurfaceControl}"/>
                    <Border Grid.Column="0" CornerRadius="8,0,0,8" Height="72">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Portada, TargetNullValue={x:Null}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>

                    <!-- Información (compacta: filas fijas, sin desbordes) -->
                    <Grid Grid.Column="1" Margin="8,5,6,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Fila 1: hora + indicadores circulares de estado (solo color) -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HoraEmisionFormateada}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                            <!-- Ya emitido: punto ámbar -->
                            <Ellipse Fill="{StaticResource Brush.Warning}" Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding EstaEmitido, Converter={StaticResource BoolToVis}}" ToolTip="{loc:T Cal_YaEmitidoTip}"/>
                            <!-- Próximo: círculo con contorno azul -->
                            <Ellipse Stroke="{StaticResource Brush.AccentStrong}" StrokeThickness="1.5" Fill="Transparent" Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding EstaEmitido, Converter={StaticResource InverseBoolToVis}}" ToolTip="{loc:T Cal_ProximoTip}"/>
                        </StackPanel>

                        <!-- Fila 2: título (hasta 2 líneas con recorte) -->
                        <TextBlock Grid.Row="1" Text="{Binding Titulo}" FontSize="11.5" FontWeight="SemiBold" Foreground="White"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28" Margin="0,1,0,0"/>

                        <!-- Fila 3: episodio -->
                        <TextBlock Grid.Row="2" FontSize="10.5"
                                   Foreground="{StaticResource Brush.TextTertiary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                    <Binding Path="[Act_EpisodioFormato]" Source="{x:Static loc:LocalizationService.Instance}" />
                                    <Binding Path="NumeroEpisodio" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>

                    <!-- BOTÓN A TODA LA TARJETA: cubre 100% del cuadro (portada + info) -->
                    <Button Grid.Column="0" Grid.ColumnSpan="2"
                            Command="{Binding DataContext.AbrirAnimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource CalTarjetaBoton}" Panel.ZIndex="20"
                            ToolTip="{loc:T Cal_AbrirFichaTip}">
                        <AutomationProperties.Name>
                            <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                <Binding Path="[Cal_AbrirFichaAuto]" Source="{x:Static loc:LocalizationService.Instance}" />
                                <Binding Path="Titulo" />
                            </MultiBinding>
                        </AutomationProperties.Name>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        
        <Style TargetType="TextBlock" x:Key="DayHeaderStyle" BasedOn="{StaticResource AppText.Section}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Mantener la barra de scroll estándar en Calendario -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" />

        <!-- PERF-05: ItemContainerStyle transparente (sin resaltado de selección) para el
             ListBox virtualizado de cada día — patrón canónico de ui-wpf-vistas.md, igual
             que en HistorialView/ActualizacionesView. Las tarjetas ya tienen su propio
             Button interno para abrir la ficha, así que el ListBoxItem no debe verse
             seleccionable. -->
        <Style x:Key="CalendarioListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource AppFilaTransparente}"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource AppPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
        <Grid Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:T Cal_Titulo}" Style="{StaticResource AppText.PageTitle}" VerticalAlignment="Center"/>

                <!-- BADGE CONTEO EN EMISIÓN -->
                <Border Style="{StaticResource AppBadge}" Margin="14,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalAnimesEnEmision}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </StackPanel>
            <Button Command="{Binding CargarCalendarioCommand}" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:T Act_BotonActualizar}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        </StackPanel>

        <!-- Loader -->
        <ProgressBar Grid.Row="1" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     Value="0" IsIndeterminate="True" 
                     Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" Width="50" Height="50"/>

        <!-- Calendario Kanban -->
        <Grid Grid.Row="1" Visibility="{Binding EstaCargando, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LUNES -->
            <Border Grid.Column="0" Margin="5" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T Cal_Lunes}" Style="{StaticResource DayHeaderStyle}" Margin="0,0,6,4"/>
                        <Border Background="{StaticResource Brush.AccentStrong}" CornerRadius="6" Padding="6,2" Margin="0,2,4,4" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=LUNES}">
                            <TextBlock Text="{loc:T Cal_Hoy}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="{StaticResource Brush.Surface3}" CornerRadius="8" Padding="6,2" Margin="0,2,0,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Lunes.Count}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Cal_SinEpisodios}" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Lunes.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ListBox ItemsSource="{Binding Lunes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"
                             ItemContainerStyle="{StaticResource CalendarioListBoxItemStyle}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.PanningMode="VerticalOnly"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"/>
                </DockPanel>
            </Border>

            <!-- MARTES -->
            <Border Grid.Column="1" Margin="5" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T Cal_Martes}" Style="{StaticResource DayHeaderStyle}" Margin="0,0,6,4"/>
                        <Border Background="{StaticResource Brush.AccentStrong}" CornerRadius="6" Padding="6,2" Margin="0,2,4,4" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=MARTES}">
                            <TextBlock Text="{loc:T Cal_Hoy}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="{StaticResource Brush.Surface3}" CornerRadius="8" Padding="6,2" Margin="0,2,0,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Martes.Count}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Cal_SinEpisodios}" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Martes.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ListBox ItemsSource="{Binding Martes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"
                             ItemContainerStyle="{StaticResource CalendarioListBoxItemStyle}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.PanningMode="VerticalOnly"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"/>
                </DockPanel>
            </Border>

            <!-- MIÉRCOLES -->
            <Border Grid.Column="2" Margin="5" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T Cal_Miercoles}" Style="{StaticResource DayHeaderStyle}" Margin="0,0,6,4"/>
                        <Border Background="{StaticResource Brush.AccentStrong}" CornerRadius="6" Padding="6,2" Margin="0,2,4,4" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=MIÉRCOLES}">
                            <TextBlock Text="{loc:T Cal_Hoy}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="{StaticResource Brush.Surface3}" CornerRadius="8" Padding="6,2" Margin="0,2,0,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Miercoles.Count}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Cal_SinEpisodios}" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Miercoles.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ListBox ItemsSource="{Binding Miercoles}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"
                             ItemContainerStyle="{StaticResource CalendarioListBoxItemStyle}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.PanningMode="VerticalOnly"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"/>
                </DockPanel>
            </Border>

            <!-- JUEVES -->
            <Border Grid.Column="3" Margin="5" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T Cal_Jueves}" Style="{StaticResource DayHeaderStyle}" Margin="0,0,6,4"/>
                        <Border Background="{StaticResource Brush.AccentStrong}" CornerRadius="6" Padding="6,2" Margin="0,2,4,4" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=JUEVES}">
                            <TextBlock Text="{loc:T Cal_Hoy}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="{StaticResource Brush.Surface3}" CornerRadius="8" Padding="6,2" Margin="0,2,0,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Jueves.Count}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Cal_SinEpisodios}" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Jueves.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ListBox ItemsSource="{Binding Jueves}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"
                             ItemContainerStyle="{StaticResource CalendarioListBoxItemStyle}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.PanningMode="VerticalOnly"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"/>
                </DockPanel>
            </Border>

            <!-- VIERNES -->
            <Border Grid.Column="4" Margin="5" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T Cal_Viernes}" Style="{StaticResource DayHeaderStyle}" Margin="0,0,6,4"/>
                        <Border Background="{StaticResource Brush.AccentStrong}" CornerRadius="6" Padding="6,2" Margin="0,2,4,4" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=VIERNES}">
                            <TextBlock Text="{loc:T Cal_Hoy}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="{StaticResource Brush.Surface3}" CornerRadius="8" Padding="6,2" Margin="0,2,0,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Viernes.Count}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Cal_SinEpisodios}" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Viernes.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ListBox ItemsSource="{Binding Viernes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"
                             ItemContainerStyle="{StaticResource CalendarioListBoxItemStyle}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.PanningMode="VerticalOnly"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"/>
                </DockPanel>
            </Border>

            <!-- SÁBADO -->
            <Border Grid.Column="5" Margin="5" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T Cal_Sabado}" Style="{StaticResource DayHeaderStyle}" Margin="0,0,6,4"/>
                        <Border Background="{StaticResource Brush.AccentStrong}" CornerRadius="6" Padding="6,2" Margin="0,2,4,4" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=SÁBADO}">
                            <TextBlock Text="{loc:T Cal_Hoy}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="{StaticResource Brush.Surface3}" CornerRadius="8" Padding="6,2" Margin="0,2,0,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Sabado.Count}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Cal_SinEpisodios}" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Sabado.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ListBox ItemsSource="{Binding Sabado}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"
                             ItemContainerStyle="{StaticResource CalendarioListBoxItemStyle}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.PanningMode="VerticalOnly"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"/>
                </DockPanel>
            </Border>

            <!-- DOMINGO -->
            <Border Grid.Column="6" Margin="5" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T Cal_Domingo}" Style="{StaticResource DayHeaderStyle}" Margin="0,0,6,4"/>
                        <Border Background="{StaticResource Brush.AccentStrong}" CornerRadius="6" Padding="6,2" Margin="0,2,4,4" VerticalAlignment="Center"
                                Visibility="{Binding DiaActual, Converter={StaticResource StringEquals}, ConverterParameter=DOMINGO}">
                            <TextBlock Text="{loc:T Cal_Hoy}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="{StaticResource Brush.Surface3}" CornerRadius="8" Padding="6,2" Margin="0,2,0,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Domingo.Count}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Cal_SinEpisodios}" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               Visibility="{Binding Domingo.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ListBox ItemsSource="{Binding Domingo}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"
                             ItemContainerStyle="{StaticResource CalendarioListBoxItemStyle}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.PanningMode="VerticalOnly"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
