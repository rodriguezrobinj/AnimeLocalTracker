<UserControl x:Class="AnimeLocalTracker.Views.CalendarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Estilo para las listas de cada día -->
        <DataTemplate x:Key="AiringEpisodeTemplate">
            <materialDesign:Card Margin="0,0,0,10" Background="#262626" UniformCornerRadius="8" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Portada -->
                    <Border Grid.Column="0" CornerRadius="8,0,0,8" ClipToBounds="True">
                        <Grid>
                            <Border Style="{StaticResource ShimmerEffectStyle}" />
                            <Image Source="{Binding UrlPortada, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" Stretch="UniformToFill" Height="80"/>
                        </Grid>
                    </Border>
                    
                    <!-- Información -->
                    <StackPanel Grid.Column="1" Margin="10,5">
                        <TextBlock Text="{Binding HoraEmisionFormateada}" FontSize="12" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" MaxHeight="35" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding NumeroEpisodio, StringFormat='Episodio {0}'}" FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </DataTemplate>
        
        <Style TargetType="TextBlock" x:Key="DayHeaderStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,60,30,30"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,30,30,30"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Calendario de Emisión" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold" VerticalAlignment="Center"/>
                
                <!-- BADGE CONTEO EN EMISIÓN -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                        CornerRadius="12" Height="24" MinWidth="26" Padding="7,0" Margin="14,0,0,0" 
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalAnimesEnEmision}" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" 
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </StackPanel>
            <Button Command="{Binding CargarCalendarioCommand}" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ACTUALIZAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Loader -->
        <ProgressBar Grid.Row="1" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     Value="0" IsIndeterminate="True" 
                     Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" Width="50" Height="50"/>

        <!-- Calendario Kanban -->
        <Grid Grid.Row="1" Visibility="{Binding EstaCargando, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lunes -->
            <Border Grid.Column="0" Margin="5" Background="#151515" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBlock Text="LUNES" DockPanel.Dock="Top" Style="{StaticResource DayHeaderStyle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Lunes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Martes -->
            <Border Grid.Column="1" Margin="5" Background="#151515" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBlock Text="MARTES" DockPanel.Dock="Top" Style="{StaticResource DayHeaderStyle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Martes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Miércoles -->
            <Border Grid.Column="2" Margin="5" Background="#151515" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBlock Text="MIÉRCOLES" DockPanel.Dock="Top" Style="{StaticResource DayHeaderStyle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Miercoles}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Jueves -->
            <Border Grid.Column="3" Margin="5" Background="#151515" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBlock Text="JUEVES" DockPanel.Dock="Top" Style="{StaticResource DayHeaderStyle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Jueves}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Viernes -->
            <Border Grid.Column="4" Margin="5" Background="#151515" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBlock Text="VIERNES" DockPanel.Dock="Top" Style="{StaticResource DayHeaderStyle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Viernes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Sábado -->
            <Border Grid.Column="5" Margin="5" Background="#151515" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBlock Text="SÁBADO" DockPanel.Dock="Top" Style="{StaticResource DayHeaderStyle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Sabado}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Domingo -->
            <Border Grid.Column="6" Margin="5" Background="#151515" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBlock Text="DOMINGO" DockPanel.Dock="Top" Style="{StaticResource DayHeaderStyle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Domingo}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
