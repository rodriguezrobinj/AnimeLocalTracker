<UserControl x:Class="AnimeLocalTracker.Views.ActualizacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             xmlns:vm="clr-namespace:AnimeLocalTracker.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <Grid MaxWidth="1280">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,60,30,30"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,30,30,30"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="NewReleases" Foreground="#60A5FA" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Act_Titulo], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppText.PageTitle}"/>
                    <TextBlock Text="{Binding [Act_Subtitulo], Source={x:Static loc:LocalizationService.Instance}}" FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding CargarActualizacionesCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="36" Padding="12,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [Act_BotonActualizar], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <!-- CARGANDO -->
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                         Width="44" Height="44" Value="0" Foreground="#60A5FA"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>

            <!-- VACÍO -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                         Visibility="{Binding EstaVacio, Converter={StaticResource BoolToVis}}">
                <Border Background="#1E293B" CornerRadius="36" Width="72" Height="72" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="NewReleases" Foreground="#64748B" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding [Act_VacioTitulo], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppEmptyTitle}"/>
                <TextBlock Text="{Binding [Act_VacioSub], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppEmptyText}" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- LISTA VIRTUALIZADA CON CABECERAS DE FECHA -->
            <ListBox ItemsSource="{Binding ItemsAgrupados}"
                     Background="Transparent" BorderThickness="0" Padding="0,0,16,0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="True"
                     SelectionMode="Single"
                     Visibility="{Binding TieneItems, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <!-- CABECERA DE FECHA (Hoy / Ayer / Hace N días) -->
                    <DataTemplate DataType="{x:Type sys:String}">
                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="Bold" Foreground="#93C5FD" Margin="1,14,0,8"
                                   Focusable="False" IsHitTestVisible="False"/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:ActualizacionItemViewModel}">
                        <Border Background="{DynamicResource Brush.Surface1}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="12,10" Margin="0,0,0,10" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- PORTADA (Clic para abrir ficha) -->
                                <Button Grid.Column="0"
                                        Command="{Binding DataContext.NavegarDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                                        Cursor="Hand" ToolTip="{Binding [Act_VerAnime], Source={x:Static loc:LocalizationService.Instance}}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Width="80" Height="45" CornerRadius="6" ClipToBounds="True"
                                            Background="#1E293B" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid>
                                            <Border Background="#161B22">
                                                <materialDesign:PackIcon Kind="MoviePlayOutline" Foreground="#475569" Width="22" Height="22"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding RutaPortada, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- INFO -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0">
                                    <!-- TÍTULO (Clic para abrir ficha) -->
                                    <Button Command="{Binding DataContext.NavegarDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                                            Cursor="Hand" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                            ToolTip="{Binding [Act_VerAnime], Source={x:Static loc:LocalizationService.Instance}}">
                                        <TextBlock Text="{Binding TituloAnime}" FontWeight="Bold" FontSize="14.5" Foreground="#E2E8F0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxHeight="20"/>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EpisodioTexto}" FontWeight="SemiBold" FontSize="12.5" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                        <TextBlock Text=" · " Foreground="#6B7280" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FechaTexto}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                        <!-- BADGE DESCARGADO -->
                                        <Border Background="#1E3A8A" CornerRadius="4" Padding="5,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Check" Foreground="#60A5FA" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBlock Text="{Binding [Act_Descargado], Source={x:Static loc:LocalizationService.Instance}}"
                                                           FontSize="10.5" Foreground="#93C5FD" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ACCIÓN: REPRODUCIR / PROGRESO / DESCARGAR -->
                                <Grid Grid.Column="2" Width="34" Height="34" VerticalAlignment="Center">
                                    <!-- 1. DESCARGADO: botón de reproducir directamente -->
                                    <Button Command="{Binding DataContext.ReproducirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="34" Height="34" Cursor="Hand"
                                            ToolTip="{Binding [Act_Reproducir], Source={x:Static loc:LocalizationService.Instance}}"
                                            AutomationProperties.Name="{Binding [Act_Reproducir], Source={x:Static loc:LocalizationService.Instance}}"
                                            Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </Button.Style>
                                        <materialDesign:PackIcon Kind="PlayCircleOutline" Foreground="#60A5FA" Width="26" Height="26"/>
                                    </Button>

                                    <!-- 2. DESCARGANDO: círculo de progreso -->
                                    <Grid Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                        <Ellipse Width="24" Height="24" Stroke="#33FFFFFF" StrokeThickness="3"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <ProgressBar Width="24" Height="24" Foreground="#60A5FA"
                                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                     IsIndeterminate="True"
                                                     Visibility="{Binding EstaEnEspera, Converter={StaticResource BoolToVis}}"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"
                                                     materialDesign:TransitionAssist.DisableTransitions="True"/>
                                        <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100"
                                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                     Width="24" Height="24" Foreground="#60A5FA"
                                                     IsIndeterminate="False"
                                                     Visibility="{Binding ProgresoDescargaActivo, Converter={StaticResource BoolToVis}}"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"
                                                     materialDesign:TransitionAssist.DisableTransitions="True"/>
                                    </Grid>

                                    <!-- 3. PENDIENTE DE DESCARGAR (no descargado ni descargando) -->
                                    <Button Command="{Binding DataContext.DescargarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="34" Height="34" Cursor="Hand"
                                            ToolTip="{Binding [Act_Descargar], Source={x:Static loc:LocalizationService.Instance}}"
                                            AutomationProperties.Name="{Binding [Act_Descargar], Source={x:Static loc:LocalizationService.Instance}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Descargado}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <materialDesign:PackIcon Kind="DownloadCircleOutline" Foreground="#60A5FA" Width="24" Height="24"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
