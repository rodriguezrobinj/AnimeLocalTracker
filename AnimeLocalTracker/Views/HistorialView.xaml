<UserControl x:Class="AnimeLocalTracker.Views.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             xmlns:vm="clr-namespace:AnimeLocalTracker.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Chip de filtro: activo = borde y texto azules (igual que en Actualizaciones/Logros) -->
        <Style x:Key="HistChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Raiz" Background="#14181E" BorderBrush="#262D38" BorderThickness="1"
                                CornerRadius="16" Padding="14,6" Margin="0,0,8,0">
                            <ContentPresenter x:Name="Texto" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="#9CA3AF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Raiz" Property="Background" Value="#1B222C"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding EsActivo}" Value="True">
                                <Setter TargetName="Raiz" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="Raiz" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="Texto" Property="TextElement.Foreground" Value="#93C5FD"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1280">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,60,30,30"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,30,30,30"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <!-- Fila 0: Header / Encabezado -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Resumen -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 2: Filtros (chips) + búsqueda -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 3: Lista de historial / Estados vacíos -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  FILA 0: ENCABEZADO PRINCIPAL                                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="History" Foreground="#60A5FA" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Hist_Titulo], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppText.PageTitle}"/>
                    <TextBlock Text="{Binding [Hist_Subtitulo], Source={x:Static loc:LocalizationService.Instance}}" FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  FILA 1: BÚSQUEDA RÁPIDA                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1E293B" CornerRadius="10" Width="42" Height="42" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="History" Foreground="#60A5FA" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalElementos}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding [Hist_Resumen_Capitulos], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#3A2F12" CornerRadius="10" Width="42" Height="42" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="ProgressClock" Foreground="#FBBF24" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalEnProgreso}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding [Hist_Resumen_EnProgreso], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="14" Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#123A2E" CornerRadius="10" Width="42" Height="42" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="ClockCheckOutline" Foreground="#34D399" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TiempoVistoTexto}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding [Hist_Resumen_Tiempo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filtros (chips con contador) + búsqueda -->
        <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,0,0,4">
        <Border DockPanel.Dock="Right" Width="280" Height="36" Margin="12,0,0,0" VerticalAlignment="Center"
                Background="#14181E" BorderBrush="#262D38" BorderThickness="1"
                CornerRadius="18" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Foreground="#6B7280" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>

                <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Foreground="#E2E8F0" FontSize="12.5"
                         VerticalAlignment="Center" CaretBrush="#60A5FA"
                         materialDesign:HintAssist.Hint="{Binding [Hist_BuscarPlaceholder], Source={x:Static loc:LocalizationService.Instance}}"
                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>

                <!-- BOTÓN LIMPIAR BÚSQUEDA -->
                <Button Grid.Column="2"
                        Command="{Binding DataContext.CambiarFiltroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Click="LimpiarBusqueda_Click"
                        Style="{StaticResource MaterialDesignIconButton}" Width="20" Height="20" Padding="0"
                        Visibility="{Binding TextoBusqueda.Length, Converter={StaticResource ZeroToVis}}">
                    <materialDesign:PackIcon Kind="CloseCircle" Foreground="#9CA3AF" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Filtros}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Etiqueta}" Style="{StaticResource HistChipStyle}"
                            Command="{Binding DataContext.CambiarFiltroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Clave}"
                            AutomationProperties.Name="{Binding Etiqueta}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  FILA 3: CONTENIDO PRINCIPAL (LISTA / CARGANDO / VACÍO)          -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <!-- 1. SPINNER DE CARGA -->
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="44" Height="44"
                         Value="0" Foreground="#60A5FA"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>

            <!-- 2. ESTADO VACÍO (SIN HISTORIAL) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding EstaVacio, Converter={StaticResource BoolToVis}}"
                        Margin="0,40,0,40">
                <Border Background="#1E293B" CornerRadius="36" Width="72" Height="72" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="History" Foreground="#64748B" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding [Hist_VacioTitulo], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppEmptyTitle}"/>
                <TextBlock Text="{Binding [Hist_VacioSubtitulo], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppEmptyText}" Margin="0,6,0,20" MaxWidth="420"/>
                <Button Command="{Binding ExplorarGaleriaCommand}"
                        Style="{StaticResource AppPrimaryButton}"
                        HorizontalAlignment="Center" Height="40" Padding="20,0" materialDesign:ButtonAssist.CornerRadius="20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewGallery" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding [Hist_ExplorarGaleria], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 3. ESTADO VACÍO POR BÚSQUEDA -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding SinResultadosBusqueda, Converter={StaticResource BoolToVis}}"
                        Margin="0,40,0,40">
                <materialDesign:PackIcon Kind="MagnifyClose" Foreground="#64748B" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding [Hist_SinResultados], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppEmptyText}" FontSize="15" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 4. LISTA DE TARJETAS VIRTUALIZADA (ListBox: virtualización REAL.
                 El ItemsControl dentro de un ScrollViewer se media con altura infinita
                 y materializaba las 400 tarjetas → lag al abrir/buscar.) -->
            <ListBox x:Name="ListaHistorial"
                     ItemsSource="{Binding ItemsAgrupados}"
                     Background="Transparent" BorderThickness="0" Padding="0,0,16,0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="True"
                     SelectionMode="Single"
                     Visibility="{Binding TieneElementos, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <!-- Plantillas implícitas por tipo: cabecera de fecha (string) y tarjeta (item) -->
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="Bold" Foreground="#93C5FD" Margin="1,14,0,8"/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:HistorialItemViewModel}">
                        <!-- FILA RICA DE HISTORIAL -->
                        <Border x:Name="Tarjeta" Background="{DynamicResource Brush.Surface1}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="14"
                                Padding="12" Margin="0,0,10,10" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- MINIATURA 16:9 CON PROGRESO (clic = reanudar) -->
                                <Button Grid.Column="0" Width="160" Height="90" MinHeight="90" Padding="0" BorderThickness="0"
                                        Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                        Command="{Binding DataContext.ReanudarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding [Hist_Reanudar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                        AutomationProperties.Name="{Binding [Hist_Reanudar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                    <Border CornerRadius="10" Background="#1E293B" ClipToBounds="True">
                                        <Grid>
                                            <Border Style="{StaticResource ShimmerEffectStyle}">
                                                <materialDesign:PackIcon Kind="MoviePlayOutline" Foreground="#475569" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            </Border>
                                            <Image Source="{Binding RutaImagenMostrar}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Border Background="#66000000" CornerRadius="16" Width="32" Height="32"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <materialDesign:PackIcon Kind="Play" Foreground="White" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ProgressBar Value="{Binding PorcentajeProgreso, Mode=OneWay}" Style="{StaticResource AppWatchProgressBar.Overlay}"
                                                         Visibility="{Binding EnProgreso, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- INFORMACIÓN -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0">
                                    <Button Command="{Binding DataContext.NavegarDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand" HorizontalAlignment="Left"
                                            Background="Transparent" BorderThickness="0" Padding="0" Height="Auto" MinHeight="0"
                                            ToolTip="{Binding [Hist_VerAnime], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                            AutomationProperties.Name="{Binding TituloAnime}">
                                        <TextBlock Text="{Binding TituloAnime}" FontWeight="Bold" FontSize="15" Foreground="#E2E8F0"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                                    </Button>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="#1E293B" CornerRadius="6" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EpisodioCorto}" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                                        </Border>
                                        <materialDesign:PackIcon Kind="ClockOutline" Foreground="#94A3B8" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding FechaRelativaTexto}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Grid Visibility="{Binding TieneEstado, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0">
                                            <Border Background="{Binding EstadoColor}" Opacity="0.16" CornerRadius="10"/>
                                            <TextBlock Text="{Binding EstadoTexto}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding EstadoColor}" Margin="10,3" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ProgresoFormateado}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"
                                                   Visibility="{Binding MostrarProgreso, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ACCIONES -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.ReanudarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Height="38" MinWidth="130" Padding="14,0" Cursor="Hand" Margin="0,0,6,0"
                                            materialDesign:ButtonAssist.CornerRadius="10"
                                            AutomationProperties.Name="{Binding AccionTexto}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AccionEsPrimaria}" Value="False">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="Play"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VistoLocal}" Value="True">
                                                                <Setter Property="Kind" Value="Replay"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock Text="{Binding AccionTexto}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    

                                    
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding VistoLocal}" Value="True">
                                <Setter TargetName="Tarjeta" Property="Opacity" Value="0.85"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
