<UserControl x:Class="AnimeLocalTracker.Views.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             xmlns:vm="clr-namespace:AnimeLocalTracker.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <Grid MaxWidth="1280">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,60,30,30"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,30,30,30"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <!-- Fila 0: Header / Encabezado -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Barra de herramientas (Búsqueda + Filtros + Acciones) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 2: Lista de historial / Estados vacíos -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  FILA 0: ENCABEZADO PRINCIPAL                                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="History" Foreground="#60A5FA" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Hist_Titulo], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppText.PageTitle}"/>
                    <TextBlock Text="{Binding [Hist_Subtitulo], Source={x:Static loc:LocalizationService.Instance}}" FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- BOTÓN LIMPIAR TODO EL HISTORIAL -->
            <Button Grid.Column="1"
                    Command="{Binding LimpiarHistorialCommand}"
                    IsEnabled="{Binding TotalElementos, Converter={StaticResource ZeroToVis}}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    BorderBrush="#3A2024" Foreground="#F87171"
                    Height="38" Padding="14,0" materialDesign:ButtonAssist.CornerRadius="10"
                    VerticalAlignment="Center">
                <Button.Resources>
                    <!-- Overrides hover to a pleasant subtle red -->
                    <SolidColorBrush x:Key="MaterialDesignFlatButtonRipple" Color="#F87171" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding [Hist_LimpiarHistorial], Source={x:Static loc:LocalizationService.Instance}}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  FILA 1: BÚSQUEDA RÁPIDA                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" HorizontalAlignment="Right" Width="280" Height="36" Margin="0,0,0,18"
                Background="#14181E" BorderBrush="#262D38" BorderThickness="1"
                CornerRadius="18" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Foreground="#6B7280" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>

                <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Foreground="#E2E8F0" FontSize="12.5"
                         VerticalAlignment="Center" CaretBrush="#60A5FA"
                         materialDesign:HintAssist.Hint="{Binding [Hist_BuscarPlaceholder], Source={x:Static loc:LocalizationService.Instance}}"
                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>

                <!-- BOTÓN LIMPIAR BÚSQUEDA -->
                <Button Grid.Column="2"
                        Command="{Binding DataContext.CambiarFiltroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Click="LimpiarBusqueda_Click"
                        Style="{StaticResource MaterialDesignIconButton}" Width="20" Height="20" Padding="0"
                        Visibility="{Binding TextoBusqueda.Length, Converter={StaticResource ZeroToVis}}">
                    <materialDesign:PackIcon Kind="CloseCircle" Foreground="#9CA3AF" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  FILA 2: CONTENIDO PRINCIPAL (LISTA / CARGANDO / VACÍO)          -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- 1. SPINNER DE CARGA -->
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="44" Height="44"
                         Value="0" Foreground="#60A5FA"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>

            <!-- 2. ESTADO VACÍO (SIN HISTORIAL) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding EstaVacio, Converter={StaticResource BoolToVis}}"
                        Margin="0,40,0,40">
                <Border Background="#1E293B" CornerRadius="36" Width="72" Height="72" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="History" Foreground="#64748B" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding [Hist_VacioTitulo], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppEmptyTitle}"/>
                <TextBlock Text="{Binding [Hist_VacioSubtitulo], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppEmptyText}" Margin="0,6,0,20" MaxWidth="420"/>
                <Button Command="{Binding ExplorarGaleriaCommand}"
                        Style="{StaticResource AppPrimaryButton}"
                        HorizontalAlignment="Center" Height="40" Padding="20,0" materialDesign:ButtonAssist.CornerRadius="20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewGallery" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding [Hist_ExplorarGaleria], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 3. ESTADO VACÍO POR BÚSQUEDA -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding SinResultadosBusqueda, Converter={StaticResource BoolToVis}}"
                        Margin="0,40,0,40">
                <materialDesign:PackIcon Kind="MagnifyClose" Foreground="#64748B" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding [Hist_SinResultados], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppEmptyText}" FontSize="15" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 4. LISTA DE TARJETAS VIRTUALIZADA (ListBox: virtualización REAL.
                 El ItemsControl dentro de un ScrollViewer se media con altura infinita
                 y materializaba las 400 tarjetas → lag al abrir/buscar.) -->
            <ListBox x:Name="ListaHistorial"
                     ItemsSource="{Binding ItemsAgrupados}"
                     Background="Transparent" BorderThickness="0" Padding="0,0,16,0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="True"
                     SelectionMode="Single"
                     Visibility="{Binding TieneElementos, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <!-- Plantillas implícitas por tipo: cabecera de fecha (string) y tarjeta (item) -->
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="Bold" Foreground="#93C5FD" Margin="1,14,0,8"/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:HistorialItemViewModel}">
                        <!-- TARJETA DE HISTORIAL -->
                        <Border Background="{DynamicResource Brush.Surface1}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="14,10" Margin="0,0,0,10"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Col 0: Miniatura / Portada con progreso -->
                                    <ColumnDefinition Width="130"/>
                                    <!-- Col 1: Información central -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Col 2: Acciones rápidas (Reanudar / Detalles / Opciones) -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- MINIATURA DEL EPISODIO / PORTADA -->
                                <Border Grid.Column="0" Width="120" Height="68" CornerRadius="8"
                                        Background="#1E293B" BorderBrush="#262D38" BorderThickness="1"
                                        ClipToBounds="True" HorizontalAlignment="Left">
                                    <Grid>
                                        <!-- PLACEHOLDER SIEMPRE DE FONDO: la imagen (si carga) lo cubre;
                                             si falta o falla, el icono queda visible -->
                                        <Border Background="#161B22">
                                            <materialDesign:PackIcon Kind="MoviePlayOutline" Foreground="#475569" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Border>

                                        <!-- IMAGEN (miniatura o portada; el placeholder queda de fondo si falla) -->
                                        <Image Source="{Binding RutaImagenMostrar}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <!-- BARRA DE PROGRESO DE REPRODUCCIÓN EN MINIATURA -->
                                        <ProgressBar Value="{Binding PorcentajeProgreso, Mode=OneWay}" Maximum="1.0"
                                                     Height="3.5" VerticalAlignment="Bottom"
                                                     Background="#33FFFFFF" Foreground="#60A5FA"
                                                     materialDesign:TransitionAssist.DisableTransitions="True"
                                                     Visibility="{Binding EnProgreso, Converter={StaticResource BoolToVis}}"/>

                                        <!-- BADGE VISTO EN MINIATURA -->
                                        <Border Background="#22C55E" CornerRadius="4" Padding="4,1" Margin="4"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="{Binding VistoLocal, Converter={StaticResource BoolToVis}}">
                                            <materialDesign:PackIcon Kind="Check" Foreground="White" Width="12" Height="12"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- INFORMACIÓN DEL EPISODIO Y ANIME (alineado arriba-izquierda) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="14,2,16,0" HorizontalAlignment="Stretch">
                                    <!-- TÍTULO DEL ANIME -->
                                    <TextBlock Text="{Binding TituloAnime}"
                                               FontWeight="Bold" FontSize="15" Foreground="#E2E8F0"
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="20"/>

                                    <!-- SUBTÍTULO: EPISODIO + ESTADO -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding TituloEpisodio}" FontWeight="SemiBold" FontSize="13" Foreground="#93C5FD"/>

                                        <TextBlock Text=" · " Foreground="#6B7280" FontSize="13"/>

                                        <!-- TIEMPO FORMATEADO -->
                                        <TextBlock Text="{Binding ProgresoFormateado}" FontSize="12.5" Foreground="#94A3B8" FontWeight="Medium"/>
                                    </StackPanel>

                                    <!-- FILA METADATOS: FECHA RELATIVA -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <materialDesign:PackIcon Kind="ClockOutline" Foreground="#6B7280" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding FechaRelativaTexto}" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ACCIONES RÁPIDAS -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- BOTÓN REANUDAR (solo icono) -->
                                    <Button Command="{Binding DataContext.ReanudarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="38" Height="38" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                            ToolTip="{Binding [Hist_Reanudar], Source={x:Static loc:LocalizationService.Instance}}">
                                        <materialDesign:PackIcon Kind="PlayCircleOutline" Foreground="#60A5FA" Width="24" Height="24"/>
                                    </Button>

                                    <!-- BOTÓN FICHA / DETALLES DEL ANIME -->
                                    <Button Command="{Binding DataContext.NavegarDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="34" Height="34" Padding="0" Margin="0,0,4,0"
                                            ToolTip="{Binding [Hist_VerAnime], Source={x:Static loc:LocalizationService.Instance}}">
                                        <materialDesign:PackIcon Kind="InformationOutline" Foreground="#94A3B8" Width="18" Height="18"/>
                                    </Button>

                                    <!-- BOTÓN ALTERNAR VISTO -->
                                    <Button Command="{Binding DataContext.AlternarVistoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="34" Height="34" Padding="0" Margin="0,0,4,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                <Setter Property="ToolTip" Value="{Binding [Hist_MarcarVisto], Source={x:Static loc:LocalizationService.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VistoLocal}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding [Hist_MarcarNoVisto], Source={x:Static loc:LocalizationService.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <materialDesign:PackIcon Width="18" Height="18">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="EyeOutline"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VistoLocal}" Value="True">
                                                            <Setter Property="Kind" Value="EyeCheck"/>
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Button>

                                    <!-- BOTÓN QUITAR DEL HISTORIAL -->
                                    <Button Command="{Binding DataContext.EliminarItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="34" Height="34" Padding="0"
                                            ToolTip="{Binding [Hist_Quitar], Source={x:Static loc:LocalizationService.Instance}}">
                                        <materialDesign:PackIcon Kind="Close" Foreground="#6B7280" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
