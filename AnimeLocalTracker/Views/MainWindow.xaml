<Window x:Class="AnimeLocalTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Mi Biblioteca" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="#121212"
        WindowStyle="None"
        MinWidth="800" MinHeight="600"
        ResizeMode="CanResize"
        KeyDown="Window_KeyDown">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <materialDesign:BooleanToVisibilityConverter x:Key="InverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible" />
        
        <!-- Scrollbar global y minimalista -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" />
    </Window.Resources>
    
    <Grid>
        <!-- BARRA DE TÍTULO CUSTOM (Flota sobre el contenido) -->
        <Grid x:Name="BarraTitulo" Height="45" Background="Transparent" VerticalAlignment="Top" Panel.ZIndex="1000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                <materialDesign:PackIcon Kind="PlayCircle" Foreground="#3F51B5" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="AnimeTracker" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnPantallaCompleta_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}" ToolTip="Pantalla Completa (F11)">
                    <materialDesign:PackIcon Kind="Fullscreen" />
                </Button>
                <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMinimizar_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}">
                    <materialDesign:PackIcon Kind="WindowMinimize" />
                </Button>
                <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMaximizar_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}">
                    <materialDesign:PackIcon Kind="WindowMaximize" />
                </Button>
                <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnCerrar_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}">
                    <materialDesign:PackIcon Kind="Close" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- CONTENIDO PRINCIPAL (Fondo completo) -->
        <Grid>
            
            <!-- PARTE 2A: VISTA DE LA GALERÍA PRINCIPAL -->
            <Grid MaxWidth="1248" Margin="30,60,30,30" Visibility="{Binding MostrandoGaleria, Converter={StaticResource BoolToVis}}">
                <Grid.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Opacidad fluida -->
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <!-- Deslizamiento fluido hacia arriba -->
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="25" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- HEADER MODERNO CON ÍCONOS -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Mi Colección" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold" VerticalAlignment="Center"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding AñadirAnimeManualCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,15,0" ToolTip="Buscar y añadir un nuevo anime">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MagnifyPlus" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                                <TextBlock Text="BUSCAR ANIME" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- BOTÓN CONECTAR (Desaparece si ya estás logeado) -->
                        <Button Command="{Binding ConectarAniListCommand}" 
                                Visibility="{Binding EstaConectado, Converter={StaticResource InverseBoolToVis}}"
                                Background="#3F51B5" BorderBrush="#3F51B5" Foreground="White" Margin="0,0,15,0" ToolTip="Conectar con AniList">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudUpload" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                                <TextBlock Text="CONECTAR" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- BADGE DE PERFIL ANIMADO (Aparece al logearte) -->
                        <Border Background="#1AFFFFFF" CornerRadius="20" Padding="12,4" Margin="0,0,15,0"
                                Visibility="{Binding EstaConectado, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" ToolTip="Cuenta sincronizada con AniList">
                                <!-- El Avatar circular -->
                                <Ellipse Width="28" Height="28" Margin="0,0,10,0" Stroke="#3F51B5" StrokeThickness="1.5">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding AvatarUsuarioAniList}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- Tu nombre de usuario -->
                                <TextBlock Text="{Binding NombreUsuarioAniList}" 
                                           Foreground="{DynamicResource MaterialDesignBody}" 
                                           VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                            </StackPanel>
                        </Border>
                        
                        <Button Command="{Binding ActualizarBibliotecaCommand}" 
                                Background="#4CAF50" BorderBrush="#4CAF50" Foreground="White" ToolTip="Actualizar datos desde la nube">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sync" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                                <TextBlock Text="SINCRONIZAR" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Panel de progreso FLOTANTE (Discreto) -->
                <materialDesign:Card Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" 
                                     Padding="25,12" UniformCornerRadius="25" Background="#1E1E1E"
                                     Visibility="{Binding EstaActualizando, Converter={StaticResource BoolToVis}}" 
                                     Panel.ZIndex="50" materialDesign:ElevationAssist.Elevation="Dp8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudSync" Foreground="#4CAF50" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding TextoProgreso}" 
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="14"/>
                        <ProgressBar Minimum="0" Maximum="{Binding ProgresoTotal}" 
                                     Value="{Binding ProgresoActual}" 
                                     Width="150" Height="6" VerticalAlignment="Center" Foreground="#4CAF50" 
                                     Background="#404CAF50" materialDesign:TransitionAssist.DisableTransitions="True"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ESTADO VACÍO -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"
                            Visibility="{Binding BibliotecaVacia, Converter={StaticResource BoolToVis}}">
                    <materialDesign:PackIcon Kind="ArchiveOutline" Width="80" Height="80" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0.5"/>
                    <TextBlock Text="Tu biblioteca está vacía" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Añade un anime para empezar tu colección local" FontSize="14" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,10,0,30" Opacity="0.8"/>
                    <Button Command="{Binding AñadirAnimeManualCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#3F51B5" BorderBrush="#3F51B5" Foreground="White" Padding="20,10" HorizontalAlignment="Center" Height="Auto">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MagnifyPlus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BUSCAR Y AÑADIR ANIME" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- El ScrollViewer de las tarjetas (Solo se ve si hay animes) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0" Margin="-14,0,-14,0"
                              Visibility="{Binding BibliotecaVacia, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsControl ItemsSource="{Binding BibliotecaLocales}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Width="180" Height="265" Margin="14" 
                                                     UniformCornerRadius="10" Background="#121212"
                                                     RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                                    <materialDesign:Card.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </materialDesign:Card.RenderTransform>
                                    <materialDesign:Card.Style>
                                        <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                                            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp6" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp12" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.15" />
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15" />
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:Card.Style>
                
                                    <Button Command="{Binding DataContext.AbrirDetalleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" 
                                            Padding="0" Background="Transparent" BorderThickness="0" Height="265" 
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Image Source="{Binding UrlPortada}" Stretch="UniformToFill" />
                                            
                                            <Border Background="{Binding ColorEstado}" Padding="8,4" CornerRadius="6" 
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                                    materialDesign:ElevationAssist.Elevation="Dp2">
                                                <TextBlock Text="{Binding EstadoVisual}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Gradiente más suave y minimalista para el título -->
                                            <Border VerticalAlignment="Bottom" Padding="12">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#CC000000" Offset="0.5"/>
                                                        <GradientStop Color="#FF000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel Margin="0,15,0,0">
                                                    <TextBlock Text="{Binding Titulo}" Foreground="White" FontWeight="Bold" 
                                                               FontSize="14" TextTrimming="CharacterEllipsis" MaxHeight="45" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- PARTE 2B: LA NUEVA VISTA DE DETALLES DEL ANIME (DISEÑO INMERSIVO) -->
            <Grid Visibility="{Binding MostrandoDetalle, Converter={StaticResource BoolToVis}}">
                <Grid.RenderTransform>
                    <TranslateTransform X="0"/>
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Opacidad fluida -->
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <!-- Deslizamiento fluido desde la derecha -->
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="30" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <!-- EL FONDO DINÁMICO DESENFOCADO -->
                <Grid>
                    <Image Source="{Binding AnimeSeleccionado.UrlPortada}" Stretch="UniformToFill" Opacity="0.25">
                        <Image.Effect>
                            <BlurEffect Radius="80" KernelType="Gaussian"/>
                        </Image.Effect>
                    </Image>
                    <!-- Capa oscura para asegurar legibilidad en cualquier tema -->
                    <Border Background="{DynamicResource MaterialDesignPaper}" Opacity="0.6"/>
                </Grid>

                <!-- EL CONTENIDO REAL -->
                <Grid MaxWidth="1248" Margin="40,65,40,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera con botones de control minimalistas (A prueba de nombres largos) -->
                    <Grid Grid.Row="0" Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <!-- Columna 0: Botón Volver (Se ajusta a su tamaño) -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Columna 1: Título (Ocupa el espacio restante sin empujar a los demás) -->
                            <ColumnDefinition Width="*"/>
                            <!-- Columna 2: Botón Eliminar (Se ajusta a su tamaño) -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding VolverAGaleriaCommand}"
                                ToolTip="Volver a la biblioteca" Margin="0,5,20,0" Padding="8,4" Height="Auto" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="VOLVER" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Título sin límites de altura, con fuente ligeramente ajustada para nombres gigantes -->
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding AnimeSeleccionado.Titulo}" 
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                                   VerticalAlignment="Top" 
                                   HorizontalAlignment="Left"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" 
                                   MaxHeight="60" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding AnimeSeleccionado.Titulo}"
                                   Margin="15,0" />
                               
                        <Button Grid.Column="2" 
                                Style="{StaticResource MaterialDesignIconForegroundButton}"
                                Command="{Binding EliminarAnimeActualCommand}"
                                Foreground="#E53935" Width="40" Height="40"
                                ToolTip="Eliminar de la biblioteca" Margin="20,0,0,0" VerticalAlignment="Top">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="24" Height="24" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Portada con elevación profunda y tamaño fijo -->
                        <materialDesign:Card Grid.Column="0" Width="260" Height="370" UniformCornerRadius="12" VerticalAlignment="Top" materialDesign:ElevationAssist.Elevation="Dp8">
                            <Image Source="{Binding AnimeSeleccionado.UrlPortada}" Stretch="UniformToFill" />
                        </materialDesign:Card>

                        <!-- COLUMNA DERECHA: Textos y Episodios -->
                        <Grid Grid.Column="1" Margin="40,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0">
                                
                                <!-- Metadatos superiores -->
                                
                                <TextBlock Text="{Binding AnimeSeleccionado.RutaCarpeta}" Margin="0,0,0,20" Opacity="0.6" FontSize="12"/>
                                
                                <!-- Sinopsis -->
                                <TextBlock Text="{Binding AnimeSeleccionado.Sinopsis}" 
                                           TextWrapping="Wrap" FontSize="15" LineHeight="22"
                                           Margin="0,0,0,25" Opacity="0.85" 
                                           MaxHeight="130" TextTrimming="CharacterEllipsis"/>
                                
                                <!-- Botón de Tracker moderno -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                        Command="{Binding AbrirEditorSeguimientoCommand}" 
                                        BorderBrush="#3F51B5" Foreground="#3F51B5"
                                        HorizontalAlignment="Left" Margin="0,0,0,20" Padding="15,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pencil" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="GESTIONAR EN ANILIST" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- NUEVO: Géneros como tarjetas individuales -->
                                <ItemsControl ItemsSource="{Binding AnimeSeleccionado.GenerosLista}" Margin="0,0,0,30">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E3F51B5" BorderBrush="#3F51B5" BorderThickness="1" CornerRadius="12" Padding="12,6" Margin="0,0,8,8">
                                                <TextBlock Text="{Binding}" Foreground="#8C9EFF" FontWeight="Bold" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Cabecera de Episodios con Controles Masivos y Filtros -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="Lista de Episodios" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    
                                    <!-- Filtro y Orden -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding OpcionesFiltro}" SelectedItem="{Binding FiltroEpisodios}" 
                                                  Width="110" materialDesign:TextFieldAssist.HasClearButton="False" 
                                                  Foreground="{DynamicResource MaterialDesignBody}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,6" Margin="0,0,10,0"/>
                                                  
                                        <ToggleButton IsChecked="{Binding OrdenAscendente}" Style="{StaticResource MaterialDesignActionToggleButton}"
                                                      Content="{materialDesign:PackIcon Kind=SortAscending, Size=20}"
                                                      materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=SortDescending, Size=20}"
                                                      ToolTip="Cambiar orden" Width="36" Height="36" Background="#2A2A2A" BorderThickness="0" Foreground="White" />
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="✓ VISTOS" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#4CAF50" 
                                                Command="{Binding MarcarVistosCommand}" 
                                                CommandParameter="{Binding SelectedItems, ElementName=ListaEpisodios}" 
                                                ToolTip="Marcar seleccionados como vistos" Padding="8,4" Height="Auto" Margin="0,0,5,0"/>
                                                
                                        <Button Content="✕ NO VISTOS" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E53935" 
                                                Command="{Binding MarcarNoVistosCommand}" 
                                                CommandParameter="{Binding SelectedItems, ElementName=ListaEpisodios}" 
                                                ToolTip="Marcar seleccionados como NO vistos" Padding="8,4" Height="Auto"/>
                                                
                                        <Button Content="↻ ACTUALIZAR" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FF9800" 
                                                Command="{Binding ActualizarAnimeActualCommand}" 
                                                ToolTip="Actualizar episodios desde AniList" Padding="8,4" Height="Auto" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            
                            <ListBox Grid.Row="1" x:Name="ListaEpisodios" ItemsSource="{Binding EpisodiosDelAnime}" 
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible" Padding="0,0,10,0"
                                     VirtualizingPanel.IsVirtualizing="True" 
                                     VirtualizingPanel.VirtualizationMode="Recycling" 
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.CanContentScroll="True"
                                     SelectionMode="Extended">
                                    
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,6"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Name="Border">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#1A4CAF50" />
                                                                <Setter TargetName="Border" Property="BorderBrush" Value="#4CAF50" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#2A2A2A" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- BOTÓN DE REPRODUCCIÓN (Aislado a la izquierda) -->
                                                <Button Grid.Column="0" 
                                                        Command="{Binding DataContext.ReproducirEpisodioCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconButton}" Width="35" Height="35" Margin="0,0,15,0"
                                                        ToolTip="Reproducir Episodio">
                                                    <materialDesign:PackIcon x:Name="IconoEstado" Kind="CloudDownload" Foreground="Gray" VerticalAlignment="Center" Width="20" Height="20"/>
                                                </Button>

                                                <!-- TÍTULO DEL EPISODIO -->
                                                <TextBlock Grid.Column="1" x:Name="TextoTitulo" Text="{Binding TituloVisual}" 
                                                           Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" FontSize="15" FontWeight="Medium"/>

                                                <!-- ESTRELLA DE FAVORITO -->
                                                <Button Grid.Column="2"
                                                        Command="{Binding DataContext.AlternarFavoritoEpisodioCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconButton}" Width="35" Height="35" Margin="0,0,5,0"
                                                        ToolTip="Marcar como favorito">
                                                    <materialDesign:PackIcon x:Name="IconoEstrella" Kind="StarOutline" Foreground="Gray" VerticalAlignment="Center" Width="20" Height="20"/>
                                                </Button>

                                                <!-- CHECKMARK VISTO -->
                                                <materialDesign:PackIcon Grid.Column="3" x:Name="IconoVisto" Kind="CheckBold" Margin="5,0,5,0" 
                                                                         Foreground="#4CAF50" VerticalAlignment="Center" Width="22" Height="22"
                                                                         Visibility="{Binding Visto, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        
                                        <!-- LA MAGIA VISUAL -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Descargado}" Value="True">
                                                <Setter TargetName="IconoEstado" Property="Kind" Value="Play" />
                                                <Setter TargetName="IconoEstado" Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                                <Setter TargetName="IconoEstado" Property="Width" Value="24" />
                                                <Setter TargetName="IconoEstado" Property="Height" Value="24" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visto}" Value="True">
                                                <Setter TargetName="TextoTitulo" Property="Foreground" Value="#4CAF50" />
                                                <Setter TargetName="TextoTitulo" Property="Opacity" Value="0.7" />
                                                <Setter TargetName="TextoTitulo" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Favorito}" Value="True">
                                                <Setter TargetName="IconoEstrella" Property="Kind" Value="Star" />
                                                <Setter TargetName="IconoEstrella" Property="Foreground" Value="#FFC107" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- PARTE 3: OVERLAY DEL EDITOR DE SEGUIMIENTO -->
            <Grid Visibility="{Binding MostrandoEditorSeguimiento, Converter={StaticResource BoolToVis}}" 
                  Background="#CC000000" Panel.ZIndex="100">
                
                <materialDesign:Card Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                     UniformCornerRadius="16" Padding="35" materialDesign:ElevationAssist.Elevation="Dp8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                            <materialDesign:PackIcon Kind="CloudSync" Foreground="#3F51B5" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Seguimiento en Nube" Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                       Foreground="#3F51B5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <ComboBox materialDesign:HintAssist.Hint="Estado actual" 
                                  ItemsSource="{Binding OpcionesEstadoVisual}" 
                                  SelectedItem="{Binding EditEstadoVisual}" 
                                  Margin="0,0,0,25" FontSize="15"/>
                        
                        <TextBox materialDesign:HintAssist.Hint="Episodios vistos" 
                                 Text="{Binding EditProgreso, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,25" FontSize="15"/>
                        
                        <TextBox materialDesign:HintAssist.Hint="Calificación (0 a 100)" 
                                 Text="{Binding EditPuntaje, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,25" FontSize="15"/>
                        
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="Inicio" SelectedDate="{Binding EditFechaInicio}" FontSize="14"/>
                            <DatePicker Grid.Column="2" materialDesign:HintAssist.Hint="Fin" SelectedDate="{Binding EditFechaFin}" FontSize="14"/>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="CANCELAR" 
                                    Style="{StaticResource MaterialDesignFlatButton}" 
                                    Command="{Binding CerrarEditorSeguimientoCommand}" Margin="0,0,10,0" FontWeight="Bold"/>
                                    
                            <Button Content="GUARDAR CAMBIOS" 
                                    Background="#3F51B5" BorderBrush="#3F51B5" Foreground="White"
                                    Command="{Binding GuardarSeguimientoCommand}" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- PARTE 1: OVERLAY DEL BUSCADOR EN VIVO DE ANILIST -->
            <Grid Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}" 
                  Background="#E6000000" Panel.ZIndex="200">
                
                <materialDesign:Card Width="550" MaxHeight="650" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                     UniformCornerRadius="20" Padding="30" materialDesign:ElevationAssist.Elevation="Dp12" Background="#1E1E1E">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header de Búsqueda -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,25">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <materialDesign:PackIcon Kind="Search" Width="28" Height="28" Foreground="#3F51B5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Buscador de Anime" Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                                           Foreground="{DynamicResource MaterialDesignBody}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBox materialDesign:HintAssist.Hint="Ej. One Piece, Naruto, Bleach..." 
                                     Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     Foreground="{DynamicResource MaterialDesignBody}"
                                     BorderBrush="#3F51B5"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                     FontSize="16" materialDesign:TextFieldAssist.HasClearButton="True"/>
                        </StackPanel>

                        <!-- Lista de Resultados con Scroll -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding ResultadosBusqueda}" Background="Transparent" 
                                 BorderThickness="0" Margin="-15,0,-15,0" Padding="0,0,5,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" CornerRadius="12" Name="Border">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#2A2A2A" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SeleccionarYCrearAnimeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            HorizontalContentAlignment="Stretch" Height="Auto" Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Miniatura del Anime con ExtraLarge -->
                                            <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Width="65" Height="90" materialDesign:ElevationAssist.Elevation="Dp4">
                                                <Image Source="{Binding CoverImage.ExtraLarge}" Stretch="UniformToFill" />
                                            </materialDesign:Card>
                                            
                                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title.Romaji}" Foreground="{DynamicResource MaterialDesignBody}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border Background="#333F51B5" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Status}" Foreground="#8C9EFF" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="14" Height="14" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Episodes, StringFormat='{} {0} EPs'}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="CERRAR" 
                                    Command="{Binding CerrarDialogoBusquedaCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="Gray" BorderBrush="Gray"
                                    FontWeight="Bold" Padding="25,0" />
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
            
            <!-- PARTE 4: SISTEMA DE DIÁLOGOS CUSTOM -->
            <Grid Visibility="{Binding DialogoVisible, Converter={StaticResource BoolToVis}}" 
                  Background="#E6000000" Panel.ZIndex="500">
                  
                <materialDesign:Card Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                     UniformCornerRadius="16" Padding="30" materialDesign:ElevationAssist.Elevation="Dp12" Background="#1E1E1E">
                    <StackPanel>
                        <!-- Cabecera del Diálogo -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <materialDesign:PackIcon Kind="{Binding DialogoIcono}" Foreground="{Binding DialogoColor}" Width="32" Height="32" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DialogoTitulo}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                       Foreground="{DynamicResource MaterialDesignBody}" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280"/>
                        </StackPanel>
                        
                        <!-- Mensaje -->
                        <TextBlock Text="{Binding DialogoMensaje}" FontSize="15" Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                   TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="22"/>
                        
                        <!-- Botones -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="CANCELAR" 
                                    Visibility="{Binding DialogoEsConfirmacion, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource MaterialDesignFlatButton}" 
                                    Command="{Binding CancelarDialogoCommand}" Margin="0,0,10,0" FontWeight="Bold" Foreground="Gray"/>
                                    
                            <Button Content="ACEPTAR" 
                                    Style="{StaticResource MaterialDesignRaisedButton}" 
                                    Background="{Binding DialogoColor}" BorderBrush="{Binding DialogoColor}" Foreground="White"
                                    Command="{Binding AceptarDialogoCommand}" FontWeight="Bold" Padding="25,0"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
            
        </Grid>
    </Grid>
</Window>