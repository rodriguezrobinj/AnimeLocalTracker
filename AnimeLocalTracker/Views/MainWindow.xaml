<Window x:Class="AnimeLocalTracker.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:AnimeLocalTracker.Views"
        xmlns:viewmodels="clr-namespace:AnimeLocalTracker.ViewModels"
        Title="Mi Biblioteca" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="#121212"
        WindowStyle="None"
        MinWidth="800" MinHeight="600"
        ResizeMode="NoResize"
        WindowState="Maximized"
        KeyDown="Window_KeyDown">
    

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- DataTemplates para enrutar el ContentControl hacia el View correcto -->
        <DataTemplate DataType="{x:Type viewmodels:GaleriaViewModel}">
            <local:GaleriaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DetalleViewModel}">
            <local:DetalleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CalendarioViewModel}">
            <local:CalendarioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReproductorViewModel}">
            <local:ReproductorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DescargasViewModel}">
            <local:DescargasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ConfiguracionViewModel}">
            <local:ConfiguracionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AcercaDeViewModel}">
            <local:AcercaDeView />
        </DataTemplate>
        
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" />
    </Window.Resources>
    
    <Grid x:Name="RootLayout">
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="True">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="600" MaxHeight="650" Background="#1E1E1E">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="25,25,25,15">
                        <TextBlock Text="Buscar y Añadir Anime" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Command="{Binding CerrarDialogoBusquedaCommand}" Style="{StaticResource MaterialDesignIconForegroundButton}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Close" />
                        </Button>
                    </Grid>

                    <!-- Barra de búsqueda dinámica (Auto-búsqueda) -->
                    <Grid Grid.Row="1" Margin="25,0,25,15">
                        <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Buscar en AniList (Escribe al menos 3 letras)..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Search"
                                 materialDesign:TextFieldAssist.LeadingIconSize="24"
                                 FontSize="16" />
                    </Grid>

                    <!-- Spinner de carga centrado en los resultados -->
                    <ProgressBar Grid.Row="2" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                 Value="0" IsIndeterminate="True" 
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" Panel.ZIndex="10" Margin="0,30,0,40"/>

                    <!-- Estado Vacío / Sin Resultados -->
                    <StackPanel Grid.Row="2" Visibility="{Binding BusquedaSinResultados, Converter={StaticResource BoolToVis}}" 
                                VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,40">
                        <materialDesign:PackIcon Kind="MagnifyClose" Width="64" Height="64" Foreground="#757575" HorizontalAlignment="Center"/>
                        <TextBlock Text="No se encontraron resultados" FontSize="18" Foreground="#757575" FontWeight="Medium" Margin="0,10,0,0"/>
                        <TextBlock Text="Intenta usar el título en Romaji o inglés" FontSize="14" Foreground="#757575" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Lista de Resultados -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding ResultadosBusqueda}" Margin="10,0,10,0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="15" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" 
                                                      Command="{Binding DataContext.SeleccionarYCrearAnimeCommand, RelativeSource={RelativeSource AncestorType=materialDesign:DialogHost}}" 
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Mini portada -->
                                        <Border Grid.Column="0" Width="55" Height="80" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left">
                                            <Grid>
                                                <Border Style="{StaticResource ShimmerEffectStyle}" />
                                                <Image Source="{Binding CoverImage.ExtraLarge, IsAsync=True, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title.Romaji}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                                            
                                            <!-- Sub-info: Año, Episodios, Estado -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <!-- Etiqueta de Estado -->
                                                <Border Background="{Binding StatusColorBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding FormattedStatus}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                
                                                <materialDesign:PackIcon Kind="CalendarBlank" Width="14" Height="14" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding FormattedYear}" FontSize="12" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                
                                                <materialDesign:PackIcon Kind="FormatListNumbered" Width="14" Height="14" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding FormattedEpisodes}" FontSize="12" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <!-- Géneros -->
                                            <TextBlock Text="{Binding FormattedGenres}" FontSize="12" Foreground="#757575" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </materialDesign:DialogHost.DialogContent>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="Transparent" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0" Panel.ZIndex="10">
                    <Grid>
                        <!-- BOTONES SUPERIORES -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0,60,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Margin" Value="0,30,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- BOTÓN BIBLIOTECA (GALERÍA) -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#82B1FF" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding EsGaleriaActiva, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarGaleriaCommand}" Width="45" Height="45" ToolTip="Biblioteca">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsGaleriaActiva}" Value="True">
                                                    <Setter Property="Background" Value="#1A82B1FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="ViewGallery" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#78909C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsGaleriaActiva}" Value="True">
                                                        <Setter Property="Foreground" Value="#82B1FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN CALENDARIO -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#82B1FF" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding EsCalendarioActivo, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarCalendarioCommand}" Width="45" Height="45" ToolTip="Calendario de Emisión">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsCalendarioActivo}" Value="True">
                                                    <Setter Property="Background" Value="#1A82B1FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="CalendarClock" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#78909C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsCalendarioActivo}" Value="True">
                                                        <Setter Property="Foreground" Value="#82B1FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN COLA DE DESCARGAS -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#82B1FF" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding EsDescargasActivas, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarDescargasCommand}" Width="45" Height="45" ToolTip="Cola de Descargas">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsDescargasActivas}" Value="True">
                                                    <Setter Property="Background" Value="#1A82B1FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="DownloadMultiple" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#78909C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsDescargasActivas}" Value="True">
                                                        <Setter Property="Foreground" Value="#82B1FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>

                                <!-- BADGE CONTEO DE DESCARGAS -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Background="#1565C0" BorderBrush="#0D47A1" BorderThickness="1" 
                                        CornerRadius="9" MinWidth="18" Height="18" Padding="4,0" Margin="0,-2,-2,0" 
                                        IsHitTestVisible="False"
                                        Visibility="{Binding TieneDescargasActivas, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ConteoDescargasActivas}" FontSize="10" FontWeight="Bold" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- BOTONES INFERIORES: CONFIGURACIÓN Y ACERCA DE -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15">
                            <!-- BOTÓN CONFIGURACIÓN -->
                            <Grid Margin="0,4">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#82B1FF" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding EsConfiguracionActiva, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarConfiguracionCommand}" Width="45" Height="45" ToolTip="Configuración">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsConfiguracionActiva}" Value="True">
                                                    <Setter Property="Background" Value="#1A82B1FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="Cog" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#78909C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsConfiguracionActiva}" Value="True">
                                                        <Setter Property="Foreground" Value="#82B1FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN ACERCA DE -->
                            <Grid Margin="0,4">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#82B1FF" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding EsAcercaDeActivo, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarAcercaDeCommand}" Width="45" Height="45" ToolTip="Acerca de AnimeLocalTracker">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsAcercaDeActivo}" Value="True">
                                                    <Setter Property="Background" Value="#1A82B1FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#78909C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsAcercaDeActivo}" Value="True">
                                                        <Setter Property="Foreground" Value="#82B1FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONTENIDO PRINCIPAL: Solo un ContentControl que se actualiza según la propiedad VistaActual -->
                <!-- Sin margen superior para que el fondo (ej. desenfoque) cubra toda la ventana detrás de la barra de título -->
                <ContentControl Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding VistaActual}" />
                
                <!-- BARRA DE TÍTULO CUSTOM -->
                <Grid Grid.Column="0" Grid.ColumnSpan="2" x:Name="BarraTitulo" Height="45" Background="Transparent" VerticalAlignment="Top" Panel.ZIndex="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                        <materialDesign:PackIcon Kind="PlayCircle" Foreground="#3F51B5" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="AnimeTracker" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" FontSize="14"/>
                        <Button Command="{Binding BuscarActualizacionesManualCommand}" 
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Comprobar actualizaciones en GitHub"
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Padding="8,2" Height="22" Margin="12,0,0,0"
                                Background="#2A3B5C" Foreground="#90CAF9" 
                                materialDesign:ButtonAssist.CornerRadius="11">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding VersionAppTexto}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnPantallaCompleta_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}" ToolTip="Pantalla Completa (F11)">
                            <materialDesign:PackIcon Kind="Fullscreen" />
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMinimizar_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}">
                            <materialDesign:PackIcon Kind="WindowMinimize" />
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMaximizar_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}" IsEnabled="False">
                            <materialDesign:PackIcon Kind="WindowMaximize" />
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnCerrar_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}">
                            <materialDesign:PackIcon Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- DIÁLOGO CUSTOM PARA TODA LA APP -->
                <Grid Visibility="{Binding DialogoVisible, Converter={StaticResource BoolToVis}}" 
                      Grid.Column="0" Grid.ColumnSpan="2"
                      Background="#B2000000" Panel.ZIndex="2000">
                    <materialDesign:Card Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                         UniformCornerRadius="14" Background="{DynamicResource MaterialDesignPaper}" 
                                         materialDesign:ElevationAssist.Elevation="Dp8" Padding="25">
                        <StackPanel>
                            <!-- Header con Ícono y Título -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <materialDesign:PackIcon Kind="{Binding DialogoIcono}" Width="28" Height="28" Foreground="{Binding DialogoColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding DialogoTitulo}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Mensaje -->
                            <TextBlock Text="{Binding DialogoMensaje}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,25" Opacity="0.8" LineHeight="20"/>

                            <!-- Botones -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="CANCELAR" Command="{Binding CancelarDialogoCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"
                                        Visibility="{Binding DialogoEsConfirmacion, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="ACEPTAR" Command="{Binding AceptarDialogoCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="{Binding DialogoColor}" BorderBrush="{Binding DialogoColor}" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- TOAST NOTIFICATION (Residual) -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Panel.ZIndex="3000" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,-100"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,0,0,-100" To="0,0,0,30" Duration="0:0:0.3">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3"/>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,0,0,30" To="0,0,0,-100" Duration="0:0:0.3">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <materialDesign:Card UniformCornerRadius="10" Background="#1E1E1E" Padding="20,15" materialDesign:ElevationAssist.Elevation="Dp8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding ToastIcono}" Foreground="{Binding ToastColor}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ToastTitulo}" FontWeight="Bold" FontSize="15" Foreground="White"/>
                                <TextBlock Text="{Binding ToastMensaje}" TextWrapping="Wrap" MaxWidth="450" Foreground="#CCCCCC" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Border>
            </Grid>
        </materialDesign:DialogHost>

    </Grid>
</Window>