<Window x:Class="AnimeLocalTracker.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
        Title="{Binding [Win_Titulo], Source={x:Static loc:LocalizationService.Instance}}"
        Icon="/Resources/app.ico"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="#121212"
        WindowStyle="None"
        MinWidth="800" MinHeight="600"
        ResizeMode="NoResize"
        WindowState="Maximized"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" />
    </Window.Resources>
    
    <Grid x:Name="RootLayout">
        <!-- Sin materialDesign:DialogHost: el diálogo modal real de la app es el custom de más abajo
             (DialogService.DialogoVisible); este DialogHost era código muerto (IsDialogOpen nunca se
             pone en true) y su capa de cobertura interceptaba clics de forma intermitente en toda la
             ventana, incluidos los combobox (bug de "solo una franja del combobox responde"). -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="Transparent" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0" Panel.ZIndex="10">
                    <!-- Antes el separador y el grupo inferior (Configuración/Acerca de) se posicionaban
                         con un margen fijo "190px desde abajo" sobre un Grid sin filas: al crecer el
                         grupo superior (ahora 8 pestañas) empezaba a invadir esa zona en cualquier
                         ventana más baja que ~740px de alto (pantallas 1366x768 con barra de tareas,
                         portátiles pequeños, etc.). Con filas de Grid el grupo inferior queda SIEMPRE
                         pegado abajo sin superponerse, y si el grupo superior no cabe, se desplaza con
                         scroll en vez de solaparse. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- BOTONES SUPERIORES (con scroll interno si la ventana no tiene alto suficiente) -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0,60,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Margin" Value="0,30,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- BOTÓN BIBLIOTECA (GALERÍA) -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#60A5FA" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding Navigation.EsGaleriaActiva, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarGaleriaCommand}" Width="45" Height="45" materialDesign:ButtonAssist.CornerRadius="12" ToolTip="{Binding [Nav_Galeria], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Nav_Galeria], Source={x:Static loc:LocalizationService.Instance}}" TabIndex="1">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1B222C"/>
                                            </Trigger>
                                                <DataTrigger Binding="{Binding Navigation.EsGaleriaActiva}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="ViewGallery" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Navigation.EsGaleriaActiva}" Value="True">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN HISTORIAL -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#60A5FA" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding Navigation.EsHistorialActivo, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarHistorialCommand}" Width="45" Height="45" materialDesign:ButtonAssist.CornerRadius="12" ToolTip="{Binding [Nav_Historial], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Nav_Historial], Source={x:Static loc:LocalizationService.Instance}}" TabIndex="2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1B222C"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Navigation.EsHistorialActivo}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="History" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Navigation.EsHistorialActivo}" Value="True">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN ACTUALIZACIONES (EPISODIOS NUEVOS) -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#60A5FA" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding Navigation.EsActualizacionesActivo, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarActualizacionesCommand}" Width="45" Height="45" materialDesign:ButtonAssist.CornerRadius="12" ToolTip="{Binding [Nav_Actualizaciones], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Nav_Actualizaciones], Source={x:Static loc:LocalizationService.Instance}}" TabIndex="3">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1B222C"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Navigation.EsActualizacionesActivo}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="NewReleases" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Navigation.EsActualizacionesActivo}" Value="True">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN AÑADIR ANIME / EXPLORAR -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#60A5FA" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding Navigation.EsAgregarAnimeActivo, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarAgregarAnimeCommand}" Width="45" Height="45" materialDesign:ButtonAssist.CornerRadius="12" ToolTip="{Binding [Nav_Agregar], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Nav_Agregar], Source={x:Static loc:LocalizationService.Instance}}" TabIndex="4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1B222C"/>
                                            </Trigger>
                                                <DataTrigger Binding="{Binding Navigation.EsAgregarAnimeActivo}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="MagnifyPlus" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Navigation.EsAgregarAnimeActivo}" Value="True">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN CALENDARIO -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#60A5FA" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding Navigation.EsCalendarioActivo, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarCalendarioCommand}" Width="45" Height="45" materialDesign:ButtonAssist.CornerRadius="12" ToolTip="{Binding [Nav_Calendario], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Nav_Calendario], Source={x:Static loc:LocalizationService.Instance}}" TabIndex="5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1B222C"/>
                                            </Trigger>
                                                <DataTrigger Binding="{Binding Navigation.EsCalendarioActivo}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="CalendarClock" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Navigation.EsCalendarioActivo}" Value="True">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN ESTADÍSTICAS -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#60A5FA" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding Navigation.EsEstadisticasActivo, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarEstadisticasCommand}" Width="45" Height="45" materialDesign:ButtonAssist.CornerRadius="12" ToolTip="{Binding [Nav_Estadisticas], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Nav_Estadisticas], Source={x:Static loc:LocalizationService.Instance}}" TabIndex="6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1B222C"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Navigation.EsEstadisticasActivo}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="ChartBar" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Navigation.EsEstadisticasActivo}" Value="True">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN LOGROS -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#60A5FA" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding Navigation.EsLogrosActivo, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarLogrosCommand}" Width="45" Height="45" materialDesign:ButtonAssist.CornerRadius="12" ToolTip="{Binding [Nav_Logros], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Nav_Logros], Source={x:Static loc:LocalizationService.Instance}}" TabIndex="7">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1B222C"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Navigation.EsLogrosActivo}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="TrophyOutline" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Navigation.EsLogrosActivo}" Value="True">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN COLA DE DESCARGAS -->
                            <Grid Margin="0,8">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#60A5FA" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding Navigation.EsDescargasActivas, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarDescargasCommand}" Width="45" Height="45" materialDesign:ButtonAssist.CornerRadius="12" ToolTip="{Binding [Nav_Descargas], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Nav_Descargas], Source={x:Static loc:LocalizationService.Instance}}" TabIndex="8">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1B222C"/>
                                            </Trigger>
                                                <DataTrigger Binding="{Binding Navigation.EsDescargasActivas}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="DownloadMultiple" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Navigation.EsDescargasActivas}" Value="True">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>

                                <!-- BADGE CONTEO DE DESCARGAS -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Background="#3B82F6" BorderBrush="#1E293B" BorderThickness="1" 
                                        CornerRadius="9" MinWidth="18" Height="18" Padding="4,0" Margin="0,-2,-2,0" 
                                        IsHitTestVisible="False"
                                        Visibility="{Binding TieneDescargasActivas, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ConteoDescargasActivas}" FontSize="10" FontWeight="Bold" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>

                        <!-- SEPARADOR DE GRUPO -->
                        <Border Grid.Row="1" HorizontalAlignment="Center" Width="28" Height="1"
                                Background="#262D38" Margin="0,8" IsHitTestVisible="False"/>

                        <!-- BOTONES INFERIORES: CONFIGURACIÓN Y ACERCA DE -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <!-- BOTÓN CONFIGURACIÓN -->
                            <Grid Margin="0,4">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#60A5FA" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding Navigation.EsConfiguracionActiva, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarConfiguracionCommand}" Width="45" Height="45" materialDesign:ButtonAssist.CornerRadius="12" ToolTip="{Binding [Nav_Configuracion], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Nav_Configuracion], Source={x:Static loc:LocalizationService.Instance}}" TabIndex="9">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1B222C"/>
                                            </Trigger>
                                                <DataTrigger Binding="{Binding Navigation.EsConfiguracionActiva}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="Cog" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Navigation.EsConfiguracionActiva}" Value="True">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- BOTÓN ACERCA DE -->
                            <Grid Margin="0,4">
                                <Rectangle Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="#60A5FA" HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Visibility="{Binding Navigation.EsAcercaDeActivo, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding NavegarAcercaDeCommand}" Width="45" Height="45" materialDesign:ButtonAssist.CornerRadius="12" ToolTip="{Binding [Nav_AcercaDe], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Nav_AcercaDe], Source={x:Static loc:LocalizationService.Instance}}" TabIndex="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1B222C"/>
                                            </Trigger>
                                                <DataTrigger Binding="{Binding Navigation.EsAcercaDeActivo}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="24" Height="24">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Navigation.EsAcercaDeActivo}" Value="True">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONTENIDO PRINCIPAL: la vista se resuelve con las DataTemplates
                     VM→Vista de App.xaml según la VistaActual (ARC-04). -->
                <!-- Sin margen superior para que el fondo (ej. desenfoque) cubra toda la ventana detrás de la barra de título -->
                <ContentControl x:Name="ContenedorVistaPrincipal" Grid.Column="0" Grid.ColumnSpan="2"
                                Content="{Binding Navigation.VistaActual}" />

                <!-- REPRODUCTOR IN-APP (EMBEBIDO DENTRO DE LA APLICACIÓN) -->
                <!-- Ocupa toda la ventana en formato habitual. En formato mini el video pasa a su propia ventana flotante
                     (MiniReproductorWindow) y aquí no se dibuja nada: la app queda libre para navegar. -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="50" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!-- Visible cuando hay un ReproductorActivo -->
                                <DataTrigger Binding="{Binding Navigation.ReproductorEnVentanaPrincipal, Converter={StaticResource NullToCollapsed}}" Value="Visible">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="CornerRadius" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Black" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <ContentControl Content="{Binding Navigation.ReproductorEnVentanaPrincipal}" />
                </Border>


                
                <!-- BARRA DE TÍTULO CUSTOM -->
                <Grid Grid.Column="0" Grid.ColumnSpan="2" x:Name="BarraTitulo" Height="45" Background="Transparent" VerticalAlignment="Top" Panel.ZIndex="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                        <materialDesign:PackIcon Kind="PlayCircle" Foreground="#3B82F6" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="AnimeTracker" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" FontSize="14"/>
                        <Button Command="{Binding BuscarActualizacionesManualCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{Binding [Nav_ComprobarUpdates], Source={x:Static loc:LocalizationService.Instance}}"
                                AutomationProperties.Name="{Binding [Nav_ComprobarUpdates], Source={x:Static loc:LocalizationService.Instance}}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Padding="8,2" Height="22" Margin="12,0,0,0"
                                Background="#1E293B" Foreground="#93C5FD"
                                materialDesign:ButtonAssist.CornerRadius="11">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding VersionAppTexto}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Estado de conexión: sin internet (la app sigue con lo guardado) o cambios esperando a subirse a AniList.
                             Un solo distintivo aquí en vez de avisos en cada pestaña; el detalle, en el tooltip. -->
                        <Border WindowChrome.IsHitTestVisibleInChrome="True" Height="22" CornerRadius="11" Padding="8,0" Margin="8,0,0,0"
                                Background="#1E293B" VerticalAlignment="Center"
                                Visibility="{Binding IndicadorConexionVisible, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding TextoEstadoConexion}" AutomationProperties.Name="{Binding TextoEstadoConexion}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="WifiOff" Width="13" Height="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"
                                                         Visibility="{Binding SinConexion, Converter={StaticResource BoolToVis}}"/>
                                <materialDesign:PackIcon Kind="CloudUploadOutline" Width="13" Height="13" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,4,0"
                                                         Visibility="{Binding SinConexion, Converter={StaticResource InverseBoolToVis}}"/>
                                <TextBlock Text="{Binding TextoBadgeConexion}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnPantallaCompleta_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}" ToolTip="{Binding [Nav_PantallaCompleta], Source={x:Static loc:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Win_BtnPantallaCompleta], Source={x:Static loc:LocalizationService.Instance}}">
                            <materialDesign:PackIcon Kind="Fullscreen" />
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMinimizar_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}" AutomationProperties.Name="{Binding [Win_BtnMinimizar], Source={x:Static loc:LocalizationService.Instance}}">
                            <materialDesign:PackIcon Kind="WindowMinimize" />
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMaximizar_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}" IsEnabled="False" AutomationProperties.Name="{Binding [Win_BtnMaximizar], Source={x:Static loc:LocalizationService.Instance}}">
                            <materialDesign:PackIcon Kind="WindowMaximize" />
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnCerrar_Click" Width="45" Height="45" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}" AutomationProperties.Name="{Binding [Win_BtnCerrarApp], Source={x:Static loc:LocalizationService.Instance}}">
                            <materialDesign:PackIcon Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════════════════════════════
                     DIÁLOGO DE CONFIRMACIÓN / AVISO PARA TODA LA APP
                     Misma piel que las tarjetas de la app (Surface1 + borde sutil), insignia circular con el
                     icono en el tono semántico (DialogoTonoConverter) y pie con los botones. Los tonos salen
                     del color que pide cada llamador, así todos los avisos combinan sin tocar a cada uno.
                     ══════════════════════════════════════════════════════════════════════════════════ -->
                <Grid Visibility="{Binding DialogService.DialogoVisible, Converter={StaticResource BoolToVis}}"
                      Grid.Column="0" Grid.ColumnSpan="2"
                      Style="{StaticResource AppOverlayScrim}" Panel.ZIndex="2000">
                    <Border Style="{StaticResource AppDialogCard}" Width="440"
                            KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                            AutomationProperties.Name="{Binding DialogService.DialogoTitulo}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Cuerpo: insignia con el icono + título + mensaje -->
                            <Grid Margin="26,26,26,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="14" VerticalAlignment="Top" Margin="0,0,18,0"
                                        Background="{Binding DialogService.DialogoColor, Converter={StaticResource DialogoTono}, ConverterParameter=Fondo}">
                                    <materialDesign:PackIcon Kind="{Binding DialogService.DialogoIcono}" Width="26" Height="26"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{Binding DialogService.DialogoColor, Converter={StaticResource DialogoTono}, ConverterParameter=Icono}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DialogService.DialogoTitulo}" Style="{StaticResource AppText.Section}" FontSize="18" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DialogService.DialogoMensaje}" Style="{StaticResource AppText.Secondary}"
                                               FontSize="13.5" LineHeight="21" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Pie: botones -->
                            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="20,14">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnDialogoCancelar" Style="{StaticResource AppDialogGhostButton}" Margin="0,0,10,0"
                                            Content="{Binding [Dlg_Cancelar], Source={x:Static loc:LocalizationService.Instance}}"
                                            Command="{Binding DialogService.CancelarDialogoCommand}"
                                            Visibility="{Binding DialogService.DialogoEsConfirmacion, Converter={StaticResource BoolToVis}}"/>
                                    <Button x:Name="BtnDialogoAceptar" Style="{StaticResource AppDialogPrimaryButton}"
                                            Content="{Binding [Dlg_Aceptar], Source={x:Static loc:LocalizationService.Instance}}"
                                            Command="{Binding DialogService.AceptarDialogoCommand}"
                                            Background="{Binding DialogService.DialogoColor, Converter={StaticResource DialogoTono}, ConverterParameter=Relleno}"
                                            BorderBrush="{Binding DialogService.DialogoColor, Converter={StaticResource DialogoTono}, ConverterParameter=Relleno}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════════════════════════════
                     SELECTOR DE TORRENT MANUAL (Fase 2d): elegir entre varios candidatos de Nyaa.si
                     Misma piel que el diálogo. Cada candidato es una tarjeta con el título completo y, debajo,
                     chips con lo que decide la elección: semillas, tamaño, resolución, grupo y "temporada completa".
                     ══════════════════════════════════════════════════════════════════════════════════ -->
                <Grid Visibility="{Binding SelectorTorrentService.SelectorVisible, Converter={StaticResource BoolToVis}}"
                      Grid.Column="0" Grid.ColumnSpan="2"
                      Style="{StaticResource AppOverlayScrim}" Panel.ZIndex="2001">
                    <Border Style="{StaticResource AppDialogCard}" Width="600" MaxHeight="660"
                            KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                            AutomationProperties.Name="{Binding [Sel_Titulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Cabecera -->
                            <Grid Margin="26,24,26,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="14" VerticalAlignment="Center" Margin="0,0,16,0"
                                        Background="{DynamicResource Brush.AccentTint}">
                                    <materialDesign:PackIcon Kind="Magnet" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Brush.Accent}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Sel_Titulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                               Style="{StaticResource AppText.Section}" FontSize="18"/>
                                    <TextBlock Text="{Binding SelectorTorrentService.TituloEpisodio}" Style="{StaticResource AppText.Secondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource AppBadge}" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectorTorrentService.Candidatos.Count, Mode=OneWay}"
                                                   Foreground="{DynamicResource Brush.AccentSoft}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [Sel_Resultados], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Lista de candidatos -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Background="{DynamicResource Brush.Surface1}">
                                <ListBox ItemsSource="{Binding SelectorTorrentService.Candidatos}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False" BorderThickness="0" Background="Transparent" Padding="18,14,18,6"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,10"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource AppTorrentCandidateButton}"
                                                    Command="{Binding DataContext.SelectorTorrentService.SeleccionarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Titulo}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" LineHeight="18"
                                                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                        <WrapPanel Margin="0,9,0,0">
                                                            <!-- Semillas -->
                                                            <Border Style="{StaticResource AppChip}" Background="{DynamicResource Brush.SuccessTint}"
                                                                    ToolTip="{Binding [Sel_SemillasTip], Source={x:Static loc:LocalizationService.Instance}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="ArrowUpBold" Width="13" Height="13" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Seeders}" FontSize="12" FontWeight="Bold" Margin="3,0,0,0" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource Brush.Success}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <!-- Tamaño -->
                                                            <Border Style="{StaticResource AppChip}" Background="{DynamicResource Brush.Surface3}"
                                                                    ToolTip="{Binding [Sel_TamanoTip], Source={x:Static loc:LocalizationService.Instance}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="Harddisk" Width="13" Height="13" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding TamanoTexto}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <!-- Resolución (si el título la anuncia) -->
                                                            <Border Style="{StaticResource AppChip}" Background="{DynamicResource Brush.AccentTint}"
                                                                    Visibility="{Binding TieneResolucion, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding Resolucion}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentSoft}"/>
                                                            </Border>
                                                            <!-- Grupo de fansub -->
                                                            <Border Style="{StaticResource AppChip}" Background="{DynamicResource Brush.Surface3}"
                                                                    Visibility="{Binding TieneGrupo, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="13" Height="13" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Grupo}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <!-- Temporada completa -->
                                                            <Border Style="{StaticResource AppChip}" Background="{DynamicResource Brush.WarningTint}"
                                                                    Visibility="{Binding EsBatch, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding [Sel_Batch], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Warning}"/>
                                                            </Border>
                                                            <!-- Nombre del release que no coincide con el anime/temporada: el usuario decide -->
                                                            <Border Style="{StaticResource AppChip}" Background="{DynamicResource Brush.WarningTint}"
                                                                    Visibility="{Binding Dudoso, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="{Binding [Sel_DudosoTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="13" Height="13" Margin="0,0,4,0"
                                                                                             VerticalAlignment="Center" Foreground="{DynamicResource Brush.Warning}"/>
                                                                    <TextBlock Text="{Binding [Sel_Dudoso], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Warning}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <materialDesign:PackIcon Grid.Column="1" Kind="ChevronRight" Width="22" Height="22" Margin="12,0,0,0"
                                                                             VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Pie -->
                            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}" CornerRadius="0,0,16,16" Padding="26,14,20,14">
                                <Grid>
                                    <TextBlock Text="{Binding [Sel_Pista], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                               Style="{StaticResource AppText.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,130,0"/>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource AppDialogGhostButton}"
                                            Content="{Binding [Dlg_Cancelar], Source={x:Static loc:LocalizationService.Instance}}"
                                            Command="{Binding SelectorTorrentService.CancelarSelectorCommand}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- MÚSICA DE FONDO: el opening/ending que sigue sonando tras salir de su ficha (solo si el usuario lo activó).
                     Por debajo del reproductor de video (ZIndex 50): al abrir un episodio la música se corta. -->
                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,16" Panel.ZIndex="15"
                        Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                        CornerRadius="12" Padding="10,6,6,6" MaxWidth="430"
                        Visibility="{Binding MusicaDeFondo.HayMusica, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="MusicNote" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- El título vuelve a la ficha del anime, con su ventana de música abierta -->
                        <Button Grid.Column="1" Command="{Binding MusicaDeFondo.IrALaFichaCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Left" Padding="0" FocusVisualStyle="{x:Null}" MaxWidth="230"
                                ToolTip="{Binding [Mus_FondoVolver], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                AutomationProperties.Name="{Binding [Mus_FondoVolver], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent"><ContentPresenter/></Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding MusicaDeFondo.Activa.TemaActual.EtiquetaSlug, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentSoft}"/>
                                    <Run Text="{Binding MusicaDeFondo.Activa.TemaActual.TituloVisible, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding MusicaDeFondo.TituloAnime}" FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button Command="{Binding MusicaDeFondo.Activa.TemaAnteriorCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="30" Height="30" Padding="0" Cursor="Hand"
                                    ToolTip="{Binding [Det_MusicaAnterior], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                    AutomationProperties.Name="{Binding [Det_MusicaAnterior], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                <materialDesign:PackIcon Kind="SkipPrevious" Width="19" Height="19" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </Button>
                            <Button Command="{Binding MusicaDeFondo.Activa.AlternarTemaActualCommand}" Width="32" Height="32" Padding="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                        <Setter Property="ToolTip" Value="{Binding [Det_MusicaReproducir], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                        <Setter Property="AutomationProperties.Name" Value="{Binding [Det_MusicaReproducir], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MusicaDeFondo.Activa.MusicaSonando}" Value="True">
                                                <Setter Property="ToolTip" Value="{Binding [Det_MusicaPausar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                                <Setter Property="AutomationProperties.Name" Value="{Binding [Det_MusicaPausar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Width="24" Height="24" Foreground="{DynamicResource Brush.Accent}">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="PlayCircle"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicaDeFondo.Activa.MusicaSonando}" Value="True">
                                                    <Setter Property="Kind" Value="PauseCircle"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                            <Button Command="{Binding MusicaDeFondo.Activa.TemaSiguienteCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="30" Height="30" Padding="0" Cursor="Hand"
                                    ToolTip="{Binding [Det_MusicaSiguiente], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                    AutomationProperties.Name="{Binding [Det_MusicaSiguiente], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                <materialDesign:PackIcon Kind="SkipNext" Width="19" Height="19" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </Button>
                            <Button Command="{Binding MusicaDeFondo.DetenerMusicaCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="30" Height="30" Padding="0" Cursor="Hand" Margin="4,0,0,0"
                                    ToolTip="{Binding [Mus_FondoDetener], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                    AutomationProperties.Name="{Binding [Mus_FondoDetener], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                <materialDesign:PackIcon Kind="Close" Width="15" Height="15" Foreground="{DynamicResource Brush.TextTertiary}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TOAST NOTIFICATION (Residual) -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Panel.ZIndex="3000" IsHitTestVisible="False" AutomationProperties.LiveSetting="Assertive">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,-100"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DialogService.ToastVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,0,0,-100" To="0,0,0,30" Duration="0:0:0.3">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3"/>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,0,0,30" To="0,0,0,-100" Duration="0:0:0.3">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <materialDesign:Card UniformCornerRadius="10" Background="#161B22" Padding="20,15" materialDesign:ElevationAssist.Elevation="Dp8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding DialogService.ToastIcono}" Foreground="{Binding DialogService.ToastColor}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DialogService.ToastTitulo}" FontWeight="Bold" FontSize="15" Foreground="White"/>
                                <TextBlock Text="{Binding DialogService.ToastMensaje}" TextWrapping="Wrap" MaxWidth="450" Foreground="#CCCCCC" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Border>
        </Grid>

    </Grid>
</Window>
