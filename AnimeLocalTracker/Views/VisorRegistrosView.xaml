<UserControl x:Class="AnimeLocalTracker.Views.VisorRegistrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             xmlns:vm="clr-namespace:AnimeLocalTracker.ViewModels"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent"
             IsVisibleChanged="Vista_IsVisibleChanged" Unloaded="Vista_Unloaded">

    <UserControl.Resources>
        <!-- Chip de nivel (activable): activo = borde y texto del color del nivel (Tag) -->
        <Style x:Key="RegChipNivel" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Raiz" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="16" Padding="12,5" Margin="0,0,8,0">
                            <ContentPresenter x:Name="Texto" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource Brush.TextSecondary}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Raiz" Property="Background" Value="#1B222C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Raiz" Property="Background" Value="{StaticResource Brush.Surface3}"/>
                                <Setter TargetName="Raiz" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Texto" Property="TextElement.Foreground" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Acción rápida con aspecto de chip (Solo avisos y errores / Limpiar filtros) -->
        <Style x:Key="RegChipAccion" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Raiz" Background="Transparent" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="16" Padding="12,5" Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource Brush.AccentSoft}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Raiz" Property="Background" Value="#1B222C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1400">
        <Grid.Style>
            <StaticResource ResourceKey="AppPageMargen"/>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ FILA 0: ENCABEZADO ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding VolverCommand}" Style="{StaticResource MaterialDesignIconButton}"
                    Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand"
                    ToolTip="{loc:T Reg_Volver}"
                    AutomationProperties.Name="{loc:T Reg_Volver}">
                <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22" Foreground="{StaticResource Brush.TextPrimary}"/>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource Brush.Surface3}" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="TextBoxSearchOutline" Foreground="{StaticResource Brush.Accent}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Reg_Titulo}" Style="{StaticResource AppText.PageTitle}"/>
                    <TextBlock Text="{loc:T Reg_Subtitulo}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ActualizarCommand}" Style="{StaticResource AppOutlinedButton}" Height="36" Padding="12,0" Margin="0,0,8,0" Cursor="Hand"
                        ToolTip="{loc:T Reg_ActualizarTip}"
                        AutomationProperties.Name="{loc:T Reg_Actualizar}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:T Reg_Actualizar}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CopiarVisiblesCommand}" Style="{StaticResource AppOutlinedButton}" Height="36" Padding="12,0" Margin="0,0,8,0" Cursor="Hand"
                        ToolTip="{loc:T Reg_CopiarTip}"
                        AutomationProperties.Name="{loc:T Reg_Copiar}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:T Reg_Copiar}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AbrirCarpetaCommand}" Style="{StaticResource AppOutlinedButton}" Height="36" Padding="12,0" Cursor="Hand"
                        ToolTip="{loc:T Cfg_CarpetaRegistrosSub}"
                        AutomationProperties.Name="{loc:T Cfg_AbrirCarpetaRegistros}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:T Cfg_AbrirCarpetaRegistros}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ FILA 1: ARCHIVO + FUENTE + BÚSQUEDA ═══ -->
        <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,12">
            <ComboBox DockPanel.Dock="Left" Width="330" Height="38" Margin="0,0,10,0" VerticalAlignment="Center"
                      ItemsSource="{Binding Archivos}" SelectedItem="{Binding ArchivoSeleccionado}" DisplayMemberPath="Etiqueta"
                      materialDesign:HintAssist.Hint="{loc:T Reg_Archivo}"
                      ToolTip="{loc:T Reg_Archivo}"
                      AutomationProperties.Name="{loc:T Reg_Archivo}"/>
            <ComboBox DockPanel.Dock="Left" Width="230" Height="38" Margin="0,0,10,0" VerticalAlignment="Center"
                      ItemsSource="{Binding Fuentes}" SelectedItem="{Binding FuenteSeleccionada}"
                      ToolTip="{loc:T Reg_Fuente}"
                      AutomationProperties.Name="{loc:T Reg_Fuente}"/>
            <Border Height="38" VerticalAlignment="Center" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="19" Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Foreground="{StaticResource Brush.TextTertiary}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.TextPrimary}" FontSize="12.5"
                             VerticalAlignment="Center" CaretBrush="{StaticResource Brush.Accent}"
                             materialDesign:HintAssist.Hint="{loc:T Reg_Buscar}"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             AutomationProperties.Name="{loc:T Reg_Buscar}"/>
                    <Button Grid.Column="2" Command="{Binding LimpiarFiltrosCommand}" Style="{StaticResource MaterialDesignIconButton}"
                            Width="22" Height="22" Padding="0" Cursor="Hand"
                            Visibility="{Binding TieneBusqueda, Converter={StaticResource BoolToVis}}"
                            ToolTip="{loc:T Reg_LimpiarFiltros}"
                            AutomationProperties.Name="{loc:T Reg_LimpiarFiltros}">
                        <materialDesign:PackIcon Kind="CloseCircle" Foreground="{StaticResource Brush.TextSecondary}" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ═══ FILA 2: NIVELES + ACCIONES RÁPIDAS + RESUMEN ═══ -->
        <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <!-- Indicador de sesión en vivo -->
                <Border Background="#123A2E" CornerRadius="10" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center"
                        Visibility="{Binding EsSesionActual, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:T Reg_EnVivoTip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:T Reg_EnVivo}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding TextoResumen}" FontSize="12" Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"/>
            </StackPanel>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton IsChecked="{Binding MostrarErrores}" Style="{StaticResource RegChipNivel}" Tag="{DynamicResource Brush.Danger}"
                              AutomationProperties.Name="{loc:T Reg_Errores}">
                    <TextBlock><Run Text="{Binding NumErrores, Mode=OneWay}"/><Run Text=" "/><Run Text="{loc:T Reg_Errores}"/></TextBlock>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding MostrarAvisos}" Style="{StaticResource RegChipNivel}" Tag="{DynamicResource Brush.Warning}"
                              AutomationProperties.Name="{loc:T Reg_Avisos}">
                    <TextBlock><Run Text="{Binding NumAvisos, Mode=OneWay}"/><Run Text=" "/><Run Text="{loc:T Reg_Avisos}"/></TextBlock>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding MostrarInfo}" Style="{StaticResource RegChipNivel}" Tag="{DynamicResource Brush.Accent}"
                              AutomationProperties.Name="{loc:T Reg_Info}">
                    <TextBlock><Run Text="{Binding NumInfo, Mode=OneWay}"/><Run Text=" "/><Run Text="{loc:T Reg_Info}"/></TextBlock>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding MostrarDebug}" Style="{StaticResource RegChipNivel}" Tag="{DynamicResource Brush.TextTertiary}"
                              ToolTip="{loc:T Reg_DepuracionTip}"
                              AutomationProperties.Name="{loc:T Reg_Depuracion}">
                    <TextBlock><Run Text="{Binding NumDebug, Mode=OneWay}"/><Run Text=" "/><Run Text="{loc:T Reg_Depuracion}"/></TextBlock>
                </ToggleButton>
                <Button Command="{Binding SoloProblemasCommand}" Style="{StaticResource RegChipAccion}"
                        Content="{loc:T Reg_SoloProblemas}"
                        AutomationProperties.Name="{loc:T Reg_SoloProblemas}"/>
                <Button Command="{Binding LimpiarFiltrosCommand}" Style="{StaticResource RegChipAccion}"
                        Content="{loc:T Reg_LimpiarFiltros}"
                        AutomationProperties.Name="{loc:T Reg_LimpiarFiltros}"/>
            </WrapPanel>
        </DockPanel>

        <!-- ═══ FILA 3: LISTA / CARGANDO / VACÍO ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="4,6">
            <Grid>
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="44" Height="44"
                             Value="0" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>

                <!-- Archivo vacío -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                            Visibility="{Binding ArchivoVacio, Converter={StaticResource BoolToVis}}">
                    <Border Background="{StaticResource Brush.Surface3}" CornerRadius="36" Width="72" Height="72" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="TextBoxOutline" Foreground="{StaticResource Brush.TextTertiary}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{loc:T Reg_VacioTitulo}" Style="{StaticResource AppEmptyTitle}"/>
                    <TextBlock Text="{loc:T Reg_VacioTexto}" Style="{StaticResource AppEmptyText}" Margin="0,6,0,0" MaxWidth="440"/>
                </StackPanel>

                <!-- Filtros sin resultados -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                            Visibility="{Binding SinResultados, Converter={StaticResource BoolToVis}}">
                    <materialDesign:PackIcon Kind="MagnifyClose" Foreground="{StaticResource Brush.TextTertiary}" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="{loc:T Reg_SinResultados}" Style="{StaticResource AppEmptyText}" FontSize="15" HorizontalAlignment="Center"/>
                    <Button Command="{Binding LimpiarFiltrosCommand}" Style="{StaticResource AppOutlinedButton}" Height="36" Padding="16,0" Margin="0,14,0,0" HorizontalAlignment="Center" Cursor="Hand"
                            Content="{loc:T Reg_LimpiarFiltros}"
                            AutomationProperties.Name="{loc:T Reg_LimpiarFiltros}"/>
                </StackPanel>

                <!-- Entradas (virtualizadas: una sesión puede tener decenas de miles) -->
                <ListBox ItemsSource="{Binding EntradasVisibles}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,6,0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         Visibility="{Binding TieneEntradas, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemContainerStyle>
                        <StaticResource ResourceKey="AppFilaTransparente"/>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EntradaRegistroItem}">
                            <Grid>
                                <!-- Cabecera de sesión: separador -->
                                <Border Visibility="{Binding EsCabecera, Converter={StaticResource BoolToVis}}"
                                        Background="{StaticResource Brush.Surface3}" CornerRadius="8" Padding="12,6" Margin="6,6,6,6">
                                    <TextBlock Text="{Binding Mensaje}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.AccentSoft}" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Entrada normal -->
                                <Border x:Name="Fila" Visibility="{Binding EsCabecera, Converter={StaticResource InverseBoolToVis}}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding HoraTexto}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Top" Margin="0,2,0,0"/>

                                        <!-- Nivel: fondo tenue + texto del color del nivel -->
                                        <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Border x:Name="FondoNivel" CornerRadius="6" Opacity="0.16" Background="{DynamicResource Brush.TextTertiary}"/>
                                            <TextBlock x:Name="TextoNivel" Text="{Binding Nivel}" FontSize="10.5" FontWeight="Bold" Margin="7,2" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                        </Grid>

                                        <TextBlock Grid.Column="2" Text="{Binding Fuente}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.AccentSoft}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Fuente}" VerticalAlignment="Top" Margin="6,2,10,0"/>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock x:Name="TextoMensaje" Text="{Binding Mensaje}" FontSize="12.5" Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap"/>
                                            <Button Command="{Binding DataContext.AlternarDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                    Background="Transparent" BorderThickness="0" Padding="0" Height="Auto" MinHeight="0"
                                                    Visibility="{Binding TieneDetalle, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="{loc:T Reg_Traza}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon x:Name="IconoTraza" Kind="ChevronRight" Width="14" Height="14" Foreground="{StaticResource Brush.AccentSoft}" VerticalAlignment="Center"/>
                                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.AccentSoft}" VerticalAlignment="Center" Margin="2,0,0,0">
                                                        <Run Text="{loc:T Reg_Traza}"/><Run Text=" ("/><Run Text="{Binding LineasDetalle, Mode=OneWay}"/><Run Text=")"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <!-- Traza: seleccionable para copiar un trozo -->
                                            <TextBox Text="{Binding Detalle, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                     FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Brush.TextPrimary}" Background="{StaticResource Brush.Surface3}"
                                                     BorderThickness="0" Padding="8,6" Margin="0,4,0,0"
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                     Visibility="{Binding Expandido, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <Button Grid.Column="4" Command="{Binding DataContext.CopiarEntradaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconButton}"
                                                Width="26" Height="26" Padding="0" Margin="6,0,0,0" VerticalAlignment="Top" Cursor="Hand"
                                                ToolTip="{loc:T Reg_CopiarEntrada}"
                                                AutomationProperties.Name="{loc:T Reg_CopiarEntrada}">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{StaticResource Brush.TextTertiary}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Nivel}" Value="ERROR">
                                    <Setter TargetName="FondoNivel" Property="Background" Value="{DynamicResource Brush.Danger}"/>
                                    <Setter TargetName="TextoNivel" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Nivel}" Value="WARN">
                                    <Setter TargetName="FondoNivel" Property="Background" Value="{DynamicResource Brush.Warning}"/>
                                    <Setter TargetName="TextoNivel" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Nivel}" Value="INFO">
                                    <Setter TargetName="FondoNivel" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                    <Setter TargetName="TextoNivel" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                </DataTrigger>
                                <!-- DEBUG escrita como contexto de un aviso/error: más tenue -->
                                <DataTrigger Binding="{Binding EsContexto}" Value="True">
                                    <Setter TargetName="TextoMensaje" Property="Foreground" Value="{StaticResource Brush.TextTertiary}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Expandido}" Value="True">
                                    <Setter TargetName="IconoTraza" Property="Kind" Value="ChevronDown"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
