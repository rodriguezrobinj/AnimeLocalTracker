<UserControl x:Class="AnimeLocalTracker.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:AnimeLocalTracker.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ConfiguracionViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1000"
             Background="#121212">
    
    <Grid ClipToBounds="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,55,30,20"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,25,30,20"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <!-- Fila 0: ENCABEZADO FIJO (No se desplaza) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: CONTENIDO DESPLAZABLE -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO FIJO DE LA VISTA -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E88E5" CornerRadius="12" Width="44" Height="44" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="Cog" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Configuración y Preferencias" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="Personaliza el almacenamiento de tus animes, reproducción y consulta información de la app" 
                               FontSize="13" Foreground="#9E9E9E" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- CONTENIDO DESPLAZABLE -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,32,20" HorizontalAlignment="Stretch">

                <!-- 1. SECCIÓN ALMACENAMIENTO Y BIBLIOTECA -->
                <materialDesign:Card Background="#1E1E1E" UniformCornerRadius="14" Margin="0,0,0,20" Padding="22" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="FolderMultiple" Foreground="#42A5F5" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Almacenamiento de Animes" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="Carpeta principal donde se crearán las carpetas de series y se escanearán los episodios descargados:" 
                                   FontSize="13" Foreground="#B0BEC5" Margin="0,0,0,12"/>

                        <!-- Selector de Ruta -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding RutaBaseAnimes, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Ruta de Almacenamiento"
                                     FontSize="13" Foreground="White" Background="#262626"
                                     materialDesign:TextFieldAssist.LeadingIcon="FolderOpen"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1" Command="{Binding SeleccionarCarpetaAnimesCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#1976D2" BorderBrush="#1565C0" Foreground="White"
                                    Height="40" Padding="14,0" Margin="0,0,8,0"
                                    ToolTip="Elegir una nueva carpeta">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderEditOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Cambiar Carpeta" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding AbrirCarpetaEnExploradorCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#78909C" Foreground="#ECEFF1"
                                    Height="40" Padding="14,0"
                                    ToolTip="Abrir en el Explorador de Windows">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Abrir en Explorador" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Estadísticas de la Carpeta -->
                        <Border Background="#262626" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="Harddisk" Foreground="#81C784" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding EspacioLibreTexto}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                    <materialDesign:PackIcon Kind="AnimationPlay" Foreground="#BA68C8" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TotalAnimesBiblioteca, StringFormat='Series en biblioteca: {0}'}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 2. SECCIÓN REPRODUCCIÓN Y PREFERENCIAS -->
                <materialDesign:Card Background="#1E1E1E" UniformCornerRadius="14" Margin="0,0,0,20" Padding="22" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="TuneVariant" Foreground="#AB47BC" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Reproducción y Descargas" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Auto-Play del siguiente episodio" FontWeight="Medium" Foreground="White" FontSize="14"/>
                                <TextBlock Text="Reproduce automáticamente el siguiente capítulo al finalizar el actual" FontSize="12" Foreground="#9E9E9E"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding AutoPlaySiguiente}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="#333333" Margin="0,4,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Subtítulos activados por defecto" FontWeight="Medium" Foreground="White" FontSize="14"/>
                                <TextBlock Text="Habilita automáticamente la primera pista de subtítulos al abrir un video" FontSize="12" Foreground="#9E9E9E"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding SubtitulosPorDefecto}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="#333333" Margin="0,4,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Descargas simultáneas" FontWeight="Medium" Foreground="White" FontSize="14"/>
                                <TextBlock Text="Cantidad máxima de descargas concurrentes en cola" FontSize="12" Foreground="#9E9E9E"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="100" SelectedValuePath="Content" SelectedValue="{Binding DescargasSimultaneas}" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Foreground="White" Background="#262626">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="5" />
                            </ComboBox>
                        </Grid>

                        <Button Command="{Binding GuardarPreferenciasCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#7B1FA2" BorderBrush="#8E24AA" Foreground="White"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Height="36" Padding="18,0"
                                HorizontalAlignment="Right" Margin="0,15,0,0"
                                ToolTip="Guardar cambios en las preferencias de reproducción y descargas">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheck" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Guardar Ajustes" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 3. SECCIÓN CUENTA Y SINCRONIZACIÓN -->
                <materialDesign:Card Background="#1E1E1E" UniformCornerRadius="14" Margin="0,0,0,20" Padding="22" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="AccountSync" Foreground="#26A69A" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Cuenta AniList y Sincronización" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding EstadoAutenticacionTexto}" FontWeight="Medium" Foreground="White" FontSize="14"/>
                                <TextBlock Text="Los episodios marcados como vistos se sincronizan automáticamente con tu perfil online de AniList" 
                                           FontSize="12" Foreground="#9E9E9E" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding CerrarSesionAniListCommand}"
                                    Visibility="{Binding EstaAutenticadoAniList, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#E57373" Foreground="#EF5350"
                                    Height="36" Padding="12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Logout" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Cerrar Sesión" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 4. SECCIÓN ACERCA DE LA APLICACIÓN -->
                <materialDesign:Card Background="#1E1E1E" UniformCornerRadius="14" Margin="0,0,0,20" Padding="22" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="InformationOutline" Foreground="#FFA726" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Acerca de AnimeLocalTracker" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Tarjeta de Identidad de la App -->
                        <Border Background="#262626" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#3F51B5" CornerRadius="12" Width="52" Height="52" Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="PlayCircle" Width="32" Height="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="AnimeLocalTracker" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                        <Border Background="#1E88E5" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VersionAppTexto}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Gestor y reproductor nativo multimedia para colecciones de anime locales con tracking automático" 
                                               FontSize="12" Foreground="#B0BEC5" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2" Command="{Binding BuscarActualizacionesCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#2E7D32" BorderBrush="#1B5E20" Foreground="White"
                                        Height="38" Padding="14,0" VerticalAlignment="Center"
                                        ToolTip="Comprobar si hay una nueva versión disponible y actualizar notas">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Update" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Buscar Actualizaciones" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Novedades de la Versión (Dinámicas desde GitHub con Caché Local) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="NewspaperVariantOutline" Foreground="#64B5F6" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TituloVersionTexto, StringFormat='Novedades: {0}'}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding FechaVersionTexto}" FontSize="12" Foreground="#90A4AE" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="#262626" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                            <StackPanel>
                                <ProgressBar IsIndeterminate="True" 
                                             Visibility="{Binding IsCargandoNovedades, Converter={StaticResource BoolToVis}}" 
                                             Height="3" VerticalAlignment="Top" Foreground="#42A5F5" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding NovedadesTexto}" 
                                           Foreground="#ECEFF1" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Repositorio GitHub y Licencias -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Proyecto de Código Abierto (Open Source)" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                <TextBlock Text="Desarrollado con .NET 8, WPF, Flyleaf, SQLite-net, MaterialDesign y Velopack" FontSize="11" Foreground="#9E9E9E" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding LicenciaTexto}" FontSize="11" Foreground="#78909C" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding AbrirRepositorioGitHubCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#90CAF9" Foreground="#90CAF9"
                                    Height="36" Padding="14,0" VerticalAlignment="Center"
                                    ToolTip="Visitar repositorio en GitHub">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Github" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Repositorio en GitHub" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
