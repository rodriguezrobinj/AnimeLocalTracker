<UserControl x:Class="AnimeLocalTracker.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             xmlns:ctl="clr-namespace:AnimeLocalTracker.Controls"
             xmlns:vm="clr-namespace:AnimeLocalTracker.ViewModels"
             xmlns:mdl="clr-namespace:AnimeLocalTracker.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- ══ Piezas compartidas de la pestaña: todas las categorías se construyen con estas
                 mismas piezas (fila de ajuste, grupo, botón, switch) para que se lean uniformes. ══ -->

        <!-- Fila de ajuste: título + descripción a la izquierda, el control (contenido) a la derecha -->
        <Style TargetType="ctl:SettingRow">
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ctl:SettingRow">
                        <Border Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource AppText.BodyStrong}" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="Descripcion" Text="{TemplateBinding Description}" Style="{StaticResource AppText.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Description" Value="">
                                <Setter TargetName="Descripcion" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de una lista que se ordena con flechas (sitios de video, servidores de descarga): puesto, nombre y flechas -->
        <DataTemplate x:Key="FilaOrdenTemplate">
            <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="8" Padding="12,3,6,3" Margin="0,0,0,6"
                    AutomationProperties.Name="{Binding Nombre}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Posicion}" Style="{StaticResource AppText.Caption}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Nombre}" Style="{StaticResource AppText.BodyStrong}" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Padding="0" Cursor="Hand"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Command="{Binding SubirCommand}" IsEnabled="{Binding PuedeSubir}"
                            ToolTip="{loc:T Cfg_OrdenServidores_Subir}"
                            AutomationProperties.Name="{loc:T Cfg_OrdenServidores_Subir}">
                        <materialDesign:PackIcon Kind="ChevronUp" Width="20" Height="20"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Padding="0" Cursor="Hand"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Command="{Binding BajarCommand}" IsEnabled="{Binding PuedeBajar}"
                            ToolTip="{loc:T Cfg_OrdenServidores_Bajar}"
                            AutomationProperties.Name="{loc:T Cfg_OrdenServidores_Bajar}">
                        <materialDesign:PackIcon Kind="ChevronDown" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Grupo: tarjeta que agrupa filas separadas por líneas finas -->
        <Style x:Key="CfgGroup" TargetType="Border" BasedOn="{StaticResource AppCard}">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="CfgDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Margin" Value="20,0"/>
        </Style>
        <Style x:Key="CfgGroupCaption" TargetType="TextBlock" BasedOn="{StaticResource AppText.Micro}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <!-- Cabecera de categoría (chip con icono + título + subtítulo) -->
        <Style x:Key="CfgChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CfgChipIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Botones de acción dentro de una fila -->
        <Style x:Key="CfgRowButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="124"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="CfgDangerButton" TargetType="Button" BasedOn="{StaticResource CfgRowButton}">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
        </Style>

        <!-- Switch en el azul de la app (el tema base de Material usa morado) -->
        <Style x:Key="CfgSwitch" TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="{DynamicResource Brush.AccentStrong}"/>
        </Style>

        <Style x:Key="CfgSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentStrong}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Botón de formato de texto (negrita / cursiva / subrayado): cuadrado, se ilumina en el azul de la app al activarse -->
        <Style x:Key="CfgFormatToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Marco" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.BorderStrong}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="{DynamicResource Brush.AccentStrong}"/>
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Brush.AccentStrong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Elemento de la paleta de colores de los subtítulos: muestra + nombre traducido -->
        <DataTemplate x:Key="CfgColorItemTemplate" DataType="{x:Type mdl:ColorEstiloOpcion}">
            <StackPanel Orientation="Horizontal">
                <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{Binding Hex}" BorderBrush="{DynamicResource Brush.TextTertiary}"/>
                <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- Botón de la barra de categorías -->
        <Style x:Key="CfgNavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                </Trigger>
                <!-- Categoría activa: Tag lleva el bool EsSeccionX de la categoría del botón -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentStrong}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CfgNavIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CfgNavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Punto de estado de la cuenta: verde conectado / gris desconectado -->
        <Style x:Key="CfgEstadoPunto" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.TextTertiary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaAutenticadoAniList}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1200" ClipToBounds="True" Style="{StaticResource AppPageRoot}">
        <Grid.RowDefinitions>
            <!-- Fila 0: ENCABEZADO FIJO -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: NAVEGACIÓN + CONTENIDO -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO FIJO DE LA VISTA -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,24">
            <Border Background="{DynamicResource Brush.Surface3}" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                <materialDesign:PackIcon Kind="Cog" Width="26" Height="26" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:T Cfg_Titulo}" Style="{StaticResource AppText.PageTitle}"/>
                <TextBlock Text="{loc:T Cfg_TituloSub}"
                           Style="{StaticResource AppText.Caption}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ CATEGORÍAS ═══ -->
            <Border Grid.Column="0" Style="{StaticResource AppCard}" CornerRadius="16" Padding="10" VerticalAlignment="Top">
                <StackPanel>
                    <Button Style="{StaticResource CfgNavButton}"
                            Command="{Binding SeleccionarSeccionCommand}" CommandParameter="{x:Static vm:SeccionConfiguracion.Biblioteca}"
                            Tag="{Binding EsSeccionBiblioteca}"
                            AutomationProperties.Name="{loc:T Cfg_CatBiblioteca}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderMultiple" Style="{StaticResource CfgNavIcon}"/>
                            <TextBlock Text="{loc:T Cfg_CatBiblioteca}" Style="{StaticResource CfgNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CfgNavButton}"
                            Command="{Binding SeleccionarSeccionCommand}" CommandParameter="{x:Static vm:SeccionConfiguracion.Reproduccion}"
                            Tag="{Binding EsSeccionReproduccion}"
                            AutomationProperties.Name="{loc:T Cfg_CatReproduccion}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Style="{StaticResource CfgNavIcon}"/>
                            <TextBlock Text="{loc:T Cfg_CatReproduccion}" Style="{StaticResource CfgNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CfgNavButton}"
                            Command="{Binding SeleccionarSeccionCommand}" CommandParameter="{x:Static vm:SeccionConfiguracion.Atajos}"
                            Tag="{Binding EsSeccionAtajos}"
                            AutomationProperties.Name="{loc:T Cfg_CatAtajos}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyboardOutline" Style="{StaticResource CfgNavIcon}"/>
                            <TextBlock Text="{loc:T Cfg_CatAtajos}" Style="{StaticResource CfgNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CfgNavButton}"
                            Command="{Binding SeleccionarSeccionCommand}" CommandParameter="{x:Static vm:SeccionConfiguracion.Descargas}"
                            Tag="{Binding EsSeccionDescargas}"
                            AutomationProperties.Name="{loc:T Cfg_CatDescargas}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudDownloadOutline" Style="{StaticResource CfgNavIcon}"/>
                            <TextBlock Text="{loc:T Cfg_CatDescargas}" Style="{StaticResource CfgNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CfgNavButton}"
                            Command="{Binding SeleccionarSeccionCommand}" CommandParameter="{x:Static vm:SeccionConfiguracion.General}"
                            Tag="{Binding EsSeccionGeneral}"
                            AutomationProperties.Name="{loc:T Cfg_CatGeneral}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TuneVariant" Style="{StaticResource CfgNavIcon}"/>
                            <TextBlock Text="{loc:T Cfg_CatGeneral}" Style="{StaticResource CfgNavText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CfgNavButton}" Margin="0"
                            Command="{Binding SeleccionarSeccionCommand}" CommandParameter="{x:Static vm:SeccionConfiguracion.Plugins}"
                            Tag="{Binding EsSeccionPlugins}"
                            AutomationProperties.Name="{loc:T Cfg_Plugins}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Puzzle" Style="{StaticResource CfgNavIcon}"/>
                            <TextBlock Text="{loc:T Cfg_Plugins}" Style="{StaticResource CfgNavText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ CONTENIDO DE LA CATEGORÍA ACTIVA ═══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <!-- ── 1. BIBLIOTECA Y DATOS ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding EsSeccionBiblioteca, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,20,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Style="{StaticResource CfgChip}"><materialDesign:PackIcon Kind="FolderMultiple" Style="{StaticResource CfgChipIcon}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Cfg_CatBiblioteca}" Style="{StaticResource AppText.Section}" FontSize="20"/>
                                    <TextBlock Text="{loc:T Cfg_CatBibliotecaSub}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{loc:T Cfg_GrupoCarpeta}" Style="{StaticResource CfgGroupCaption}"/>
                            <Border Style="{StaticResource CfgGroup}" Padding="20">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Text="{Binding RutaBaseAnimes, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="{loc:T Cfg_RutaHint}"
                                                 materialDesign:HintAssist.IsFloating="False"
                                                 FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="FolderOpen"
                                                 materialDesign:TextFieldAssist.LeadingIconSize="20"
                                                 VerticalContentAlignment="Center"
                                                 Height="42" Padding="10,6" Margin="0,0,10,0"/>

                                        <Button Grid.Column="1" Command="{Binding SeleccionarCarpetaAnimesCommand}"
                                                Style="{StaticResource AppPrimaryButton}"
                                                Height="42" Padding="16,0" Margin="0,0,8,0" Cursor="Hand"
                                                materialDesign:ButtonAssist.CornerRadius="8"
                                                ToolTip="{loc:T Cfg_CambiarCarpetaTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FolderEditOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{loc:T Cfg_CambiarCarpeta}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Command="{Binding AbrirCarpetaEnExploradorCommand}"
                                                Style="{StaticResource CfgRowButton}" Height="42" MinWidth="0" Padding="16,0"
                                                ToolTip="{loc:T Cfg_ExploradorTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="OpenInNew" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{loc:T Cfg_Explorador}" VerticalAlignment="Center" FontWeight="Medium" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16,10" MinHeight="56">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Harddisk" Foreground="{DynamicResource Brush.Success}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:T Cfg_EspacioDisco}" Style="{StaticResource AppText.Micro}"/>
                                                    <TextBlock Text="{Binding EspacioLibreTexto}" Style="{StaticResource AppText.BodyStrong}" FontSize="13" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16,10" MinHeight="56">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="AnimationPlay" Foreground="{DynamicResource Brush.AccentSoft}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:T Cfg_ColeccionTotal}" Style="{StaticResource AppText.Micro}"/>
                                                    <TextBlock Text="{Binding TotalAnimesTexto}" Style="{StaticResource AppText.BodyStrong}" FontSize="13" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:T Cfg_GrupoCopias}" Style="{StaticResource CfgGroupCaption}"/>
                            <Border Style="{StaticResource CfgGroup}">
                                <StackPanel>
                                    <ctl:SettingRow Title="{loc:T Cfg_LimpiarCache}"
                                                    Description="{loc:T Cfg_LimpiarCacheTip}">
                                        <Button Command="{Binding LimpiarCacheCommand}" Style="{StaticResource CfgRowButton}"
                                                AutomationProperties.Name="{loc:T Cfg_LimpiarCache}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Broom" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{loc:T Cfg_AccionLimpiar}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <!-- Openings/endings descargados antes: nombre legible, etiquetas y portada, sin volver a descargarlos -->
                                    <ctl:SettingRow Title="{loc:T Cfg_OrganizarMusica}"
                                                    Description="{loc:T Cfg_OrganizarMusicaTip}">
                                        <Button Command="{Binding OrganizarMusicaCommand}" Style="{StaticResource CfgRowButton}"
                                                AutomationProperties.Name="{loc:T Cfg_OrganizarMusica}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FolderMusicOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"
                                                                         Visibility="{Binding OrganizandoMusica, Converter={StaticResource InverseBoolToVis}}"/>
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="14" Height="14" Margin="0,0,7,0"
                                                             Visibility="{Binding OrganizandoMusica, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{loc:T Cfg_AccionOrganizar}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                                                           Visibility="{Binding OrganizandoMusica, Converter={StaticResource InverseBoolToVis}}"/>
                                                <TextBlock Text="{Binding ProgresoOrganizarMusicaTexto}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                                                           Visibility="{Binding OrganizandoMusica, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Button>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_RowBackup}"
                                                    Description="{loc:T Cfg_RowBackupSub}">
                                        <Button Command="{Binding ExportarBackupCommand}" Style="{StaticResource CfgRowButton}"
                                                ToolTip="{loc:T Cfg_ExportarBackup}"
                                                AutomationProperties.Name="{loc:T Cfg_ExportarBackup}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DatabaseExportOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{loc:T Cfg_AccionExportar}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_RestaurarBackup}"
                                                    Description="{loc:T Cfg_RowRestaurarSub}">
                                        <Button Command="{Binding RestaurarBackupCommand}" Style="{StaticResource CfgRowButton}"
                                                AutomationProperties.Name="{loc:T Cfg_RestaurarBackup}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DatabaseImportOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{loc:T Cfg_AccionRestaurar}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_ExportarBiblioteca}"
                                                    Description="{loc:T Cfg_ExportarBibliotecaSub}">
                                        <Button Command="{Binding ExportarBibliotecaCommand}" Style="{StaticResource CfgRowButton}"
                                                AutomationProperties.Name="{loc:T Cfg_ExportarBiblioteca}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Export" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{loc:T Cfg_AccionExportar}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_ImportarBiblioteca}"
                                                    Description="{loc:T Cfg_ImportarBibliotecaSub}">
                                        <Button Command="{Binding ImportarBibliotecaCommand}" Style="{StaticResource CfgRowButton}"
                                                AutomationProperties.Name="{loc:T Cfg_ImportarBiblioteca}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Import" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{loc:T Cfg_AccionImportar}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>

                            <!-- PRI-01: borrado total de los datos locales (doble confirmación) -->
                            <TextBlock Text="{loc:T Cfg_GrupoPeligro}" Style="{StaticResource CfgGroupCaption}"/>
                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <ctl:SettingRow Title="{loc:T Cfg_BorrarDatosTitulo}"
                                                Description="{loc:T Cfg_BorrarDatosSub}">
                                    <Button Command="{Binding BorrarTodosMisDatosCommand}" Style="{StaticResource CfgDangerButton}"
