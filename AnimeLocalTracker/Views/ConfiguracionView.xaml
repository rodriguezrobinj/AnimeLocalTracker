<UserControl x:Class="AnimeLocalTracker.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">


    
    <Grid ClipToBounds="True" MaxWidth="1200">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,65,30,25"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,35,30,25"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <!-- Fila 0: ENCABEZADO FIJO (No se desplaza) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: CONTENIDO DESPLAZABLE -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO FIJO DE LA VISTA -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="Cog" Width="26" Height="26" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Configuración y Preferencias" Style="{StaticResource AppText.PageTitle}"/>
                    <TextBlock Text="Personaliza el almacenamiento de tus animes, reproducción multimedia y sincronización con AniList" 
                               FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- CONTENIDO DESPLAZABLE -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,24,20" HorizontalAlignment="Stretch">

                <!-- 1. SECCIÓN ALMACENAMIENTO Y BIBLIOTECA -->
                <materialDesign:Card Background="#121212" BorderBrush="#262D38" BorderThickness="1" UniformCornerRadius="16" Margin="0,0,0,20" Padding="22" materialDesign:ElevationAssist.Elevation="Dp0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#1E293B" CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FolderMultiple" Foreground="#60A5FA" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Cfg_Almacenamiento], Source={x:Static loc:LocalizationService.Instance}}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding [Cfg_AlmacenamientoSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Selector de Ruta -->
                        <Grid Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding RutaBaseAnimes, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="{Binding [Cfg_RutaHint], Source={x:Static loc:LocalizationService.Instance}}"
                                     materialDesign:HintAssist.IsFloating="False"
                                     FontSize="13" Foreground="White" Background="#14181E" BorderBrush="#2D3748"
                                     materialDesign:TextFieldAssist.LeadingIcon="FolderOpen"
                                     materialDesign:TextFieldAssist.LeadingIconSize="20"
                                     VerticalContentAlignment="Center"
                                     Height="42" Padding="10,6" Margin="0,0,10,0"/>

                            <Button Grid.Column="1" Command="{Binding SeleccionarCarpetaAnimesCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#3B82F6" BorderBrush="#1D4ED8" Foreground="White"
                                    Height="42" Padding="16,0" Margin="0,0,8,0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="Elegir una nueva carpeta de almacenamiento">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderEditOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding [Cfg_CambiarCarpeta], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding AbrirCarpetaEnExploradorCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#6B7280" Foreground="#E2E8F0"
                                    Height="42" Padding="16,0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="Abrir en el Explorador de Windows">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding [Cfg_Explorador], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="Medium" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Estadísticas de la Carpeta en 2 Tarjetas Alineadas -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#14181E" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="10" Padding="16,10" MinHeight="56" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Harddisk" Foreground="#34D399" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [Cfg_EspacioDisco], Source={x:Static loc:LocalizationService.Instance}}" FontSize="10" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding EspacioLibreTexto}" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#14181E" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="10" Padding="16,10" MinHeight="56" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AnimationPlay" Foreground="#93C5FD" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Colección Total" FontSize="10" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TotalAnimesTexto}" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Mantenimiento: limpiar caché + Respaldos: exportar DB / exportar JSON / importar JSON -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding LimpiarCacheCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#F59E0B" Foreground="#FCD34D"
                                    Height="40" Padding="16,0" Margin="0,0,6,0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{Binding [Cfg_LimpiarCacheTip], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Broom" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding [Cfg_LimpiarCache], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding ExportarBackupCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#34D399" Foreground="#6EE7B7"
                                    Height="40" Padding="16,0" Margin="3,0,3,0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{Binding [Cfg_ExportarBackup], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseExportOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding [Cfg_BtnBackup], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ExportarBibliotecaCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#60A5FA" Foreground="#93C5FD"
                                    Height="40" Padding="16,0" Margin="3,0,3,0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{Binding [Cfg_ExportarBiblioteca], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Export" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding [Cfg_BtnExportarJson], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Command="{Binding ImportarBibliotecaCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#F59E0B" Foreground="#FCD34D"
                                    Height="40" Padding="16,0" Margin="6,0,0,0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{Binding [Cfg_ImportarBiblioteca], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding [Cfg_BtnImportarJson], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 2. SECCIÓN REPRODUCCIÓN Y PREFERENCIAS (FILAS UNIFORMEMENTE ALINEADAS) -->
                <materialDesign:Card Background="#121212" BorderBrush="#262D38" BorderThickness="1" UniformCornerRadius="16" Margin="0,0,0,20" Padding="22" materialDesign:ElevationAssist.Elevation="Dp0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#1E293B" CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="TuneVariant" Foreground="#93C5FD" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Cfg_Reproduccion], Source={x:Static loc:LocalizationService.Instance}}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding [Cfg_ReproduccionSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Fila 1: Auto Play -->
                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" MinHeight="56" Padding="16,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Cfg_AutoPlay], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding [Cfg_AutoPlaySub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,6,0" IsChecked="{Binding AutoPlaySiguiente}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Fila 1.5: Auto-Skip Intro / Outro (AniSkip) -->
                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" MinHeight="56" Padding="16,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Cfg_AutoSkip], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding [Cfg_AutoSkipSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,6,0" IsChecked="{Binding AutoSkipIntroOutro}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Fila 2: Subtítulos -->
                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" MinHeight="56" Padding="16,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Cfg_Subtitulos], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding [Cfg_SubtitulosSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,6,0" IsChecked="{Binding SubtitulosPorDefecto}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Fila 3: Descargas Simultáneas -->
                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" MinHeight="56" Padding="16,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding [Cfg_DescargasSimultaneas], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding [Cfg_DescargasSimultaneasSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Right" SelectedValue="{Binding DescargasSimultaneas}" 
                                          Height="38" MinWidth="75"
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Fila 4: Intervalo AniList -->
                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" MinHeight="56" Padding="16,8" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding [Cfg_IntervaloSync], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding [Cfg_IntervaloSyncSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Right" SelectedValue="{Binding IntervaloSincronizacionMinutos}" 
                                          Height="38" MinWidth="130"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="2 minutos" Tag="2"/>
                                    <ComboBoxItem Content="5 minutos" Tag="5"/>
                                    <ComboBoxItem Content="10 minutos" Tag="10"/>
                                    <ComboBoxItem Content="30 minutos" Tag="30"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Fila: Umbral de marcado visto -->
                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" MinHeight="56" Padding="16,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding [Cfg_UmbralVisto], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding [Cfg_UmbralVistoSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding UmbralMarcadoVisto}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UmbralMarcadoVisto, StringFormat='{}{0}%'}"
                                               Foreground="#93C5FD" FontWeight="Bold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Fila: Notificaciones de episodios nuevos -->
                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" MinHeight="56" Padding="16,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Cfg_NotificarEpisodios], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding [Cfg_NotificarEpisodiosSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,6,0" IsChecked="{Binding NotificarNuevosEpisodios}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Fila: Idioma -->
                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" MinHeight="56" Padding="16,8" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding [Cfg_Idioma], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding [Cfg_IdiomaSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Right" SelectedValue="{Binding Idioma}"
                                          SelectedValuePath="Tag" Height="38" MinWidth="150">
                                    <ComboBoxItem Content="Español" Tag="es"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Fila: Velocidad de reproducción por defecto -->
                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" MinHeight="56" Padding="16,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding [Cfg_Velocidad], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding [Cfg_VelocidadSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Right" SelectedValue="{Binding VelocidadReproduccionDefecto}"
                                          SelectedValuePath="Tag" Height="38" MinWidth="110">
                                    <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                    <ComboBoxItem Content="0.75x" Tag="0.75"/>
                                    <ComboBoxItem Content="1x" Tag="1.0"/>
                                    <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                    <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                    <ComboBoxItem Content="2x" Tag="2.0"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Atajos de teclado configurables -->
                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding [Cfg_Atajos], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                <TextBlock Text="{Binding [Cfg_AtajosSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Atajo_PlayPausa], Source={x:Static loc:LocalizationService.Instance}}" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding Atajos[PlayPausa], Mode=TwoWay}" SelectedValuePath="Tag" Height="32" MinWidth="130" Margin="8,2">
                                        <ComboBoxItem Content="Espacio" Tag="Space"/><ComboBoxItem Content="Enter" Tag="Return"/><ComboBoxItem Content="P" Tag="P"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Atajo_PantallaCompleta], Source={x:Static loc:LocalizationService.Instance}}" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding Atajos[PantallaCompleta], Mode=TwoWay}" SelectedValuePath="Tag" Height="32" MinWidth="130" Margin="8,2">
                                        <ComboBoxItem Content="F11" Tag="F11"/><ComboBoxItem Content="F" Tag="F"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Atajo_Silenciar], Source={x:Static loc:LocalizationService.Instance}}" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding Atajos[Silenciar], Mode=TwoWay}" SelectedValuePath="Tag" Height="32" MinWidth="130" Margin="8,2">
                                        <ComboBoxItem Content="M" Tag="M"/><ComboBoxItem Content="V" Tag="V"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [Atajo_Adelantar10], Source={x:Static loc:LocalizationService.Instance}}" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" SelectedValue="{Binding Atajos[Adelantar10], Mode=TwoWay}" SelectedValuePath="Tag" Height="32" MinWidth="130" Margin="8,2">
                                        <ComboBoxItem Content="→" Tag="Right"/><ComboBoxItem Content="L" Tag="L"/><ComboBoxItem Content="." Tag="OemPeriod"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Atajo_Retroceder10], Source={x:Static loc:LocalizationService.Instance}}" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" SelectedValue="{Binding Atajos[Retroceder10], Mode=TwoWay}" SelectedValuePath="Tag" Height="32" MinWidth="130" Margin="8,2">
                                        <ComboBoxItem Content="←" Tag="Left"/><ComboBoxItem Content="J" Tag="J"/><ComboBoxItem Content="," Tag="OemComma"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [Atajo_SaltarIntro], Source={x:Static loc:LocalizationService.Instance}}" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" SelectedValue="{Binding Atajos[SaltarIntro], Mode=TwoWay}" SelectedValuePath="Tag" Height="32" MinWidth="130" Margin="8,2">
                                        <ComboBoxItem Content="S" Tag="S"/><ComboBoxItem Content="K" Tag="K"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding GuardarPreferenciasCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#3B82F6" BorderBrush="#1D4ED8" Foreground="White"
                                HorizontalAlignment="Right" Height="40" Padding="20,0"
                                materialDesign:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding [Cfg_Guardar], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 3. SECCIÓN CUENTA Y SINCRONIZACIÓN -->
                <materialDesign:Card Background="#121212" BorderBrush="#262D38" BorderThickness="1" UniformCornerRadius="16" Margin="0,0,0,20" Padding="22" materialDesign:ElevationAssist.Elevation="Dp0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#1E293B" CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountSync" Foreground="#34D399" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Cfg_Cuenta], Source={x:Static loc:LocalizationService.Instance}}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding [Cfg_CuentaSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="10" MinHeight="56" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="8" Height="8" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding EstadoAutenticacionTexto}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding [Cfg_SyncSub], Source={x:Static loc:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="#9CA3AF"/>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding CerrarSesionAniListCommand}"
                                        Visibility="{Binding EstaAutenticadoAniList, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#EF4444" Foreground="#F87171"
                                        Height="38" Padding="14,0" VerticalAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Logout" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding [Cfg_CerrarSesion], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
