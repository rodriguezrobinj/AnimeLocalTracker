                                        <ComboBox SelectedValue="{Binding Atajos[PlayPausa], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{Binding [Atajo_PlayPausa], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <ComboBoxItem Content="{Binding [Tecla_Espacio], Source={x:Static loc:LocalizationService.Instance}}" Tag="Space"/><ComboBoxItem Content="Enter" Tag="Return"/><ComboBoxItem Content="P" Tag="P"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{Binding [Atajo_PantallaCompleta], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ComboBox SelectedValue="{Binding Atajos[PantallaCompleta], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{Binding [Atajo_PantallaCompleta], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <ComboBoxItem Content="F11" Tag="F11"/><ComboBoxItem Content="F" Tag="F"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{Binding [Atajo_Silenciar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ComboBox SelectedValue="{Binding Atajos[Silenciar], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{Binding [Atajo_Silenciar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <ComboBoxItem Content="M" Tag="M"/><ComboBoxItem Content="V" Tag="V"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{Binding [Atajo_Adelantar10], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ComboBox SelectedValue="{Binding Atajos[Adelantar10], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{Binding [Atajo_Adelantar10], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <ComboBoxItem Content="→" Tag="Right"/><ComboBoxItem Content="L" Tag="L"/><ComboBoxItem Content="." Tag="OemPeriod"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{Binding [Atajo_Retroceder10], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ComboBox SelectedValue="{Binding Atajos[Retroceder10], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{Binding [Atajo_Retroceder10], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <ComboBoxItem Content="←" Tag="Left"/><ComboBoxItem Content="J" Tag="J"/><ComboBoxItem Content="," Tag="OemComma"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{Binding [Atajo_SaltarIntro], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ComboBox SelectedValue="{Binding Atajos[SaltarIntro], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{Binding [Atajo_SaltarIntro], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <ComboBoxItem Content="S" Tag="S"/><ComboBoxItem Content="K" Tag="K"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── 4. DESCARGAS Y CUENTA ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding EsSeccionDescargas, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,20,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Style="{StaticResource CfgChip}"><materialDesign:PackIcon Kind="CloudDownloadOutline" Style="{StaticResource CfgChipIcon}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Cfg_CatDescargas], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Section}" FontSize="20"/>
                                    <TextBlock Text="{Binding [Cfg_CatDescargasSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding [Cfg_GrupoDescargas], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource CfgGroupCaption}"/>
                            <Border Style="{StaticResource CfgGroup}">
                                <StackPanel>
                                    <ctl:SettingRow Title="{Binding [Cfg_DescargasSimultaneas], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                    Description="{Binding [Cfg_DescargasSimultaneasSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ComboBox SelectedValue="{Binding DescargasSimultaneas}" SelectedValuePath="Content" Height="36" MinWidth="80"
                                                  AutomationProperties.Name="{Binding [Cfg_DescargasSimultaneas], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="3"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="5"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{Binding [Cfg_IntervaloSync], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                    Description="{Binding [Cfg_IntervaloSyncSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ComboBox SelectedValue="{Binding IntervaloSincronizacionMinutos}" SelectedValuePath="Tag" Height="36" MinWidth="140"
                                                  AutomationProperties.Name="{Binding [Cfg_IntervaloSync], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <ComboBoxItem Content="2 minutos" Tag="2"/>
                                            <ComboBoxItem Content="5 minutos" Tag="5"/>
                                            <ComboBoxItem Content="10 minutos" Tag="10"/>
                                            <ComboBoxItem Content="30 minutos" Tag="30"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding [Cfg_GrupoCuenta], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource CfgGroupCaption}"/>
                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <ctl:SettingRow Title="{Binding EstadoAutenticacionTexto}"
                                                Description="{Binding [Cfg_SyncSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource CfgEstadoPunto}"/>
                                        <Button Command="{Binding CerrarSesionAniListCommand}"
                                                Visibility="{Binding EstaAutenticadoAniList, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource CfgDangerButton}"
                                                AutomationProperties.Name="{Binding [Cfg_CerrarSesion], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Logout" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding [Cfg_CerrarSesion], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ctl:SettingRow>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── 5. GENERAL ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding EsSeccionGeneral, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,20,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Style="{StaticResource CfgChip}"><materialDesign:PackIcon Kind="TuneVariant" Style="{StaticResource CfgChipIcon}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Cfg_CatGeneral], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Section}" FontSize="20"/>
                                    <TextBlock Text="{Binding [Cfg_CatGeneralSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <StackPanel>
                                    <ctl:SettingRow Title="{Binding [Cfg_Idioma], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                    Description="{Binding [Cfg_IdiomaSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ComboBox SelectedValue="{Binding Idioma}" SelectedValuePath="Tag" Height="36" MinWidth="150"
                                                  AutomationProperties.Name="{Binding [Cfg_Idioma], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <ComboBoxItem Content="Español" Tag="es"/>
                                            <ComboBoxItem Content="English" Tag="en"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{Binding [Cfg_NotificarEpisodios], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                    Description="{Binding [Cfg_NotificarEpisodiosSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ToggleButton IsChecked="{Binding NotificarNuevosEpisodios}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{Binding [Cfg_NotificarEpisodios], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{Binding [Cfg_MinimizarBandeja], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                    Description="{Binding [Cfg_MinimizarBandejaSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ToggleButton IsChecked="{Binding MinimizarABandejaAlCerrar}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{Binding [Cfg_MinimizarBandeja], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{Binding [Cfg_NotificarConBandeja], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                    Description="{Binding [Cfg_NotificarConBandejaSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ToggleButton IsChecked="{Binding NotificarConBandejaSiempre}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{Binding [Cfg_NotificarConBandeja], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{Binding [Cfg_IniciarConWindows], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                    Description="{Binding [Cfg_IniciarConWindowsSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ToggleButton IsChecked="{Binding IniciarConWindows}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{Binding [Cfg_IniciarConWindows], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding [Cfg_GrupoTeclaPanico], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource CfgGroupCaption}"/>
                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <StackPanel>
                                    <ctl:SettingRow Title="{Binding [Cfg_TeclaPanico], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                    Description="{Binding [Cfg_TeclaPanicoSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ToggleButton IsChecked="{Binding TeclaPanicoActiva}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{Binding [Cfg_TeclaPanico], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{Binding [Cfg_TeclaPanicoAtajo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                    Description="{Binding [Cfg_TeclaPanicoAtajoSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ComboBox SelectedValue="{Binding TeclaPanico}" SelectedValuePath="Tag" Height="36" MinWidth="120"
                                                  IsEnabled="{Binding TeclaPanicoActiva}"
                                                  AutomationProperties.Name="{Binding [Cfg_TeclaPanicoAtajo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <ComboBoxItem Content="F12" Tag="F12"/>
                                            <ComboBoxItem Content="Escape" Tag="Escape"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── 6. PLUGINS ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding EsSeccionPlugins, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,20,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Style="{StaticResource CfgChip}"><materialDesign:PackIcon Kind="Puzzle" Style="{StaticResource CfgChipIcon}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Cfg_Plugins], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Section}" FontSize="20"/>
                                    <TextBlock Text="{Binding [Cfg_PluginsSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <StackPanel>
                                    <!-- SEC-01: interruptor general. Apagado por defecto: un plugin corre con TODOS los permisos de la app. -->
                                    <ctl:SettingRow Title="{Binding [Cfg_PluginsPermitir], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                    Description="{Binding [Cfg_PluginsPermitirSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <ToggleButton IsChecked="{Binding PluginsHabilitados}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{Binding [Cfg_PluginsPermitir], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <!-- Aviso de riesgo -->
                                    <Border Margin="20,14,20,4" Padding="14,10" CornerRadius="10" Background="{DynamicResource Brush.WarningTint}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ShieldAlertOutline" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,10,0"
                                                                     Foreground="{DynamicResource Brush.Warning}"/>
                                            <TextBlock Text="{Binding [Cfg_PluginsAviso], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Secondary}" TextWrapping="Wrap" MaxWidth="620"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lista de plugins con su estado de confianza -->
                                    <StackPanel Margin="20,10,20,6">
                                        <ItemsControl ItemsSource="{Binding PluginsDetalle}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource AppCard}" Background="{DynamicResource Brush.Surface2}" Padding="14,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <materialDesign:PackIcon Kind="FileCode" Foreground="{DynamicResource Brush.Accent}" Width="20" Height="20"
                                                                                     VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Nombre}" Style="{StaticResource AppText.BodyStrong}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding Tipo}" Style="{StaticResource AppText.Caption}"/>
                                                                    <TextBlock Text="  ·  SHA-256 " Style="{StaticResource AppText.Caption}"/>
                                                                    <TextBlock Text="{Binding HashCorto}" Style="{StaticResource AppText.Caption}" FontFamily="Consolas"
                                                                               ToolTip="{Binding HashCompleto}"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Border Grid.Column="2" CornerRadius="7" Padding="9,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding TextoEstado}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="Confiable">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessTint}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="Modificado">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningTint}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <Button Grid.Column="3" Style="{StaticResource CfgRowButton}" MinWidth="128" Height="34"
                                                                    Command="{Binding DataContext.AlternarConfianzaPluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    AutomationProperties.Name="{Binding TextoAccion}">
                                                                <TextBlock Text="{Binding TextoAccion}" FontWeight="SemiBold" FontSize="12"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding [Cfg_SinPlugins], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                                   Style="{StaticResource AppText.Secondary}" FontStyle="Italic" Margin="0,4,0,8"
                                                   Visibility="{Binding PluginsDetalle.Count, Converter={StaticResource ZeroToVis}}"/>

                                        <!-- Los .dll solo se cargan al iniciar la app -->
                                        <TextBlock Text="{Binding [Cfg_PluginsReiniciar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Caption}" Foreground="{DynamicResource Brush.Warning}"
                                                   TextWrapping="Wrap" Margin="0,2,0,6"
                                                   Visibility="{Binding PluginsRequiereReinicio, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <Grid Margin="20,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Cfg_PluginsSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                        <Button Grid.Column="1" Command="{Binding AbrirCarpetaPluginsCommand}" Style="{StaticResource CfgRowButton}" VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding [Cfg_AbrirCarpetaPlugins], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding [Cfg_AbrirCarpetaPlugins], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ BARRA DE GUARDADO: siempre visible en las categorías con preferencias ═══ -->
                <Border Grid.Row="1" Style="{StaticResource AppCard}" CornerRadius="12" Padding="16,10" Margin="0,12,20,0"
                        Visibility="{Binding MostrarBarraGuardar, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Cfg_GuardarHint], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                   Style="{StaticResource AppText.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                        <Button Grid.Column="1" Command="{Binding GuardarPreferenciasCommand}"
                                Style="{StaticResource AppPrimaryButton}"
                                Height="40" Padding="20,0" Cursor="Hand"
                                materialDesign:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding [Cfg_Guardar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
