                                            <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="{loc:T Cfg_BtnBorrarDatos}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </ctl:SettingRow>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── 2. REPRODUCCIÓN ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding EsSeccionReproduccion, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,20,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Style="{StaticResource CfgChip}"><materialDesign:PackIcon Kind="PlayCircleOutline" Style="{StaticResource CfgChipIcon}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Cfg_CatReproduccion}" Style="{StaticResource AppText.Section}" FontSize="20"/>
                                    <TextBlock Text="{loc:T Cfg_CatReproduccionSub}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <StackPanel>
                                    <ctl:SettingRow Title="{loc:T Cfg_AccionFinEpisodio}"
                                                    Description="{loc:T Cfg_AccionFinEpisodioSub}">
                                        <ComboBox SelectedValue="{Binding AccionFinEpisodio}" SelectedValuePath="Tag" Height="36" MinWidth="230"
                                                  AutomationProperties.Name="{loc:T Cfg_AccionFinEpisodio}">
                                            <ComboBoxItem Content="{loc:T Cfg_AccionFinEpisodio_CuentaAtras}" Tag="AutoPlayCuentaAtras"/>
                                            <ComboBoxItem Content="{loc:T Cfg_AccionFinEpisodio_Inmediato}" Tag="AutoPlayInmediato"/>
                                            <ComboBoxItem Content="{loc:T Cfg_AccionFinEpisodio_SalirFicha}" Tag="PausarYSalirFicha"/>
                                            <ComboBoxItem Content="{loc:T Cfg_AccionFinEpisodio_Permanecer}" Tag="PermanecerPausado"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_AmbitoAudio}"
                                                    Description="{loc:T Cfg_AmbitoAudioSub}">
                                        <ComboBox SelectedValue="{Binding AmbitoAjustesAudio}" SelectedValuePath="Tag" Height="36" MinWidth="230"
                                                  AutomationProperties.Name="{loc:T Cfg_AmbitoAudio}">
                                            <ComboBoxItem Content="{loc:T Cfg_AmbitoAudio_Global}" Tag="Global"/>
                                            <ComboBoxItem Content="{loc:T Cfg_AmbitoAudio_PorAnime}" Tag="PorAnime"/>
                                            <ComboBoxItem Content="{loc:T Cfg_AmbitoAudio_PorCapitulo}" Tag="PorCapitulo"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_PreferenciaAudio}"
                                                    Description="{loc:T Cfg_PreferenciaAudioSub}">
                                        <ComboBox SelectedValue="{Binding PreferenciaAudioAnimeAv1}" SelectedValuePath="Tag" Height="36" MinWidth="230"
                                                  AutomationProperties.Name="{loc:T Cfg_PreferenciaAudio}">
                                            <ComboBoxItem Content="{loc:T Cfg_PreferenciaAudio_Ninguna}" Tag=""/>
                                            <ComboBoxItem Content="{loc:T Cfg_PreferenciaAudio_Sub}" Tag="SUB"/>
                                            <ComboBoxItem Content="{loc:T Cfg_PreferenciaAudio_Dub}" Tag="DUB"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_OrdenProveedores}"
                                                    Description="{loc:T Cfg_OrdenProveedoresSub}">
                                        <StackPanel MinWidth="280">
                                            <ItemsControl ItemsSource="{Binding OrdenProveedores}" ItemTemplate="{StaticResource FilaOrdenTemplate}" KeyboardNavigation.TabNavigation="Continue"/>
                                            <Button Style="{StaticResource CfgRowButton}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                    Command="{Binding RestablecerOrdenProveedoresCommand}"
                                                    AutomationProperties.Name="{loc:T Cfg_OrdenServidores_Restablecer}">
                                                <TextBlock Text="{loc:T Cfg_OrdenServidores_Restablecer}" FontWeight="SemiBold" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_ServidorPreferido}"
                                                    Description="{loc:T Cfg_ServidorPreferidoSub}">
                                        <StackPanel MinWidth="280">
                                            <ItemsControl ItemsSource="{Binding OrdenServidores}" ItemTemplate="{StaticResource FilaOrdenTemplate}" KeyboardNavigation.TabNavigation="Continue"/>
                                            <Button Style="{StaticResource CfgRowButton}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                    Command="{Binding RestablecerOrdenServidoresCommand}"
                                                    AutomationProperties.Name="{loc:T Cfg_OrdenServidores_Restablecer}">
                                                <TextBlock Text="{loc:T Cfg_OrdenServidores_Restablecer}" FontWeight="SemiBold" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_BusquedaTorrent}"
                                                    Description="{loc:T Cfg_BusquedaTorrentSub}">
                                        <ToggleButton IsChecked="{Binding BusquedaTorrentHabilitada}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_BusquedaTorrent}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_GrupoFansubPreferido}"
                                                    Description="{loc:T Cfg_GrupoFansubPreferidoSub}">
                                        <TextBox Text="{Binding GrupoFansubPreferidoTorrent, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" MinWidth="180"
                                                 materialDesign:HintAssist.Hint="{loc:T Cfg_GrupoFansubPreferidoHint}"
                                                 materialDesign:HintAssist.IsFloating="False"
                                                 FontSize="13" VerticalContentAlignment="Center"
                                                 Height="42" Padding="10,6"
                                                 Foreground="{DynamicResource Brush.TextPrimary}" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                                                 AutomationProperties.Name="{loc:T Cfg_GrupoFansubPreferido}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_ResolucionPreferida}"
                                                    Description="{loc:T Cfg_ResolucionPreferidaSub}">
                                        <ComboBox SelectedValue="{Binding ResolucionPreferidaTorrent}" SelectedValuePath="Tag" Height="36" MinWidth="150"
                                                  AutomationProperties.Name="{loc:T Cfg_ResolucionPreferida}">
                                            <ComboBoxItem Content="{loc:T Cfg_ResolucionPreferida_Ninguna}" Tag=""/>
                                            <ComboBoxItem Content="1080p" Tag="1080p"/>
                                            <ComboBoxItem Content="720p" Tag="720p"/>
                                            <ComboBoxItem Content="480p" Tag="480p"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_SeguirSembrando}"
                                                    Description="{loc:T Cfg_SeguirSembrandoSub}">
                                        <ToggleButton IsChecked="{Binding SeguirSembrandoTorrents}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_SeguirSembrando}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_PasosSalto}"
                                                    Description="{loc:T Cfg_PasosSaltoSub}">
                                        <ComboBox SelectedValue="{Binding PasosSaltoSegundos}" SelectedValuePath="Tag" Height="36" MinWidth="90"
                                                  AutomationProperties.Name="{loc:T Cfg_PasosSalto}">
                                            <ComboBoxItem Content="5s" Tag="5"/>
                                            <ComboBoxItem Content="10s" Tag="10"/>
                                            <ComboBoxItem Content="30s" Tag="30"/>
                                            <ComboBoxItem Content="60s" Tag="60"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EvitarSuspension}"
                                                    Description="{loc:T Cfg_EvitarSuspensionSub}">
                                        <ToggleButton IsChecked="{Binding EvitarSuspensionPantalla}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_EvitarSuspension}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_AutoSkip}"
                                                    Description="{loc:T Cfg_AutoSkipSub}">
                                        <ToggleButton IsChecked="{Binding AutoSkipIntroOutro}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_AutoSkip}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_Subtitulos}"
                                                    Description="{loc:T Cfg_SubtitulosSub}">
                                        <ToggleButton IsChecked="{Binding SubtitulosPorDefecto}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_Subtitulos}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_UmbralVisto}"
                                                    Description="{loc:T Cfg_UmbralVistoSub}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Style="{StaticResource CfgSlider}" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Width="170"
                                                    Value="{Binding UmbralMarcadoVisto}"
                                                    AutomationProperties.Name="{loc:T Cfg_UmbralVisto}"/>
                                            <TextBlock Text="{Binding UmbralMarcadoVisto, StringFormat='{}{0}%'}"
                                                       Foreground="{DynamicResource Brush.AccentSoft}" FontWeight="Bold" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_Velocidad}"
                                                    Description="{loc:T Cfg_VelocidadSub}">
                                        <ComboBox SelectedValue="{Binding VelocidadReproduccionDefecto}" SelectedValuePath="Tag" Height="36" MinWidth="110"
                                                  AutomationProperties.Name="{loc:T Cfg_Velocidad}">
                                            <ComboBoxItem Content="0.5x"><ComboBoxItem.Tag><sys:Double>0.5</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                                            <ComboBoxItem Content="0.75x"><ComboBoxItem.Tag><sys:Double>0.75</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                                            <ComboBoxItem Content="1x"><ComboBoxItem.Tag><sys:Double>1.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                                            <ComboBoxItem Content="1.25x"><ComboBoxItem.Tag><sys:Double>1.25</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                                            <ComboBoxItem Content="1.5x"><ComboBoxItem.Tag><sys:Double>1.5</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                                            <ComboBoxItem Content="2x"><ComboBoxItem.Tag><sys:Double>2.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{loc:T Cfg_GrupoRendimientoVideo}" Style="{StaticResource CfgGroupCaption}" Margin="4,4,0,8"/>
                            <Border Style="{StaticResource CfgGroup}" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Diagnóstico: qué tiene este equipo y cómo se reprodujo el último video -->
                                    <StackPanel Margin="16,12,16,12">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Chip" Width="18" Height="18" Foreground="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DiagnosticoEquipoTexto}" Style="{StaticResource AppText.Body}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DiagnosticoUltimoVideoTexto}" Style="{StaticResource AppText.Caption}" TextWrapping="Wrap" Margin="26,4,0,0"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_ModoSaltos}"
                                                    Description="{loc:T Cfg_ModoSaltosSub}">
                                        <ComboBox SelectedValue="{Binding ModoSaltosVideo}" SelectedValuePath="Tag" Height="36" MinWidth="230"
                                                  AutomationProperties.Name="{loc:T Cfg_ModoSaltos}">
                                            <ComboBoxItem Content="{loc:T Cfg_Opcion_Automatico}" Tag="Automatico"/>
                                            <ComboBoxItem Content="{loc:T Cfg_ModoSaltos_Exactos}" Tag="Exactos"/>
                                            <ComboBoxItem Content="{loc:T Cfg_ModoSaltos_Rapidos}" Tag="Rapidos"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_AceleracionHardware}"
                                                    Description="{loc:T Cfg_AceleracionHardwareSub}">
                                        <ToggleButton IsChecked="{Binding AceleracionHardwareVideo}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_AceleracionHardware}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_TarjetaGrafica}"
                                                    Description="{loc:T Cfg_TarjetaGraficaSub}">
                                        <ComboBox ItemsSource="{Binding TarjetasGraficas}" SelectedValue="{Binding TarjetaGraficaVideo}"
                                                  SelectedValuePath="Valor" DisplayMemberPath="Nombre" Height="36" MinWidth="230" MaxWidth="320"
                                                  AutomationProperties.Name="{loc:T Cfg_TarjetaGrafica}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EscaladoInteligente}"
                                                    Description="{loc:T Cfg_EscaladoInteligenteSub}">
                                        <ComboBox SelectedValue="{Binding EscaladoInteligenteVideo}" SelectedValuePath="Tag" Height="36" MinWidth="230"
                                                  AutomationProperties.Name="{loc:T Cfg_EscaladoInteligente}">
                                            <ComboBoxItem Content="{loc:T Cfg_Opcion_Automatico}" Tag="Automatico"/>
                                            <ComboBoxItem Content="{loc:T Cfg_Opcion_Activado}" Tag="Activado"/>
                                            <ComboBoxItem Content="{loc:T Cfg_Opcion_Desactivado}" Tag="Desactivado"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:T Cfg_GrupoEstiloSubtitulos}" Style="{StaticResource CfgGroupCaption}" Margin="4,4,0,8"/>
                            <Border Style="{StaticResource CfgGroup}">
                                <StackPanel>
                                    <!-- Vista previa: una "pantalla" de 1280 px de ancho reducida al espacio disponible, para que el
                                         tamaño de letra se aprecie en la misma proporción que en el reproductor. Usa el mismo control
                                         (SubtitleTextView) que el reproductor: lo que se ve aquí es lo que se ve al ver un capítulo. -->
                                    <Border Margin="20,16,20,6" CornerRadius="10" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                            AutomationProperties.Name="{loc:T Cfg_EstiloVistaPrevia}">
                                        <Viewbox Stretch="Uniform">
                                            <Grid Width="1280" Height="320">
                                                <Grid.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#0F172A" Offset="0"/>
                                                        <GradientStop Color="#3B6FB6" Offset="0.3"/>
                                                        <GradientStop Color="#DCEBFA" Offset="0.62"/>
                                                        <GradientStop Color="#F7F7F2" Offset="0.78"/>
                                                        <GradientStop Color="#2F6B3A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Grid.Background>
                                                <Viewbox VerticalAlignment="Bottom" Margin="40,40,40,25" StretchDirection="DownOnly" MaxHeight="320">
                                                    <ctl:SubtitleTextView MaxWidth="1200"
                                                                          Texto="{loc:T Cfg_EstiloVistaPreviaTexto}"
                                                                          Estilo="{Binding EstiloVistaPrevia}"/>
                                                </Viewbox>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{loc:T Cfg_EstiloVistaPreviaSub}" Style="{StaticResource AppText.Caption}" TextWrapping="Wrap" Margin="22,0,20,12"/>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EstiloFuente}"
                                                    Description="{loc:T Cfg_EstiloFuenteSub}">
                                        <ComboBox ItemsSource="{Binding FuentesSubtitulos}" SelectedItem="{Binding EstiloFuente}" Height="36" MinWidth="180"
                                                  AutomationProperties.Name="{loc:T Cfg_EstiloFuente}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EstiloTamano}"
                                                    Description="{loc:T Cfg_EstiloTamanoSub}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Style="{StaticResource CfgSlider}" Minimum="24" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True" Width="170"
                                                    Value="{Binding EstiloTamano}"
                                                    AutomationProperties.Name="{loc:T Cfg_EstiloTamano}"/>
                                            <TextBlock Text="{Binding EstiloTamano, StringFormat='{}{0:0} px'}"
                                                       Foreground="{DynamicResource Brush.AccentSoft}" FontWeight="Bold" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EstiloFormato}"
                                                    Description="{loc:T Cfg_EstiloFormatoSub}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton IsChecked="{Binding EstiloNegrita}" Style="{StaticResource CfgFormatToggle}"
                                                          ToolTip="{loc:T Cfg_EstiloNegrita}"
                                                          AutomationProperties.Name="{loc:T Cfg_EstiloNegrita}">
                                                <materialDesign:PackIcon Kind="FormatBold" Width="20" Height="20"/>
                                            </ToggleButton>
                                            <ToggleButton IsChecked="{Binding EstiloCursiva}" Style="{StaticResource CfgFormatToggle}"
                                                          ToolTip="{loc:T Cfg_EstiloCursiva}"
                                                          AutomationProperties.Name="{loc:T Cfg_EstiloCursiva}">
                                                <materialDesign:PackIcon Kind="FormatItalic" Width="20" Height="20"/>
                                            </ToggleButton>
                                            <ToggleButton IsChecked="{Binding EstiloSubrayado}" Style="{StaticResource CfgFormatToggle}"
                                                          ToolTip="{loc:T Cfg_EstiloSubrayado}"
                                                          AutomationProperties.Name="{loc:T Cfg_EstiloSubrayado}">
                                                <materialDesign:PackIcon Kind="FormatUnderline" Width="20" Height="20"/>
                                            </ToggleButton>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EstiloColorTexto}"
                                                    Description="{loc:T Cfg_EstiloColorTextoSub}">
                                        <ComboBox ItemsSource="{Binding ColoresSubtitulos}" SelectedValue="{Binding EstiloColorTexto}" SelectedValuePath="Hex"
                                                  ItemTemplate="{StaticResource CfgColorItemTemplate}" Height="36" MinWidth="160"
                                                  AutomationProperties.Name="{loc:T Cfg_EstiloColorTexto}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EstiloContornoColor}"
                                                    Description="{loc:T Cfg_EstiloContornoColorSub}">
                                        <ComboBox ItemsSource="{Binding ColoresSubtitulos}" SelectedValue="{Binding EstiloColorContorno}" SelectedValuePath="Hex"
                                                  ItemTemplate="{StaticResource CfgColorItemTemplate}" Height="36" MinWidth="160"
                                                  AutomationProperties.Name="{loc:T Cfg_EstiloContornoColor}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EstiloContornoGrosor}"
                                                    Description="{loc:T Cfg_EstiloContornoGrosorSub}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Style="{StaticResource CfgSlider}" Minimum="0" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="170"
                                                    Value="{Binding EstiloGrosorContorno}"
                                                    AutomationProperties.Name="{loc:T Cfg_EstiloContornoGrosor}"/>
                                            <TextBlock Text="{Binding EstiloGrosorContorno, StringFormat='{}{0:0.#}'}"
                                                       Foreground="{DynamicResource Brush.AccentSoft}" FontWeight="Bold" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EstiloFondo}"
                                                    Description="{loc:T Cfg_EstiloFondoSub}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Style="{StaticResource CfgSlider}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Width="170"
                                                    Value="{Binding EstiloOpacidadFondo}"
                                                    AutomationProperties.Name="{loc:T Cfg_EstiloFondo}"/>
                                            <TextBlock Text="{Binding EstiloOpacidadFondo, StringFormat='{}{0:0}%'}"
                                                       Foreground="{DynamicResource Brush.AccentSoft}" FontWeight="Bold" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EstiloBordeGrosor}"
                                                    Description="{loc:T Cfg_EstiloBordeGrosorSub}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Style="{StaticResource CfgSlider}" Minimum="0" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="170"
                                                    Value="{Binding EstiloGrosorBorde}"
                                                    AutomationProperties.Name="{loc:T Cfg_EstiloBordeGrosor}"/>
                                            <TextBlock Text="{Binding EstiloGrosorBorde, StringFormat='{}{0:0.#}'}"
                                                       Foreground="{DynamicResource Brush.AccentSoft}" FontWeight="Bold" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EstiloBordeColor}"
                                                    Description="{loc:T Cfg_EstiloBordeColorSub}">
                                        <ComboBox ItemsSource="{Binding ColoresSubtitulos}" SelectedValue="{Binding EstiloColorBorde}" SelectedValuePath="Hex"
                                                  ItemTemplate="{StaticResource CfgColorItemTemplate}" Height="36" MinWidth="160"
                                                  AutomationProperties.Name="{loc:T Cfg_EstiloBordeColor}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EstiloRestablecer}"
                                                    Description="{loc:T Cfg_EstiloRestablecerSub}">
                                        <Button Command="{Binding RestablecerEstiloSubtitulosCommand}" Style="{StaticResource CfgRowButton}"
                                                Content="{loc:T Cfg_EstiloRestablecer}"
                                                AutomationProperties.Name="{loc:T Cfg_EstiloRestablecer}"/>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── 3. ATAJOS DE TECLADO ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding EsSeccionAtajos, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,20,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Style="{StaticResource CfgChip}"><materialDesign:PackIcon Kind="KeyboardOutline" Style="{StaticResource CfgChipIcon}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Cfg_Atajos}" Style="{StaticResource AppText.Section}" FontSize="20"/>
                                    <TextBlock Text="{loc:T Cfg_AtajosSub}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <StackPanel>
                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{loc:T Atajo_PlayPausa}">
                                        <ComboBox SelectedValue="{Binding Atajos[PlayPausa], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{loc:T Atajo_PlayPausa}">
                                            <ComboBoxItem Content="{loc:T Tecla_Espacio}" Tag="Space"/><ComboBoxItem Content="Enter" Tag="Return"/><ComboBoxItem Content="P" Tag="P"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{loc:T Atajo_PantallaCompleta}">
                                        <ComboBox SelectedValue="{Binding Atajos[PantallaCompleta], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{loc:T Atajo_PantallaCompleta}">
                                            <ComboBoxItem Content="F11" Tag="F11"/><ComboBoxItem Content="F" Tag="F"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{loc:T Atajo_Silenciar}">
                                        <ComboBox SelectedValue="{Binding Atajos[Silenciar], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{loc:T Atajo_Silenciar}">
                                            <ComboBoxItem Content="M" Tag="M"/><ComboBoxItem Content="V" Tag="V"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{loc:T Atajo_Adelantar10}">
                                        <ComboBox SelectedValue="{Binding Atajos[Adelantar10], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{loc:T Atajo_Adelantar10}">
                                            <ComboBoxItem Content="→" Tag="Right"/><ComboBoxItem Content="L" Tag="L"/><ComboBoxItem Content="." Tag="OemPeriod"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{loc:T Atajo_Retroceder10}">
                                        <ComboBox SelectedValue="{Binding Atajos[Retroceder10], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{loc:T Atajo_Retroceder10}">
                                            <ComboBoxItem Content="←" Tag="Left"/><ComboBoxItem Content="J" Tag="J"/><ComboBoxItem Content="," Tag="OemComma"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow MinHeight="52" Padding="20,8" Title="{loc:T Atajo_SaltarIntro}">
                                        <ComboBox SelectedValue="{Binding Atajos[SaltarIntro], Mode=TwoWay}" SelectedValuePath="Tag" Height="34" MinWidth="140"
                                                  AutomationProperties.Name="{loc:T Atajo_SaltarIntro}">
                                            <ComboBoxItem Content="S" Tag="S"/><ComboBoxItem Content="K" Tag="K"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── 4. DESCARGAS Y CUENTA ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding EsSeccionDescargas, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,20,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Style="{StaticResource CfgChip}"><materialDesign:PackIcon Kind="CloudDownloadOutline" Style="{StaticResource CfgChipIcon}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Cfg_CatDescargas}" Style="{StaticResource AppText.Section}" FontSize="20"/>
                                    <TextBlock Text="{loc:T Cfg_CatDescargasSub}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{loc:T Cfg_GrupoDescargas}" Style="{StaticResource CfgGroupCaption}"/>
                            <Border Style="{StaticResource CfgGroup}">
                                <StackPanel>
                                    <ctl:SettingRow Title="{loc:T Cfg_DescargasSimultaneas}"
                                                    Description="{loc:T Cfg_DescargasSimultaneasSub}">
                                        <ComboBox SelectedValue="{Binding DescargasSimultaneas}" SelectedValuePath="Content" Height="36" MinWidth="80"
                                                  AutomationProperties.Name="{loc:T Cfg_DescargasSimultaneas}">
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="3"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="5"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_IntervaloSync}"
                                                    Description="{loc:T Cfg_IntervaloSyncSub}">
                                        <ComboBox SelectedValue="{Binding IntervaloSincronizacionMinutos}" SelectedValuePath="Tag" Height="36" MinWidth="140"
                                                  AutomationProperties.Name="{loc:T Cfg_IntervaloSync}">
                                            <ComboBoxItem Content="2 minutos" Tag="2"/>
                                            <ComboBoxItem Content="5 minutos" Tag="5"/>
                                            <ComboBoxItem Content="10 minutos" Tag="10"/>
                                            <ComboBoxItem Content="30 minutos" Tag="30"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_EliminarTrasVer}"
                                                    Description="{loc:T Cfg_EliminarTrasVerSub}">
                                        <ComboBox SelectedValue="{Binding ModoEliminarTrasVer}" SelectedValuePath="Tag" Height="36" MinWidth="230"
                                                  AutomationProperties.Name="{loc:T Cfg_EliminarTrasVer}">
                                            <ComboBoxItem Content="{loc:T Cfg_EliminarTrasVer_Apagado}" Tag="Apagado"/>
                                            <ComboBoxItem Content="{loc:T Cfg_EliminarTrasVer_Automatico}" Tag="Automatico"/>
                                            <ComboBoxItem Content="{loc:T Cfg_EliminarTrasVer_AlCompletar}" Tag="AlCompletarSerie"/>
                                            <ComboBoxItem Content="{loc:T Cfg_EliminarTrasVer_ConsumoLigero}" Tag="ConsumoLigero"/>
                                        </ComboBox>
                                    </ctl:SettingRow>

                                    <Border Style="{StaticResource CfgDivider}"
                                            Visibility="{Binding EsConsumoLigero, Converter={StaticResource BoolToVis}}"/>
                                    <ctl:SettingRow Title="{loc:T Cfg_EpisodiosAConservar}"
                                                    Description="{loc:T Cfg_EpisodiosAConservarSub}"
                                                    Visibility="{Binding EsConsumoLigero, Converter={StaticResource BoolToVis}}">
                                        <ComboBox SelectedValue="{Binding EpisodiosAConservar}" SelectedValuePath="Content" Height="36" MinWidth="80"
                                                  AutomationProperties.Name="{loc:T Cfg_EpisodiosAConservar}">
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="3"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="5"/>
                                            <ComboBoxItem Content="6"/>
                                            <ComboBoxItem Content="7"/>
                                            <ComboBoxItem Content="8"/>
                                            <ComboBoxItem Content="9"/>
                                            <ComboBoxItem Content="10"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:T Cfg_GrupoCuenta}" Style="{StaticResource CfgGroupCaption}"/>
                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <ctl:SettingRow Title="{Binding EstadoAutenticacionTexto}"
                                                Description="{loc:T Cfg_SyncSub}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource CfgEstadoPunto}"/>
                                        <Button Command="{Binding CerrarSesionAniListCommand}"
                                                Visibility="{Binding EstaAutenticadoAniList, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource CfgDangerButton}"
                                                AutomationProperties.Name="{loc:T Cfg_CerrarSesion}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Logout" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{loc:T Cfg_CerrarSesion}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ctl:SettingRow>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── 5. GENERAL ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding EsSeccionGeneral, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,20,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Style="{StaticResource CfgChip}"><materialDesign:PackIcon Kind="TuneVariant" Style="{StaticResource CfgChipIcon}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Cfg_CatGeneral}" Style="{StaticResource AppText.Section}" FontSize="20"/>
                                    <TextBlock Text="{loc:T Cfg_CatGeneralSub}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <StackPanel>
                                    <ctl:SettingRow Title="{loc:T Cfg_Idioma}"
                                                    Description="{loc:T Cfg_IdiomaSub}">
                                        <ComboBox SelectedValue="{Binding Idioma}" SelectedValuePath="Tag" Height="36" MinWidth="150"
                                                  AutomationProperties.Name="{loc:T Cfg_Idioma}">
                                            <ComboBoxItem Content="Español" Tag="es"/>
                                            <ComboBoxItem Content="English" Tag="en"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_NotificarEpisodios}"
                                                    Description="{loc:T Cfg_NotificarEpisodiosSub}">
                                        <ToggleButton IsChecked="{Binding NotificarNuevosEpisodios}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_NotificarEpisodios}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_MinimizarBandeja}"
                                                    Description="{loc:T Cfg_MinimizarBandejaSub}">
                                        <ToggleButton IsChecked="{Binding MinimizarABandejaAlCerrar}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_MinimizarBandeja}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_NotificarConBandeja}"
                                                    Description="{loc:T Cfg_NotificarConBandejaSub}">
                                        <ToggleButton IsChecked="{Binding NotificarConBandejaSiempre}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_NotificarConBandeja}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_MusicaSeguirFuera}"
                                                    Description="{loc:T Cfg_MusicaSeguirFueraSub}">
                                        <ToggleButton IsChecked="{Binding MusicaSigueFueraDeLaFicha}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_MusicaSeguirFuera}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_IniciarConWindows}"
                                                    Description="{loc:T Cfg_IniciarConWindowsSub}">
                                        <ToggleButton IsChecked="{Binding IniciarConWindows}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_IniciarConWindows}"/>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:T Cfg_GrupoTeclaPanico}" Style="{StaticResource CfgGroupCaption}"/>
                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <StackPanel>
                                    <ctl:SettingRow Title="{loc:T Cfg_TeclaPanico}"
                                                    Description="{loc:T Cfg_TeclaPanicoSub}">
                                        <ToggleButton IsChecked="{Binding TeclaPanicoActiva}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_TeclaPanico}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_TeclaPanicoAtajo}"
                                                    Description="{loc:T Cfg_TeclaPanicoAtajoSub}">
                                        <ComboBox SelectedValue="{Binding TeclaPanico}" SelectedValuePath="Tag" Height="36" MinWidth="120"
                                                  IsEnabled="{Binding TeclaPanicoActiva}"
                                                  AutomationProperties.Name="{loc:T Cfg_TeclaPanicoAtajo}">
                                            <ComboBoxItem Content="F12" Tag="F12"/>
                                            <ComboBoxItem Content="Escape" Tag="Escape"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>

                            <!-- Registro de diagnóstico: un archivo por sesión + errores.log -->
                            <TextBlock Text="{loc:T Cfg_GrupoRegistro}" Style="{StaticResource CfgGroupCaption}"/>
                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <StackPanel>
                                    <ctl:SettingRow Title="{loc:T Cfg_RegistroDetallado}"
                                                    Description="{loc:T Cfg_RegistroDetalladoSub}">
                                        <ToggleButton IsChecked="{Binding RegistroDetallado}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_RegistroDetallado}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <ctl:SettingRow Title="{loc:T Cfg_CarpetaRegistros}"
                                                    Description="{loc:T Cfg_CarpetaRegistrosSub}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding VerRegistrosCommand}" Style="{StaticResource CfgRowButton}" Margin="0,0,8,0"
                                                    AutomationProperties.Name="{loc:T Cfg_VerRegistros}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="TextBoxSearchOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{loc:T Cfg_VerRegistros}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding AbrirCarpetaRegistrosCommand}" Style="{StaticResource CfgRowButton}"
                                                    AutomationProperties.Name="{loc:T Cfg_AbrirCarpetaRegistros}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{loc:T Cfg_AbrirCarpetaRegistros}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── 6. PLUGINS ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding EsSeccionPlugins, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,20,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Style="{StaticResource CfgChip}"><materialDesign:PackIcon Kind="Puzzle" Style="{StaticResource CfgChipIcon}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Cfg_Plugins}" Style="{StaticResource AppText.Section}" FontSize="20"/>
                                    <TextBlock Text="{loc:T Cfg_PluginsSub}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource CfgGroup}" Margin="0">
                                <StackPanel>
                                    <!-- SEC-01: interruptor general. Apagado por defecto: un plugin corre con TODOS los permisos de la app. -->
                                    <ctl:SettingRow Title="{loc:T Cfg_PluginsPermitir}"
                                                    Description="{loc:T Cfg_PluginsPermitirSub}">
                                        <ToggleButton IsChecked="{Binding PluginsHabilitados}" Style="{StaticResource CfgSwitch}"
                                                      AutomationProperties.Name="{loc:T Cfg_PluginsPermitir}"/>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <!-- Aviso de riesgo -->
                                    <Border Margin="20,14,20,4" Padding="14,10" CornerRadius="10" Background="{DynamicResource Brush.WarningTint}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ShieldAlertOutline" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,10,0"
                                                                     Foreground="{DynamicResource Brush.Warning}"/>
                                            <TextBlock Text="{loc:T Cfg_PluginsAviso}" Style="{StaticResource AppText.Secondary}" TextWrapping="Wrap" MaxWidth="620"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lista de plugins con su estado de confianza -->
                                    <StackPanel Margin="20,10,20,6">
                                        <ItemsControl ItemsSource="{Binding PluginsDetalle}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource AppCard}" Background="{DynamicResource Brush.Surface2}" Padding="14,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <materialDesign:PackIcon Kind="FileCode" Foreground="{DynamicResource Brush.Accent}" Width="20" Height="20"
                                                                                     VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Nombre}" Style="{StaticResource AppText.BodyStrong}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding Tipo}" Style="{StaticResource AppText.Caption}"/>
                                                                    <TextBlock Text="  ·  SHA-256 " Style="{StaticResource AppText.Caption}"/>
                                                                    <TextBlock Text="{Binding HashCorto}" Style="{StaticResource AppText.Caption}" FontFamily="Consolas"
                                                                               ToolTip="{Binding HashCompleto}"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Border Grid.Column="2" CornerRadius="7" Padding="9,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding TextoEstado}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="Confiable">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessTint}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="Modificado">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningTint}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <Button Grid.Column="3" Style="{StaticResource CfgRowButton}" MinWidth="128" Height="34"
                                                                    Command="{Binding DataContext.AlternarConfianzaPluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    AutomationProperties.Name="{Binding TextoAccion}">
                                                                <TextBlock Text="{Binding TextoAccion}" FontWeight="SemiBold" FontSize="12"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{loc:T Cfg_SinPlugins}"
                                                   Style="{StaticResource AppText.Secondary}" FontStyle="Italic" Margin="0,4,0,8"
                                                   Visibility="{Binding PluginsDetalle.Count, Converter={StaticResource ZeroToVis}}"/>

                                        <!-- Los .dll solo se cargan al iniciar la app -->
                                        <TextBlock Text="{loc:T Cfg_PluginsReiniciar}" Style="{StaticResource AppText.Caption}" Foreground="{DynamicResource Brush.Warning}"
                                                   TextWrapping="Wrap" Margin="0,2,0,6"
                                                   Visibility="{Binding PluginsRequiereReinicio, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource CfgDivider}"/>

                                    <Grid Margin="20,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:T Cfg_PluginsSub}" Style="{StaticResource AppText.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                        <Button Grid.Column="1" Command="{Binding AbrirCarpetaPluginsCommand}" Style="{StaticResource CfgRowButton}" VerticalAlignment="Center"
                                                AutomationProperties.Name="{loc:T Cfg_AbrirCarpetaPlugins}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{loc:T Cfg_AbrirCarpetaPlugins}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ BARRA DE GUARDADO: siempre visible en las categorías con preferencias ═══ -->
                <Border Grid.Row="1" Style="{StaticResource AppCard}" CornerRadius="12" Padding="16,10" Margin="0,12,20,0"
                        Visibility="{Binding MostrarBarraGuardar, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:T Cfg_GuardarHint}"
                                   Style="{StaticResource AppText.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                        <Button Grid.Column="1" Command="{Binding GuardarPreferenciasCommand}"
                                Style="{StaticResource AppPrimaryButton}"
                                Height="40" Padding="20,0" Cursor="Hand"
                                materialDesign:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{loc:T Cfg_Guardar}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
