<UserControl x:Class="AnimeLocalTracker.Views.DetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <Grid>
        <!-- EL FONDO DINÁMICO DESENFOCADO -->
        <Grid ClipToBounds="True">
            <!-- Acelerado y Asíncrono. Margin="-25" compensa el borde transparente del BlurEffect -->
            <Image Source="{Binding AnimeSeleccionado.PortadaVisible, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" 
                   Stretch="UniformToFill" Opacity="0.25" Margin="-25"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect>
                    <BlurEffect Radius="40" KernelType="Gaussian"/>
                </Image.Effect>
            </Image>
            <!-- Capa oscura para asegurar legibilidad en cualquier tema -->
            <Border Background="{DynamicResource MaterialDesignPaper}" Opacity="0.6"/>
        </Grid>

        <!-- EL CONTENIDO REAL -->
        <Grid MaxWidth="1248">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="105,55,40,40"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Margin" Value="105,25,40,40"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding VolverAGaleriaCommand}"
                        ToolTip="Volver a la biblioteca" Margin="0,5,20,0" Padding="8,4" Height="Auto" Foreground="{DynamicResource MaterialDesignBodyLight}"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="VOLVER" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                
                <TextBlock Grid.Column="1" 
                           Text="{Binding AnimeSeleccionado.Titulo}" 
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                           VerticalAlignment="Top" 
                           HorizontalAlignment="Left"
                           FontWeight="Bold"
                           TextWrapping="Wrap" 
                           MaxHeight="60" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding AnimeSeleccionado.Titulo}"
                           Margin="15,0" />
                       
                <Button Grid.Column="2" 
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        Command="{Binding EliminarAnimeActualCommand}"
                        Foreground="#E53935" Width="40" Height="40"
                        ToolTip="Eliminar de la biblioteca" Margin="20,0,0,0" VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="DeleteOutline" Width="24" Height="24" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Portada con elevación profunda y tamaño fijo -->
                <materialDesign:Card Grid.Column="0" Width="260" Height="370" UniformCornerRadius="12" VerticalAlignment="Top" materialDesign:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Border Style="{StaticResource ShimmerEffectStyle}" CornerRadius="12" />
                        <Image Source="{Binding AnimeSeleccionado.PortadaVisible, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" Stretch="UniformToFill" />
                    </Grid>
                </materialDesign:Card>

                <!-- COLUMNA DERECHA: Textos y Episodios -->
                <Grid Grid.Column="1" Margin="40,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding AnimeSeleccionado.RutaCarpeta}" Margin="0,0,0,20" Opacity="0.6" FontSize="12"/>
                        
                        <!-- Sinopsis -->
                        <TextBlock Text="{Binding AnimeSeleccionado.Sinopsis}" 
                                   TextWrapping="Wrap" FontSize="15" LineHeight="22"
                                   Margin="0,0,0,25" Opacity="0.85" 
                                   MaxHeight="130" TextTrimming="CharacterEllipsis"/>
                        
                        <!-- Botón de Tracker moderno -->
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Command="{Binding AbrirEditorSeguimientoCommand}" 
                                Visibility="{Binding EstaConectado, Converter={StaticResource BoolToVis}}"
                                BorderBrush="#3F51B5" Foreground="#3F51B5"
                                HorizontalAlignment="Left" Margin="0,0,0,20" Padding="15,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="GESTIONAR EN ANILIST" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        
                        <ItemsControl ItemsSource="{Binding AnimeSeleccionado.GenerosLista}" Margin="0,0,0,30">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E3F51B5" BorderBrush="#3F51B5" BorderThickness="1" CornerRadius="12" Padding="12,6" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding}" Foreground="#8C9EFF" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Cabecera de Episodios con Controles Masivos y Filtros -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Lista de Episodios" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            
                            <!-- Filtro y Orden -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding OpcionesFiltro}" SelectedItem="{Binding FiltroEpisodios}" 
                                          Width="130" materialDesign:TextFieldAssist.HasClearButton="False" 
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,6" Margin="0,0,10,0"/>
                                          
                                <ToggleButton IsChecked="{Binding OrdenAscendente}" Style="{StaticResource MaterialDesignActionToggleButton}"
                                              Content="{materialDesign:PackIcon Kind=SortDescending, Size=20}"
                                              materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=SortAscending, Size=20}"
                                              ToolTip="Cambiar orden" Width="36" Height="36" Background="#2A2A2A" BorderThickness="0" Foreground="White" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="✓ VISTOS" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#4CAF50" 
                                        Command="{Binding MarcarVistosCommand}" 
                                        CommandParameter="{Binding SelectedItems, ElementName=ListaEpisodios}" 
                                        ToolTip="Marcar seleccionados como vistos" Padding="8,4" Height="Auto" Margin="0,0,5,0"/>
                                        
                                <Button Content="✕ NO VISTOS" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E53935" 
                                        Command="{Binding MarcarNoVistosCommand}" 
                                        CommandParameter="{Binding SelectedItems, ElementName=ListaEpisodios}" 
                                        ToolTip="Marcar seleccionados como NO vistos" Padding="8,4" Height="Auto"/>
                                        
                                <Button Content="↻ ACTUALIZAR" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FF9800" 
                                        Command="{Binding ActualizarAnimeActualCommand}" 
                                        ToolTip="Actualizar episodios desde AniList" Padding="8,4" Height="Auto" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    
                    <ListBox Grid.Row="1" x:Name="ListaEpisodios" ItemsSource="{Binding EpisodiosDelAnime}" 
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible" Padding="0,0,10,0"
                             VirtualizingPanel.IsVirtualizing="True" 
                             VirtualizingPanel.VirtualizationMode="Recycling" 
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             SelectionMode="Extended">
                            
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Name="Border">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#1A4CAF50" />
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="#4CAF50" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#2A2A2A" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Columna 0: Punto azul no visto -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 1: Título y subtítulo -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Columna 2: Tamaño de archivo -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 3: Acción (Descargar / Progreso Circular / Reproducir) -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 4: Estrella Favorito -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- PUNTO AZUL (No Visto) -->
                                        <Ellipse Grid.Column="0" x:Name="PuntoNoVisto" Width="7" Height="7" 
                                                 Fill="#448AFF" VerticalAlignment="Center" Margin="0,0,12,0"
                                                 Visibility="{Binding Visto, Converter={StaticResource InverseBoolToVis}}"/>

                                        <!-- TÍTULO Y SUBTÍTULO -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TextoTitulo" Text="{Binding TituloVisual}" 
                                                       Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                        Visibility="{Binding TieneProgresoGuardado, Converter={StaticResource BoolToVis}}">
                                                <ProgressBar Value="{Binding PorcentajeProgreso, Mode=OneWay}" Maximum="1.0" 
                                                             Height="3" Width="80" Background="#33FFFFFF" Foreground="#00E5FF" 
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ProgresoFormateado}" Foreground="#00E5FF" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- TAMAÑO DE ARCHIVO (Cuando está descargado) -->
                                        <TextBlock Grid.Column="2" Text="{Binding TamanoArchivoFormateado}" 
                                                   Foreground="#90CAF9" FontSize="13" FontWeight="Medium" 
                                                   VerticalAlignment="Center" Margin="0,0,15,0"
                                                   Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}"/>

                                        <!-- BOTÓN / INDICADOR DE ACCIÓN -->
                                        <Grid Grid.Column="3" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <!-- 1. ESTADO: DESCARGADO (Checkmark circular para reproducir) -->
                                            <Button Command="{Binding DataContext.ReproducirEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36"
                                                    ToolTip="Reproducir episodio"
                                                    Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}">
                                                <materialDesign:PackIcon Kind="CheckCircle" Foreground="#82B1FF" Width="26" Height="26" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- 2. ESTADO: DESCARGANDO O EN ESPERA -->
                                            <Grid Width="36" Height="36" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip="Descargando"
                                                  Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                                
                                                <!-- Lienzo / Pista circular de fondo (Track) para visualizar el total -->
                                                <Ellipse Width="26" Height="26" Stroke="#33FFFFFF" StrokeThickness="3" 
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <!-- Animación de espera / en cola (Progreso 0%) -->
                                                <ProgressBar Width="26" Height="26" Foreground="#82B1FF"
                                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True"
                                                             ToolTip="Descargando"
                                                             Visibility="{Binding EstaEnEspera, Converter={StaticResource BoolToVis}}"
                                                             VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <!-- Progreso activo circular determinado (> 0%) -->
                                                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" 
                                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             Width="26" Height="26" Foreground="#82B1FF"
                                                             IsIndeterminate="False"
                                                             ToolTip="Descargando"
                                                             Visibility="{Binding ProgresoDescargaActivo, Converter={StaticResource BoolToVis}}"
                                                             VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>

                                            <!-- 3. ESTADO: NO DESCARGADO (Icono circular flecha abajo para descargar) -->
                                            <Button Command="{Binding DataContext.DescargarEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="36" Height="36"
                                                    ToolTip="Descargar episodio">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Descargado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="DownloadCircleOutline" Foreground="#82B1FF" Width="26" Height="26" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <!-- BOTÓN FAVORITO -->
                                        <Button Grid.Column="4"
                                                Command="{Binding DataContext.AlternarFavoritoEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Margin="0,0,2,0"
                                                ToolTip="Marcar como favorito">
                                            <materialDesign:PackIcon x:Name="IconoEstrella" Kind="StarOutline" Foreground="#555555" VerticalAlignment="Center" Width="18" Height="18"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                
                                <DataTemplate.Triggers>
                                    <!-- ESTADO VISTO: TÍTULO ATENUADO -->
                                    <DataTrigger Binding="{Binding Visto}" Value="True">
                                        <Setter TargetName="TextoTitulo" Property="Foreground" Value="#757D8A" />
                                        <Setter TargetName="TextoTitulo" Property="Opacity" Value="0.6" />
                                        <Setter TargetName="TextoTitulo" Property="FontWeight" Value="Normal" />
                                    </DataTrigger>
                                    <!-- ESTADO DESCARGANDO -->
                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                        <Setter TargetName="TextoTitulo" Property="Opacity" Value="0.75" />
                                    </DataTrigger>
                                    <!-- FAVORITO -->
                                    <DataTrigger Binding="{Binding Favorito}" Value="True">
                                        <Setter TargetName="IconoEstrella" Property="Kind" Value="Star" />
                                        <Setter TargetName="IconoEstrella" Property="Foreground" Value="#FFC107" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EpisodiosDelAnime.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="ClockAlertOutline" Width="56" Height="56" Foreground="#44FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="{Binding MensajeSinEpisodios}" Foreground="#AAFFFFFF" FontSize="18" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SubtituloSinEpisodios}" Foreground="#66FFFFFF" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        
        <!-- PARTE 3: OVERLAY DEL EDITOR DE SEGUIMIENTO -->
        <!-- Lo metemos dentro de DetalleView para que pertenezca a DetalleViewModel -->
        <Grid Visibility="{Binding MostrandoEditorSeguimiento, Converter={StaticResource BoolToVis}}" 
              Background="#CC000000" Panel.ZIndex="100">

            <materialDesign:Card Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                 UniformCornerRadius="14" Background="{DynamicResource MaterialDesignPaper}" 
                                 materialDesign:ElevationAssist.Elevation="Dp8" Padding="25">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <materialDesign:PackIcon Kind="CloudSync" Width="28" Height="28" Foreground="#3F51B5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Actualizar Progreso (AniList)" Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Estado -->
                    <TextBlock Text="Estado" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <ComboBox ItemsSource="{Binding OpcionesEstadoVisual}" 
                              SelectedItem="{Binding EditEstadoVisual}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                              Margin="0,0,0,20"/>

                    <!-- Progreso -->
                    <TextBlock Text="Episodios Vistos" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBox Text="{Binding EditProgreso, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                             Margin="0,0,0,20" />

                    <!-- Puntaje -->
                    <TextBlock Text="Puntuación (0-100)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Slider Minimum="0" Maximum="100" Value="{Binding EditPuntaje, UpdateSourceTrigger=PropertyChanged}" 
                                Width="260" VerticalAlignment="Center" Margin="0,0,15,0"
                                Foreground="#FFC107" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock Text="{Binding EditPuntaje, StringFormat={}{0:F0}}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Fechas -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Fecha Inicio" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <DatePicker SelectedDate="{Binding EditFechaInicio}" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Fecha Fin" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <DatePicker SelectedDate="{Binding EditFechaFin}" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCELAR" Command="{Binding CerrarEditorSeguimientoCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                        <Button Content="GUARDAR EN LA NUBE" Command="{Binding GuardarEditorSeguimientoCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#3F51B5" BorderBrush="#3F51B5" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
