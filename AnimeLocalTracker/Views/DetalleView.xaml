<UserControl x:Class="AnimeLocalTracker.Views.DetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="#121212">
    <UserControl.Resources>

    <!-- ══ Botón redondo de icono de las filas de episodio (favorito, reproducir, opciones, descargar, elegir torrent). Plantilla
         mínima: la de Material Design trae la animación de onda y varias capas, y con 3 botones visibles por fila era lo
         que más pesaba al crear cada fila. ══ -->
    <Style x:Key="DetRowIconBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Raiz" Background="{TemplateBinding Background}" CornerRadius="17">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Raiz" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Raiz" Property="Background" Value="{StaticResource Brush.RingBase}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Menú contextual de una fila de episodio. Uno solo para toda la lista: antes cada fila creaba el suyo (menú, 6 opciones,
         iconos y estilos) aunque nunca se abriera, y esa era buena parte de lo que costaba pintar la lista. Su DataContext es el
         episodio de la fila sobre la que se abre (PlacementTarget); los comandos llegan por el Tag de esa fila (el ViewModel). ══ -->
    <ContextMenu x:Key="MenuEpisodio" Placement="RelativePoint" HorizontalOffset="18" VerticalOffset="12"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                 Background="#151B29" BorderBrush="{StaticResource Brush.BorderControl}" BorderThickness="1"
                 Padding="6" FontSize="12.5" Foreground="{StaticResource Brush.TextPrimary}" HasDropShadow="False">
        <ContextMenu.Resources>
            <Style TargetType="ContextMenu">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="FondoItem" Background="{TemplateBinding Background}"
                                    CornerRadius="7" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="FondoItem" Property="Background" Value="#24344A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Separator">
                <Setter Property="Background" Value="{StaticResource Brush.BorderControl}"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="8,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Background="{TemplateBinding Background}"
                                    Height="{TemplateBinding Height}"
                                    Margin="{TemplateBinding Margin}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ContextMenu.Resources>
        <MenuItem Header="{loc:T Act_Reproducir}"
                  Command="{Binding PlacementTarget.Tag.Episodios.ReproducirEpisodioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}"
                  Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}">
            <MenuItem.Icon>
                <materialDesign:PackIcon Kind="PlayArrow" Foreground="{StaticResource Brush.Accent}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <!-- "Reproducir" (y su separador) solo en los episodios que están en disco -->
        <Separator Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}"/>
        <MenuItem Header="{loc:T Det_MarcarVisto}"
                  Command="{Binding PlacementTarget.Tag.Episodios.AlternarVistoEpisodioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}"
                  Visibility="{Binding Visto, Converter={StaticResource InverseBoolToVis}}">
            <MenuItem.Icon>
                <materialDesign:PackIcon Kind="Check" Foreground="#10B981" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{loc:T Det_MarcarNoVisto}"
                  Command="{Binding PlacementTarget.Tag.Episodios.AlternarVistoEpisodioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}"
                  Visibility="{Binding Visto, Converter={StaticResource BoolToVis}}">
            <MenuItem.Icon>
                <materialDesign:PackIcon Kind="EyeOffOutline" Foreground="{StaticResource Brush.TextSecondary}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{loc:T Det_MarcarAnterioresVistos}"
                  Command="{Binding PlacementTarget.Tag.Episodios.MarcarAnterioresVistosCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}">
            <MenuItem.Icon>
                <materialDesign:PackIcon Kind="CheckAll" Foreground="{StaticResource Brush.Success}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{loc:T Det_MarcarTemporadaCompleta}"
                  Command="{Binding PlacementTarget.Tag.Episodios.MarcarTemporadaCompletaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
            <MenuItem.Icon>
                <materialDesign:PackIcon Kind="PlaylistCheck" Foreground="{StaticResource Brush.Accent}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <!-- Como "Eliminar": solo en los episodios que están en disco (si no, quedaba una raya suelta al final del menú) -->
        <Separator Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}"/>
        <MenuItem Header="{loc:T Det_EliminarEpisodio}"
                  Command="{Binding PlacementTarget.Tag.Episodios.EliminarEpisodioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}"
                  Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}">
            <MenuItem.Icon>
                <materialDesign:PackIcon Kind="DeleteOutline" Foreground="{StaticResource Brush.Danger}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>

    <!-- ══ Barra de acciones de la cabecera de episodios: botones neutros y menús desplegables ══ -->
    <Style x:Key="DetToolBtn" TargetType="ButtonBase">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSoft}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Raiz" Background="{StaticResource Brush.SurfaceControl}" BorderBrush="{StaticResource Brush.BorderControl}" BorderThickness="1" CornerRadius="10" Padding="9,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Raiz" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Raiz" Property="Background" Value="{StaticResource Brush.Surface3}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DetToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource DetToolBtn}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.AccentSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ítem de menú: icono + título + descripción -->
    <Style x:Key="DetMenuItem" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <EventSetter Event="Click" Handler="MenuAcciones_ItemClick"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Raiz" Background="Transparent" CornerRadius="8" Padding="10,8">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Raiz" Property="Background" Value="{StaticResource Brush.Surface3}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DetMenuCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceDialog}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Width" Value="270"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>
    </UserControl.Resources>


    <Grid>
        <!-- 1. FONDO DIFUMINADO HERO CON DEGRADADO SUAVE -->
        <Grid ClipToBounds="True">
            <Image Source="{Binding AnimeSeleccionado.PortadaVisible, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" 
                   Stretch="UniformToFill" Opacity="0.30" Margin="-35"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect>
                    <BlurEffect Radius="50" KernelType="Gaussian"/>
                </Image.Effect>
            </Image>
            
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#66000000" Offset="0.0"/>
                        <GradientStop Color="#B3121212" Offset="0.35"/>
                        <GradientStop Color="#F2121212" Offset="0.70"/>
                        <GradientStop Color="#FF121212" Offset="0.95"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- 2. CONTENIDO PRINCIPAL: DISTRIBUCIÓN EN 2 COLUMNAS (PORTADA Y METADATOS IZQUIERDA / INFO Y EPISODIOS DERECHA) -->
        <Grid MaxWidth="1450">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="95,65,30,25"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Margin" Value="95,35,30,25"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <!-- COLUMNA IZQUIERDA: PÓSTER DESTACADO, ACCIONES Y BADGES -->
                <ColumnDefinition Width="285"/>
                <!-- COLUMNA DERECHA: TÍTULO, SINOPSIS, GÉNEROS Y LISTA DE EPISODIOS -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= COLUMNA IZQUIERDA (PÓSTER Y ACCIONES) ================= -->
            <ScrollViewer x:Name="ColumnaPortadaScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,30,0" Padding="0,0,4,0">
                <StackPanel HorizontalAlignment="Stretch">
                    
                    <!-- PÓSTER DESTACADO Y GRANDE -->
                    <materialDesign:Card Width="255" Height="365" UniformCornerRadius="16" 
                                         materialDesign:ElevationAssist.Elevation="Dp8" Background="#1A1A1A" 
                                         HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Grid>
                            <Border Style="{StaticResource ShimmerEffectStyle}" CornerRadius="16" />
                            <Image Source="{Binding AnimeSeleccionado.PortadaVisible, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" 
                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                        </Grid>
                    </materialDesign:Card>

                    <!-- BARRA DE ACCIONES ELEGANTE INTEGRADA (BAJO EL PÓSTER) -->
                    <Border Background="{StaticResource Brush.Surface2}" CornerRadius="12" Padding="4" Margin="0,0,0,0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Center" Width="255">
                        <UniformGrid Rows="1" HorizontalAlignment="Stretch">
                            <!-- 1. FAVORITO. Antes este corazón era "Biblioteca" y lo que hacía era ELIMINAR el anime; eliminar está
                                 ahora en el menú de herramientas de la lista. -->
                            <Button Command="{Binding AlternarFavoritoAnimeCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="4,8" Height="Auto" Cursor="Hand"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{loc:T Det_FavoritoAnimeTip}"
                                    AutomationProperties.Name="{loc:T Det_FavoritoAnime}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Width="20" Height="20" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Rose}">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="HeartOutline"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsFavoritoAnime}" Value="True">
                                                        <Setter Property="Kind" Value="Heart"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{loc:T Det_FavoritoAnime}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. SEGUIMIENTO (AniList) - SOLO VISIBLE SI EL USUARIO ESTÁ LOGEADO -->
                            <Button Command="{Binding Seguimiento.AbrirEditorSeguimientoCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Visibility="{Binding EstaConectado, Converter={StaticResource BoolToVis}}"
                                    Padding="4,8" Height="Auto"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{loc:T Det_SeguimientoTip}"
                                    AutomationProperties.Name="{loc:T Det_Seguimiento}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Sync" Width="20" Height="20" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Text="{loc:T Det_Seguimiento}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. WEBVIEW -->
                            <Button Command="{Binding AbrirWebViewCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="4,8" Height="Auto"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{loc:T Det_WebViewTip}"
                                    AutomationProperties.Name="{loc:T Det_WebView}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Earth" Width="20" Height="20" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Text="{loc:T Det_WebView}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= COLUMNA DERECHA (INFO PRINCIPAL + EPISODIOS) ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- FILA 0: TÍTULO, SUBTÍTULO, BADGES, SINOPSIS -->
                    <RowDefinition Height="Auto"/>
                    <!-- FILA 1: CABECERA Y LISTA DE EPISODIOS -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BLOQUE DE INFORMACIÓN (TÍTULO, METADATOS, BADGES, SINOPSIS) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <!-- TÍTULO PRINCIPAL -->
                    <TextBlock Text="{Binding AnimeSeleccionado.Titulo}" 
                               FontSize="26" FontWeight="Bold" Foreground="White"
                               TextWrapping="Wrap" LineHeight="32"
                               ToolTip="{Binding AnimeSeleccionado.Titulo}"
                               Margin="0,0,0,4"/>

                    <!-- SUBTÍTULO / NOMBRES ALTERNATIVOS Y ESTUDIO -->
                    <TextBlock Text="{Binding AnimeSeleccionado.NombresAlternativos}" 
                               FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" 
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- FILA UNIFICADA DE BADGES (ESTADO, PROGRESO Y GÉNEROS) -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <!-- Badge Estado (En Emisión / Finalizado) -->
                        <Border BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,6" VerticalAlignment="Center">
                            <!-- Verde solo si está en emisión; antes el fondo era verde también en "Finalizado" -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceControl}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderControl}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AnimeSeleccionado.Estado}" Value="RELEASING">
                                            <Setter Property="Background" Value="#1A10B981"/>
                                            <Setter Property="BorderBrush" Value="#3310B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="13" Height="13" Foreground="{Binding AnimeSeleccionado.ColorEstado}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding AnimeSeleccionado.EstadoVisual}" FontSize="11" Foreground="{Binding AnimeSeleccionado.ColorEstado}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Badge Progreso (Episodios vistos) -->
                        <Border Background="{StaticResource Brush.AccentStrongTint}" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="EyeOutline" Width="13" Height="13" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding AnimeSeleccionado.ProgresoEpisodiosTexto}" FontSize="11" Foreground="{StaticResource Brush.AccentSoft}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Badge Próximo episodio: cuenta atrás en vivo (dato local). Al pulsarlo: avisos y descarga automática -->
                        <Grid Margin="0,0,8,6" VerticalAlignment="Center"
                              Visibility="{Binding TieneContadorProximo, Converter={StaticResource BoolToVis}}">
                            <ToggleButton x:Name="AvisosToggle" Style="{StaticResource DetChipToggle}"
                                          IsChecked="{Binding IsOpen, ElementName=AvisosPopup, Mode=TwoWay}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=AvisosPopup, Converter={StaticResource InverseBool}}"
                                          ToolTip="{Binding ContadorProximoTooltip}"
                                          AutomationProperties.Name="{loc:T Det_AvisosTip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="TimerOutline" Width="13" Height="13" Foreground="{StaticResource Brush.WarningStrong}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding ContadorProximoTexto}" FontSize="11" Foreground="{StaticResource Brush.WarningSoft}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="BellRing" Width="12" Height="12" Foreground="{StaticResource Brush.WarningStrong}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                             Visibility="{Binding TieneAvisosActivos, Converter={StaticResource BoolToVis}}"/>
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="13" Height="13" Foreground="{StaticResource Brush.WarningStrong}" VerticalAlignment="Center" Margin="3,1,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <Popup x:Name="AvisosPopup" PlacementTarget="{Binding ElementName=AvisosToggle}" Placement="Bottom" VerticalOffset="6"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource DetMenuCard}" Width="320" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T Det_AvisosTitulo}" FontSize="13.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{loc:T Det_AvisosAvisarTitulo}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{loc:T Det_AvisosAvisarDesc}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"
                                                          IsChecked="{Binding AvisarEpisodioNuevo, Mode=TwoWay}" Cursor="Hand"
                                                          AutomationProperties.Name="{loc:T Det_AvisosAvisarTitulo}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{loc:T Det_AvisosDescargarTitulo}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{loc:T Det_AvisosDescargarDesc}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"
                                                          IsChecked="{Binding DescargarAutomaticamente, Mode=TwoWay}" Cursor="Hand"
                                                          AutomationProperties.Name="{loc:T Det_AvisosDescargarTitulo}"/>
                                        </Grid>

                                        <TextBlock Text="{loc:T Det_AvisosNota}" FontSize="10.5" Foreground="{StaticResource Brush.IconMuted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Badge Espacio en disco -->
                        <Border Background="#1A64748B" BorderBrush="#3364748B" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,6" VerticalAlignment="Center"
                                Visibility="{Binding TieneEspacioEnDisco, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding EspacioEnDiscoTooltip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="HarddiskPlus" Width="13" Height="13" Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding EspacioEnDiscoTexto}" FontSize="11" Foreground="{StaticResource Brush.TextSoft}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Etiquetas con datos de AniList (nota, formato y duración, estudio, fuente) -->
                        <ItemsControl ItemsSource="{Binding EtiquetasAniList}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.SurfaceControl}" BorderBrush="{StaticResource Brush.BorderControl}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,6" VerticalAlignment="Center"
                                            ToolTip="{Binding Tooltip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="{Binding Icono}" Width="13" Height="13" Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Texto}" FontSize="11" Foreground="{StaticResource Brush.TextSoft}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Tráiler -->
                        <Button Command="{Binding AbrirTrailerCommand}" Style="{StaticResource DetChipButton}" Margin="0,0,8,6" VerticalAlignment="Center"
                                Visibility="{Binding TieneTrailer, Converter={StaticResource BoolToVis}}"
                                ToolTip="{loc:T Det_TrailerTip}" AutomationProperties.Name="{loc:T Det_Trailer}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="13" Height="13" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{loc:T Det_Trailer}" FontSize="11" Foreground="{StaticResource Brush.AccentSoft}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Openings & Endings (AnimeThemes.moe) -->
                        <Button Command="{Binding Musica.ToggleMusicaCommand}" Style="{StaticResource DetChipButton}" Margin="0,0,8,6" VerticalAlignment="Center"
                                Visibility="{Binding Musica.TieneTemasMusicales, Converter={StaticResource BoolToVis}}"
                                ToolTip="{loc:T Det_MusicaTip}" AutomationProperties.Name="{loc:T Det_Musica}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Con un tema sonando (aunque el panel esté cerrado) el icono pasa a un ecualizador -->
                                <materialDesign:PackIcon Width="13" Height="13" Foreground="{StaticResource Brush.Music}" VerticalAlignment="Center" Margin="0,0,5,0">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="MusicNote"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Musica.MusicaSonando}" Value="True">
                                                    <Setter Property="Kind" Value="Equalizer"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{loc:T Det_Musica}" FontSize="11" Foreground="{StaticResource Brush.MusicSoft}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Musica.MusicaSonando, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource Brush.Music}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:T Det_MusicaSonando}" FontSize="11" Foreground="{StaticResource Brush.Music}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Chips de Géneros -->
                        <ItemsControl ItemsSource="{Binding AnimeSeleccionado.GenerosLista}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.SurfaceControl}" BorderBrush="{StaticResource Brush.BorderControl}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,6,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Converter={StaticResource GeneroTraducido}}" Foreground="{StaticResource Brush.TextSecondary}" FontWeight="Medium" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <!-- SINOPSIS LIMPIA EXPANDIBLE INTELIGENTE -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding AnimeSeleccionado.SinopsisLimpia}" 
                                   TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                   Foreground="#D1D5DB" Opacity="0.9">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="MaxHeight" Value="1000"/>
                                    <Setter Property="TextTrimming" Value="None"/>
                                    <Style.Triggers>
                                        <!-- Cuando la sinopsis es larga y NO está expandida, limitamos la altura a 3 líneas aprox -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding AnimeSeleccionado.TieneSinopsisLarga}" Value="True"/>
                                                <Condition Binding="{Binding SinopsisExpandida}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="MaxHeight" Value="60"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Botón de expandir/contraer: Solo visible si la sinopsis es larga -->
                        <Button Command="{Binding AlternarSinopsisCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Visibility="{Binding AnimeSeleccionado.TieneSinopsisLarga, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Left" Height="22" Padding="6,0" Margin="0,2,0,0">
                            <materialDesign:PackIcon Foreground="{StaticResource Brush.TextSecondary}" Width="18" Height="18">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronDown"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SinopsisExpandida}" Value="True">
                                                <Setter Property="Kind" Value="ChevronUp"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </StackPanel>

                    <!-- DIVISOR ELEGANTE -->
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,4,0,12"/>
                </StackPanel>

                <!-- CABECERA Y LISTA DE EPISODIOS VERTICAL -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- BANNER EPISODIOS FALTANTES (huecos silenciosos en la carpeta local) -->
                        <Border CornerRadius="8" Background="#1F1708" BorderBrush="#B45309" BorderThickness="1"
                                Padding="12,8" Margin="0,0,0,10"
                                Visibility="{Binding Episodios.HayEpisodiosFaltantes, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="AlertOutline" Width="18" Height="18" Foreground="{StaticResource Brush.WarningStrong}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Episodios.EpisodiosFaltantesTexto}" Foreground="{StaticResource Brush.WarningSoft}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Command="{Binding Episodios.DescargarFaltantesCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        BorderBrush="{StaticResource Brush.WarningStrong}" Foreground="{StaticResource Brush.WarningStrong}"
                                        Height="30" Padding="10,0" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DownloadOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{loc:T Det_DescargarFaltantes}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- DESHACER EL ÚLTIMO MARCADO: unos segundos tras marcar episodios como vistos / no vistos -->
                        <Border CornerRadius="8" Background="{StaticResource Brush.Surface2}" BorderBrush="{StaticResource Brush.BorderControl}" BorderThickness="1"
                                Padding="12,6" Margin="0,0,0,10"
                                Visibility="{Binding Episodios.PuedeDeshacerMarcado, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="CheckAll" Width="17" Height="17" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Episodios.DeshacerMarcadoTexto}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Command="{Binding Episodios.DeshacerMarcadoCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{StaticResource Brush.Accent}" Foreground="{StaticResource Brush.AccentSoft}"
                                        Height="28" Padding="10,0" Margin="10,0,0,0" Cursor="Hand"
                                        AutomationProperties.Name="{loc:T Det_Deshacer}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="UndoVariant" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{loc:T Det_Deshacer}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding Episodios.OlvidarMarcadoAnteriorCommand}" Style="{StaticResource MaterialDesignToolButton}"
                                        Width="26" Height="26" Padding="0" Margin="4,0,0,0" Cursor="Hand"
                                        ToolTip="{loc:T Det_DeshacerDescartar}"
                                        AutomationProperties.Name="{loc:T Det_DeshacerDescartar}">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="{StaticResource Brush.TextTertiary}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- CABECERA DE LA LISTA DE EPISODIOS -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- CONTEO DE EPISODIOS -->
                        <TextBlock Grid.Column="0" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                    <Binding Path="[Det_EpisodiosFormato]" Source="{x:Static loc:LocalizationService.Instance}" />
                                    <Binding Path="Episodios.EpisodiosDelAnime.Count" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- FILTRO Y ORDENACIÓN (lo que cambia QUÉ episodios se ven) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Episodios.OpcionesFiltro}" SelectedItem="{Binding Episodios.FiltroSeleccionado}"
                                      DisplayMemberPath="Texto"
                                      AutomationProperties.Name="{loc:T Det_FiltroEpisodios}"
                                      Height="34" Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>

                            <ToggleButton IsChecked="{Binding Episodios.OrdenAscendente}" Style="{StaticResource MaterialDesignActionToggleButton}"
                                          Content="{materialDesign:PackIcon Kind=SortDescending, Size=18}"
                                          materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=SortAscending, Size=18}"
                                          ToolTip="{loc:T Det_OrdenTip}" Width="34" Height="34" Background="{StaticResource Brush.SurfaceControl}" BorderBrush="{StaticResource Brush.BorderControl}" BorderThickness="1" Foreground="White"
                                          AutomationProperties.Name="{loc:T Det_OrdenTip}" />

                            <!-- IR A UN EPISODIO: solo en series largas (en One Piece no había forma de llegar al 600 sin recorrer la lista) -->
                            <Border Background="{StaticResource Brush.SurfaceControl}" BorderBrush="{StaticResource Brush.BorderControl}" BorderThickness="1" CornerRadius="10" Height="34" Margin="8,0,0,0" Padding="10,0"
                                    Visibility="{Binding Episodios.MostrarIrAEpisodio, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{loc:T Det_IrAEpisodioTip}">
                                <TextBox x:Name="CajaIrAEpisodio" Width="72" BorderThickness="0" Background="Transparent" Padding="0"
                                         Foreground="White" FontSize="12" CaretBrush="{StaticResource Brush.Accent}" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                         materialDesign:HintAssist.Hint="{loc:T Det_IrAEpisodio}"
                                         materialDesign:HintAssist.IsFloating="False"
                                         PreviewTextInput="CajaIrAEpisodio_PreviewTextInput" KeyDown="CajaIrAEpisodio_KeyDown"
                                         AutomationProperties.Name="{loc:T Det_IrAEpisodioTip}"/>
                            </Border>
                        </StackPanel>

                        <!-- ACCIONES: 2 menús + 2 botones de icono, todos con el mismo estilo (antes 7 botones de colores) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- MARCAR ▾ : vistos / no vistos de los episodios seleccionados (o todos) -->
                            <Grid Margin="0,0,6,0">
                                <ToggleButton x:Name="MarcarToggle" Style="{StaticResource DetToolToggle}" Width="104"
                                              IsChecked="{Binding IsOpen, ElementName=MarcarPopup, Mode=TwoWay}"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=MarcarPopup, Converter={StaticResource InverseBool}}"
                                              ToolTip="{loc:T Det_MarcarVistosTip}"
                                              AutomationProperties.Name="{loc:T Det_Marcar}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckAll" Width="17" Height="17" VerticalAlignment="Center" Foreground="{StaticResource Brush.Success}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:T Det_Marcar}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="ChevronDown" Width="15" Height="15" VerticalAlignment="Center" Margin="4,1,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup x:Name="MarcarPopup" PlacementTarget="{Binding ElementName=MarcarToggle}" Placement="Bottom"
                                       HorizontalOffset="-166" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Style="{StaticResource DetMenuCard}">
                                        <StackPanel>
                                    <Button Command="{Binding Episodios.MarcarVistosCommand}" Style="{StaticResource DetMenuItem}"
                                            CommandParameter="{Binding SelectedItems, ElementName=ListaEpisodios}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="CheckAll" Width="20" Height="20" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:T Det_MarcarComoVistos}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{loc:T Det_MarcarVistosTip}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding Episodios.MarcarNoVistosCommand}" Style="{StaticResource DetMenuItem}"
                                            CommandParameter="{Binding SelectedItems, ElementName=ListaEpisodios}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="EyeOffOutline" Width="20" Height="20" Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:T Det_MarcarComoNoVistos}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{loc:T Det_MarcarNoVistosTip}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- ACTUALIZAR desde AniList -->
                            <Button Command="{Binding ActualizarAnimeActualCommand}" Style="{StaticResource DetToolBtn}" Margin="0,0,6,0"
                                    ToolTip="{loc:T Det_ActualizarTip}" AutomationProperties.Name="{loc:T Det_Actualizar}">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="{StaticResource Brush.Accent}"/>
                            </Button>

                            <!-- CARPETA del anime -->
                            <Button Command="{Binding AbrirCarpetaAnimeCommand}" Style="{StaticResource DetToolBtn}" Margin="0,0,6,0"
                                    ToolTip="{loc:T Det_CarpetaTip}" AutomationProperties.Name="{loc:T Det_Carpeta}">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" Foreground="{StaticResource Brush.Success}"/>
                            </Button>

                            <!-- HERRAMIENTAS ⋯ : detectar OP, verificar integridad, duplicados -->
                            <Grid>
                                <ToggleButton x:Name="HerramientasToggle" Style="{StaticResource DetToolToggle}"
                                              IsChecked="{Binding IsOpen, ElementName=HerramientasPopup, Mode=TwoWay}"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=HerramientasPopup, Converter={StaticResource InverseBool}}"
                                              ToolTip="{loc:T Det_Herramientas}" AutomationProperties.Name="{loc:T Det_Herramientas}">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="DotsHorizontal" Width="20" Height="20">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Episodios.VerificandoIntegridad}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Episodios.EstaAnalizandoDuplicados}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <!-- Herramienta en curso: spinner en el propio botón -->
                                        <ProgressBar Width="16" Height="16" IsIndeterminate="True" Foreground="{StaticResource Brush.WarningStrong}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignCircularProgressBar}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Episodios.VerificandoIntegridad}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Episodios.EstaAnalizandoDuplicados}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </Grid>
                                </ToggleButton>
                                <Popup x:Name="HerramientasPopup" PlacementTarget="{Binding ElementName=HerramientasToggle}" Placement="Bottom"
                                       HorizontalOffset="-236" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Style="{StaticResource DetMenuCard}">
                                        <StackPanel>
                                    <Button Command="{Binding Episodios.AnalizarOpeningsCommand}" Style="{StaticResource DetMenuItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:T Det_DetectarOp}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{loc:T Det_DetectarOpTip}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding Episodios.VerificarIntegridadCommand}" Style="{StaticResource DetMenuItem}"
                                            IsEnabled="{Binding Episodios.VerificandoIntegridad, Converter={StaticResource InverseBool}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="ShieldSearch" Width="20" Height="20" Foreground="{StaticResource Brush.WarningStrong}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:T Det_VerificarIntegridad}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{loc:T Det_VerificarIntegridadDesc}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding Episodios.AnalizarDuplicadosCommand}" Style="{StaticResource DetMenuItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="ContentDuplicate" Width="20" Height="20" Foreground="{StaticResource Brush.WarningStrong}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:T Det_Duplicados}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{loc:T Det_DuplicadosTip}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding LiberarEspacioCommand}" Style="{StaticResource DetMenuItem}"
                                            IsEnabled="{Binding HayEspacioLiberable}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="DeleteSweepOutline" Width="20" Height="20" Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:T Det_LiberarEspacio}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{Binding LiberarEspacioDescripcion}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Border Height="1" Background="{StaticResource Brush.BorderControl}" Margin="8,4"/>
                                    <Button Command="{Binding EliminarAnimeActualCommand}" Style="{StaticResource DetMenuItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="TrashCanOutline" Width="20" Height="20" Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:T Bib_EliminarTitulo}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{loc:T Det_EliminarDeBibliotecaDesc}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Grid>

                <!-- LISTA DE EPISODIOS VIRTUALIZADA CON DISEÑO VERTICAL COMPLETO -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="ListaEpisodios" ItemsSource="{Binding Episodios.EpisodiosDelAnime}"
                             MouseDoubleClick="ListaEpisodios_MouseDoubleClick" KeyDown="ListaEpisodios_KeyDown"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0,0,10,60"
                             VirtualizingPanel.IsVirtualizing="True" 
                             VirtualizingPanel.VirtualizationMode="Recycling" 
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             SelectionMode="Extended">
                        
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Name="Border">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.AccentStrongTint}" />
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Brush.AccentStrong}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.SurfaceChip}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Menú contextual (recurso MenuEpisodio): clic derecho en la fila, o clic izquierdo sobre el icono de
                                     episodio descargado -->
                                <Border Padding="10,8" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" AutomationProperties.Name="{Binding ResumenAccesible}"
                                        ContextMenu="{StaticResource MenuEpisodio}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Columna 0: Punto no visto + Marcador Bookmark -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 1: Miniatura del episodio -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 2: Título y subtítulo -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Columna 3: Tamaño de archivo -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 4: Acción Descargar / Progreso / Reproducir -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- PUNTO NO VISTO + MARCADOR BOOKMARK -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse x:Name="PuntoNoVisto" Width="6" Height="6" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     Visibility="Visible"/>

                                            <Button Command="{Binding DataContext.Episodios.AlternarFavoritoEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DetRowIconBtn}" Width="26" Height="26" Padding="0"
                                                    ToolTip="{loc:T Det_FavoritoTip}"
                                                    AutomationProperties.Name="{loc:T Det_FavoritoTip}">
                                                <materialDesign:PackIcon x:Name="IconoBookmark" Kind="BookmarkOutline" Foreground="#6B7280" Width="17" Height="17" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- MINIATURA DEL EPISODIO (generada vía Python/ffmpeg) -->
                                        <Border x:Name="BorderMiniatura" Grid.Column="1" Width="72" Height="40" CornerRadius="5" Margin="0,0,10,0"
                                                Background="{StaticResource Brush.SurfaceChip}" BorderBrush="{StaticResource Brush.BorderControl}" BorderThickness="1" VerticalAlignment="Center"
                                                Visibility="Visible">
                                            <Image Source="{Binding RutaMiniatura, TargetNullValue={x:Null}}" Stretch="UniformToFill" 
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,72,40" RadiusX="5" RadiusY="5"/>
                                                </Image.Clip>
                                            </Image>
                                        </Border>

                                        <!-- TÍTULO Y SUBTÍTULO / PROGRESO -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TextoTitulo" Text="{Binding TituloVisual}" 
                                                       Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            
                                            <StackPanel x:Name="PanelProgreso" Orientation="Horizontal" Margin="0,3,0,0"
                                                        Visibility="Visible">
                                                <ProgressBar Value="{Binding PorcentajeProgreso, Mode=OneWay}" Style="{StaticResource AppWatchProgressBar}" Width="90" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ProgresoFormateado}" Foreground="{StaticResource Brush.AccentSoft}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- BADGE TÉCNICO (metadata ffprobe vía Python) -->
                                            <Border x:Name="BadgeTecnico" CornerRadius="4" Background="{StaticResource Brush.SurfaceChip}" BorderBrush="{StaticResource Brush.BorderControl}" BorderThickness="1"
                                                    Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                    Visibility="Visible">
                                                <TextBlock Text="{Binding BadgeTecnico}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" FontWeight="Medium"/>
                                            </Border>

                                            <!-- BADGE ARCHIVO CORRUPTO (Doctor de Integridad) -->
                                            <Border CornerRadius="4" Background="#3A1416" BorderBrush="{StaticResource Brush.Danger}" BorderThickness="1"
                                                    Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                    ToolTip="{loc:T Det_ArchivoCorruptoTip}"
                                                    Visibility="{Binding EstaCorrupto, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AlertOctagonOutline" Width="11" Height="11" Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{loc:T Det_ArchivoCorruptoBadge}" Foreground="#FCA5A5" FontSize="10" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- TAMAÑO DE ARCHIVO -->
                                        <TextBlock Grid.Column="3" Text="{Binding TamanoArchivoFormateado}" 
                                                   Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" FontWeight="Medium" 
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}"/>

                                        <!-- ACCIÓN: DESCARGAR / REPRODUCIR / DESCARGANDO -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            
                                            <!-- 1a. DESCARGADO: BOTÓN DIRECTO PARA REPRODUCIR -->
                                            <Button Command="{Binding DataContext.Episodios.ReproducirEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DetRowIconBtn}" Width="34" Height="34"
                                                    ToolTip="{loc:T Act_Reproducir}"
                                                    AutomationProperties.Name="{loc:T Act_Reproducir}"
                                                    Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,0,4,0">
                                                <materialDesign:PackIcon Kind="PlayCircle" Foreground="{StaticResource Brush.Accent}" Width="28" Height="28" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- 1b. DESCARGADO: ICONO QUE ABRE EL MENÚ DEL EPISODIO -->
                                            <Button Click="BotonEpisodioDescargado_Click"
                                                    Style="{StaticResource DetRowIconBtn}" Width="34" Height="34"
                                                    ToolTip="{loc:T Det_OpcionesTip}"
                                                    AutomationProperties.Name="{loc:T Det_OpcionesNombre}"
                                                    Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}">
                                                <materialDesign:PackIcon Kind="CheckCircle" Foreground="#10B981" Width="24" Height="24" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- 2. DESCARGANDO O EN COLA -->
                                            <Grid Width="34" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip="{loc:T Det_DescargandoTip}"
                                                  Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                                
                                                <Ellipse Width="24" Height="24" Stroke="{StaticResource Brush.RingBase}" StrokeThickness="3" 
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <ProgressBar Width="24" Height="24" Foreground="{StaticResource Brush.Accent}"
                                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True"
                                                             Visibility="{Binding EstaEnEspera, Converter={StaticResource BoolToVis}}"
                                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                                             materialDesign:TransitionAssist.DisableTransitions="True"/>

                                                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" 
                                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             Width="24" Height="24" Foreground="{StaticResource Brush.Accent}"
                                                             IsIndeterminate="False"
                                                             Visibility="{Binding ProgresoDescargaActivo, Converter={StaticResource BoolToVis}}"
                                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                                             materialDesign:TransitionAssist.DisableTransitions="True"/>
                                            </Grid>

                                            <!-- 3. NO DESCARGADO: BOTÓN DE DESCARGAR -->
                                            <Button Command="{Binding DataContext.Episodios.DescargarEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="34" Height="34"
                                                    ToolTip="{loc:T Det_DescargarEpisodioTip}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DetRowIconBtn}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Descargado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="DownloadCircleOutline" Foreground="{StaticResource Brush.Accent}" Width="24" Height="24" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- Fase 2d: elegir torrent manualmente (solo si la búsqueda por torrent está activa) -->
                                            <Button Command="{Binding DataContext.Episodios.ElegirTorrentManualCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="34" Height="34"
                                                    ToolTip="{loc:T Det_ElegirTorrentTip}"
                                                    AutomationProperties.Name="{loc:T Det_ElegirTorrentTip}"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DetRowIconBtn}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Descargado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.Episodios.BusquedaTorrentHabilitada, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="Magnify" Foreground="{StaticResource Brush.TextTertiary}" Width="20" Height="20" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <DataTemplate.Triggers>
                                    <!-- ESTADO VISTO: TÍTULO ATENUADO Y OCULTAR PUNTO AZUL -->
                                    <DataTrigger Binding="{Binding Visto}" Value="True">
                                        <!-- #94A3B8 y sin transparencia: el gris anterior (#6B7280 al 60 %) casi no se leía sobre el fondo oscuro -->
                                        <Setter TargetName="TextoTitulo" Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
                                        <Setter TargetName="TextoTitulo" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="PuntoNoVisto" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    
                                    <DataTrigger Binding="{Binding RutaMiniatura}" Value="{x:Null}">
                                        <Setter TargetName="BorderMiniatura" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    
                                    <DataTrigger Binding="{Binding TieneProgresoGuardado}" Value="False">
                                        <Setter TargetName="PanelProgreso" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    
                                    <DataTrigger Binding="{Binding BadgeTecnico}" Value="{x:Null}">
                                        <Setter TargetName="BadgeTecnico" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    
                                    <!-- ESTADO FAVORITO: BOOKMARK ACTIVO AZUL -->
                                    <DataTrigger Binding="{Binding Favorito}" Value="True">
                                        <Setter TargetName="IconoBookmark" Property="Kind" Value="Bookmark" />
                                        <Setter TargetName="IconoBookmark" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ESTADO VACÍO CUANDO NO HAY EPISODIOS -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Episodios.EpisodiosDelAnime.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="MovieOpenOffOutline" Width="52" Height="52" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.6"/>
                        <TextBlock Text="{Binding Episodios.MensajeSinEpisodios}" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Episodios.SubtituloSinEpisodios}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- BOTÓN PRINCIPAL DE LA LISTA: siempre ofrece "lo siguiente" (reanudar el episodio a medias, ver el primero sin ver
                         o descargarlo). Antes solo existía "Reanudar", y solo con un episodio a medias. -->
                    <Button Command="{Binding Episodios.EjecutarAccionPrincipalCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource Brush.AccentSoft}" BorderBrush="{StaticResource Brush.AccentSoft}" Foreground="#0F172A"
                            Height="42" Padding="18,0" materialDesign:ButtonAssist.CornerRadius="21" Cursor="Hand"
                            materialDesign:ElevationAssist.Elevation="Dp6"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,15"
                            Visibility="{Binding Episodios.TieneAccionPrincipal, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="{Binding Episodios.AccionPrincipalTexto}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="{Binding Episodios.AccionPrincipalIcono}" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Episodios.AccionPrincipalTexto}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
        
        <!-- PARTE 3: EDITOR DE SEGUIMIENTO DE ANILIST (con su selector de fecha). Vive en EditorSeguimientoView y, como la
             ventana de música, se crea la primera vez que se abre. -->
        <ContentControl x:Name="AnfitrionSeguimiento" Panel.ZIndex="100" Focusable="False"/>

        <!-- PARTE 3b: VENTANA DE OPENINGS & ENDINGS. Vive en PanelMusicaView y se crea la primera vez que se abre (ver
             DetalleView.xaml.cs): la mayoría de las visitas a una ficha nunca la abren. -->
        <ContentControl x:Name="AnfitrionMusica" Panel.ZIndex="95" Focusable="False"/>

    </Grid>
</UserControl>
