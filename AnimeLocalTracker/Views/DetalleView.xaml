<UserControl x:Class="AnimeLocalTracker.Views.DetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="#121212">

    <Grid>
        <!-- 1. FONDO DIFUMINADO HERO CON DEGRADADO SUAVE -->
        <Grid ClipToBounds="True">
            <Image Source="{Binding AnimeSeleccionado.PortadaVisible, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" 
                   Stretch="UniformToFill" Opacity="0.30" Margin="-35"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect>
                    <BlurEffect Radius="50" KernelType="Gaussian"/>
                </Image.Effect>
            </Image>
            
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#66000000" Offset="0.0"/>
                        <GradientStop Color="#B3121212" Offset="0.35"/>
                        <GradientStop Color="#F2121212" Offset="0.70"/>
                        <GradientStop Color="#FF121212" Offset="0.95"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- 2. CONTENIDO PRINCIPAL: DISTRIBUCIÓN EN 2 COLUMNAS (PORTADA Y METADATOS IZQUIERDA / INFO Y EPISODIOS DERECHA) -->
        <Grid MaxWidth="1450">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="95,65,30,25"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Margin" Value="95,35,30,25"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <!-- COLUMNA IZQUIERDA: PÓSTER DESTACADO, ACCIONES Y BADGES -->
                <ColumnDefinition Width="285"/>
                <!-- COLUMNA DERECHA: TÍTULO, SINOPSIS, GÉNEROS Y LISTA DE EPISODIOS -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= COLUMNA IZQUIERDA (PÓSTER Y ACCIONES) ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,30,0" Padding="0,0,4,0">
                <StackPanel HorizontalAlignment="Stretch">
                    
                    <!-- PÓSTER DESTACADO Y GRANDE -->
                    <materialDesign:Card Width="255" Height="365" UniformCornerRadius="16" 
                                         materialDesign:ElevationAssist.Elevation="Dp8" Background="#1A1A1A" 
                                         HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Grid>
                            <Border Style="{StaticResource ShimmerEffectStyle}" CornerRadius="16" />
                            <Image Source="{Binding AnimeSeleccionado.PortadaVisible, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" 
                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                        </Grid>
                    </materialDesign:Card>

                    <!-- BARRA DE ACCIONES ELEGANTE INTEGRADA (BAJO EL PÓSTER) -->
                    <Border Background="#161B22" CornerRadius="12" Padding="4" Margin="0,0,0,0" BorderBrush="#262D38" BorderThickness="1" HorizontalAlignment="Center" Width="255">
                        <UniformGrid Rows="1" HorizontalAlignment="Stretch">
                            <!-- 1. EN BIBLIOTECA -->
                            <Button Command="{Binding EliminarAnimeActualCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="4,8" Height="Auto"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{Binding [Det_EnBibliotecaTip], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Heart" Width="20" Height="20" HorizontalAlignment="Center" Foreground="#F43F5E"/>
                                    <TextBlock Text="{Binding [Det_Biblioteca], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. SEGUIMIENTO (AniList) - SOLO VISIBLE SI EL USUARIO ESTÁ LOGEADO -->
                            <Button Command="{Binding AbrirEditorSeguimientoCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Visibility="{Binding EstaConectado, Converter={StaticResource BoolToVis}}"
                                    Padding="4,8" Height="Auto"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{Binding [Det_SeguimientoTip], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Sync" Width="20" Height="20" HorizontalAlignment="Center" Foreground="#60A5FA"/>
                                    <TextBlock Text="{Binding [Det_Seguimiento], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. WEBVIEW -->
                            <Button Command="{Binding AbrirWebViewCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="4,8" Height="Auto"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{Binding [Det_WebViewTip], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Earth" Width="20" Height="20" HorizontalAlignment="Center" Foreground="#60A5FA"/>
                                    <TextBlock Text="{Binding [Det_WebView], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= COLUMNA DERECHA (INFO PRINCIPAL + EPISODIOS) ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- FILA 0: TÍTULO, SUBTÍTULO, BADGES, SINOPSIS -->
                    <RowDefinition Height="Auto"/>
                    <!-- FILA 1: CABECERA Y LISTA DE EPISODIOS -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BLOQUE DE INFORMACIÓN (TÍTULO, METADATOS, BADGES, SINOPSIS) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <!-- TÍTULO PRINCIPAL -->
                    <TextBlock Text="{Binding AnimeSeleccionado.Titulo}" 
                               FontSize="26" FontWeight="Bold" Foreground="White"
                               TextWrapping="Wrap" LineHeight="32"
                               ToolTip="{Binding AnimeSeleccionado.Titulo}"
                               Margin="0,0,0,4"/>

                    <!-- SUBTÍTULO / NOMBRES ALTERNATIVOS Y ESTUDIO -->
                    <TextBlock Text="{Binding AnimeSeleccionado.NombresAlternativos}" 
                               FontSize="12" Foreground="#9CA3AF" 
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- FILA UNIFICADA DE BADGES (ESTADO, PROGRESO Y GÉNEROS) -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <!-- Badge Estado (En Emisión / Finalizado) -->
                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="13" Height="13" Foreground="{Binding AnimeSeleccionado.ColorEstado}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding AnimeSeleccionado.EstadoVisual}" FontSize="11" Foreground="{Binding AnimeSeleccionado.ColorEstado}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Badge Progreso (Episodios vistos) -->
                        <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="EyeOutline" Width="13" Height="13" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding AnimeSeleccionado.ProgresoEpisodiosTexto}" FontSize="11" Foreground="#93C5FD" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Chips de Géneros -->
                        <ItemsControl ItemsSource="{Binding AnimeSeleccionado.GenerosLista}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1F242C" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,6,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Converter={StaticResource GeneroTraducido}}" Foreground="#9CA3AF" FontWeight="Medium" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <!-- SINOPSIS LIMPIA EXPANDIBLE INTELIGENTE -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding AnimeSeleccionado.SinopsisLimpia}" 
                                   TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                   Foreground="#D1D5DB" Opacity="0.9">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="MaxHeight" Value="1000"/>
                                    <Setter Property="TextTrimming" Value="None"/>
                                    <Style.Triggers>
                                        <!-- Cuando la sinopsis es larga y NO está expandida, limitamos la altura a 3 líneas aprox -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding AnimeSeleccionado.TieneSinopsisLarga}" Value="True"/>
                                                <Condition Binding="{Binding SinopsisExpandida}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="MaxHeight" Value="60"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Botón de expandir/contraer: Solo visible si la sinopsis es larga -->
                        <Button Command="{Binding AlternarSinopsisCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Visibility="{Binding AnimeSeleccionado.TieneSinopsisLarga, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Left" Height="22" Padding="6,0" Margin="0,2,0,0">
                            <materialDesign:PackIcon Foreground="#9CA3AF" Width="18" Height="18">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronDown"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SinopsisExpandida}" Value="True">
                                                <Setter Property="Kind" Value="ChevronUp"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </StackPanel>

                    <!-- DIVISOR ELEGANTE -->
                    <Border Height="1" Background="#262D38" Margin="0,4,0,12"/>
                </StackPanel>

                <!-- CABECERA Y LISTA DE EPISODIOS VERTICAL -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BANNER PRÓXIMOS EPISODIOS (temporalidad AniList vs local) -->
                    <StackPanel Grid.Row="0">
                        <Border CornerRadius="8" Background="#111827" BorderBrush="#1D4ED8" BorderThickness="1"
                                Padding="12,8" Margin="0,0,0,10"
                                Visibility="{Binding TieneProximosEpisodios, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="16" Height="16" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ProximosEpisodiosTexto}" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- BANNER EPISODIOS FALTANTES (huecos silenciosos en la carpeta local) -->
                        <Border CornerRadius="8" Background="#1F1708" BorderBrush="#B45309" BorderThickness="1"
                                Padding="12,8" Margin="0,0,0,10"
                                Visibility="{Binding HayEpisodiosFaltantes, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="AlertOutline" Width="18" Height="18" Foreground="#FBBF24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding EpisodiosFaltantesTexto}" Foreground="#FCD34D" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Command="{Binding DescargarFaltantesCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        BorderBrush="#FBBF24" Foreground="#FBBF24"
                                        Height="30" Padding="10,0" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DownloadOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding [Det_DescargarFaltantes], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- CABECERA DE LA LISTA DE EPISODIOS -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- CONTEO DE EPISODIOS -->
                        <TextBlock Grid.Column="0" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedFormat}">
                                    <Binding Path="[Det_EpisodiosFormato]" Source="{x:Static loc:LocalizationService.Instance}" />
                                    <Binding Path="EpisodiosDelAnime.Count" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- FILTROS Y ORDENACIÓN -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding OpcionesFiltro}" SelectedItem="{Binding FiltroEpisodios}" 
                                      Height="34" Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                      
                            <ToggleButton IsChecked="{Binding OrdenAscendente}" Style="{StaticResource MaterialDesignActionToggleButton}"
                                          Content="{materialDesign:PackIcon Kind=SortDescending, Size=18}"
                                          materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=SortAscending, Size=18}"
                                          ToolTip="{Binding [Det_OrdenTip], Source={x:Static loc:LocalizationService.Instance}}" Width="34" Height="34" Background="#1F242C" BorderBrush="#2D333B" BorderThickness="1" Foreground="White" />

                            <!-- CARPETA DEL ANIME (acción única, no por episodio) -->
                            <Button Command="{Binding AbrirCarpetaAnimeCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#34D399" Foreground="#34D399"
                                    Height="34" Padding="10,0" Margin="8,0,0,0"
                                    ToolTip="{Binding [Det_CarpetaTip], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding [Det_Carpeta], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- DETECTAR OP (Plugin de Audio) -->
                            <Button Command="{Binding AnalizarOpeningsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#60A5FA" Foreground="#60A5FA"
                                    Height="34" Padding="10,0" Margin="8,0,0,0"
                                    ToolTip="{Binding [Det_DetectarOpTip], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding [Det_DetectarOp], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- DOCTOR DE INTEGRIDAD DE VIDEO -->
                            <Button Command="{Binding VerificarIntegridadCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#FBBF24" Foreground="#FBBF24"
                                    Height="34" Padding="10,0" Margin="8,0,0,0"
                                    IsEnabled="{Binding VerificandoIntegridad, Converter={StaticResource InverseBool}}"
                                    ToolTip="{Binding [Det_VerificarIntegridad], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldSearch" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding [Det_VerificarIntegridad], Source={x:Static loc:LocalizationService.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VerificandoIntegridad}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Det_VerificandoIntegridad], Source={x:Static loc:LocalizationService.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- BOTONES DE ACCIÓN MASIVA (Cápsulas modernas) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            
                            <!-- BOTÓN MARCAR VISTOS -->
                            <Button Command="{Binding MarcarVistosCommand}" 
                                    CommandParameter="{Binding SelectedItems, ElementName=ListaEpisodios}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#10B981" Foreground="#34D399"
                                    Height="34" Padding="10,0" Margin="0,0,6,0"
                                    ToolTip="{Binding [Det_MarcarVistosTip], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckAll" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding [Det_Vistos], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- BOTÓN MARCAR NO VISTOS -->
                            <Button Command="{Binding MarcarNoVistosCommand}" 
                                    CommandParameter="{Binding SelectedItems, ElementName=ListaEpisodios}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#EF4444" Foreground="#F87171"
                                    Height="34" Padding="10,0" Margin="0,0,6,0"
                                    ToolTip="{Binding [Det_MarcarNoVistosTip], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="EyeOffOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding [Det_NoVistos], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- BOTÓN ACTUALIZAR -->
                            <Button Command="{Binding ActualizarAnimeActualCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#60A5FA" Foreground="#93C5FD"
                                    Height="34" Padding="10,0"
                                    ToolTip="{Binding [Det_ActualizarTip], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding [Det_Actualizar], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- BOTÓN ANALIZAR DUPLICADOS (hash perceptual vía Python) -->
                            <Button Command="{Binding AnalizarDuplicadosCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#F59E0B" Foreground="#FBBF24"
                                    Height="34" Padding="10,0" Margin="6,0,0,0"
                                    ToolTip="{Binding [Det_DuplicadosTip], Source={x:Static loc:LocalizationService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentDuplicate" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"
                                                             Visibility="{Binding EstaAnalizandoDuplicados, Converter={StaticResource InverseBoolToVis}}"/>
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Width="13" Height="13" IsIndeterminate="True"
                                                 Foreground="#FBBF24"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                 Visibility="{Binding EstaAnalizandoDuplicados, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding [Det_Duplicados], Source={x:Static loc:LocalizationService.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstaAnalizandoDuplicados}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Det_Analizando], Source={x:Static loc:LocalizationService.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                <!-- LISTA DE EPISODIOS VIRTUALIZADA CON DISEÑO VERTICAL COMPLETO -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="ListaEpisodios" ItemsSource="{Binding EpisodiosDelAnime}" 
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0,0,10,60"
                             VirtualizingPanel.IsVirtualizing="True" 
                             VirtualizingPanel.VirtualizationMode="Recycling" 
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             SelectionMode="Extended">
                        
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Name="Border">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#1A3B82F6" />
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#1F2937" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" AutomationProperties.Name="{Binding ResumenAccesible}">
                                    <!-- Menú contextual de la fila: se abre con clic izquierdo SOLO sobre el
                                         icono de episodio descargado (o con clic derecho en la fila) -->
                                    <Border.ContextMenu>
                                        <ContextMenu Placement="RelativePoint" HorizontalOffset="18" VerticalOffset="12"
                                                     Background="#151B29" BorderBrush="#2D333B" BorderThickness="1"
                                                     Padding="6" FontSize="12.5" Foreground="#E2E8F0" HasDropShadow="False">
                                            <ContextMenu.Resources>
                                                <Style TargetType="ContextMenu">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContextMenu">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="10" Padding="6">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
                                                                    </Border.Effect>
                                                                    <ScrollViewer>
                                                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Foreground" Value="#E2E8F0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="MenuItem">
                                                                <Border x:Name="FondoItem" Background="{TemplateBinding Background}"
                                                                        CornerRadius="7" Padding="10,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsHighlighted" Value="True">
                                                                        <Setter TargetName="FondoItem" Property="Background" Value="#24344A"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.45"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                <Style TargetType="Separator">
                                                    <Setter Property="Background" Value="#2D333B"/>
                                                    <Setter Property="Height" Value="1"/>
                                                    <Setter Property="Margin" Value="8,4"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Separator">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        Height="{TemplateBinding Height}"
                                                                        Margin="{TemplateBinding Margin}"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ContextMenu.Resources>
                                            <MenuItem Header="{Binding [Act_Reproducir], Source={x:Static loc:LocalizationService.Instance}}"
                                                      Command="{Binding PlacementTarget.Tag.ReproducirEpisodioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="PlayArrow" Foreground="#60A5FA" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{Binding [Det_MarcarVisto], Source={x:Static loc:LocalizationService.Instance}}"
                                                      Command="{Binding PlacementTarget.Tag.AlternarVistoEpisodioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding Visto, Converter={StaticResource InverseBoolToVis}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Check" Foreground="#10B981" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{Binding [Det_MarcarNoVisto], Source={x:Static loc:LocalizationService.Instance}}"
                                                      Command="{Binding PlacementTarget.Tag.AlternarVistoEpisodioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding Visto, Converter={StaticResource BoolToVis}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="EyeOffOutline" Foreground="#9CA3AF" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{Binding [Det_MarcarAnterioresVistos], Source={x:Static loc:LocalizationService.Instance}}"
                                                      Command="{Binding PlacementTarget.Tag.MarcarAnterioresVistosCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="CheckAll" Foreground="#34D399" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{Binding [Det_MarcarTemporadaCompleta], Source={x:Static loc:LocalizationService.Instance}}"
                                                      Command="{Binding PlacementTarget.Tag.MarcarTemporadaCompletaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="PlaylistCheck" Foreground="#60A5FA" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{Binding [Det_EliminarEpisodio], Source={x:Static loc:LocalizationService.Instance}}"
                                                      Command="{Binding PlacementTarget.Tag.EliminarEpisodioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#F87171" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Columna 0: Punto no visto + Marcador Bookmark -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 1: Miniatura del episodio -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 2: Título y subtítulo -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Columna 3: Tamaño de archivo -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 4: Acción Descargar / Progreso / Reproducir -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- PUNTO NO VISTO + MARCADOR BOOKMARK -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse x:Name="PuntoNoVisto" Width="6" Height="6" Fill="#60A5FA" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     Visibility="Visible"/>

                                            <Button Command="{Binding DataContext.AlternarFavoritoEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}" Width="26" Height="26" Padding="0"
                                                    ToolTip="{Binding [Det_FavoritoTip], Source={x:Static loc:LocalizationService.Instance}}"
                                                    AutomationProperties.Name="{Binding [Det_FavoritoTip], Source={x:Static loc:LocalizationService.Instance}}">
                                                <materialDesign:PackIcon x:Name="IconoBookmark" Kind="BookmarkOutline" Foreground="#6B7280" Width="17" Height="17" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- MINIATURA DEL EPISODIO (generada vía Python/ffmpeg) -->
                                        <Border x:Name="BorderMiniatura" Grid.Column="1" Width="72" Height="40" CornerRadius="5" Margin="0,0,10,0"
                                                Background="#1F2937" BorderBrush="#2D333B" BorderThickness="1" VerticalAlignment="Center"
                                                Visibility="Visible">
                                            <Image Source="{Binding RutaMiniatura}" Stretch="UniformToFill" 
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,72,40" RadiusX="5" RadiusY="5"/>
                                                </Image.Clip>
                                            </Image>
                                        </Border>

                                        <!-- TÍTULO Y SUBTÍTULO / PROGRESO -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TextoTitulo" Text="{Binding TituloVisual}" 
                                                       Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            
                                            <StackPanel x:Name="PanelProgreso" Orientation="Horizontal" Margin="0,3,0,0"
                                                        Visibility="Visible">
                                                <ProgressBar Value="{Binding PorcentajeProgreso, Mode=OneWay}" Style="{StaticResource AppWatchProgressBar}" Width="90" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ProgresoFormateado}" Foreground="#93C5FD" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- BADGE TÉCNICO (metadata ffprobe vía Python) -->
                                            <Border x:Name="BadgeTecnico" CornerRadius="4" Background="#1F2937" BorderBrush="#2D333B" BorderThickness="1"
                                                    Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                    Visibility="Visible">
                                                <TextBlock Text="{Binding BadgeTecnico}" Foreground="#9CA3AF" FontSize="10" FontWeight="Medium"/>
                                            </Border>

                                            <!-- BADGE ARCHIVO CORRUPTO (Doctor de Integridad) -->
                                            <Border CornerRadius="4" Background="#3A1416" BorderBrush="#F87171" BorderThickness="1"
                                                    Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                    ToolTip="{Binding [Det_ArchivoCorruptoTip], Source={x:Static loc:LocalizationService.Instance}}"
                                                    Visibility="{Binding EstaCorrupto, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AlertOctagonOutline" Width="11" Height="11" Foreground="#F87171" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{Binding [Det_ArchivoCorruptoBadge], Source={x:Static loc:LocalizationService.Instance}}" Foreground="#FCA5A5" FontSize="10" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- TAMAÑO DE ARCHIVO -->
                                        <TextBlock Grid.Column="3" Text="{Binding TamanoArchivoFormateado}" 
                                                   Foreground="#9CA3AF" FontSize="12" FontWeight="Medium" 
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}"/>

                                        <!-- ACCIÓN: DESCARGAR / REPRODUCIR / DESCARGANDO -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            
                                            <!-- 1a. DESCARGADO: BOTÓN DIRECTO PARA REPRODUCIR -->
                                            <Button Command="{Binding DataContext.ReproducirEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34"
                                                    ToolTip="{Binding [Act_Reproducir], Source={x:Static loc:LocalizationService.Instance}}"
                                                    AutomationProperties.Name="{Binding [Act_Reproducir], Source={x:Static loc:LocalizationService.Instance}}"
                                                    Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,0,4,0">
                                                <materialDesign:PackIcon Kind="PlayCircle" Foreground="#60A5FA" Width="28" Height="28" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- 1b. DESCARGADO: ICONO QUE ABRE EL MENÚ DEL EPISODIO -->
                                            <Button Click="BotonEpisodioDescargado_Click"
                                                    Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34"
                                                    ToolTip="{Binding [Det_OpcionesTip], Source={x:Static loc:LocalizationService.Instance}}"
                                                    AutomationProperties.Name="{Binding [Det_OpcionesNombre], Source={x:Static loc:LocalizationService.Instance}}"
                                                    Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}">
                                                <materialDesign:PackIcon Kind="CheckCircle" Foreground="#10B981" Width="24" Height="24" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- 2. DESCARGANDO O EN COLA -->
                                            <Grid Width="34" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip="{Binding [Det_DescargandoTip], Source={x:Static loc:LocalizationService.Instance}}"
                                                  Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                                
                                                <Ellipse Width="24" Height="24" Stroke="#33FFFFFF" StrokeThickness="3" 
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <ProgressBar Width="24" Height="24" Foreground="#60A5FA"
                                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True"
                                                             Visibility="{Binding EstaEnEspera, Converter={StaticResource BoolToVis}}"
                                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                                             materialDesign:TransitionAssist.DisableTransitions="True"/>

                                                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" 
                                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             Width="24" Height="24" Foreground="#60A5FA"
                                                             IsIndeterminate="False"
                                                             Visibility="{Binding ProgresoDescargaActivo, Converter={StaticResource BoolToVis}}"
                                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                                             materialDesign:TransitionAssist.DisableTransitions="True"/>
                                            </Grid>

                                            <!-- 3. NO DESCARGADO: BOTÓN DE DESCARGAR -->
                                            <Button Command="{Binding DataContext.DescargarEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="34" Height="34"
                                                    ToolTip="{Binding [Det_DescargarEpisodioTip], Source={x:Static loc:LocalizationService.Instance}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Descargado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="DownloadCircleOutline" Foreground="#60A5FA" Width="24" Height="24" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <DataTemplate.Triggers>
                                    <!-- ESTADO VISTO: TÍTULO ATENUADO Y OCULTAR PUNTO AZUL -->
                                    <DataTrigger Binding="{Binding Visto}" Value="True">
                                        <Setter TargetName="TextoTitulo" Property="Foreground" Value="#6B7280" />
                                        <Setter TargetName="TextoTitulo" Property="Opacity" Value="0.6" />
                                        <Setter TargetName="TextoTitulo" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="PuntoNoVisto" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    
                                    <DataTrigger Binding="{Binding RutaMiniatura}" Value="{x:Null}">
                                        <Setter TargetName="BorderMiniatura" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    
                                    <DataTrigger Binding="{Binding TieneProgresoGuardado}" Value="False">
                                        <Setter TargetName="PanelProgreso" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    
                                    <DataTrigger Binding="{Binding BadgeTecnico}" Value="{x:Null}">
                                        <Setter TargetName="BadgeTecnico" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    
                                    <!-- ESTADO FAVORITO: BOOKMARK ACTIVO AZUL -->
                                    <DataTrigger Binding="{Binding Favorito}" Value="True">
                                        <Setter TargetName="IconoBookmark" Property="Kind" Value="Bookmark" />
                                        <Setter TargetName="IconoBookmark" Property="Foreground" Value="#60A5FA" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ESTADO VACÍO CUANDO NO HAY EPISODIOS -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EpisodiosDelAnime.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="MovieOpenOffOutline" Width="52" Height="52" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.6"/>
                        <TextBlock Text="{Binding MensajeSinEpisodios}" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SubtituloSinEpisodios}" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- BOTÓN FLOTANTE "▶ REANUDAR" (Solo visible si hay capítulo en progreso sin terminar) -->
                    <Button Command="{Binding ReanudarCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#93C5FD" BorderBrush="#93C5FD" Foreground="#0F172A"
                            Height="42" Padding="18,0" materialDesign:ButtonAssist.CornerRadius="21"
                            materialDesign:ElevationAssist.Elevation="Dp6"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,15"
                            Visibility="{Binding TieneCapituloEnProgreso, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding [Det_ReanudarTip], Source={x:Static loc:LocalizationService.Instance}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding [Hist_Reanudar], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
        
        <!-- PARTE 3: OVERLAY DEL EDITOR DE SEGUIMIENTO ANILIST (DISEÑO UNIFICADO Y PULIDO) -->
        <Grid Visibility="{Binding MostrandoEditorSeguimiento, Converter={StaticResource BoolToVis}}" 
              Background="#CC000000" Panel.ZIndex="100">

            <materialDesign:Card x:Name="EditorSeguimientoCard" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                 UniformCornerRadius="16" Background="#1A1F26" BorderBrush="#2D3748" BorderThickness="1"
                                 materialDesign:ElevationAssist.Elevation="Dp16" Padding="22,20">
                <materialDesign:Card.Resources>
                    <Style x:Key="CleanScoreSlider" TargetType="Slider">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Height" Value="20"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Slider">
                                    <Grid VerticalAlignment="Center" Height="20">
                                        <Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                              OverridesDefaultStyle="True"
                                                              Focusable="False"
                                                              IsTabStop="False"
                                                              Height="4"
                                                              VerticalAlignment="Center">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="#3B82F6" Height="4" CornerRadius="2,0,0,2"/>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                              OverridesDefaultStyle="True"
                                                              Focusable="False"
                                                              IsTabStop="False"
                                                              Height="4"
                                                              VerticalAlignment="Center">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="#2D3748" Height="4" CornerRadius="0,2,2,0"/>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb OverridesDefaultStyle="True"
                                                       Focusable="False" 
                                                       Width="16" 
                                                       Height="16" 
                                                       VerticalAlignment="Center">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Ellipse Width="16" Height="16" Fill="#3B82F6" Stroke="#60A5FA" StrokeThickness="2" Cursor="Hand"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="SegLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                    </Style>

                    <!-- Chip de estado: activo = borde y texto azules -->
                    <Style x:Key="SegChip" TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Raiz" Background="#14181E" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="16" Padding="13,6" Margin="0,0,8,8">
                                        <ContentPresenter x:Name="Texto" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="#9CA3AF"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Raiz" Property="Background" Value="#1B222C"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding EsActivo}" Value="True">
                                            <Setter TargetName="Raiz" Property="Background" Value="#1E293B"/>
                                            <Setter TargetName="Raiz" Property="BorderBrush" Value="#60A5FA"/>
                                            <Setter TargetName="Texto" Property="TextElement.Foreground" Value="#93C5FD"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Botón cuadrado pequeño (−, +, hoy) -->
                    <Style x:Key="SegStepBtn" TargetType="Button">
                        <Setter Property="MinWidth" Value="40"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Raiz" Background="Transparent" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Raiz" Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="#93C5FD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ══ Calendario del selector de fecha, con la plantilla estándar de WPF (su cabecera navega
                         mes → año → década con un clic) y los colores de la app ══ -->
                    <Style x:Key="SegCalNavBtn" TargetType="Button">
                        <Setter Property="Width" Value="30"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Raiz" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Raiz" Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="#93C5FD"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="SegCalHeaderBtn" TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Raiz" Background="Transparent" CornerRadius="8" Padding="10,5" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter x:Name="Texto" VerticalAlignment="Center" TextElement.FontSize="13.5" TextElement.FontWeight="Bold"
                                                              TextElement.Foreground="#E2E8F0"/>
                                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#94A3B8" StrokeThickness="1.6" Margin="7,2,0,0" VerticalAlignment="Center"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Raiz" Property="Background" Value="#1E293B"/>
                                            <Setter TargetName="Texto" Property="TextElement.Foreground" Value="#93C5FD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Día del mes -->
                    <Style x:Key="SegCalDayBtn" TargetType="CalendarDayButton">
                        <Setter Property="MinWidth" Value="34"/>
                        <Setter Property="MinHeight" Value="34"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="#E2E8F0"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CalendarDayButton">
                                    <Grid>
                                        <Border x:Name="Fondo" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="17" Margin="1"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Fondo" Property="Background" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="IsToday" Value="True">
                                            <Setter TargetName="Fondo" Property="BorderBrush" Value="#60A5FA"/>
                                        </Trigger>
                                        <Trigger Property="IsInactive" Value="True">
                                            <Setter Property="Foreground" Value="#4B5563"/>
                                        </Trigger>
                                        <Trigger Property="IsBlackedOut" Value="True">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Fondo" Property="Background" Value="#2563EB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Mes / año (vistas de año y década) -->
                    <Style x:Key="SegCalMonthBtn" TargetType="CalendarButton">
                        <Setter Property="MinWidth" Value="56"/>
                        <Setter Property="MinHeight" Value="38"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="#E2E8F0"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CalendarButton">
                                    <Grid>
                                        <Border x:Name="Fondo" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Margin="3" Height="38" VerticalAlignment="Center"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Fondo" Property="Background" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="HasSelectedDays" Value="True">
                                            <Setter TargetName="Fondo" Property="Background" Value="#2563EB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsInactive" Value="True">
                                            <Setter Property="Foreground" Value="#4B5563"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="SegCalItem" TargetType="CalendarItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CalendarItem">
                                    <ControlTemplate.Resources>
                                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,4"/>
                                        </DataTemplate>
                                    </ControlTemplate.Resources>
                                    <Grid x:Name="PART_Root" MinWidth="268">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PART_PreviousButton" Grid.Column="0" Style="{StaticResource SegCalNavBtn}">
                                                <Path Data="M 5,0 L 0,5 L 5,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Button>
                                            <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource SegCalHeaderBtn}" HorizontalAlignment="Center"/>
                                            <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource SegCalNavBtn}">
                                                <Path Data="M 0,0 L 5,5 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Button>
                                        </Grid>

                                        <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                        </Grid>

                                        <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <!-- La vista visible depende del modo del calendario: mes (por defecto), año (12 meses) o década (años) -->
                                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
                                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
                                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="SegCalendar" TargetType="Calendar">
                        <Setter Property="Foreground" Value="#E2E8F0"/>
                        <Setter Property="CalendarItemStyle" Value="{StaticResource SegCalItem}"/>
                        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource SegCalDayBtn}"/>
                        <Setter Property="CalendarButtonStyle" Value="{StaticResource SegCalMonthBtn}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Calendar">
                                    <Border Background="#1A1F26" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="12" Padding="10,8,10,10">
                                        <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="SegDatePicker" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#14181E"/>
                        <Setter Property="BorderBrush" Value="#2D3748"/>
                        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="#3B82F6"/>
                        <Setter Property="CalendarStyle" Value="{StaticResource SegCalendar}"/>
                    </Style>
                </materialDesign:Card.Resources>

                <StackPanel>
                    <!-- CABECERA: icono + título + anime + cerrar -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#14181E" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Sync" Width="19" Height="19" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Det_ActualizarAniListTitulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" FontSize="15.5" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding AnimeSeleccionado.Titulo}" FontSize="11.5" Foreground="#94A3B8" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding CerrarEditorSeguimientoCommand}"
                                Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Padding="0" Cursor="Hand"
                                ToolTip="{Binding [Det_CerrarVentanaTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" AutomationProperties.Name="{Binding [Det_CerrarVentanaTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#9CA3AF"/>
                        </Button>
                    </Grid>

                    <!-- ESTADO: chips de un clic -->
                    <TextBlock Text="{Binding [Det_Estado], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource SegLabel}"/>
                    <ItemsControl ItemsSource="{Binding EstadosChips}" Margin="0,6,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Etiqueta}" Style="{StaticResource SegChip}"
                                        Command="{Binding DataContext.SeleccionarEstadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Clave}"
                                        AutomationProperties.Name="{Binding Etiqueta}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- PROGRESO (stepper) + PUNTUACIÓN, en dos columnas -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Episodios vistos -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [Det_EpisodiosVistos], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource SegLabel}"/>
                            <Border Background="#14181E" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="10" Height="40" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding DecrementarProgresoCommand}" Style="{StaticResource SegStepBtn}"
                                            ToolTip="{Binding [Det_SegMenosTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" AutomationProperties.Name="{Binding [Det_SegMenosTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <materialDesign:PackIcon Kind="Minus" Width="16" Height="16"/>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBox Text="{Binding EditProgresoTexto, UpdateSourceTrigger=PropertyChanged}"
                                                 MinWidth="34" MaxWidth="60" BorderThickness="0" Background="Transparent"
                                                 Foreground="White" FontSize="15" FontWeight="Bold" TextAlignment="Right"
                                                 CaretBrush="#60A5FA" VerticalContentAlignment="Center"
                                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                 AutomationProperties.Name="{Binding [Det_EpisodiosVistos], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding EditTotalEpisodiosTexto}" FontSize="13" Foreground="#94A3B8" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding IncrementarProgresoCommand}" Style="{StaticResource SegStepBtn}"
                                            ToolTip="{Binding [Det_SegMasTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" AutomationProperties.Name="{Binding [Det_SegMasTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Puntuación -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding [Det_Puntuacion], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource SegLabel}"/>
                            <Border Background="#14181E" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="10" Height="40" Margin="0,6,0,0" Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding EditPuntaje, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource CleanScoreSlider}" IsSnapToTickEnabled="True" TickFrequency="1"
                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                            AutomationProperties.Name="{Binding [Det_Puntuacion], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EditPuntajeTexto}" FontWeight="Bold" FontSize="15" Foreground="#93C5FD"
                                               MinWidth="26" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- FECHAS: inicio y fin en una fila, con atajo "hoy" -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [Det_FechaInicio], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource SegLabel}"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0" SelectedDate="{Binding EditFechaInicio}" Style="{StaticResource SegDatePicker}"
                                            AutomationProperties.Name="{Binding [Det_FechaInicio], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                <Button Grid.Column="1" Command="{Binding PonerFechaInicioHoyCommand}" Style="{StaticResource SegStepBtn}" Margin="4,0,0,0"
                                        ToolTip="{Binding [Det_SegHoyTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" AutomationProperties.Name="{Binding [Det_SegHoyTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                    <TextBlock Text="{Binding [Det_SegHoyCorto], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding [Det_FechaFin], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource SegLabel}"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0" SelectedDate="{Binding EditFechaFin}" Style="{StaticResource SegDatePicker}"
                                            AutomationProperties.Name="{Binding [Det_FechaFin], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                <Button Grid.Column="1" Command="{Binding PonerFechaFinHoyCommand}" Style="{StaticResource SegStepBtn}" Margin="4,0,0,0"
                                        ToolTip="{Binding [Det_SegHoyTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" AutomationProperties.Name="{Binding [Det_SegHoyTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                    <TextBlock Text="{Binding [Det_SegHoyCorto], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ACCIONES -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="{Binding [Gal_Cancelar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Command="{Binding CerrarEditorSeguimientoCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="#374151" Foreground="#9CA3AF" Height="42" Padding="18,0" FontSize="13"
                                materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand"/>

                        <Button Grid.Column="1" Command="{Binding GuardarEditorSeguimientoCommand}"
                                Style="{StaticResource AppPrimaryButton}"
                                Height="42" Padding="18,0" Margin="10,0,0,0"
                                materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CloudUpload" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding [Det_GuardarAniList], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
