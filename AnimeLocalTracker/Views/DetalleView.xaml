<UserControl x:Class="AnimeLocalTracker.Views.DetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="#121212">

    <Grid>
        <!-- 1. FONDO DIFUMINADO HERO CON DEGRADADO SUAVE -->
        <Grid ClipToBounds="True">
            <Image Source="{Binding AnimeSeleccionado.PortadaVisible, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" 
                   Stretch="UniformToFill" Opacity="0.30" Margin="-35"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect>
                    <BlurEffect Radius="50" KernelType="Gaussian"/>
                </Image.Effect>
            </Image>
            
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#66000000" Offset="0.0"/>
                        <GradientStop Color="#B3121212" Offset="0.35"/>
                        <GradientStop Color="#F2121212" Offset="0.70"/>
                        <GradientStop Color="#FF121212" Offset="0.95"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- 2. CONTENIDO PRINCIPAL: DISTRIBUCIÓN EN 2 COLUMNAS (PORTADA Y METADATOS IZQUIERDA / INFO Y EPISODIOS DERECHA) -->
        <Grid MaxWidth="1450">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="95,65,30,25"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Margin" Value="95,35,30,25"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <!-- COLUMNA IZQUIERDA: PÓSTER DESTACADO, ACCIONES Y BADGES -->
                <ColumnDefinition Width="285"/>
                <!-- COLUMNA DERECHA: TÍTULO, SINOPSIS, GÉNEROS Y LISTA DE EPISODIOS -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= COLUMNA IZQUIERDA (PÓSTER Y ACCIONES) ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,30,0" Padding="0,0,4,0">
                <StackPanel HorizontalAlignment="Stretch">
                    
                    <!-- PÓSTER DESTACADO Y GRANDE -->
                    <materialDesign:Card Width="255" Height="365" UniformCornerRadius="16" 
                                         materialDesign:ElevationAssist.Elevation="Dp8" Background="#1A1A1A" 
                                         HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Grid>
                            <Border Style="{StaticResource ShimmerEffectStyle}" CornerRadius="16" />
                            <Image Source="{Binding AnimeSeleccionado.PortadaVisible, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" 
                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                        </Grid>
                    </materialDesign:Card>

                    <!-- BARRA DE ACCIONES ELEGANTE INTEGRADA (BAJO EL PÓSTER) -->
                    <Border Background="#161B22" CornerRadius="12" Padding="4" Margin="0,0,0,0" BorderBrush="#262D38" BorderThickness="1" HorizontalAlignment="Center" Width="255">
                        <UniformGrid Rows="1" HorizontalAlignment="Stretch">
                            <!-- 1. EN BIBLIOTECA -->
                            <Button Command="{Binding EliminarAnimeActualCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="4,8" Height="Auto"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="En biblioteca (Clic para eliminar de la biblioteca)">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Heart" Width="20" Height="20" HorizontalAlignment="Center" Foreground="#F43F5E"/>
                                    <TextBlock Text="Biblioteca" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. SEGUIMIENTO (AniList) - SOLO VISIBLE SI EL USUARIO ESTÁ LOGEADO -->
                            <Button Command="{Binding AbrirEditorSeguimientoCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Visibility="{Binding EstaConectado, Converter={StaticResource BoolToVis}}"
                                    Padding="4,8" Height="Auto"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="Gestionar seguimiento y progreso en AniList">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Sync" Width="20" Height="20" HorizontalAlignment="Center" Foreground="#60A5FA"/>
                                    <TextBlock Text="Seguimiento" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. WEBVIEW -->
                            <Button Command="{Binding AbrirWebViewCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="4,8" Height="Auto"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="Abrir ficha oficial en el navegador web">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Earth" Width="20" Height="20" HorizontalAlignment="Center" Foreground="#60A5FA"/>
                                    <TextBlock Text="WebView" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= COLUMNA DERECHA (INFO PRINCIPAL + EPISODIOS) ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- FILA 0: TÍTULO, SUBTÍTULO, BADGES, SINOPSIS -->
                    <RowDefinition Height="Auto"/>
                    <!-- FILA 1: CABECERA Y LISTA DE EPISODIOS -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BLOQUE DE INFORMACIÓN (TÍTULO, METADATOS, BADGES, SINOPSIS) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <!-- TÍTULO PRINCIPAL -->
                    <TextBlock Text="{Binding AnimeSeleccionado.Titulo}" 
                               FontSize="26" FontWeight="Bold" Foreground="White"
                               TextWrapping="Wrap" LineHeight="32"
                               ToolTip="{Binding AnimeSeleccionado.Titulo}"
                               Margin="0,0,0,4"/>

                    <!-- SUBTÍTULO / NOMBRES ALTERNATIVOS Y ESTUDIO -->
                    <TextBlock Text="{Binding AnimeSeleccionado.NombresAlternativos}" 
                               FontSize="12" Foreground="#9CA3AF" 
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- FILA UNIFICADA DE BADGES (ESTADO, PROGRESO Y GÉNEROS) -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <!-- Badge Estado (En Emisión / Finalizado) -->
                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="13" Height="13" Foreground="{Binding AnimeSeleccionado.ColorEstado}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding AnimeSeleccionado.EstadoVisual}" FontSize="11" Foreground="{Binding AnimeSeleccionado.ColorEstado}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Badge Progreso (Episodios vistos) -->
                        <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="EyeOutline" Width="13" Height="13" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding AnimeSeleccionado.ProgresoEpisodiosTexto}" FontSize="11" Foreground="#93C5FD" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Chips de Géneros -->
                        <ItemsControl ItemsSource="{Binding AnimeSeleccionado.GenerosLista}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1F242C" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,6,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding}" Foreground="#9CA3AF" FontWeight="Medium" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <!-- SINOPSIS LIMPIA EXPANDIBLE INTELIGENTE -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding AnimeSeleccionado.SinopsisLimpia}" 
                                   TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                   Foreground="#D1D5DB" Opacity="0.9">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="MaxHeight" Value="1000"/>
                                    <Setter Property="TextTrimming" Value="None"/>
                                    <Style.Triggers>
                                        <!-- Cuando la sinopsis es larga y NO está expandida, limitamos la altura a 3 líneas aprox -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding AnimeSeleccionado.TieneSinopsisLarga}" Value="True"/>
                                                <Condition Binding="{Binding SinopsisExpandida}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="MaxHeight" Value="60"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Botón de expandir/contraer: Solo visible si la sinopsis es larga -->
                        <Button Command="{Binding AlternarSinopsisCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Visibility="{Binding AnimeSeleccionado.TieneSinopsisLarga, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Left" Height="22" Padding="6,0" Margin="0,2,0,0">
                            <materialDesign:PackIcon Foreground="#9CA3AF" Width="18" Height="18">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronDown"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SinopsisExpandida}" Value="True">
                                                <Setter Property="Kind" Value="ChevronUp"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </StackPanel>

                    <!-- DIVISOR ELEGANTE -->
                    <Border Height="1" Background="#262D38" Margin="0,4,0,12"/>
                </StackPanel>

                <!-- CABECERA Y LISTA DE EPISODIOS VERTICAL -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BANNER PRÓXIMOS EPISODIOS (temporalidad AniList vs local) -->
                    <Border Grid.Row="0" CornerRadius="8" Background="#111827" BorderBrush="#1D4ED8" BorderThickness="1"
                            Padding="12,8" Margin="0,0,0,10"
                            Visibility="{Binding TieneProximosEpisodios, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="16" Height="16" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ProximosEpisodiosTexto}" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- CABECERA DE LA LISTA DE EPISODIOS -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- CONTEO DE EPISODIOS -->
                        <TextBlock Grid.Column="0" Text="{Binding EpisodiosDelAnime.Count, StringFormat='{}{0} episodios'}" 
                                   FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <!-- FILTROS Y ORDENACIÓN -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding OpcionesFiltro}" SelectedItem="{Binding FiltroEpisodios}" 
                                      Height="34" Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                      
                            <ToggleButton IsChecked="{Binding OrdenAscendente}" Style="{StaticResource MaterialDesignActionToggleButton}"
                                          Content="{materialDesign:PackIcon Kind=SortDescending, Size=18}"
                                          materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=SortAscending, Size=18}"
                                          ToolTip="Cambiar orden ascendente/descendente" Width="34" Height="34" Background="#1F242C" BorderBrush="#2D333B" BorderThickness="1" Foreground="White" />
                        </StackPanel>

                        <!-- BOTONES DE ACCIÓN MASIVA (Cápsulas modernas) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            
                            <!-- BOTÓN MARCAR VISTOS -->
                            <Button Command="{Binding MarcarVistosCommand}" 
                                    CommandParameter="{Binding SelectedItems, ElementName=ListaEpisodios}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#10B981" Foreground="#34D399"
                                    Height="34" Padding="10,0" Margin="0,0,6,0"
                                    ToolTip="Marcar episodios seleccionados (o todos) como vistos">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckAll" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Vistos" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- BOTÓN MARCAR NO VISTOS -->
                            <Button Command="{Binding MarcarNoVistosCommand}" 
                                    CommandParameter="{Binding SelectedItems, ElementName=ListaEpisodios}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#EF4444" Foreground="#F87171"
                                    Height="34" Padding="10,0" Margin="0,0,6,0"
                                    ToolTip="Marcar episodios seleccionados (o todos) como no vistos">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="EyeOffOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="No vistos" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- BOTÓN ACTUALIZAR -->
                            <Button Command="{Binding ActualizarAnimeActualCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#60A5FA" Foreground="#93C5FD"
                                    Height="34" Padding="10,0"
                                    ToolTip="Actualizar información y episodios desde AniList">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Actualizar" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- BOTÓN ANALIZAR DUPLICADOS (hash perceptual vía Python) -->
                            <Button Command="{Binding AnalizarDuplicadosCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#F59E0B" Foreground="#FBBF24"
                                    Height="34" Padding="10,0" Margin="6,0,0,0"
                                    ToolTip="Detectar archivos duplicados por hash perceptual">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentDuplicate" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"
                                                             Visibility="{Binding EstaAnalizandoDuplicados, Converter={StaticResource InverseBoolToVis}}"/>
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Width="13" Height="13" IsIndeterminate="True"
                                                 Foreground="#FBBF24"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                 Visibility="{Binding EstaAnalizandoDuplicados, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Duplicados"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstaAnalizandoDuplicados}" Value="True">
                                                        <Setter Property="Text" Value="Analizando..."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                <!-- LISTA DE EPISODIOS VIRTUALIZADA CON DISEÑO VERTICAL COMPLETO -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="ListaEpisodios" ItemsSource="{Binding EpisodiosDelAnime}" 
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0,0,10,60"
                             VirtualizingPanel.IsVirtualizing="True" 
                             VirtualizingPanel.VirtualizationMode="Recycling" 
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             SelectionMode="Extended">
                        
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Name="Border">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#1A3B82F6" />
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#1F2937" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Columna 0: Punto no visto + Marcador Bookmark -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 1: Miniatura del episodio -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 2: Título y subtítulo -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Columna 3: Tamaño de archivo -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Columna 4: Acción Descargar / Progreso / Reproducir -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- PUNTO NO VISTO + MARCADOR BOOKMARK -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse Width="6" Height="6" Fill="#60A5FA" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     Visibility="{Binding Visto, Converter={StaticResource InverseBoolToVis}}"/>

                                            <Button Command="{Binding DataContext.AlternarFavoritoEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}" Width="26" Height="26" Padding="0"
                                                    ToolTip="Marcar como favorito / guardado">
                                                <materialDesign:PackIcon x:Name="IconoBookmark" Kind="BookmarkOutline" Foreground="#6B7280" Width="17" Height="17" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- MINIATURA DEL EPISODIO (generada vía Python/ffmpeg) -->
                                        <Border Grid.Column="1" Width="72" Height="40" CornerRadius="5" Margin="0,0,10,0"
                                                Background="#1F2937" BorderBrush="#2D333B" BorderThickness="1" VerticalAlignment="Center"
                                                Visibility="{Binding RutaMiniatura, Converter={StaticResource NullToCollapsed}}">
                                            <Image Source="{Binding RutaMiniatura}" Stretch="UniformToFill" 
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,72,40" RadiusX="5" RadiusY="5"/>
                                                </Image.Clip>
                                            </Image>
                                        </Border>

                                        <!-- TÍTULO Y SUBTÍTULO / PROGRESO -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TextoTitulo" Text="{Binding TituloVisual}" 
                                                       Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                        Visibility="{Binding TieneProgresoGuardado, Converter={StaticResource BoolToVis}}">
                                                <ProgressBar Value="{Binding PorcentajeProgreso, Mode=OneWay}" Maximum="1.0" 
                                                             Height="3" Width="85" Background="#33FFFFFF" Foreground="#60A5FA" 
                                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                                             materialDesign:TransitionAssist.DisableTransitions="True"/>
                                                <TextBlock Text="{Binding ProgresoFormateado}" Foreground="#93C5FD" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- BADGE TÉCNICO (metadata ffprobe vía Python) -->
                                            <Border CornerRadius="4" Background="#1F2937" BorderBrush="#2D333B" BorderThickness="1"
                                                    Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                    Visibility="{Binding BadgeTecnico, Converter={StaticResource NullToCollapsed}}">
                                                <TextBlock Text="{Binding BadgeTecnico}" Foreground="#9CA3AF" FontSize="10" FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- TAMAÑO DE ARCHIVO -->
                                        <TextBlock Grid.Column="3" Text="{Binding TamanoArchivoFormateado}" 
                                                   Foreground="#9CA3AF" FontSize="12" FontWeight="Medium" 
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}"/>

                                        <!-- ACCIÓN: DESCARGAR / REPRODUCIR / DESCARGANDO -->
                                        <Grid Grid.Column="4" Width="34" Height="34" VerticalAlignment="Center">
                                            
                                            <!-- 1. DESCARGADO: BOTÓN DE REPRODUCIR -->
                                            <Button Command="{Binding DataContext.ReproducirEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34"
                                                    ToolTip="Descargado (Clic para reproducir)"
                                                    Visibility="{Binding Descargado, Converter={StaticResource BoolToVis}}">
                                                <materialDesign:PackIcon Kind="CheckCircle" Foreground="#60A5FA" Width="24" Height="24" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- 2. DESCARGANDO O EN COLA -->
                                            <Grid Width="34" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip="Descargando episodio"
                                                  Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                                
                                                <Ellipse Width="24" Height="24" Stroke="#33FFFFFF" StrokeThickness="3" 
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <ProgressBar Width="24" Height="24" Foreground="#60A5FA"
                                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True"
                                                             Visibility="{Binding EstaEnEspera, Converter={StaticResource BoolToVis}}"
                                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                                             materialDesign:TransitionAssist.DisableTransitions="True"/>

                                                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" 
                                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             Width="24" Height="24" Foreground="#60A5FA"
                                                             IsIndeterminate="False"
                                                             Visibility="{Binding ProgresoDescargaActivo, Converter={StaticResource BoolToVis}}"
                                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                                             materialDesign:TransitionAssist.DisableTransitions="True"/>
                                            </Grid>

                                            <!-- 3. NO DESCARGADO: BOTÓN DE DESCARGAR -->
                                            <Button Command="{Binding DataContext.DescargarEpisodioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="34" Height="34"
                                                    ToolTip="Descargar episodio">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Descargado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="DownloadCircleOutline" Foreground="#60A5FA" Width="24" Height="24" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                                
                                <DataTemplate.Triggers>
                                    <!-- ESTADO VISTO: TÍTULO ATENUADO -->
                                    <DataTrigger Binding="{Binding Visto}" Value="True">
                                        <Setter TargetName="TextoTitulo" Property="Foreground" Value="#6B7280" />
                                        <Setter TargetName="TextoTitulo" Property="Opacity" Value="0.6" />
                                        <Setter TargetName="TextoTitulo" Property="FontWeight" Value="Normal" />
                                    </DataTrigger>
                                    
                                    <!-- ESTADO FAVORITO: BOOKMARK ACTIVO AZUL -->
                                    <DataTrigger Binding="{Binding Favorito}" Value="True">
                                        <Setter TargetName="IconoBookmark" Property="Kind" Value="Bookmark" />
                                        <Setter TargetName="IconoBookmark" Property="Foreground" Value="#60A5FA" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ESTADO VACÍO CUANDO NO HAY EPISODIOS -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EpisodiosDelAnime.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="MovieOpenOffOutline" Width="52" Height="52" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.6"/>
                        <TextBlock Text="{Binding MensajeSinEpisodios}" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SubtituloSinEpisodios}" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- BOTÓN FLOTANTE "▶ REANUDAR" (Solo visible si hay capítulo en progreso sin terminar) -->
                    <Button Command="{Binding ReanudarCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#93C5FD" BorderBrush="#93C5FD" Foreground="#0F172A"
                            Height="42" Padding="18,0" materialDesign:ButtonAssist.CornerRadius="21"
                            materialDesign:ElevationAssist.Elevation="Dp6"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,15"
                            Visibility="{Binding TieneCapituloEnProgreso, Converter={StaticResource BoolToVis}}"
                            ToolTip="Continuar reproduciendo el episodio en progreso">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Reanudar" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
        
        <!-- PARTE 3: OVERLAY DEL EDITOR DE SEGUIMIENTO ANILIST (DISEÑO UNIFICADO Y PULIDO) -->
        <Grid Visibility="{Binding MostrandoEditorSeguimiento, Converter={StaticResource BoolToVis}}" 
              Background="#CC000000" Panel.ZIndex="100">

            <materialDesign:Card Width="430" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                 UniformCornerRadius="16" Background="#1A1F26" BorderBrush="#2D3748" BorderThickness="1"
                                 materialDesign:ElevationAssist.Elevation="Dp16" Padding="22">
                <materialDesign:Card.Resources>
                    <Style x:Key="CleanScoreSlider" TargetType="Slider">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Height" Value="20"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Slider">
                                    <Grid VerticalAlignment="Center" Height="20">
                                        <Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                              OverridesDefaultStyle="True"
                                                              Focusable="False"
                                                              IsTabStop="False"
                                                              Height="4"
                                                              VerticalAlignment="Center">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="#3B82F6" Height="4" CornerRadius="2,0,0,2"/>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                              OverridesDefaultStyle="True"
                                                              Focusable="False"
                                                              IsTabStop="False"
                                                              Height="4"
                                                              VerticalAlignment="Center">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="#2D3748" Height="4" CornerRadius="0,2,2,0"/>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb OverridesDefaultStyle="True"
                                                       Focusable="False" 
                                                       Width="16" 
                                                       Height="16" 
                                                       VerticalAlignment="Center">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Ellipse Width="16" Height="16" Fill="#3B82F6" Stroke="#60A5FA" StrokeThickness="2" Cursor="Hand"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </materialDesign:Card.Resources>

                <StackPanel>
                    <!-- CABECERA MODERNA CON BOTÓN CERRAR -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#14181E" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Sync" Width="20" Height="20" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Actualizar en AniList" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Sincroniza tu progreso y puntuación con la nube" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding CerrarEditorSeguimientoCommand}"
                                Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Padding="0"
                                ToolTip="Cerrar ventana">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#9CA3AF"/>
                        </Button>
                    </Grid>

                    <!-- FILA 1: ESTADO Y EPISODIOS VISTOS (2 COLUMNAS) -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ESTADO -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Estado" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding OpcionesEstadoVisual}" 
                                      SelectedItem="{Binding EditEstadoVisual}"
                                      Height="38"/>
                        </StackPanel>

                        <!-- EPISODIOS VISTOS (VALIDADO) -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Episodios Vistos" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding EditProgresoTexto, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:TextFieldAssist.UnderlineBrush="#3B82F6"
                                     VerticalContentAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold"
                                     Foreground="White" Background="#14181E" BorderBrush="#2D3748"
                                     TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- FILA 2: PUNTUACIÓN (0-100) SIN ESTRELLA Y CON SLIDER CENTRADO -->
                    <StackPanel Margin="0,0,0,14">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Puntuación" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center"/>

                            <Border HorizontalAlignment="Right" Background="#14181E" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding EditPuntaje, StringFormat={}{0:F0}}" FontWeight="Bold" FontSize="12" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                    <TextBlock Text=" / 100" FontSize="11" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Slider Minimum="0" Maximum="100" Value="{Binding EditPuntaje, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{StaticResource CleanScoreSlider}"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- FILA 3: FECHAS (INICIO Y FIN) SIN RECORTES DE TEXTO -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Fecha de Inicio" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding EditFechaInicio}" 
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        materialDesign:TextFieldAssist.UnderlineBrush="#3B82F6"
                                        VerticalContentAlignment="Center"
                                        Foreground="White" Background="#14181E" BorderBrush="#2D3748"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Fecha de Fin" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding EditFechaFin}" 
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        materialDesign:TextFieldAssist.UnderlineBrush="#3B82F6"
                                        VerticalContentAlignment="Center"
                                        Foreground="White" Background="#14181E" BorderBrush="#2D3748"/>
                        </StackPanel>
                    </Grid>

                    <!-- BOTONES DE ACCIÓN ESPACIOSOS -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CerrarEditorSeguimientoCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                BorderBrush="#374151" Foreground="#9CA3AF" Height="44" Padding="18,0"
                                FontSize="13"
                                materialDesign:ButtonAssist.CornerRadius="8"/>

                        <Button Grid.Column="1" Command="{Binding GuardarEditorSeguimientoCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#2563EB" BorderBrush="#1D4ED8" Foreground="White"
                                Height="44" Padding="18,0" Margin="10,0,0,0"
                                materialDesign:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CloudUpload" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Guardar en AniList" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
