<UserControl x:Class="AnimeLocalTracker.Views.DescargasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <Grid MaxWidth="1248">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,60,30,30"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,30,30,30"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <!-- Fila 0: Header / Título -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Lista de descargas -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER SUPERIOR -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Cola de descargas" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                <!-- BADGE CONTEO -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                        CornerRadius="12" Height="24" MinWidth="26" Padding="7,0" Margin="14,0,0,0" 
                        VerticalAlignment="Center"
                        Visibility="{Binding TieneDescargas, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ConteoActivas}" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" 
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

            <!-- LISTA DE DESCARGAS ACTIVAS -->
            <Grid Grid.Row="1">
                <!-- VISTA CON DESCARGAS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              Visibility="{Binding TieneDescargas, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- ENCABEZADO DE GRUPO (AnimeAv1) -->
                        <TextBlock Text="AnimeAv1" FontSize="15" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="10,0,0,15"/>

                        <ItemsControl ItemsSource="{Binding ColaDescargas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141923" CornerRadius="10" Padding="16,14" Margin="0,0,0,10" BorderBrush="#1F2937" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Handle de arrastre/icono -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Contenido: Títulos y barra -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Botón cancelar -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ICONO IZQUIERDO -->
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Menu" Foreground="#555E6D" 
                                                                     Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                            <!-- CUERPO CENTRAL -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding AnimeTitulo}" FontWeight="Bold" FontSize="15" Foreground="White" 
                                                               TextTrimming="CharacterEllipsis" MaxWidth="700" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding ProgresoTexto}" FontWeight="Bold" FontSize="14" Foreground="#82B1FF" 
                                                               HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                                </Grid>

                                                <TextBlock Text="{Binding TituloEpisodio}" FontSize="13" Foreground="#8E99A8" Margin="0,0,0,10"/>

                                                <!-- BARRA DE PROGRESO -->
                                                <ProgressBar Value="{Binding Progreso}" Minimum="0" Maximum="100" 
                                                             Height="6" Foreground="#448AFF" Background="#263238" 
                                                             IsIndeterminate="{Binding EstaEnEspera}"
                                                             BorderThickness="0" Margin="0,0,10,0"/>
                                            </StackPanel>

                                            <!-- BOTÓN CANCELAR -->
                                            <Button Grid.Column="2" 
                                                    Command="{Binding DataContext.CancelarDescargaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36" 
                                                    ToolTip="Cancelar descarga" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Close" Foreground="#78909C" Width="20" Height="20"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ESTADO VACÍO (Sin descargas) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding TieneDescargas, Converter={StaticResource InverseBoolToVis}}">
                    <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="72" Height="72" Foreground="#3A475C" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="No hay descargas en curso" FontSize="18" FontWeight="Bold" Foreground="#8E99A8" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Los capítulos que pongas a descargar se mostrarán aquí en tiempo real." FontSize="14" Foreground="#555E6D" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- BOTÓN FLOTANTE INFERIOR 'PARAR' -->
                <Button Command="{Binding PararTodasCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,10,10" Height="48" Padding="20,0"
                        Background="#0D47A1" BorderBrush="#1565C0" Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        materialDesign:ElevationAssist.Elevation="Dp6"
                        Visibility="{Binding TieneDescargas, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Stop" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Parar" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
</UserControl>
