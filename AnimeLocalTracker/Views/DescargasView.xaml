<UserControl x:Class="AnimeLocalTracker.Views.DescargasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <Grid MaxWidth="1248">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,60,30,30"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,30,30,30"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <!-- Fila 0: Header / Título -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Lista de descargas -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER SUPERIOR -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Cola de descargas" Style="{StaticResource AppText.PageTitle}" VerticalAlignment="Center"/>

                <!-- BADGE CONTEO -->
                <Border Style="{StaticResource AppBadge}" Margin="14,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding TieneDescargas, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ConteoActivas}" Style="{StaticResource AppText.Caption}" FontWeight="Bold" Foreground="#60A5FA"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

            <!-- LISTA DE DESCARGAS ACTIVAS -->
            <Grid Grid.Row="1">
                <!-- VISTA CON DESCARGAS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              Padding="0,0,20,0"
                              Visibility="{Binding TieneDescargas, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- ENCABEZADO DE GRUPO (AnimeAv1) -->
                        <TextBlock Text="AnimeAv1" FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" Margin="10,0,0,15"/>

                        <ItemsControl ItemsSource="{Binding ColaDescargas}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Tarjeta de descarga con barra de estado lateral -->
                                    <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1"
                                            CornerRadius="12" Padding="0" Margin="0,0,15,10" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- BARRA DE ESTADO LATERAL: azul descargando / ámbar en pausa -->
                                            <Border Grid.Column="0" Background="#60A5FA">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#60A5FA"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                <Setter Property="Background" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- CUERPO CENTRAL -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,14">
                                                <Grid Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AnimeTitulo}" FontWeight="Bold" FontSize="14.5" Foreground="#E2E8F0"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="620" HorizontalAlignment="Left"/>
                                                        <!-- CHIP EN PAUSA -->
                                                        <Border Background="#33F59E0B" BorderBrush="#66F59E0B" BorderThickness="1" CornerRadius="6"
                                                                Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="En pausa" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ProgresoTexto}" FontWeight="Bold" FontSize="14" Foreground="#60A5FA"
                                                               HorizontalAlignment="Right" Margin="0,0,0,0"/>
                                                </Grid>

                                                <TextBlock Text="{Binding TituloEpisodio}" FontSize="12.5" Foreground="#9CA3AF" Margin="0,0,0,10"/>

                                                <!-- BARRA DE PROGRESO (Sin transiciones para 0 lag durante descargas activas) -->
                                                <ProgressBar Value="{Binding Progreso}" Minimum="0" Maximum="100"
                                                             Height="6" Foreground="#60A5FA" Background="#1B222C"
                                                             IsIndeterminate="{Binding EstaEnEspera}"
                                                             BorderThickness="0"
                                                             materialDesign:TransitionAssist.DisableTransitions="True"/>
                                            </StackPanel>

                                            <!-- BOTONES DE ACCIÓN -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">

                                                <!-- BOTÓN PAUSA / REANUDAR -->
                                                <Button Command="{Binding DataContext.AlternarPausaDescargaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36"
                                                        AutomationProperties.Name="Pausar o reanudar descarga">
                                                    <materialDesign:PackIcon Foreground="#60A5FA" Width="22" Height="22">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="Pause" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                        <Setter Property="Kind" Value="Play" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Button>

                                                <!-- BOTÓN CANCELAR -->
                                                <Button Command="{Binding DataContext.CancelarDescargaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36" 
                                                        ToolTip="Cancelar descarga" Margin="4,0,0,0"
                                                        AutomationProperties.Name="Cancelar descarga">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="#F87171" Width="20" Height="20"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ESTADO VACÍO (Sin descargas) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding TieneDescargas, Converter={StaticResource InverseBoolToVis}}">
                    <Border Background="#1E293B" CornerRadius="40" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="40" Height="40" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No hay descargas en curso" Style="{StaticResource AppEmptyTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="Los capítulos que pongas a descargar se mostrarán aquí en tiempo real." Style="{StaticResource AppEmptyText}"/>
                </StackPanel>

                <!-- BOTONES FLOTANTES DE ACCIONES (SEPARADOS) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                            Margin="0,0,10,10"
                            Visibility="{Binding TieneDescargas, Converter={StaticResource BoolToVis}}">

                    <!-- BOTÓN 1: PAUSAR / REANUDAR TODAS -->
                    <Button Command="{Binding AlternarPausaTodasCommand}"
                            Height="44" Padding="20,0" Margin="0,0,10,0"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            materialDesign:ElevationAssist.Elevation="Dp3"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Background" Value="#3B82F6" />
                                <Setter Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="White" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TodasPausadas}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8" />
                                        <Setter Property="BorderBrush" Value="#3B82F6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="Pause" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TodasPausadas}" Value="True">
                                                <Setter Property="Kind" Value="Play" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock FontWeight="Bold" FontSize="14" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Pausar todas" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TodasPausadas}" Value="True">
                                                <Setter Property="Text" Value="Reanudar todas" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- BOTÓN 2: MENÚ DE 3 PUNTOS (SEPARADO) -->
                    <Grid>
                        <Button x:Name="MenuOpcionesBtn"
                                Width="44" Height="44"
                                Background="#1E293B" BorderBrush="#2D3748" BorderThickness="1"
                                Click="MenuOpcionesBtn_Click"
                                PreviewMouseLeftButtonDown="MenuOpcionesBtn_PreviewMouseLeftButtonDown"
                                Cursor="Hand" ToolTip="Más opciones">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3" Color="Black" />
                                        </Border.Effect>
                                        <materialDesign:PackIcon x:Name="icon" Kind="DotsVertical" Width="22" Height="22" 
                                                                 Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#2D3748"/>
                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#6B7280"/>
                                            <Setter TargetName="icon" Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#6B7280"/>
                                            <Setter TargetName="icon" Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- POPUP DEL MENÚ -->
                        <Popup x:Name="MenuOpcionesPopup"
                               PlacementTarget="{Binding ElementName=MenuOpcionesBtn}"
                               Placement="Top"
                               VerticalOffset="-8"
                               HorizontalOffset="-180"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="#1E293B" BorderBrush="#2D3748" BorderThickness="1" 
                                    CornerRadius="10" Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" />
                                </Border.Effect>
                                <Button Command="{Binding CancelarTodasCommand}"
                                        Click="CerrarMenuOpciones_Click"
                                        Height="38" Padding="14,0"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="#2D1518"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="#EF4444" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cancelar todas las descargas" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
</UserControl>
