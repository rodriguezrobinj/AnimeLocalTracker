<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Estilos que comparten la ficha del anime (DetalleView) y sus ventanas (PanelMusicaView). Se cargan una vez desde
         App.xaml, no en cada visita a la ficha. -->

    <!-- Chips pulsables de la fila de etiquetas (mismo tamaño que las etiquetas informativas) -->
    <ControlTemplate x:Key="DetChipTemplate" TargetType="ButtonBase">
        <Border x:Name="Raiz" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Raiz" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DetChipToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="#1AF59E0B"/>
        <Setter Property="BorderBrush" Value="#33F59E0B"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource DetChipTemplate}"/>
    </Style>

    <Style x:Key="DetChipButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentStrongTint}"/>
        <Setter Property="BorderBrush" Value="#333B82F6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource DetChipTemplate}"/>
        <Style.Triggers>
            <!-- Apagado (p. ej. "Descargar todos" sin conexión): se ve atenuado en vez de parecer pulsable -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
