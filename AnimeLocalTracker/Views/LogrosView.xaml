<UserControl x:Class="AnimeLocalTracker.Views.LogrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             xmlns:vm="clr-namespace:AnimeLocalTracker.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Chip de filtro (categoría / estado): activo = borde y texto azul de la paleta -->
        <Style x:Key="LogroChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Raiz" Background="#14181E" BorderBrush="#262D38" BorderThickness="1"
                                CornerRadius="16" Padding="14,6" Margin="0,0,8,8">
                            <ContentPresenter x:Name="Texto" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="#9CA3AF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Raiz" Property="Background" Value="#1B222C"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding EsActivo}" Value="True">
                                <Setter TargetName="Raiz" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="Raiz" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="Texto" Property="TextElement.Foreground" Value="#93C5FD"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1280">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,60,30,30"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,30,30,30"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: encabezado -->
            <RowDefinition Height="Auto"/>  <!-- 1: resumen de rango -->
            <RowDefinition Height="Auto"/>  <!-- 2: filtros -->
            <RowDefinition Height="*"/>     <!-- 3: lista / estados -->
        </Grid.RowDefinitions>

        <!-- ═══ FILA 0: ENCABEZADO ═══ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
            <Border Background="#1E293B" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="TrophyAward" Foreground="#FBBF24" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding [Logro_Titulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.PageTitle}"/>
                <TextBlock Text="{Binding [Logro_Subtitulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ═══ FILA 1: RESUMEN (rango · progreso total · niveles por dificultad) ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Rango -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding RangoNombre}" FontSize="20" FontWeight="Bold" Foreground="#FBBF24"/>
                        <TextBlock Text="{Binding PuntosTexto}" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgresoRango, Mode=OneWay}" Height="6" Margin="0,8,0,4"
                                 Foreground="#FBBF24" Background="#262D38" BorderThickness="0"/>
                    <TextBlock Text="{Binding SiguienteRangoTexto}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Progreso total -->
                <StackPanel Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NivelesTexto}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgresoTotal, Mode=OneWay}" Height="6" Margin="0,8,0,0"
                                 Foreground="#60A5FA" Background="#262D38" BorderThickness="0"/>
                </StackPanel>

                <!-- Niveles conseguidos por dificultad -->
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Contadores}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,0,0,0" HorizontalAlignment="Center" MinWidth="52">
                                <TextBlock Text="{Binding Cantidad}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="{Binding Color}"/>
                                <TextBlock Text="{Binding Nombre}" FontSize="10" HorizontalAlignment="Center" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ═══ FILA 2: FILTROS ═══ -->
        <StackPanel Grid.Row="2" Margin="0,0,0,6">
            <ItemsControl ItemsSource="{Binding Categorias}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Etiqueta}" Style="{StaticResource LogroChipStyle}"
                                Command="{Binding DataContext.SeleccionarCategoriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Clave}"
                                AutomationProperties.Name="{Binding Etiqueta}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Estados}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Etiqueta}" Style="{StaticResource LogroChipStyle}"
                                Command="{Binding DataContext.SeleccionarEstadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Clave}"
                                AutomationProperties.Name="{Binding Etiqueta}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ═══ FILA 3: CONTENIDO (CARGANDO / VACÍO / SIN RESULTADOS / LISTA) ═══ -->
        <Grid Grid.Row="3">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="44" Height="44"
                         Value="0" Foreground="#60A5FA"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>

            <!-- Vacío (no se pudieron evaluar los logros) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40"
                        Visibility="{Binding EstaVacio, Converter={StaticResource BoolToVis}}">
                <Border Background="#1E293B" CornerRadius="36" Width="72" Height="72" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="TrophyOutline" Foreground="#64748B" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding [Logro_VacioTitulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppEmptyTitle}"/>
                <TextBlock Text="{Binding [Logro_VacioSubtitulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppEmptyText}" Margin="0,6,0,0" MaxWidth="420"/>
            </StackPanel>

            <!-- Sin resultados con los filtros actuales -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40"
                        Visibility="{Binding SinResultados, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="FilterVariant" Foreground="#64748B" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding [Logro_SinResultados], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppEmptyText}" FontSize="15" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Lista virtualizada: cabeceras de categoría (string) + tarjetas (LogroItemViewModel) -->
            <ListBox ItemsSource="{Binding ItemsAgrupados}"
                     Background="Transparent" BorderThickness="0" Padding="0,0,16,0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="True"
                     SelectionMode="Single"
                     Visibility="{Binding TieneElementos, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="Bold" Foreground="#93C5FD" Margin="1,14,0,8"/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:LogroItemViewModel}">
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12"
                                Padding="16,12" Margin="0,0,10,10"
                                AutomationProperties.Name="{Binding Titulo}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <!-- Bloqueado: atenuado pero legible -->
                                        <DataTrigger Binding="{Binding Desbloqueado}" Value="False">
                                            <Setter Property="Opacity" Value="0.7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icono de la familia -->
                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Width="52" Height="52" VerticalAlignment="Top" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="{Binding Icono}" Foreground="{Binding Color}" Width="26" Height="26"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Título, descripción, progreso y marcas de nivel -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Descripcion}" FontSize="11.5" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding ProgresoPorcentaje, Mode=OneWay}"
                                                     Height="6" VerticalAlignment="Center" Foreground="{Binding Color}" Background="#262D38" BorderThickness="0"
                                                     Visibility="{Binding MostrarProgreso, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProgresoTexto}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Niveles}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="9" Height="9" Margin="0,0,5,0" Fill="{Binding Color}" ToolTip="{Binding Nombre}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Nivel actual, puntos y fecha -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding NivelNombre}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"
                                               Foreground="{Binding NivelColor}"/>
                                    <TextBlock Text="{Binding PuntosTexto}" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding FechaTexto}" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,4,0,0"
                                               TextWrapping="Wrap" TextAlignment="Right"
                                               Visibility="{Binding TieneFecha, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
