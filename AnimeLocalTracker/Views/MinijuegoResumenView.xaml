<UserControl x:Class="AnimeLocalTracker.Views.MinijuegoResumenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             Background="Transparent">

    <!-- Resumen final de una partida. Se enlaza al ViewModel del juego (ResumenPuntosTexto, ResumenAciertosTexto,
         IniciarPartidaCommand, VolverAlInicioCommand). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MinijuegosEstilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource AppCard}" MaxWidth="520" Padding="32,28" VerticalAlignment="Top" HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
            <Border Background="{DynamicResource Brush.WarningTint}" CornerRadius="32" Width="64" Height="64" Margin="0,0,0,16" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="TrophyAward" Foreground="{DynamicResource Brush.Warning}" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{loc:T Mini_ResumenTitulo}" Style="{StaticResource AppText.Section}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding ResumenPuntosTexto}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding ResumenAciertosTexto}" Style="{StaticResource AppText.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,12"/>

            <!-- Récord: insignia solo si esta partida lo superó; si no, el récord vigente como referencia -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24" Visibility="{Binding MostrarRecordEnResumen, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource Brush.WarningTint}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,6"
                        Visibility="{Binding EsNuevoRecord, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StarCircle" Foreground="{DynamicResource Brush.Warning}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:T Mini_NuevoRecord}"
                                   Style="{StaticResource AppText.Micro}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ResumenRecordTexto}" Style="{StaticResource AppText.Caption}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Ronda a ronda: cuál era la respuesta y si se acertó (10 filas como mucho: un ItemsControl basta) -->
            <TextBlock Text="{loc:T Mini_ResumenRondas}"
                       Style="{StaticResource AppText.Micro}" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210" Margin="0,0,0,22" Width="420">
                <ItemsControl ItemsSource="{Binding ResumenRondas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="Icono" Kind="CloseCircleOutline" Foreground="{DynamicResource Brush.Danger}" Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Respuesta}" Style="{StaticResource AppText.Secondary}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding Respuesta}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Puntos, StringFormat='+{0}'}" Style="{StaticResource AppText.Micro}"
                                           Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Acierto}" Value="True">
                                    <Setter TargetName="Icono" Property="Kind" Value="CheckCircleOutline"/>
                                    <Setter TargetName="Icono" Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding IniciarPartidaCommand}" Style="{StaticResource MiniBotonPrincipal}" Margin="0,0,10,0"
                        AutomationProperties.Name="{loc:T Mini_JugarDeNuevo}">
                    <TextBlock Text="{loc:T Mini_JugarDeNuevo}"/>
                </Button>
                <Button Command="{Binding VolverAlInicioCommand}" Style="{StaticResource MiniBotonSecundario}"
                        AutomationProperties.Name="{loc:T Mini_Volver}">
                    <TextBlock Text="{loc:T Mini_Volver}"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
