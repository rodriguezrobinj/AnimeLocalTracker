<UserControl x:Class="AnimeLocalTracker.Views.SelectorSeccionGaleria"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             VerticalAlignment="Center" Focusable="False"
             Visibility="{Binding HayMinijuegos, Converter={StaticResource BoolToVis}}">

    <!-- Selector Biblioteca | Minijuegos de la Galería. Se usa en las dos secciones; el DataContext es el GaleriaViewModel. -->
    <UserControl.Resources>
        <Style x:Key="SeccionGaleriaBoton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="3"
            AutomationProperties.Name="{Binding [Gal_SeccionesAcc], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding MostrarBibliotecaCommand}" Margin="0,0,2,0"
                    AutomationProperties.Name="{Binding [Gal_SeccionBiblioteca], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SeccionGaleriaBoton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoBiblioteca}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ViewGridOutline" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [Gal_SeccionBiblioteca], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding MostrarMinijuegosCommand}"
                    AutomationProperties.Name="{Binding [Gal_SeccionMinijuegos], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SeccionGaleriaBoton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoMinijuegos}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="GamepadVariantOutline" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [Gal_SeccionMinijuegos], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
