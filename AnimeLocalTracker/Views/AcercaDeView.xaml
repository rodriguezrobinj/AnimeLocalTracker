<UserControl x:Class="AnimeLocalTracker.Views.AcercaDeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">
    
    <Grid ClipToBounds="True" MaxWidth="1248">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,55,30,20"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,25,30,20"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <!-- Fila 0: ENCABEZADO FIJO -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: CONTENIDO DESPLAZABLE -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO FIJO DE LA VISTA -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FFA726" CornerRadius="12" Width="44" Height="44" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Acerca de AnimeLocalTracker" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="Información del sistema, actualizaciones y novedades de la versión instalada" 
                               FontSize="13" Foreground="#9E9E9E" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- CONTENIDO DESPLAZABLE -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,32,20" HorizontalAlignment="Stretch">

                <!-- 1. TARJETA DE IDENTIDAD DE LA APP -->
                <materialDesign:Card Background="#1E1E1E" UniformCornerRadius="14" Margin="0,0,0,20" Padding="22" materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#3F51B5" CornerRadius="12" Width="52" Height="52" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="PlayCircle" Width="32" Height="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AnimeLocalTracker" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <Border Background="#1E88E5" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VersionAppTexto, StringFormat='v{0}'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Gestor y reproductor nativo multimedia para colecciones de anime locales con sincronización automática" 
                                       FontSize="12" Foreground="#B0BEC5" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding BuscarActualizacionesCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#2E7D32" BorderBrush="#1B5E20" Foreground="White"
                                Height="38" Padding="14,0" VerticalAlignment="Center"
                                ToolTip="Comprobar si hay una nueva versión disponible y actualizar notas">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Buscar Actualizaciones" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </materialDesign:Card>

                <!-- 2. NOVEDADES DE LA VERSIÓN (DINÁMICAS DESDE GITHUB) -->
                <materialDesign:Card Background="#1E1E1E" UniformCornerRadius="14" Margin="0,0,0,20" Padding="22" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Foreground="#64B5F6" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding TituloVersionTexto, StringFormat='Novedades: {0}'}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding FechaVersionTexto}" FontSize="12" Foreground="#90A4AE" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="#262626" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <ProgressBar IsIndeterminate="True" 
                                             Visibility="{Binding IsCargandoNovedades, Converter={StaticResource BoolToVis}}" 
                                             Height="3" VerticalAlignment="Top" Foreground="#42A5F5" Margin="0,0,0,10"
                                             materialDesign:TransitionAssist.DisableTransitions="True"/>
                                <TextBlock Text="{Binding NovedadesTexto}" 
                                           Foreground="#ECEFF1" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 3. REPOSITORIO GITHUB Y LICENCIAS -->
                <materialDesign:Card Background="#1E1E1E" UniformCornerRadius="14" Margin="0,0,0,20" Padding="22" materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Proyecto de Código Abierto (Open Source)" FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                            <TextBlock Text="Desarrollado con .NET 8, WPF, Flyleaf, SQLite-net, MaterialDesign y Velopack" FontSize="12" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding LicenciaTexto}" FontSize="11" Foreground="#78909C" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding AbrirRepositorioGitHubCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="#90CAF9" Foreground="#90CAF9"
                                Height="38" Padding="16,0" VerticalAlignment="Center"
                                ToolTip="Visitar repositorio en GitHub">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="OpenInNew" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Repositorio en GitHub" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
