<UserControl x:Class="AnimeLocalTracker.Views.AcercaDeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- LOC-08/UI-Novedades: MdXaml trae su propio estilo "Standard" pensado para fondo
             claro; se sobreescribe aquí para que el FlowDocument herede los colores oscuros
             de la tarjeta en vez de imponer texto negro sobre fondo oscuro. -->
        <Style x:Key="NovedadesMarkdownViewerStyle" TargetType="mdxam:MarkdownScrollViewer">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ── Piezas compartidas de la vista: todas las tarjetas usan la misma cabecera
                (icono en chip + título + subtítulo) para que la página se lea uniforme. ── -->
        <Style x:Key="AcercaCard" TargetType="Border" BasedOn="{StaticResource AppCard}">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="AcercaChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AcercaChipIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AcercaBody" TargetType="TextBlock" BasedOn="{StaticResource AppText.Secondary}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="AcercaTechChip" TargetType="Border" BasedOn="{StaticResource AppBadge}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="AcercaTechChipText" TargetType="TextBlock" BasedOn="{StaticResource AppText.Micro}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1200" ClipToBounds="True" Style="{StaticResource AppPageRoot}">
        <Grid.RowDefinitions>
            <!-- Fila 0: ENCABEZADO FIJO -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: CONTENIDO DESPLAZABLE -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO FIJO DE LA VISTA -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,24">
            <Border Background="{DynamicResource Brush.Surface3}" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                <materialDesign:PackIcon Kind="InformationOutline" Width="26" Height="26" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding [Acerca_Titulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.PageTitle}"/>
                <TextBlock Text="{Binding [Acerca_Subtitulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                           Style="{StaticResource AppText.Caption}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- CONTENIDO DESPLAZABLE -->
        <ScrollViewer x:Name="PaginaScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,24,20" HorizontalAlignment="Stretch">

                <!-- 1. IDENTIDAD DE LA APP + BUSCAR ACTUALIZACIONES -->
                <Border Style="{StaticResource AcercaCard}" Margin="0,0,0,12" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface3}" BorderBrush="{DynamicResource Brush.AccentStrong}" BorderThickness="1"
                                CornerRadius="16" Width="64" Height="64" Margin="0,0,18,0">
                            <materialDesign:PackIcon Kind="PlayCircle" Width="36" Height="36" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding [Acerca_NombreApp], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="{Binding [Acerca_Descripcion], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                       Style="{StaticResource AcercaBody}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding BuscarActualizacionesCommand}"
                                Style="{StaticResource AppPrimaryButton}"
                                Height="42" Padding="18,0" VerticalAlignment="Center" Cursor="Hand"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                ToolTip="{Binding [Acerca_ComprobarActualizacionesTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                AutomationProperties.Name="{Binding [Acerca_BuscarActualizaciones], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding [Acerca_BuscarActualizaciones], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. DATOS RÁPIDOS: versión y licencia -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AppCard}" CornerRadius="12" Padding="16,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource AcercaChip}">
                                <materialDesign:PackIcon Kind="Update" Style="{StaticResource AcercaChipIcon}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Acerca_Version], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Micro}"/>
                                <TextBlock Text="{Binding VersionAppTexto, Mode=OneWay}" Style="{StaticResource AppText.BodyStrong}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AppCard}" CornerRadius="12" Padding="16,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource AcercaChip}">
                                <materialDesign:PackIcon Kind="HeartOutline" Style="{StaticResource AcercaChipIcon}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Acerca_Licencia], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Micro}"/>
                                <TextBlock Text="MIT" Style="{StaticResource AppText.BodyStrong}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. NOVEDADES DE LA VERSIÓN (DINÁMICAS DESDE GITHUB) -->
                <Border Style="{StaticResource AcercaCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource AcercaChip}">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Style="{StaticResource AcercaChipIcon}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NovedadesTituloTexto, Mode=OneWay}" Style="{StaticResource AppText.Section}"/>
                                    <TextBlock Text="{Binding [Acerca_RegistroCambios], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource AppBadge}">
                                        <Setter Property="Padding" Value="10,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FechaVersionTexto}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FechaVersionTexto, Mode=OneWay}" Style="{StaticResource AppText.Micro}" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                            <StackPanel>
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{Binding IsCargandoNovedades, Converter={StaticResource BoolToVis}}"
                                             Height="3" VerticalAlignment="Top" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,12"
                                             materialDesign:TransitionAssist.DisableTransitions="True"/>
                                <mdxam:MarkdownScrollViewer Markdown="{Binding NovedadesTexto}"
                                                             MarkdownStyleName="Standard"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource Brush.TextPrimary}"
                                                             VerticalScrollBarVisibility="Disabled"
                                                             PreviewMouseWheel="Novedades_PreviewMouseWheel"
                                                             Style="{StaticResource NovedadesMarkdownViewerStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. PRIVACIDAD (PRI-03/04): tres garantías en columnas, a ancho completo -->
                <Border Style="{StaticResource AcercaCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource AcercaChip}">
                                <materialDesign:PackIcon Kind="ShieldAccount" Style="{StaticResource AcercaChipIcon}" Foreground="{DynamicResource Brush.Success}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Acerca_PrivacidadTitulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Section}"/>
                                <TextBlock Text="{Binding [Acerca_PrivacidadSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Caption}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Harddisk" Width="20" Height="20" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding [Acerca_PrivacidadP1], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AcercaBody}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="AccountSync" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding [Acerca_PrivacidadP2], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AcercaBody}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="EyeOffOutline" Width="20" Height="20" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding [Acerca_PrivacidadP3], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AcercaBody}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- AVISO DE CONTENIDO (recomendación de buenas prácticas, no asesoría legal) -->
                <Border Style="{StaticResource AcercaCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource AcercaChip}">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Style="{StaticResource AcercaChipIcon}" Foreground="{DynamicResource Brush.Warning}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Acerca_AvisoContenidoTitulo], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Section}"/>
                                <TextBlock Text="{Binding [Acerca_AvisoContenidoSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Caption}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding [Acerca_AvisoContenidoTexto], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AcercaBody}"/>
                    </StackPanel>
                </Border>

                <!-- 5. PROYECTO OPEN SOURCE: todo el texto (título, licencia y tecnologías) en la columna
                     izquierda; los botones en la derecha, centrados verticalmente respecto a ESE bloque completo. -->
                <Border Style="{StaticResource AcercaCard}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource AcercaChip}">
                                    <materialDesign:PackIcon Kind="Github" Style="{StaticResource AcercaChipIcon}" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Acerca_ProyectoOpenSource], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" Style="{StaticResource AppText.Section}"/>
                                    <TextBlock Text="{Binding LicenciaTexto, Mode=OneWay}" Style="{StaticResource AppText.Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Tecnologías (nombres propios: no se traducen). El margen inferior de los chips
                                 se compensa para que el bloque de texto no tenga más aire abajo que arriba,
                                 así el centrado de los botones es exacto. -->
                            <WrapPanel Margin="0,0,0,-8">
                                <Border Style="{StaticResource AcercaTechChip}"><TextBlock Text=".NET 8" Style="{StaticResource AcercaTechChipText}"/></Border>
                                <Border Style="{StaticResource AcercaTechChip}"><TextBlock Text="C#" Style="{StaticResource AcercaTechChipText}"/></Border>
                                <Border Style="{StaticResource AcercaTechChip}"><TextBlock Text="WPF" Style="{StaticResource AcercaTechChipText}"/></Border>
                                <Border Style="{StaticResource AcercaTechChip}"><TextBlock Text="Flyleaf" Style="{StaticResource AcercaTechChipText}"/></Border>
                                <Border Style="{StaticResource AcercaTechChip}"><TextBlock Text="SQLite-net" Style="{StaticResource AcercaTechChipText}"/></Border>
                                <Border Style="{StaticResource AcercaTechChip}"><TextBlock Text="MaterialDesign" Style="{StaticResource AcercaTechChipText}"/></Border>
                                <Border Style="{StaticResource AcercaTechChip}"><TextBlock Text="Velopack" Style="{StaticResource AcercaTechChipText}"/></Border>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding AbrirReportarProblemaCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{DynamicResource Brush.TextTertiary}" Foreground="{DynamicResource Brush.TextPrimary}"
                                    Height="38" Padding="16,0" Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{Binding [Acerca_ReportarProblemaTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                    AutomationProperties.Name="{Binding [Acerca_ReportarProblema], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BugOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding [Acerca_ReportarProblema], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AbrirRepositorioGitHubCommand}"
                                    Style="{StaticResource AppOutlinedButton}"
                                    BorderBrush="{DynamicResource Brush.AccentStrong}"
                                    Height="38" Padding="16,0" VerticalAlignment="Center" Cursor="Hand"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    ToolTip="{Binding [Acerca_AbrirRepositorioTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                                    AutomationProperties.Name="{Binding [Acerca_VerGitHub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding [Acerca_VerGitHub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
