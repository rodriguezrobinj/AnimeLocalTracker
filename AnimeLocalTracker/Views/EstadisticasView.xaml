<UserControl x:Class="AnimeLocalTracker.Views.EstadisticasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ctl="clr-namespace:AnimeLocalTracker.Controls"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="GradAzul" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#60A5FA" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradVerde" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#34D399" Offset="0"/>
            <GradientStop Color="#10B981" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradMorado" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#A78BFA" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradAmbar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FBBF24" Offset="0"/>
            <GradientStop Color="#F59E0B" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid ClipToBounds="True" MaxWidth="1280">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,65,30,25"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,35,30,25"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartDonut" Foreground="#93C5FD" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Stats_Titulo], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource AppText.PageTitle}"/>
                    <TextBlock Text="{Binding [Stats_Subtitulo], Source={x:Static loc:LocalizationService.Instance}}" FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- BANNER DE ERROR (EST-03) -->
        <Border Grid.Row="1" Background="#3A1416" BorderBrush="#F87171" BorderThickness="1" CornerRadius="12"
                Padding="16,12" Margin="0,0,24,14" VerticalAlignment="Top"
                Visibility="{Binding HayError, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertCircle" Foreground="#F87171" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MensajeError}" Foreground="#FECACA" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,24,20" HorizontalAlignment="Stretch">

                <!-- ══ FILA 1: KPIs PRINCIPALES ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,8,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AnimationPlay" Foreground="#60A5FA" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [Stats_EpisodiosVistos], Source={x:Static loc:LocalizationService.Instance}}" FontSize="10" Foreground="#6B7280" FontWeight="Bold" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalEpisodiosVistos}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="8,0,8,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockOutline" Foreground="#34D399" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [Stats_HorasReproducidas], Source={x:Static loc:LocalizationService.Instance}}" FontSize="10" Foreground="#6B7280" FontWeight="Bold" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding HorasVistasTexto}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="8,0,8,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewGallery" Foreground="#A78BFA" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [Stats_AnimesBiblioteca], Source={x:Static loc:LocalizationService.Instance}}" FontSize="10" Foreground="#6B7280" FontWeight="Bold" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalAnimes}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="3" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="8,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrophyOutline" Foreground="#FBBF24" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [Stats_BibliotecaCompletada], Source={x:Static loc:LocalizationService.Instance}}" FontSize="10" Foreground="#6B7280" FontWeight="Bold" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PorcentajeCompletadoTexto}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ProgressClock" Foreground="#F59E0B" Width="16" Height="16" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding AnimesEnProceso}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding [Stats_AMedioVer], Source={x:Static loc:LocalizationService.Instance}}" FontSize="10" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HeartOutline" Foreground="#F87171" Width="16" Height="16" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding TotalFavoritos}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding [Stats_EpisodiosFavoritos], Source={x:Static loc:LocalizationService.Instance}}" FontSize="10" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DownloadCircle" Foreground="#38BDF8" Width="16" Height="16" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding TotalDescargados}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding [Stats_EpisodiosDescargados], Source={x:Static loc:LocalizationService.Instance}}" FontSize="10" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="3" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Timelapse" Foreground="#F472B6" Width="16" Height="16" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding DuracionPromedioTexto}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding [Stats_DuracionPromedio], Source={x:Static loc:LocalizationService.Instance}}" FontSize="10" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ FILA 2: INSIGHTS DEL ANALISTA ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#2E2547" CornerRadius="10" Width="36" Height="36" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PaletteOutline" Foreground="#A78BFA" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Stats_GeneroFavorito], Source={x:Static loc:LocalizationService.Instance}}" FontSize="9" Foreground="#6B7280" FontWeight="Bold"/>
                                <TextBlock Text="{Binding GeneroFavorito}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding GeneroFavoritoDetalle}" FontSize="10" Foreground="#9CA3AF" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1E2A4A" CornerRadius="10" Width="36" Height="36" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Crown" Foreground="#60A5FA" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Stats_AnimeMasVisto], Source={x:Static loc:LocalizationService.Instance}}" FontSize="9" Foreground="#6B7280" FontWeight="Bold"/>
                                <TextBlock Text="{Binding AnimeMasVisto}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AnimeMasVistoDetalle}" FontSize="10" Foreground="#9CA3AF" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1E2A2A" CornerRadius="10" Width="36" Height="36" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CalendarStar" Foreground="#34D399" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Stats_AnioMasActivo], Source={x:Static loc:LocalizationService.Instance}}" FontSize="9" Foreground="#6B7280" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MejorAnio}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding MejorAnioDetalle}" FontSize="10" Foreground="#9CA3AF" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="8,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#2A241E" CornerRadius="10" Width="36" Height="36" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Speedometer" Foreground="#FBBF24" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Stats_Ritmo], Source={x:Static loc:LocalizationService.Instance}}" FontSize="9" Foreground="#6B7280" FontWeight="Bold"/>
                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,2,0,0">
                                    <Run Text="{Binding HorasPorMes}"/><Run Text="{Binding [Stats_PorMes], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                </TextBlock>                                <TextBlock FontSize="10" Foreground="#9CA3AF" Margin="0,1,0,0">
                                    <Run Text="{Binding [Stats_RachaActual], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/><Run Text="{Binding RachaActual}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══ FILA 3: DONUTS (ESTADO | GÉNEROS) ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [Stats_DistribucionLista], Source={x:Static loc:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding [Stats_PorEstado], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,14"/>
                            <ctl:DonutChart ItemsSource="{Binding DonutEstado}" CentroTexto="{Binding DonutEstadoCentro}" CentroSubtexto="{Binding [Stats_DonutCentroAnimes], Source={x:Static loc:LocalizationService.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [Stats_AnalisisGenero], Source={x:Static loc:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding [Stats_GeneroSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,14"/>
                            <ctl:DonutChart ItemsSource="{Binding DonutGeneros}" CentroTexto="{Binding DonutGenerosCentro}" CentroSubtexto="{Binding DonutGenerosSubcentro}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ FILA 4: ACTIVIDAD SEMANAL + TOP ANIMES ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,8,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding [Stats_Actividad7Dias], Source={x:Static loc:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4">
                                <Run Text="{Binding PromedioDiarioTexto}"/>
                                <Run Text="{Binding [Stats_PromedioDiarioSub], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
                                <Run Text="{Binding RachaMaxima}"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding ActividadSemana}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Etiqueta}" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Height="18" VerticalAlignment="Center">
                                                <Border CornerRadius="4" Width="{Binding AnchoBarra}" HorizontalAlignment="Left">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#34D399" Offset="0"/>
                                                            <GradientStop Color="#10B981" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Valor}" Foreground="#6EE7B7" FontSize="12" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [Stats_TopAnimes], Source={x:Static loc:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding [Stats_TopAnimesSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding TopAnimes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="88"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="#1E293B" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Posicion}" Foreground="#93C5FD" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Titulo}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="#1E293B" CornerRadius="4" Height="8" Margin="0,5,0,0" HorizontalAlignment="Stretch">
                                                    <Border CornerRadius="4" Width="{Binding AnchoBarra}" HorizontalAlignment="Left">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#A78BFA" Offset="0"/>
                                                                <GradientStop Color="#8B5CF6" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ProgresoTexto}" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ FILA 5: POR AÑO ══ -->
                <Border Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding [Stats_PorAnio], Source={x:Static loc:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding [Stats_PorAnioSub], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding VistosPorAnio}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Etiqueta}" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Height="18" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Width="{Binding AnchoBarra}" HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#60A5FA" Offset="0"/>
                                                        <GradientStop Color="#3B82F6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Valor}" Foreground="#93C5FD" FontSize="12" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
