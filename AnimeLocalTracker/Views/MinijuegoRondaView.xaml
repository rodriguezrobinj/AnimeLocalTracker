<UserControl x:Class="AnimeLocalTracker.Views.MinijuegoRondaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             Background="Transparent">

    <!-- La columna de la ronda, igual en los tres juegos: ronda y puntos, pistas reveladas, pedir otra pista, las 4 opciones,
         el resultado con el botón para continuar, los atajos y "Abandonar partida". Se enlaza al ViewModel del juego activo
         (MinijuegoViewModelBase); lo propio de cada juego (portada, audio, imagen) va a su izquierda, en la vista del juego. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MinijuegosEstilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Ronda y puntos -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource AppBadge}" Margin="0,0,8,0">
                <TextBlock Text="{Binding RondaTexto}" Style="{StaticResource AppText.Micro}" VerticalAlignment="Center"/>
            </Border>
            <Border Style="{StaticResource AppBadge}" Background="{DynamicResource Brush.WarningTint}">
                <TextBlock Text="{Binding PuntosTexto}" Style="{StaticResource AppText.Micro}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- Pistas reveladas (2-6 elementos: un ItemsControl basta, no es una lista grande) -->
        <ItemsControl ItemsSource="{Binding Pistas}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource AppCard}" Margin="0,0,0,6" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="{Binding Icono}" Foreground="{DynamicResource Brush.Accent}" Width="20" Height="20"
                                                     VerticalAlignment="Top" Margin="0,2,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Etiqueta}" Style="{StaticResource AppText.Micro}" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                <TextBlock Text="{Binding Texto}" Style="{StaticResource AppText.Body}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Tras responder: un dato más sobre la respuesta (de qué anime es el personaje). Sin texto no ocupa sitio. -->
        <TextBlock Text="{Binding DetalleRespuestaTexto}" TextWrapping="Wrap" Margin="0,0,0,14">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource AppText.Secondary}">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Pedir otra pista -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18"
                    Visibility="{Binding HaRespondido, Converter={StaticResource InverseBoolToVis}}">
            <Button Command="{Binding PedirPistaCommand}" Style="{StaticResource MiniBotonSecundario}"
                    IsEnabled="{Binding PuedePedirPista}"
                    AutomationProperties.Name="{Binding [Mini_PedirPista], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [Mini_PedirPista], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding PuntosPosiblesTexto}" Style="{StaticResource AppText.Caption}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- 2×2: en 4 filas, con todas las pistas visibles las opciones se salían de la ventana en pantallas de 768 px -->
        <ItemsControl ItemsSource="{Binding Opciones}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource MiniOpcionStyle}"
                            Command="{Binding DataContext.ResponderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding NombreAccesible}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Resultado de la ronda + continuar -->
        <StackPanel Margin="0,6,0,0" Visibility="{Binding MostrarSiguiente, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ResultadoTexto}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UltimoFueAcierto}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Command="{Binding SiguienteCommand}" Style="{StaticResource MiniBotonPrincipal}" HorizontalAlignment="Left"
                    AutomationProperties.Name="{Binding TextoSiguiente}">
                <TextBlock Text="{Binding TextoSiguiente}"/>
            </Button>
        </StackPanel>

        <TextBlock Text="{Binding AtajosTexto}" Style="{StaticResource AppText.Micro}" Foreground="{DynamicResource Brush.TextTertiary}"
                   Margin="0,20,0,0" TextWrapping="Wrap"/>

        <!-- Abandonar: antes la única forma de empezar otra partida era terminar las 10 rondas. Una partida abandonada no se guarda. -->
        <Button Command="{Binding VolverAlInicioCommand}" Style="{StaticResource MiniBotonSecundario}" HorizontalAlignment="Left" Margin="0,14,0,0"
                ToolTip="{Binding [Mini_AbandonarTip], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"
                AutomationProperties.Name="{Binding [Mini_Abandonar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}">
            <TextBlock Text="{Binding [Mini_Abandonar], Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay}"/>
        </Button>
    </StackPanel>
</UserControl>
