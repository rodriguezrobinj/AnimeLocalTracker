<UserControl x:Class="AnimeLocalTracker.Views.GaleriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <Grid MaxWidth="1248">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="95,60,30,30" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Margin" Value="95,30,30,30" />
                    </DataTrigger>
                    <Trigger Property="Visibility" Value="Visible">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuarticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="25" To="0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuarticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Overlay invisible para cerrar el menú si se hace clic fuera de él -->
        <Border Background="Transparent" 
                Visibility="{Binding MenuUsuarioAbierto, Converter={StaticResource BoolToVis}}"
                Grid.RowSpan="3" Panel.ZIndex="5">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CerrarMenuUsuarioCommand}"/>
            </Border.InputBindings>
        </Border>

        <!-- HEADER MODERNO CON ÍCONOS -->
        <Grid Grid.Row="0" Margin="0,0,0,20" Panel.ZIndex="10">
            <TextBlock Text="Mi Colección" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold" VerticalAlignment="Center"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding AñadirAnimeManualCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,15,0" ToolTip="Buscar y añadir un nuevo anime">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MagnifyPlus" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="BUSCAR ANIME" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ConectarAniListCommand}" 
                        Visibility="{Binding EstaConectado, Converter={StaticResource InverseBoolToVis}}"
                        Background="#3F51B5" BorderBrush="#3F51B5" Foreground="White" Margin="0,0,15,0" ToolTip="Conectar con AniList">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudUpload" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="CONECTAR" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                
                <ToggleButton Command="{Binding ToggleModoSeleccionCommand}" 
                              IsChecked="{Binding ModoSeleccion, Mode=OneWay}"
                              Style="{StaticResource MaterialDesignActionToggleButton}"
                              Background="#2A2A2A" BorderThickness="0" Margin="0,0,15,0"
                              ToolTip="Selección múltiple" Width="40" Height="40">
                    <materialDesign:ToggleButtonAssist.OnContent>
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="White"/>
                    </materialDesign:ToggleButtonAssist.OnContent>
                    <materialDesign:PackIcon Kind="CheckAll" Width="20" Height="20" Foreground="{DynamicResource MaterialDesignBody}"/>
                </ToggleButton>

                <Grid Margin="0,0,15,0" Visibility="{Binding EstaConectado, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top">
                    <!-- Idle state background -->
                    <Border Background="#1AFFFFFF" CornerRadius="20" Height="40" VerticalAlignment="Top" IsHitTestVisible="False"/>

                    <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <!-- Expandable background that clips contents -->
                        <Border x:Name="UnifiedBackground" 
                                Width="{Binding ActualWidth, ElementName=UserMenuToggle}"
                                Background="#252525" CornerRadius="20"
                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Height" Value="40"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=UserMenuToggle}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Background" Value="#2AFFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#00FFFFFF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MenuUsuarioAbierto}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Background" Value="#252525"/>
                                            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                            <!-- Softer bottom corners when open -->
                                            <Setter Property="CornerRadius" Value="20,20,16,16"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="40" To="86" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="86" To="40" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <!-- Dropdown content placed below the button using Margin -->
                            <Grid Margin="0,40,0,0" Height="46" VerticalAlignment="Top">
                                <!-- Subtle separator line -->
                                <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Margin="12,0"/>
                                <Button Command="{Binding DesconectarAniListCommand}" 
                                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FF5252"
                                        Height="46" Padding="24,0" Margin="0"
                                        materialDesign:ButtonAssist.CornerRadius="0,0,16,16">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Logout" Margin="0,0,8,0" VerticalAlignment="Center" Width="20" Height="20"/>
                                        <TextBlock Text="Cerrar Sesión" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Canvas>
                    
                    <Button x:Name="UserMenuToggle" 
                            Command="{Binding ToggleMenuUsuarioCommand}"
                            Height="40" MinWidth="180" VerticalAlignment="Top"
                            Cursor="Hand" ToolTip="Cuenta sincronizada con AniList (Clic para opciones)"
                            Background="Transparent" BorderThickness="0" Padding="24,4" Panel.ZIndex="2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="28" Height="28" Margin="0,0,10,0" Stroke="#3F51B5" StrokeThickness="1.5">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarUsuarioAniList, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding NombreUsuarioAniList}" 
                                       Foreground="{DynamicResource MaterialDesignBody}" 
                                       VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                            <materialDesign:PackIcon Kind="ChevronDown" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MenuUsuarioAbierto}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="180" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="180" To="0" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <Button Command="{Binding ActualizarBibliotecaCommand}" 
                        Background="#4CAF50" BorderBrush="#4CAF50" Foreground="White" ToolTip="Actualizar datos desde la nube">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Sync" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="SINCRONIZAR" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- BARRA DE BÚSQUEDA Y FILTROS -->
        <Grid Grid.Row="1" Margin="0,0,0,20" Visibility="{Binding BibliotecaVacia, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Buscador Local -->
            <Border Grid.Column="0" Background="#1AFFFFFF" CornerRadius="12" Height="46" VerticalAlignment="Center" Padding="15,0,5,0" Margin="0,0,20,0"
                    HorizontalAlignment="Left" Width="350" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <TextBox Grid.Column="1" 
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Buscar anime guardado..."
                             materialDesign:HintAssist.IsFloating="False"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             FontSize="15"
                             Foreground="White"
                             Margin="0,0,10,0">
                    </TextBox>
                </Grid>
            </Border>

            <!-- Chips de Estado -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <RadioButton Content="Todos" Margin="0,0,10,0" IsChecked="True" GroupName="FiltroEstado"
                             Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todos"
                             Style="{StaticResource MaterialDesignTabRadioButton}" 
                             Height="32" Padding="16,0" FontSize="13" FontWeight="SemiBold"/>
                
                <RadioButton Content="Viendo" Margin="0,0,10,0" GroupName="FiltroEstado"
                             Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Viendo"
                             Style="{StaticResource MaterialDesignTabRadioButton}" 
                             Height="32" Padding="16,0" FontSize="13" FontWeight="SemiBold"/>
                             
                <RadioButton Content="Completados" Margin="0,0,10,0" GroupName="FiltroEstado"
                             Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Completados"
                             Style="{StaticResource MaterialDesignTabRadioButton}" 
                             Height="32" Padding="16,0" FontSize="13" FontWeight="SemiBold"/>
                             
                <RadioButton Content="Planeando" Margin="0,0,0,0" GroupName="FiltroEstado"
                             Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Planeando"
                             Style="{StaticResource MaterialDesignTabRadioButton}" 
                             Height="32" Padding="16,0" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- Panel de progreso FLOTANTE -->
        <materialDesign:Card Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" 
                             Padding="25,12" UniformCornerRadius="25" Background="#1E1E1E"
                             Visibility="{Binding EstaActualizando, Converter={StaticResource BoolToVis}}" 
                             Panel.ZIndex="50" materialDesign:ElevationAssist.Elevation="Dp8">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CloudSync" Foreground="#4CAF50" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding TextoProgreso}" 
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="14"/>
                <ProgressBar Minimum="0" Maximum="{Binding ProgresoTotal}" 
                             Value="{Binding ProgresoActual}" 
                             Width="150" Height="6" VerticalAlignment="Center" Foreground="#4CAF50" 
                             Background="#404CAF50" materialDesign:TransitionAssist.DisableTransitions="True"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- BARRA DE ACCIONES MÚLTIPLES (FLOTANTE) -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30" 
                Background="#252525" CornerRadius="24" Padding="20,8"
                Visibility="{Binding ModoSeleccion, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="100" BorderBrush="#40FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Mover a:" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14"/>
                
                <Button Content="Viendo" Command="{Binding CategorizarSeleccionadosCommand}" CommandParameter="CURRENT" 
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#64B5F6" FontWeight="Bold"/>
                
                <Button Content="Completados" Command="{Binding CategorizarSeleccionadosCommand}" CommandParameter="COMPLETED" 
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#81C784" FontWeight="Bold"/>
                
                <Button Content="Planeando" Command="{Binding CategorizarSeleccionadosCommand}" CommandParameter="PLANNING" 
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E0E0E0" FontWeight="Bold"/>
                
                <Border Width="1" Background="#40FFFFFF" Margin="10,5"/>
                
                <Button Content="Cancelar" Command="{Binding ToggleModoSeleccionCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E57373" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- ESTADO VACÍO (0 animes guardados) -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"
                    Visibility="{Binding BibliotecaVacia, Converter={StaticResource BoolToVis}}">
            <materialDesign:PackIcon Kind="ArchiveOutline" Width="80" Height="80" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0.5"/>
            <TextBlock Text="Tu biblioteca está vacía" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center"/>
            <TextBlock Text="Añade un anime para empezar tu colección local" FontSize="14" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,10,0,30" Opacity="0.8"/>
            <Button Command="{Binding AñadirAnimeManualCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#3F51B5" BorderBrush="#3F51B5" Foreground="White" Padding="20,10" HorizontalAlignment="Center" Height="Auto">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MagnifyPlus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="BUSCAR Y AÑADIR ANIME" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- SIN RESULTADOS (La búsqueda o filtro no encontró nada) -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"
                    Visibility="{Binding SinResultados, Converter={StaticResource BoolToVis}}">
            <materialDesign:PackIcon Kind="MagnifyRemoveOutline" Width="80" Height="80" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0.5"/>
            <TextBlock Text="No se encontraron animes" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center"/>
            <TextBlock Text="Intenta usar otros términos de búsqueda o cambia el filtro de estado." FontSize="14" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.8"/>
        </StackPanel>

        <!-- Lista virtualizada -->
        <ListBox Grid.Row="2" ItemsSource="{Binding BibliotecaFiltrada}" Margin="-14,0,-14,0" Padding="0"
                 Visibility="{Binding BibliotecaVacia, Converter={StaticResource InverseBoolToVis}}"
                 Background="Transparent" BorderThickness="0" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="None" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Width="180" Height="265" Margin="14" 
                                             UniformCornerRadius="10" Background="#121212"
                                             RenderTransformOrigin="0.5,0.5" ClipToBounds="False"
                                             CacheMode="BitmapCache">
                            <materialDesign:Card.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </materialDesign:Card.RenderTransform>
                            <materialDesign:Card.Style>
                                <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp6" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp12" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:Card.Style>
        
                            <!-- NOTA: Usaremos RelativeSource AncestorType UserControl para encontrar el ViewModel de la Galería -->
                            <Button Command="{Binding DataContext.AbrirDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" 
                                    Padding="0" Background="Transparent" BorderThickness="0" Height="265" 
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Border Style="{StaticResource ShimmerEffectStyle}" CornerRadius="10" />
                                    <Image Source="{Binding PortadaVisible, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" Stretch="UniformToFill" />
                                    
                                    <!-- OVERLAY DE SELECCIÓN -->
                                    <Border Background="#66000000" Visibility="{Binding EstaSeleccionado, Converter={StaticResource BoolToVis}}"/>
                                    <Border BorderBrush="#3F51B5" BorderThickness="4" CornerRadius="10" Visibility="{Binding EstaSeleccionado, Converter={StaticResource BoolToVis}}"/>
                                    
                                    <!-- CHECKBOX DE SELECCIÓN (Visible solo en ModoSeleccion) -->
                                    <CheckBox IsChecked="{Binding EstaSeleccionado}" 
                                              Visibility="{Binding DataContext.ModoSeleccion, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                              Style="{StaticResource MaterialDesignDarkCheckBox}"
                                              IsHitTestVisible="False"
                                              Panel.ZIndex="10"/>

                                    <Border Background="{Binding ColorEstado}" Padding="8,4" CornerRadius="6" 
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                            materialDesign:ElevationAssist.Elevation="Dp2"
                                            Visibility="{Binding EstaSeleccionado, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="{Binding EstadoVisual}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>

                                    <!-- BADGE NUEVOS EPISODIOS -->
                                    <Border Background="#E53935" CornerRadius="10" Padding="8,4" 
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                            Visibility="{Binding TieneNuevosEpisodios, Converter={StaticResource BoolToVis}}"
                                            materialDesign:ElevationAssist.Elevation="Dp4"
                                            Panel.ZIndex="15">
                                        <TextBlock Text="{Binding NuevosEpisodios, StringFormat='{}{0} Nuevos'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>

                                    <Border VerticalAlignment="Bottom" Padding="12,25,12,12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#CC000000" Offset="0.5"/>
                                                <GradientStop Color="#FF000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" Foreground="White" FontWeight="Bold" 
                                                       FontSize="14" TextTrimming="CharacterEllipsis" MaxHeight="45" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            
                                            <!-- PROGRESS BAR Y TEXTO -->
                                            <ProgressBar Value="{Binding ProgresoPorcentaje, Mode=OneWay}" Height="4" 
                                                         Background="#44FFFFFF" Foreground="#E53935" 
                                                         BorderThickness="0" Margin="0,0,0,4"/>
                                            
                                            <TextBlock Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} de {1} vistos">
                                                        <Binding Path="EpisodiosVistos"/>
                                                        <Binding Path="TotalEpisodios"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Button>
                        </materialDesign:Card>
                    </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</UserControl>
