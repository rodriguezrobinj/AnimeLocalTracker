<UserControl x:Class="AnimeLocalTracker.Views.GaleriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             xmlns:views="clr-namespace:AnimeLocalTracker.Views"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent">

    <UserControl.InputBindings>
        <!-- Escape cierra el panel "Qué veo hoy" (sin efecto cuando está cerrado) -->
        <KeyBinding Key="Escape" Command="{Binding QueVeoHoy.CerrarQueVerHoyCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- La tarjeta de anime (TarjetaAnime) y su menú contextual -->
                <ResourceDictionary Source="GaleriaTarjeta.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ══ Botón "QUÉ VEO HOY": mismo recipe que "Filtros" y el resto de botones outlined de la app
                     (superficie plana + borde sutil, acento azul; al pasar el ratón resalta con el azul). ══ -->
            <Style x:Key="QueVeoHoyButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Surface1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentStrong}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Raíz sin márgenes: el panel "Qué veo hoy" la cubre por completo (antes quedaba dentro de la
         página con márgenes y dejaba a la vista un marco y la barra de scroll de la galería). -->
    <Grid>
    <!-- Cambiar entre Biblioteca y Minijuegos es un cambio en seco: se oculta el contenedor, no la página (que es la que anima al aparecer). -->
    <Grid Visibility="{Binding MostrandoBiblioteca, Converter={StaticResource BoolToVis}}">
    <Grid MaxWidth="1248">
        <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource AppPageRoot}">
                <Style.Triggers>
                    <!-- Con la ruleta abierta la galería se difumina y no recibe NADA: ni rueda, ni barra de
                         scroll, ni clics, ni teclado (IsEnabled=False). -->
                    <DataTrigger Binding="{Binding QueVeoHoy.QueVerHoyAbierto}" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="16" KernelType="Gaussian"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Overlay invisible para cerrar el menú si se hace clic fuera de él -->
        <Border Background="Transparent" 
                Visibility="{Binding MenuUsuarioAbierto, Converter={StaticResource BoolToVis}}"
                Grid.RowSpan="3" Panel.ZIndex="5">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CerrarMenuUsuarioCommand}"/>
            </Border.InputBindings>
        </Border>

        <!-- HEADER MODERNO CON ÍCONOS -->
        <Grid Grid.Row="0" Margin="0,0,0,20" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:T Gal_Titulo}" Style="{StaticResource AppText.PageTitle}" VerticalAlignment="Center"/>

                <!-- BADGE CONTEO BIBLIOTECA -->
                <Border Style="{StaticResource AppBadge}" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalAnimesBiblioteca}" Style="{StaticResource AppText.Caption}" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <!-- Selector Biblioteca | Minijuegos -->
                <views:SelectorSeccionGaleria Margin="22,0,0,0"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Botón Qué Veo Hoy (abre el panel con la ruleta) -->
                <Button Command="{Binding QueVeoHoy.ElegirQueVerHoyCommand}"
                        Style="{StaticResource QueVeoHoyButton}" Margin="0,0,10,0"
                        ToolTip="{loc:T Gal_QueVerTip}"
                        AutomationProperties.Name="{loc:T Gal_QueVeoHoy}">
                    <Button.Triggers>
                        <!-- Detalle sutil: el dado da una vuelta al pasar el ratón (solo con el ratón, sin bucles) -->
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="DadoQueVeoHoy"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.5" FillBehavior="Stop" EasingFunction="{StaticResource Anim.Suave}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="DadoQueVeoHoy" Kind="DiceMultiple" Width="18" Height="18" Margin="0,0,8,0"
                                                 VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <materialDesign:PackIcon.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </materialDesign:PackIcon.RenderTransform>
                        </materialDesign:PackIcon>
                        <TextBlock Text="{loc:T Gal_QueVeoHoy}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Botón Selección Múltiple -->
                <ToggleButton Command="{Binding ToggleModoSeleccionCommand}" 
                              IsChecked="{Binding ModoSeleccion, Mode=OneWay}"
                              Style="{StaticResource MaterialDesignActionToggleButton}"
                              Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                              Margin="0,0,10,0"
                              ToolTip="{loc:T Gal_SeleccionMultiple}" Width="40" Height="40"
                              AutomationProperties.Name="{loc:T Gal_SeleccionMultiple}">
                    <materialDesign:ToggleButtonAssist.OnContent>
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                    </materialDesign:ToggleButtonAssist.OnContent>
                    <materialDesign:PackIcon Kind="CheckAll" Width="18" Height="18" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </ToggleButton>

                <!-- Botón Sincronizar -->
                <Button Command="{Binding ActualizarBibliotecaCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Width="40" Height="40" Padding="0" Margin="0,0,10,0"
                        ToolTip="{loc:T Gal_ActualizarNube}"
                        AutomationProperties.Name="{loc:T Gal_ActualizarNube}">
                    <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" Foreground="{DynamicResource Brush.Success}"/>
                </Button>

                <!-- Botón Conectar (si no está autenticado) -->
                <Button Command="{Binding ConectarAniListCommand}"
                        Style="{StaticResource AppPrimaryButton}" Height="40" Padding="14,0"
                        Visibility="{Binding EstaConectado, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="{loc:T Gal_ConectarTip}"
                        AutomationProperties.Name="{loc:T Gal_Conectar}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudUpload" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="{loc:T Gal_Conectar}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"/>
                    </StackPanel>
                </Button>

                <!-- Menú Usuario (si está autenticado) -->
                <Grid Margin="0,0,0,0" Visibility="{Binding EstaConectado, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top">
                    <!-- Idle state background -->
                    <Border Background="#1AFFFFFF" CornerRadius="20" Height="40" VerticalAlignment="Top" IsHitTestVisible="False"/>

                    <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <!-- Expandable background that clips contents -->
                        <Border x:Name="UnifiedBackground" 
                                Width="{Binding ActualWidth, ElementName=UserMenuToggle}"
                                Background="{DynamicResource Brush.Surface3}" CornerRadius="20"
                                BorderBrush="{DynamicResource Brush.RingBase}" BorderThickness="1"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Height" Value="40"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=UserMenuToggle}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Background" Value="#2AFFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#00FFFFFF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MenuUsuarioAbierto}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.RingBase}"/>
                                            <!-- Softer bottom corners when open -->
                                            <Setter Property="CornerRadius" Value="20,20,16,16"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="40" To="86" Duration="0:0:0.25" EasingFunction="{StaticResource Anim.Suave}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="86" To="40" Duration="{StaticResource Anim.Normal}" EasingFunction="{StaticResource Anim.SuaveEntrada}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <!-- Dropdown content placed below the button using Margin -->
                            <Grid Margin="0,40,0,0" Height="46" VerticalAlignment="Top">
                                <!-- Subtle separator line -->
                                <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Margin="12,0"/>
                                <Button Command="{Binding DesconectarAniListCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FF5252"
                                        Height="46" Padding="24,0" Margin="0"
                                        materialDesign:ButtonAssist.CornerRadius="0,0,16,16"
                                        AutomationProperties.Name="{loc:T Cfg_CerrarSesion}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Logout" Margin="0,0,8,0" VerticalAlignment="Center" Width="20" Height="20"/>
                                        <TextBlock Text="{loc:T Cfg_CerrarSesion}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Canvas>
                    
                    <Button x:Name="UserMenuToggle"
                            Command="{Binding ToggleMenuUsuarioCommand}"
                            Height="40" MinWidth="180" VerticalAlignment="Top"
                            Cursor="Hand" ToolTip="{loc:T Gal_CuentaSincronizadaTip}"
                            Background="Transparent" BorderThickness="0" Padding="24,4" Panel.ZIndex="2"
                            AutomationProperties.Name="{Binding NombreUsuarioAniList}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="28" Height="28" Margin="0,0,10,0" Stroke="{DynamicResource Brush.AccentStrong}" StrokeThickness="1.5">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarUsuarioAniList, TargetNullValue={x:Null}, FallbackValue={x:Null}, IsAsync=True}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding NombreUsuarioAniList}" 
                                       Foreground="{DynamicResource MaterialDesignBody}" 
                                       VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                            <materialDesign:PackIcon Kind="ChevronDown" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MenuUsuarioAbierto}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="180" Duration="{StaticResource Anim.Normal}" EasingFunction="{StaticResource Anim.Suave}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="180" To="0" Duration="{StaticResource Anim.Normal}" EasingFunction="{StaticResource Anim.SuaveEntrada}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- BARRA DE BÚSQUEDA Y FILTROS (control propio) -->
        <views:GaleriaFiltrosView Grid.Row="1" Margin="0,0,0,20" Visibility="{Binding BibliotecaVacia, Converter={StaticResource InverseBoolToVis}}"/>

        <!-- Panel de progreso FLOTANTE -->
        <materialDesign:Card Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" 
                             Padding="25,12" UniformCornerRadius="25" Background="#1E1E1E"
                             Visibility="{Binding EstaActualizando, Converter={StaticResource BoolToVis}}" 
                             Panel.ZIndex="50" materialDesign:ElevationAssist.Elevation="Dp8">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CloudSync" Foreground="{DynamicResource Brush.Success}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding TextoProgreso}" 
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="14"/>
                <!-- Indeterminada: es una sola consulta a AniList; la barra que "avanzaba" por anime saltaba de vacía a llena de golpe -->
                <ProgressBar IsIndeterminate="{Binding EstaActualizando}"
                             Width="150" Height="6" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Success}"
                             Background="#404CAF50"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- BARRA DE ACCIONES MÚLTIPLES (FLOTANTE) -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30" 
                Background="{DynamicResource Brush.Surface3}" CornerRadius="24" Padding="16,8"
                Visibility="{Binding ModoSeleccion, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="100" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
            <!-- Los colores de cada destino son los mismos que los de la etiqueta de estado de la tarjeta -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SeleccionadosTexto}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold" FontSize="13"/>
                <Button Content="{loc:T Gal_SeleccionarTodos}" Command="{Binding SeleccionarTodosCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Brush.AccentSoft}" FontWeight="SemiBold" Padding="10,0"/>

                <Border Width="1" Background="{DynamicResource Brush.BorderStrong}" Margin="8,5"/>

                <TextBlock Text="{loc:T Gal_MoverA}" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="4,0,6,0" FontWeight="Bold" FontSize="14"/>

                <Button Content="{loc:T Gal_FiltroViendo}" Command="{Binding CategorizarSeleccionadosCommand}" CommandParameter="CURRENT"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" Padding="10,0"/>

                <Button Content="{loc:T Hist_FiltroCompletados}" Command="{Binding CategorizarSeleccionadosCommand}" CommandParameter="COMPLETED"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Brush.Success}" FontWeight="Bold" Padding="10,0"/>

                <Button Content="{loc:T Gal_FiltroPlaneando}" Command="{Binding CategorizarSeleccionadosCommand}" CommandParameter="PLANNING"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Bold" Padding="10,0"/>

                <Button Content="{loc:T Gal_FiltroEnPausa}" Command="{Binding CategorizarSeleccionadosCommand}" CommandParameter="PAUSED"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Brush.WarningStrong}" FontWeight="Bold" Padding="10,0"/>

                <Button Content="{loc:T Gal_FiltroAbandonados}" Command="{Binding CategorizarSeleccionadosCommand}" CommandParameter="DROPPED"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Brush.Danger}" FontWeight="Bold" Padding="10,0"/>

                <Border Width="1" Background="{DynamicResource Brush.BorderStrong}" Margin="8,5"/>

                <Button Content="{loc:T Gal_Cancelar}" Command="{Binding ToggleModoSeleccionCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="Bold" Padding="10,0"/>
            </StackPanel>
        </Border>

        <!-- ESTADO VACÍO (0 animes guardados) -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"
                    Visibility="{Binding BibliotecaVacia, Converter={StaticResource BoolToVis}}">
            <materialDesign:PackIcon Kind="ArchiveOutline" Width="80" Height="80" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0.5"/>
            <TextBlock Text="{loc:T Gal_VacioTitulo}" Style="{StaticResource AppEmptyTitle}"/>
            <TextBlock Text="{loc:T Gal_VacioSub}" Style="{StaticResource AppEmptyText}" Margin="0,10,0,30"/>
            <Button Command="{Binding AñadirAnimeManualCommand}" Style="{StaticResource AppPrimaryButton}" Padding="20,10" HorizontalAlignment="Center" Height="Auto">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MagnifyPlus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:T Gal_BuscarYAnadir}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- SIN RESULTADOS (La búsqueda o filtro no encontró nada) -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"
                    Visibility="{Binding SinResultados, Converter={StaticResource BoolToVis}}">
            <materialDesign:PackIcon Kind="MagnifyRemoveOutline" Width="80" Height="80" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0.5"/>
            <TextBlock Text="{loc:T Gal_SinResultadosTitulo}" Style="{StaticResource AppEmptyTitle}"/>
            <TextBlock Text="{loc:T Gal_SinResultadosSub}" Style="{StaticResource AppEmptyText}" Margin="0,10,0,24"/>
            <Button Command="{Binding LimpiarFiltrosCommand}" Style="{StaticResource AppOutlinedButton}" HorizontalAlignment="Center" Cursor="Hand"
                    AutomationProperties.Name="{loc:T Gal_LimpiarFiltros}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:T Gal_LimpiarFiltros}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- CARGANDO la biblioteca al abrir la app -->
        <ProgressBar Grid.Row="2" Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="{Binding EstaCargando}"
                     Width="44" Height="44" Value="0" Foreground="{DynamicResource Brush.Accent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>

        <!-- Lista virtualizada y acelerada por hardware (60fps+) -->
        <ListBox x:Name="ListaGaleria" Grid.Row="2" ItemsSource="{Binding BibliotecaFiltrada}" Margin="-14,0,-14,0" Padding="0,0,14,0"
                 Visibility="{Binding BibliotecaVacia, Converter={StaticResource InverseBoolToVis}}"
                 Background="Transparent" BorderThickness="0" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.PanningMode="Both"
                 ScrollViewer.IsDeferredScrollingEnabled="False"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.CacheLengthUnit="Item"
                 VirtualizingPanel.CacheLength="4,4"
                 RenderOptions.ClearTypeHint="Enabled"
                 KeyboardNavigation.DirectionalNavigation="Continue"
                 ItemTemplate="{StaticResource TarjetaAnime}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="None" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>
    </Grid>
    </Grid>

    <!-- SECCIÓN MINIJUEGOS de la Galería: misma página (título + selector) pero con los juegos como contenido. La vista de los
         juegos se crea la primera vez que hace falta (ContenidoMinijuegos) y después se conserva. Fuera de la sección queda
         Hidden y no Collapsed: así se puede dejar construida por adelantado (un elemento Collapsed no se mide). -->
    <Grid x:Name="SeccionMinijuegos" Visibility="{Binding MostrandoMinijuegos, Converter={StaticResource BoolToVisOculto}}">
    <Grid MaxWidth="1248" Style="{StaticResource AppPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="{loc:T Gal_Titulo}" Style="{StaticResource AppText.PageTitle}" VerticalAlignment="Center"/>
            <views:SelectorSeccionGaleria Margin="22,0,0,0"/>
        </StackPanel>

        <ContentControl Grid.Row="1" Content="{Binding ContenidoMinijuegos}" Focusable="False" IsTabStop="False"/>
    </Grid>
    </Grid>

    <!-- QUE VEO HOY: panel modal con ruleta de portadas (control propio, con su ViewModel) -->
    <views:QueVeoHoyPanel DataContext="{Binding QueVeoHoy}"/>
    </Grid>

</UserControl>
