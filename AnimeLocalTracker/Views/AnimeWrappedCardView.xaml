<UserControl x:Class="AnimeLocalTracker.Views.AnimeWrappedCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="1080" Height="1350">
    <Grid Width="1080" Height="1350">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1020" Offset="0"/>
                <GradientStop Color="#1E1B4B" Offset="0.55"/>
                <GradientStop Color="#3B1650" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" Margin="70,0">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                <materialDesign:PackIcon Kind="Star" Foreground="#A78BFA" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="ANIMELOCALTRACKER" FontSize="20" FontWeight="Bold" Foreground="#C4B5FD"/>
            </StackPanel>

            <TextBlock Text="{Binding TituloCard}" FontSize="54" FontWeight="Black" Foreground="White"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,44"/>

            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,50">
                <Border Width="170" Height="170" CornerRadius="85" Background="#2E2547" BorderBrush="#A78BFA" BorderThickness="4">
                    <Grid>
                        <materialDesign:PackIcon Kind="Account" Foreground="#8B7EC8" Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse x:Name="AvatarEllipse" Width="162" Height="162"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding NombreUsuario}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,20,0,0"/>

                <!-- Sello de rango (Logros): el mismo "Novato → ... → Leyenda" de Estadísticas, ya en
                     mayúsculas desde el ViewModel (ConstruirDatosWrappedAsync) — para que la tarjeta se
                     sienta ganada y no una plantilla genérica con números sueltos. -->
                <Border Background="#3B2E5E" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="22" Padding="22,9" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TrophyVariant" Foreground="#FBBF24" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="{Binding RangoOtakuTexto}" FontSize="17" FontWeight="Bold" Foreground="#FDE68A"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Height="1" Background="#332B55" Margin="0,0,0,44"/>

            <Grid Margin="0,0,0,50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,36">
                    <TextBlock Text="{Binding HorasLabel}" FontSize="15" FontWeight="Bold" Foreground="#A78BFA"/>
                    <TextBlock Text="{Binding HorasVistasTexto}" FontSize="50" FontWeight="Black" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,36">
                    <TextBlock Text="{Binding EpisodiosLabel}" FontSize="15" FontWeight="Bold" Foreground="#60A5FA"/>
                    <TextBlock Text="{Binding EpisodiosVistosTexto}" FontSize="50" FontWeight="Black" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding GeneroLabel}" FontSize="15" FontWeight="Bold" Foreground="#34D399"/>
                    <TextBlock Text="{Binding GeneroFavorito}" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{Binding RachaLabel}" FontSize="15" FontWeight="Bold" Foreground="#FBBF24"/>
                    <TextBlock Text="{Binding RachaMaximaTexto}" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,50">
                <TextBlock Text="{Binding TopAnimesLabel}" FontSize="15" FontWeight="Bold" Foreground="#F472B6" Margin="0,0,0,20"/>
                <ItemsControl ItemsSource="{Binding TopAnimesItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Portada con el puesto (1/2/3) como medalla en la esquina -->
                                <Grid Grid.Column="0" Width="76" Height="108" Margin="0,0,22,0">
                                    <Border CornerRadius="10" Background="#2E2547" BorderBrush="#4C3B73" BorderThickness="1.5" ClipToBounds="True">
                                        <Grid>
                                            <!-- Placeholder DEBAJO de la portada: visible solo si Portada es null o falla la carga -->
                                            <materialDesign:PackIcon Kind="ImageOutline" Foreground="#5B4A82" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Portada}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#F472B6"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,-10,0,0">
                                        <TextBlock Text="{Binding Posicion}" FontSize="15" FontWeight="Black" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Column="1" Text="{Binding Titulo}" FontSize="26" FontWeight="SemiBold" Foreground="White"
                                           VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="100"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding Footer}" FontSize="16" Foreground="#6B7280" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
