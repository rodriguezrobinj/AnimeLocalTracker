<UserControl x:Class="AnimeLocalTracker.Views.AgregarAnimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:loc="clr-namespace:AnimeLocalTracker.Services"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid MaxWidth="1280" Style="{StaticResource AppPageRoot}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Search Bar -->
            <RowDefinition Height="Auto" /> <!-- Section Title -->
            <RowDefinition Height="*" />    <!-- Content Grid -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  HEADER & BARRA DE BÚSQUEDA                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Título Principal -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <Border Background="{StaticResource Brush.Surface3}" CornerRadius="12" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="MagnifyPlus" Foreground="{StaticResource Brush.AccentSoft}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Add_Titulo}" Style="{StaticResource AppText.PageTitle}"/>
                    <TextBlock Text="{loc:T Add_Subtitulo}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Barra de Búsqueda Moderna -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" 
                    CornerRadius="14" Height="46" Padding="14,0" HorizontalAlignment="Stretch" MaxWidth="600"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="22" Height="22" 
                                             Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalAlignment="Center" FontSize="14" Foreground="White"
                             BorderThickness="0" Background="Transparent" 
                             CaretBrush="{StaticResource Brush.Accent}"
                             materialDesign:HintAssist.Hint="{loc:T Add_BuscarHint}"
                             materialDesign:HintAssist.Foreground="#6B7280"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" />

                    <!-- Botón Limpiar Búsqueda -->
                    <Button Grid.Column="2" Command="{Binding LimpiarBusquedaCommand}"
                            Style="{StaticResource MaterialDesignToolButton}"
                            Foreground="{StaticResource Brush.TextSecondary}" Width="28" Height="28" Padding="0"
                            ToolTip="{loc:T Add_LimpiarBusquedaTip}"
                            AutomationProperties.Name="{loc:T Add_LimpiarBusquedaTip}"
                            Visibility="{Binding TieneTextoBusqueda, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  TÍTULO DE SECCIÓN DINÁMICO                                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,8,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Fire" Width="20" Height="20" Foreground="{StaticResource Brush.Warning}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Visibility="{Binding MostrandoTendencias, Converter={StaticResource BoolToVis}}"/>
                <materialDesign:PackIcon Kind="FilterVariant" Width="20" Height="20" Foreground="{StaticResource Brush.Accent}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Visibility="{Binding MostrandoTendencias, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBlock Text="{Binding TituloSeccion}" Style="{StaticResource AppText.Section}" VerticalAlignment="Center"/>

                <!-- BADGE CONTEO DE RESULTADOS -->
                <Border Style="{StaticResource AppBadge}" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding BusquedaSinResultados, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="{Binding Resultados.Count}" Style="{StaticResource AppText.Caption}" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- FILTROS DE GÉNERO, TEMPORADA Y AÑO (sobre los resultados de búsqueda/tendencias) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Selector de Género: el valor real (GeneroSeleccionado, usado para filtrar contra
                     AniListMedia.Genres) sigue en inglés como lo entrega AniList — el ItemTemplate
                     solo traduce lo que se MUESTRA (mismo patrón que GaleriaView). -->
                <ComboBox ItemsSource="{Binding GenerosDisponibles}"
                          SelectedItem="{Binding GeneroSeleccionado}"
                          ToolTip="{loc:T Add_GeneroTip}"
                          Height="34" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource GeneroTraducido}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- El valor es el código de AniList (WINTER…); la plantilla lo traduce al mostrarlo -->
                <ComboBox ItemsSource="{Binding TemporadasDisponibles}"
                          SelectedItem="{Binding TemporadaSeleccionada}"
                          ToolTip="{loc:T Add_TemporadaTip}"
                          Height="34" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TemporadaTexto}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding AniosDisponibles}"
                          SelectedItem="{Binding AnioSeleccionado}"
                          ToolTip="{loc:T Add_AnioTip}"
                          Height="34" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button Command="{Binding LimpiarFiltrosCommand}"
                        Visibility="{Binding HayFiltrosActivos, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Padding="0" Cursor="Hand"
                        ToolTip="{loc:T Add_LimpiarFiltrosTemporada}"
                        AutomationProperties.Name="{loc:T Add_LimpiarFiltrosTemporada}">
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="18" Height="18" Foreground="{StaticResource Brush.TextSecondary}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  CONTENIDO PRINCIPAL (SPINNER / VACÍO / CUADRÍCULA)           -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- Spinner de Carga -->
            <StackPanel Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,60" Panel.ZIndex="10">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0" IsIndeterminate="True"
                             Foreground="{StaticResource Brush.Accent}" Width="48" Height="48"/>
                <TextBlock Text="{loc:T Add_Cargando}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="14" Margin="0,16,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Sin conexión: buscar/tendencias necesitan internet (no es "sin resultados").
                 ZIndex: la lista de resultados (fondo transparente) va después en la misma celda y se quedaba con los clics del botón. -->
            <StackPanel Visibility="{Binding SinConexion, Converter={StaticResource BoolToVis}}" Panel.ZIndex="5"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,60">
                <Border Background="{StaticResource Brush.Surface3}" CornerRadius="40" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="WifiOff" Width="40" Height="40" Foreground="{StaticResource Brush.TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{loc:T Add_SinConexionTitulo}" FontSize="18" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:T Add_SinConexionSub}"
                           FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                <Button Command="{Binding CargarTendenciasCommand}" Cursor="Hand"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource Brush.AccentStrong}" Foreground="{StaticResource Brush.Accent}" Margin="0,18,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:T Add_Reintentar}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Estado Vacío / Sin Resultados (búsqueda vacía o filtro de temporada/año sin coincidencias) -->
            <StackPanel Visibility="{Binding MostrarSinResultados, Converter={StaticResource BoolToVis}}" Panel.ZIndex="5"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,60">
                <Border Background="{StaticResource Brush.Surface3}" CornerRadius="40" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="MagnifyClose" Width="40" Height="40" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{loc:T Add_SinResultadosTitulo}" FontSize="18" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:T Add_SinResultadosSub}"
                           FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
                <Button Command="{Binding LimpiarFiltrosCommand}"
                        Visibility="{Binding SinResultadosFiltrados, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource Brush.AccentStrong}" Foreground="{StaticResource Brush.Accent}" Margin="0,18,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:T Add_LimpiarFiltrosTemporada}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CargarTendenciasCommand}"
                        Visibility="{Binding SinResultadosFiltrados, Converter={StaticResource InverseBoolToVis}}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource Brush.AccentStrong}" Foreground="{StaticResource Brush.Accent}" Margin="0,18,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Fire" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:T Add_VerTendencias}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListBox ItemsSource="{Binding ResultadosFiltrados}"
                     Background="Transparent" BorderThickness="0"
                     KeyboardNavigation.DirectionalNavigation="Continue"
                     KeyboardNavigation.TabNavigation="Continue"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.PanningMode="Both"
                     ScrollViewer.IsDeferredScrollingEnabled="False"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLengthUnit="Item"
                     VirtualizingPanel.CacheLength="4,4"
                     RenderOptions.ClearTypeHint="Enabled"
                     Padding="0,0,16,20"
                     Visibility="{Binding MostrarSinResultados, Converter={StaticResource InverseBoolToVis}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Orientation="Horizontal" ItemSize="220, 375" SpacingMode="Uniform" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="True"/>
                        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8,8,8,12" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="14" Padding="0" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentStrong}"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="{StaticResource Anim.Rapida}" EasingFunction="{StaticResource Anim.Suave}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="{StaticResource Anim.Rapida}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <!-- Estado de foco visible para navegación por teclado (UX-004):
                                             mismo patrón que GaleriaView.xaml (IsKeyboardFocusWithin) -->
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentStrong}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="210"/> <!-- Portada -->
                                    <RowDefinition Height="*"/>   <!-- Información y Acciones -->
                                </Grid.RowDefinitions>

                                <!-- PORTADA CON BADGES -->
                                <Grid Grid.Row="0">
                                    <!-- Efecto "bones": shimmer de fondo mientras la portada carga;
                                         la imagen, al cargar, la cubre por completo. -->
                                    <Border Style="{StaticResource ShimmerEffectStyle}" />

                                    <!-- Portada con imagen asíncrona en alta calidad -->
                                    <Image Source="{Binding PortadaUrl, IsAsync=True, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                           Stretch="UniformToFill" 
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderOptions.EdgeMode="Aliased"
                                           SnapsToDevicePixels="True"/>

                                    <!-- Degradado inferior para contraste -->
                                    <Border VerticalAlignment="Bottom" Height="80">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#E614181E" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Badge de Estado (Top-Left) -->
                                    <Border Background="{Binding EstadoColor}" 
                                            CornerRadius="6" Padding="7,3" 
                                            HorizontalAlignment="Left" VerticalAlignment="Top" 
                                            Margin="10,10,0,0">
                                        <TextBlock Text="{Binding EstadoTexto}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>

                                    <!-- Badge de Año y Episodios (Bottom-Left sobre portada) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,8">
                                        <!-- Episodios -->
                                        <Border Background="{StaticResource Brush.Scrim}" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding EpisodiosTexto}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                        </Border>

                                        <!-- Año -->
                                        <Border Background="{StaticResource Brush.Scrim}" CornerRadius="4" Padding="5,2" Margin="0,0,6,0"
                                                Visibility="{Binding TieneAño, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding AñoTexto}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </Border>

                                        <!-- Temporada -->
                                        <Border Background="{StaticResource Brush.Scrim}" CornerRadius="4" Padding="5,2"
                                                Visibility="{Binding TieneTemporada, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding TemporadaTexto}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- INFORMACIÓN Y ACCIONES -->
                                <Grid Grid.Row="1" Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Título -->
                                        <RowDefinition Height="Auto"/> <!-- Géneros -->
                                        <RowDefinition Height="*"/>    <!-- Espaciador -->
                                        <RowDefinition Height="Auto"/> <!-- Botón -->
                                    </Grid.RowDefinitions>

                                    <!-- Título -->
                                    <TextBlock Grid.Row="0" Text="{Binding TituloPrincipal}" 
                                               FontWeight="Bold" FontSize="13" Foreground="White" 
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                               ToolTip="{Binding TituloPrincipal}" Height="34"/>

                                    <!-- Géneros -->
                                    <TextBlock Grid.Row="1" Text="{Binding GenerosTexto}" 
                                               FontSize="10.5" Foreground="{StaticResource Brush.TextSecondary}" 
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>

                                    <!-- Botones de Acción -->
                                    <Grid Grid.Row="3" Margin="0,2,0,0">
                                        <!-- Botón AÑADIR A BIBLIOTECA (cuando NO está en biblioteca) -->
                                        <Button Command="{Binding DataContext.AñadirAnimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding EstaEnBiblioteca, Converter={StaticResource InverseBoolToVis}}"
                                                Background="{StaticResource Brush.AccentStrong}" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1" Foreground="White"
                                                Height="34" Padding="10,0" materialDesign:ButtonAssist.CornerRadius="8"
                                                Cursor="Hand" ToolTip="{loc:T Add_AnadirBibliotecaTip}">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding EstaGuardando, Converter={StaticResource InverseBoolToVis}}">
                                                    <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{loc:T Add_AnadirBiblioteca}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                                             Value="0" IsIndeterminate="True" Width="18" Height="18" Foreground="White"
                                                             Visibility="{Binding EstaGuardando, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Button>

                                        <!-- Botón EN BIBLIOTECA (cuando YA está en biblioteca) -->
                                        <Button Command="{Binding DataContext.VerEnBibliotecaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding EstaEnBiblioteca, Converter={StaticResource BoolToVis}}"
                                                Background="#132E22" BorderBrush="#10B981" BorderThickness="1" Foreground="{StaticResource Brush.Success}"
                                                Height="34" Padding="10,0" materialDesign:ButtonAssist.CornerRadius="8"
                                                Cursor="Hand" ToolTip="{loc:T Add_VerBibliotecaTip}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Brush.Success}"/>
                                                <TextBlock Text="{loc:T Add_EnBiblioteca}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
