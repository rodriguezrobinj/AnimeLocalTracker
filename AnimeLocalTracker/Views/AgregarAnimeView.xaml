<UserControl x:Class="AnimeLocalTracker.Views.AgregarAnimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid MaxWidth="1280" Style="{StaticResource AppPageRoot}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Search Bar -->
            <RowDefinition Height="Auto" /> <!-- Section Title -->
            <RowDefinition Height="*" />    <!-- Content Grid -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  HEADER & BARRA DE BÚSQUEDA                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Título Principal -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <Border Background="#1E293B" CornerRadius="12" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="MagnifyPlus" Foreground="#93C5FD" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Añadir Anime" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold" FontSize="26"/>
                    <TextBlock Text="Explora tendencias o busca cualquier anime en AniList para tu colección local" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Barra de Búsqueda Moderna -->
            <Border Grid.Column="1" Background="#14181E" BorderBrush="#2D3748" BorderThickness="1" 
                    CornerRadius="14" Height="46" Padding="14,0" HorizontalAlignment="Stretch" MaxWidth="600"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="22" Height="22" 
                                             Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalAlignment="Center" FontSize="14" Foreground="White"
                             BorderThickness="0" Background="Transparent" 
                             CaretBrush="#60A5FA"
                             materialDesign:HintAssist.Hint="Buscar por título (ej. Frieren, Solo Leveling, Bleach)..."
                             materialDesign:HintAssist.Foreground="#6B7280"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" />

                    <!-- Botón Limpiar Búsqueda -->
                    <Button Grid.Column="2" Command="{Binding LimpiarBusquedaCommand}" 
                            Style="{StaticResource MaterialDesignToolButton}" 
                            Foreground="#9CA3AF" Width="28" Height="28" Padding="0"
                            ToolTip="Limpiar búsqueda"
                            Visibility="{Binding TieneTextoBusqueda, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  TÍTULO DE SECCIÓN DINÁMICO                                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,8,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Fire" Width="20" Height="20" Foreground="#F59E0B" 
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Visibility="{Binding MostrandoTendencias, Converter={StaticResource BoolToVis}}"/>
                <materialDesign:PackIcon Kind="FilterVariant" Width="20" Height="20" Foreground="#60A5FA" 
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Visibility="{Binding MostrandoTendencias, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBlock Text="{Binding TituloSeccion}" FontSize="18" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  CONTENIDO PRINCIPAL (SPINNER / VACÍO / CUADRÍCULA)           -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- Spinner de Carga -->
            <StackPanel Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,60" Panel.ZIndex="10">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                             Value="0" IsIndeterminate="True" 
                             Foreground="#60A5FA" Width="48" Height="48"/>
                <TextBlock Text="Cargando animes desde AniList..." Foreground="#9CA3AF" FontSize="14" Margin="0,16,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Estado Vacío / Sin Resultados -->
            <StackPanel Visibility="{Binding BusquedaSinResultados, Converter={StaticResource BoolToVis}}" 
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,60">
                <Border Background="#1E293B" CornerRadius="40" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="MagnifyClose" Width="40" Height="40" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No se encontraron resultados" FontSize="18" Foreground="#E2E8F0" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Prueba escribiendo el título en Romaji, inglés o con menos palabras clave." 
                           FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
                <Button Command="{Binding CargarTendenciasCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                        BorderBrush="#3B82F6" Foreground="#60A5FA" Margin="0,18,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Fire" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ver tendencias populares" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListBox ItemsSource="{Binding Resultados}"
                     Background="Transparent" BorderThickness="0"
                     Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.PanningMode="Both"
                     ScrollViewer.IsDeferredScrollingEnabled="False"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLengthUnit="Item"
                     VirtualizingPanel.CacheLength="4,4"
                     RenderOptions.ClearTypeHint="Enabled"
                     Padding="0,0,8,20"
                     Visibility="{Binding BusquedaSinResultados, Converter={StaticResource InverseBoolToVis}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Orientation="Horizontal" ItemSize="220, 375" SpacingMode="Uniform" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8,8,8,12" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" 
                                CornerRadius="14" Padding="0" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="210"/> <!-- Portada -->
                                    <RowDefinition Height="*"/>   <!-- Información y Acciones -->
                                </Grid.RowDefinitions>

                                <!-- PORTADA CON BADGES -->
                                <Grid Grid.Row="0">
                                    <!-- Portada con imagen asíncrona en alta calidad -->
                                    <Image Source="{Binding PortadaUrl, IsAsync=True, TargetNullValue={x:Null}, FallbackValue={x:Null}}" 
                                           Stretch="UniformToFill" 
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderOptions.EdgeMode="Aliased"
                                           SnapsToDevicePixels="True"/>

                                    <!-- Degradado inferior para contraste -->
                                    <Border VerticalAlignment="Bottom" Height="80">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#E614181E" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Badge de Estado (Top-Left) -->
                                    <Border Background="{Binding EstadoColor}" 
                                            CornerRadius="6" Padding="7,3" 
                                            HorizontalAlignment="Left" VerticalAlignment="Top" 
                                            Margin="10,10,0,0">
                                        <TextBlock Text="{Binding EstadoTexto}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>

                                    <!-- Badge de Año y Episodios (Bottom-Left sobre portada) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,8">
                                        <!-- Episodios -->
                                        <Border Background="#99000000" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding EpisodiosTexto}" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                        </Border>

                                        <!-- Año -->
                                        <Border Background="#99000000" CornerRadius="4" Padding="5,2"
                                                Visibility="{Binding TieneAño, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding AñoTexto}" FontSize="10" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- INFORMACIÓN Y ACCIONES -->
                                <Grid Grid.Row="1" Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Título -->
                                        <RowDefinition Height="Auto"/> <!-- Géneros -->
                                        <RowDefinition Height="*"/>    <!-- Espaciador -->
                                        <RowDefinition Height="Auto"/> <!-- Botón -->
                                    </Grid.RowDefinitions>

                                    <!-- Título -->
                                    <TextBlock Grid.Row="0" Text="{Binding TituloPrincipal}" 
                                               FontWeight="Bold" FontSize="13" Foreground="White" 
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                               ToolTip="{Binding TituloPrincipal}" Height="34"/>

                                    <!-- Géneros -->
                                    <TextBlock Grid.Row="1" Text="{Binding GenerosTexto}" 
                                               FontSize="10.5" Foreground="#9CA3AF" 
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>

                                    <!-- Botones de Acción -->
                                    <Grid Grid.Row="3" Margin="0,2,0,0">
                                        <!-- Botón AÑADIR A BIBLIOTECA (cuando NO está en biblioteca) -->
                                        <Button Command="{Binding DataContext.AñadirAnimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding EstaEnBiblioteca, Converter={StaticResource InverseBoolToVis}}"
                                                Background="#3B82F6" BorderBrush="#60A5FA" BorderThickness="1" Foreground="White"
                                                Height="34" Padding="10,0" materialDesign:ButtonAssist.CornerRadius="8"
                                                Cursor="Hand" ToolTip="Añadir a mi biblioteca local">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding EstaGuardando, Converter={StaticResource InverseBoolToVis}}">
                                                    <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Añadir a biblioteca" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                                             Value="0" IsIndeterminate="True" Width="18" Height="18" Foreground="White"
                                                             Visibility="{Binding EstaGuardando, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Button>

                                        <!-- Botón EN BIBLIOTECA (cuando YA está en biblioteca) -->
                                        <Button Command="{Binding DataContext.VerEnBibliotecaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding EstaEnBiblioteca, Converter={StaticResource BoolToVis}}"
                                                Background="#132E22" BorderBrush="#10B981" BorderThickness="1" Foreground="#34D399"
                                                Height="34" Padding="10,0" materialDesign:ButtonAssist.CornerRadius="8"
                                                Cursor="Hand" ToolTip="Ver detalles en tu biblioteca">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#34D399"/>
                                                <TextBlock Text="En tu biblioteca" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
