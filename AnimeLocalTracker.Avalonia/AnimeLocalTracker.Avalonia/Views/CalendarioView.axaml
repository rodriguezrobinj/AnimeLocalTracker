<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:AnimeLocalTracker.Core.ViewModels;assembly=AnimeLocalTracker.Core"
             xmlns:converters="clr-namespace:AnimeLocalTracker.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:DataType="vm:CalendarioViewModel"
             x:Class="AnimeLocalTracker.Avalonia.Views.CalendarioView"
             Background="Transparent">

    <UserControl.Resources>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
        <converters:ZeroToBoolConverter x:Key="ZeroToBoolConverter" />
        
        <!-- Estilo para las listas de cada día -->
        <DataTemplate x:Key="AiringEpisodeTemplate">
            <Border Margin="0,0,0,10" Background="#1B222C" CornerRadius="8" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Portada -->
                    <Border Grid.Column="0" CornerRadius="8,0,0,8" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding UrlPortada}" Stretch="UniformToFill" Height="80"/>
                        </Grid>
                    </Border>
                    
                    <!-- Información -->
                    <StackPanel Grid.Column="1" Margin="10,5">
                        <TextBlock Text="{Binding HoraEmisionFormateada}" FontSize="12" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" MaxHeight="35" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding NumeroEpisodio, StringFormat='Episodio {0}'}" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="95,65,30,25" MaxWidth="1280">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Calendario de Emisión" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                
                <!-- BADGE CONTEO EN EMISIÓN -->
                <Border Background="#1E3A8A" CornerRadius="10" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalAnimesEnEmision}" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" 
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </StackPanel>
            <Button Command="{Binding CargarCalendarioCommand}" HorizontalAlignment="Right" 
                    Background="Transparent" BorderBrush="#3B82F6" BorderThickness="1" Foreground="#60A5FA"
                    Padding="12,8" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Refresh" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ACTUALIZAR" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Loader -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" 
                     IsVisible="{Binding EstaCargando}" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" Width="50" Height="50" Foreground="#60A5FA"/>

        <!-- Calendario Kanban -->
        <Grid Grid.Row="1" IsVisible="{Binding !EstaCargando}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LUNES -->
            <Border Grid.Column="0" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="LUNES" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                IsVisible="{Binding DiaActual, Converter={StaticResource StringEqualsConverter}, ConverterParameter=LUNES}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Lunes.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               IsVisible="{Binding Lunes.Count, Converter={StaticResource ZeroToBoolConverter}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" AllowAutoHide="True">
                        <ItemsControl ItemsSource="{Binding Lunes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- MARTES -->
            <Border Grid.Column="1" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="MARTES" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                IsVisible="{Binding DiaActual, Converter={StaticResource StringEqualsConverter}, ConverterParameter=MARTES}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Martes.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               IsVisible="{Binding Martes.Count, Converter={StaticResource ZeroToBoolConverter}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" AllowAutoHide="True">
                        <ItemsControl ItemsSource="{Binding Martes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- MIÉRCOLES -->
            <Border Grid.Column="2" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="MIÉRCOLES" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                IsVisible="{Binding DiaActual, Converter={StaticResource StringEqualsConverter}, ConverterParameter=MIÉRCOLES}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Miercoles.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               IsVisible="{Binding Miercoles.Count, Converter={StaticResource ZeroToBoolConverter}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" AllowAutoHide="True">
                        <ItemsControl ItemsSource="{Binding Miercoles}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- JUEVES -->
            <Border Grid.Column="3" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="JUEVES" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                IsVisible="{Binding DiaActual, Converter={StaticResource StringEqualsConverter}, ConverterParameter=JUEVES}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Jueves.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               IsVisible="{Binding Jueves.Count, Converter={StaticResource ZeroToBoolConverter}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" AllowAutoHide="True">
                        <ItemsControl ItemsSource="{Binding Jueves}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- VIERNES -->
            <Border Grid.Column="4" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="VIERNES" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                IsVisible="{Binding DiaActual, Converter={StaticResource StringEqualsConverter}, ConverterParameter=VIERNES}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Viernes.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               IsVisible="{Binding Viernes.Count, Converter={StaticResource ZeroToBoolConverter}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" AllowAutoHide="True">
                        <ItemsControl ItemsSource="{Binding Viernes}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- SÁBADO -->
            <Border Grid.Column="5" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="SÁBADO" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                IsVisible="{Binding DiaActual, Converter={StaticResource StringEqualsConverter}, ConverterParameter=SÁBADO}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Sabado.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               IsVisible="{Binding Sabado.Count, Converter={StaticResource ZeroToBoolConverter}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" AllowAutoHide="True">
                        <ItemsControl ItemsSource="{Binding Sabado}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- DOMINGO -->
            <Border Grid.Column="6" Margin="5" Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="DOMINGO" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0"/>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center"
                                IsVisible="{Binding DiaActual, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DOMINGO}">
                            <TextBlock Text="HOY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2" Margin="6,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Domingo.Count}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sin episodios" FontSize="11" Foreground="#6B7280" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,2,0,8"
                               IsVisible="{Binding Domingo.Count, Converter={StaticResource ZeroToBoolConverter}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" AllowAutoHide="True">
                        <ItemsControl ItemsSource="{Binding Domingo}" ItemTemplate="{StaticResource AiringEpisodeTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
