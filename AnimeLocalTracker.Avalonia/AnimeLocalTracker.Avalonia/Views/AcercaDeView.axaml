<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:AnimeLocalTracker.Core.ViewModels;assembly=AnimeLocalTracker.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="vm:AcercaDeViewModel"
             x:Class="AnimeLocalTracker.Avalonia.Views.AcercaDeView"
             Background="Transparent">

    <Grid ClipToBounds="True" MaxWidth="1200" Margin="95,65,30,25">
        <Grid.RowDefinitions>
            <!-- Fila 0: ENCABEZADO FIJO -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: CONTENIDO DESPLAZABLE -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO FIJO DE LA VISTA -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="26" Height="26" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Acerca de AnimeLocalTracker" FontSize="26" FontWeight="Bold" Foreground="#E2E8F0" />
                    <TextBlock Text="Información del sistema, novedades de versiones y detalles del proyecto" 
                               FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- CONTENIDO DESPLAZABLE -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,24,20" HorizontalAlignment="Stretch">

                <!-- 1. TARJETA HERO DE IDENTIDAD DE LA APP -->
                <Border Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="16" Margin="0,0,0,20" Padding="24" BoxShadow="0 4 10 0 #40000000">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Width="64" Height="64" Margin="0,0,18,0">
                            <materialIcons:MaterialIcon Kind="PlayCircle" Width="36" Height="36" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="AnimeLocalTracker" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VersionAppTexto, StringFormat='v{0}'}" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Gestor y reproductor nativo multimedia para colecciones de anime locales con sincronización inteligente en AniList." 
                                       FontSize="12" Foreground="#9CA3AF" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding BuscarActualizacionesCommand}"
                                Background="#059669" BorderBrush="#047857" Foreground="White"
                                Height="42" Padding="18,0" VerticalAlignment="Center" CornerRadius="8"
                                ToolTip.Tip="Comprobar si hay una nueva versión disponible en GitHub">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="Update" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Buscar Actualizaciones" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. NOVEDADES DE LA VERSIÓN -->
                <Border Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="16" Margin="0,0,0,20" Padding="24" BoxShadow="0 4 10 0 #40000000">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1E293B" CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline" Foreground="#60A5FA" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TituloVersionTexto, StringFormat='Novedades: {0}'}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Registro de cambios y mejoras publicadas" FontSize="11" Foreground="#9CA3AF"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#14181E" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FechaVersionTexto}" FontSize="11" Foreground="#9CA3AF" FontWeight="Medium"/>
                            </Border>
                        </Grid>

                        <Border Background="#14181E" BorderBrush="#262D38" BorderThickness="1" CornerRadius="12" Padding="18,16">
                            <StackPanel>
                                <ProgressBar IsIndeterminate="True" 
                                             IsVisible="{Binding IsCargandoNovedades}" 
                                             Height="3" VerticalAlignment="Top" Foreground="#60A5FA" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding NovedadesTexto}" 
                                           Foreground="#E2E8F0" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. REPOSITORIO GITHUB Y LICENCIAS -->
                <Border Background="#121212" BorderBrush="#262D38" BorderThickness="1" CornerRadius="16" Margin="0,0,0,20" Padding="24" BoxShadow="0 4 10 0 #40000000">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialIcons:MaterialIcon Kind="Github" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Proyecto de Código Abierto (Open Source)" FontWeight="Bold" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Text="Desarrollado con .NET 8, C#, Avalonia UI, LibVLCSharp, SQLite-net, y Velopack." FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding LicenciaTexto}" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding AbrirRepositorioGitHubCommand}"
                                Background="Transparent" BorderBrush="#3B82F6" Foreground="#93C5FD" BorderThickness="1"
                                Height="40" Padding="18,0" VerticalAlignment="Center" CornerRadius="8"
                                ToolTip.Tip="Abrir repositorio en GitHub">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="OpenInNew" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Ver en GitHub" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
