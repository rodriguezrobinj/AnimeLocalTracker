# Dependencias EXTRA del daemon Python, además de las de pyproject.toml (que es la fuente de las versiones directas).
# Se compilan juntas a requirements.txt (con hashes SHA-256) con:
#   py -3.11 -m pip install pip-tools
#   py -3.11 -m piptools compile --allow-unsafe --generate-hashes --strip-extras -o requirements.txt pyproject.toml requirements.in
#   (revisar después que ningún paquete quede en versión rc/beta: grep -E "==.*(rc|a|b)[0-9]" requirements.txt)
#   Sin --upgrade solo cambia lo que cambie aquí o en pyproject.toml: el resto conserva la versión del lock anterior.
#   Ya no lleva --pre (se puso por anitopy, retirado el 2026-10-08): el lock se regeneró sin él el 2026-10-11. Los topes de
#   abajo se pusieron cuando con --pre el resolvedor elegía betas; se conservan como versiones probadas.
#   Ojo con Dependabot: regenera el lock solo desde este archivo, sin pyproject.toml, y borra yt-dlp, playwright y otros
#   (PR #18, CI en rojo). Sus PR de este directorio se cierran y la subida se hace a mano con el comando de arriba.
# El lock se instala con:  python -m pip install --require-hashes -r tools/python/requirements.txt
#                          python -m pip install --no-deps -e tools/python

# Suplantación de huella TLS para yt-dlp (la usaba el script de release por su cuenta).
# >=0.15 por PYSEC-2026-2431 (pip-audit en CI); yt-dlp 2026.8.19 soporta curl_cffi hasta 0.16.x. Se fija a la última
# estable: con --pre el resolvedor elegía un beta (0.16.4b1).
curl_cffi==0.16.3

# Empaquetado del daemon (.exe).
pyinstaller>=6.22,<7

# Se fija a la versión estable con la que se probó el daemon (el tope nació cuando, con --pre, el resolvedor eligió el
# beta 2.14.0b2).
pydantic==2.14.0
